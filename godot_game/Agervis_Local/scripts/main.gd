func handle_shop_key(key: InputEventKey) -> void :
	if barber_preview_active:
		if key.keycode == KEY_ESCAPE:
			close_barber_preview()
		elif key.keycode == KEY_UP:
			barber_preview_field = posmod(barber_preview_field - 1, 4)
		elif key.keycode in [KEY_DOWN, KEY_TAB]:
			barber_preview_field = posmod(barber_preview_field + 1, 4)
		elif key.keycode == KEY_LEFT:
			adjust_barber_preview(-1)
		elif key.keycode == KEY_RIGHT:
			adjust_barber_preview(1)
		elif key.keycode == KEY_P:
			shop_payment_source = posmod(shop_payment_source + 1, 3)
		elif key.keycode in [KEY_ENTER, KEY_SPACE]:
			confirm_barber_preview()
		return
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.PLAY
	elif key.keycode == KEY_UP:
		shop_cursor = posmod(shop_cursor - 1, shop_items.size()) if not shop_items.is_empty() else 0
		shop_quantity = 1
	elif key.keycode == KEY_DOWN:
		shop_cursor = posmod(shop_cursor + 1, shop_items.size()) if not shop_items.is_empty() else 0
		shop_quantity = 1
	elif key.keycode == KEY_LEFT:
		shop_quantity = maxi(1, shop_quantity - 1)
	elif key.keycode == KEY_RIGHT:
		shop_quantity = mini(9, shop_quantity + 1)
	elif key.keycode == KEY_TAB:
		shop_payment_source = posmod(shop_payment_source + 1, 3)
	elif key.keycode in [KEY_ENTER, KEY_SPACE]:
		purchase_shop_selection()
	elif key.keycode == KEY_S:
		sell_shop_selection()

func shop_page_start() -> int:
	return clampi((shop_cursor / 6) * 6, 0, maxi(0, shop_items.size() - 1)) if not shop_items.is_empty() else 0

func shop_page_button_rect(next_page: bool) -> Rect2:
	return Rect2(525 if next_page else 455, 154, 58, 30)

func handle_shop_pointer(screen_point: Vector2, _secondary: bool) -> void :
	if barber_preview_active:
		handle_barber_preview_pointer(screen_point)
		return
	if Rect2(1084, 98, 76, 44).has_point(screen_point):
		mode = ScreenMode.PLAY
		return
	if shop_page_button_rect(false).has_point(screen_point):
		shop_cursor = maxi(0, shop_cursor - 6)
		return
	if shop_page_button_rect(true).has_point(screen_point):
		shop_cursor = mini(maxi(0, shop_items.size() - 1), shop_cursor + 6)
		return
	var start: = shop_page_start()
	for row in range(mini(6, maxi(0, shop_items.size() - start))):
		if Rect2(120, 190 + row * 62, 470, 54).has_point(screen_point):
			shop_cursor = start + row
			shop_quantity = 1
			return
	for source_index in range(3):
		if Rect2(650 + source_index * 156, 385, 142, 46).has_point(screen_point):
			shop_payment_source = source_index
			return
	if Rect2(650, 455, 66, 52).has_point(screen_point): shop_quantity = maxi(1, shop_quantity - 1)
	elif Rect2(730, 455, 110, 52).has_point(screen_point): pass
	elif Rect2(854, 455, 66, 52).has_point(screen_point): shop_quantity = mini(9, shop_quantity + 1)
	elif Rect2(650, 535, 230, 58).has_point(screen_point): purchase_shop_selection()
	elif Rect2(900, 535, 230, 58).has_point(screen_point): sell_shop_selection()

func handle_barber_preview_pointer(screen_point: Vector2) -> void :
	if Rect2(1050, 98, 110, 44).has_point(screen_point) or Rect2(850, 552, 250, 58).has_point(screen_point):
		close_barber_preview()
		return
	for field_index in range(4):
		var row: = Rect2(120, 205 + field_index * 76, 530, 62)
		if row.has_point(screen_point):
			barber_preview_field = field_index
			if screen_point.x < row.position.x + 72:
				adjust_barber_preview(-1)
			elif screen_point.x > row.end.x - 72:
				adjust_barber_preview(1)
			return
	for source_index in range(3):
		if Rect2(695 + source_index * 140, 474, 126, 44).has_point(screen_point):
			shop_payment_source = source_index
			return
	if Rect2(580, 552, 250, 58).has_point(screen_point):
		confirm_barber_preview()

func shop_source_name() -> String:
	return ["CLEAN CASH", "DIRTY CASH", "BANK FUNDS"][shop_payment_source]

func shop_source_balance() -> int:
	return [cash, dirty_cash, bank_balance][shop_payment_source]

func change_shop_source_balance(delta: int) -> void :
	match shop_payment_source:
		0: cash = maxi(0, cash + delta)
		1: dirty_cash = maxi(0, dirty_cash + delta)
		2: bank_balance = maxi(0, bank_balance + delta)

func selected_shop_offer() -> Dictionary:
	if shop_items.is_empty(): return {}
	shop_cursor = clampi(shop_cursor, 0, shop_items.size() - 1)
	return shop_items[shop_cursor]

func purchase_shop_selection() -> void :
	var offer: = selected_shop_offer()
	if offer.is_empty(): return
	var effect: = String(offer.get("effect", "item"))
	var quantity: = 1 if effect in ["hair", "hair_color", "facial_hair", "facial_color"] else shop_quantity
	if effect == "contingency": quantity = mini(quantity, max_contingencies - contingencies.size())
	if quantity <= 0:
		notify("CONTINGENCY POUCH IS FULL", DANGER, 2.5)
		return
	var unit_price: = int(offer["price"])
	var total_price: = unit_price * quantity
	if effect == "item" and inventory.size() + quantity > carry_capacity():
		var item_name_preview: = String(offer.get("name", ""))
		var backpack_exception: = quantity == 1 and Build10.equipment_slot(item_name_preview) == "back" and inventory.size() + 1 <= projected_carry_capacity("back", item_name_preview)
		if not backpack_exception:
			notify("CARRIED INVENTORY FULL - EQUIP A BACKPACK OR BUY LESS", DANGER, 2.5)
			return

	if shop_source_balance() < total_price:
		notify("NOT ENOUGH %s  -  NEED $%d" % [shop_source_name(), total_price], DANGER, 2.5)
		return
	if online_economy_enabled():
		var vendor_id: = economy_vendor_id_for_shop()
		var item_name: = String(offer["name"])
		if vendor_id.is_empty() or (effect != "item" and effect not in ["contingency", "food", "water", "bandage"]):
			notify("THAT SERVICE IS NOT YET ON THE ONLINE LEDGER", ACCENT, 2.8)
			return
		var money_type: String = ["clean", "dirty", "bank"][shop_payment_source]
		submit_online_economy_request("PURCHASE", {
			"vendor_id": vendor_id, "item_id": item_name, "quantity": quantity, "money_type": money_type, 
		}, true, {"item_name": item_name, "quantity": quantity, "effect": effect})
		return
	change_shop_source_balance( - total_price)
	var item_name: = String(offer["name"])
	for unit in range(quantity):
		apply_shop_effect(effect, item_name)
	if shop_payment_source == 1 and not camera_for_position(area, player_position).is_empty():
		add_world_note("A camera retained a cash purchase later linkable to dirty funds if another case identifies the money.")
	shop_button_flash = 0.22
	shop_confirmation = "RECEIVED %s%s  /  PAID $%d FROM %s" % [item_name.to_upper(), " x" + str(quantity) if quantity > 1 else "", total_price, shop_source_name()]
	notify(shop_confirmation, GOOD, 3.0)

func apply_shop_effect(effect: String, item_name: String) -> void :
	match effect:
		"food": health = minf(100.0, health + 24.0)
		"water": stamina = 100.0
		"bandage": health = minf(100.0, health + 12.0)
		"contingency": equip_contingency_item(item_name)
		"hair":
			var index: = creation_hair_styles.find(player_hair_style)
			player_hair_style = creation_hair_styles[posmod(index + 1, creation_hair_styles.size())]
		"hair_color":
			var index: = creation_hair_colors.find(player_hair_color)
			player_hair_color = creation_hair_colors[posmod(index + 1, creation_hair_colors.size())]
		"facial_hair":
			var index: = creation_facial_hair_styles.find(player_facial_hair_style)
			player_facial_hair_style = creation_facial_hair_styles[posmod(index + 1, creation_facial_hair_styles.size())]
		"facial_color":
			var index: = creation_hair_colors.find(player_facial_hair_color)
			player_facial_hair_color = creation_hair_colors[posmod(index + 1, creation_hair_colors.size())]
		_: try_add_inventory_item(item_name)

