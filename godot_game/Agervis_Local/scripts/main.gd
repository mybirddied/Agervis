	dialog_bubble_pending_anchor = Vector2.ZERO
	dialog_title = title
	dialog_lines = lines
	dialog_speakers.clear()
	dialog_options = options
	menu_cursor = 0
	return_mode = mode if mode != ScreenMode.DIALOG else ScreenMode.PLAY
	mode = ScreenMode.DIALOG

func open_multi_speaker_dialog(title: String, exchanges: Array, options: Array[Dictionary]) -> void :
	click_move_active = false
	dialog_bubble_actor_id = dialog_bubble_pending_actor_id
	dialog_bubble_anchor = dialog_bubble_pending_anchor
	dialog_bubble_pending_actor_id = ""
	dialog_bubble_pending_anchor = Vector2.ZERO
	dialog_title = title
	dialog_lines.clear()
	dialog_speakers.clear()
	for exchange in exchanges:
		if exchange is Dictionary:
			dialog_speakers.append(String(exchange.get("speaker", "RESIDENT")))
			dialog_lines.append(String(exchange.get("line", "")))
	dialog_options = options
	menu_cursor = 0
	return_mode = mode if mode != ScreenMode.DIALOG else ScreenMode.PLAY
	mode = ScreenMode.DIALOG

func handle_dialog_key(key: InputEventKey) -> void :
	if dialog_options.is_empty():

		mode = return_mode
		if key.keycode in [KEY_W, KEY_A, KEY_S, KEY_D] and return_mode == ScreenMode.PLAY:
			click_move_active = false
		return
	if key.keycode == KEY_ESCAPE:
		mode = return_mode
		return
	if key.keycode == KEY_UP:
		menu_cursor = posmod(menu_cursor - 1, dialog_options.size())
		return
	if key.keycode == KEY_DOWN:
		menu_cursor = posmod(menu_cursor + 1, dialog_options.size())
		return
	if key.keycode == KEY_ENTER or key.keycode == KEY_SPACE:
		activate_dialog_selection()
		return
	var index: = numeric_index(key)
	if index >= 0 and index < dialog_options.size():
		handle_dialog_choice(String(dialog_options[index]["id"]))
func activate_dialog_selection() -> void :
	if dialog_options.is_empty():
		mode = return_mode
		return
	menu_cursor = clampi(menu_cursor, 0, dialog_options.size() - 1)
	handle_dialog_choice(String(dialog_options[menu_cursor]["id"]))

func handle_dialog_choice(choice_id: String) -> void :
	if handle_firearms_dialog_choice(choice_id):
		return
	if handle_stealth_dialog_choice(choice_id):
		return
	if handle_cooking_dialog_choice(choice_id):
		return
	if choice_id in UNSUPPORTED_ONLINE_DIALOG_MUTATIONS and reject_unsupported_online_mutation("THAT ACTION"):
