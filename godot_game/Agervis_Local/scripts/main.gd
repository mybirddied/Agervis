func draw_prop_bed(rect: Rect2, modulate: Color) -> void :
	var frame: = Color("#6b5340") * modulate
	var sheet: = Color("#ddd8c8") * modulate
	var blanket: = Color("#5d7486") * modulate
	var deck_y: = rect.position.y + rect.size.y * 0.44
	var head_w: = rect.size.x * 0.14

	draw_rect(Rect2(rect.position.x, rect.position.y, head_w, rect.end.y - rect.position.y - 12.0), frame)
	draw_rect(Rect2(rect.position.x, rect.position.y, head_w, 6.0), frame.lightened(0.2))
	draw_rect(Rect2(rect.end.x - head_w * 0.7, deck_y - 14.0, head_w * 0.7, rect.end.y - deck_y + 2.0), frame)

	var deck: = Rect2(rect.position.x + head_w, deck_y, rect.size.x - head_w * 1.7, rect.end.y - deck_y - 14.0)
	draw_rect(deck, sheet)
	draw_rect(Rect2(deck.position.x + deck.size.x * 0.32, deck.position.y, deck.size.x * 0.68, deck.size.y), blanket)

	draw_rect(Rect2(deck.position.x + deck.size.x * 0.32, deck.position.y, deck.size.x * 0.68, 7.0), 
		sheet.darkened(0.06))
	if not low_spec:

		for seam in range(3):
			var sx: = deck.position.x + deck.size.x * (0.45 + float(seam) * 0.17)
			draw_line(Vector2(sx, deck.position.y + 9.0), Vector2(sx, deck.end.y), 
				blanket.darkened(0.22), 1.0)

	draw_rect(Rect2(deck.position.x + 4.0, deck_y - 9.0, deck.size.x * 0.26, 16.0), sheet.lightened(0.1))
	if not low_spec:
		draw_line(Vector2(deck.position.x + 6.0, deck_y - 6.0), 
			Vector2(deck.position.x + deck.size.x * 0.26, deck_y - 6.0), Color(0, 0, 0, 0.12), 1.0)
	draw_prop_bed_near_band(rect, modulate, deck.end.y)




func draw_prop_bed_near_band(rect: Rect2, modulate: Color, rail_y: float) -> void :
	var frame: = Color("#6b5340") * modulate
	var blanket: = Color("#5d7486") * modulate
	var head_w: = rect.size.x * 0.14
	var span_x: = rect.position.x + head_w
	var span_w: = rect.size.x - head_w * 1.7

	draw_rect(Rect2(span_x + span_w * 0.32, rail_y, span_w * 0.68, 9.0), blanket.darkened(0.16))

	draw_rect(Rect2(span_x, rail_y, span_w, 7.0), frame)
	draw_rect(Rect2(span_x, rail_y, span_w, 2.0), frame.lightened(0.22))
	for leg in range(2):
		var lx: = span_x + 4.0 + float(leg) * (span_w - 14.0)
		draw_rect(Rect2(lx, rail_y + 7.0, 10.0, rect.end.y - rail_y - 7.0), frame.darkened(0.3))




func draw_prop_storage_unit(rect: Rect2, modulate: Color) -> void :
	var body: = Color("#7c6248") * modulate
	draw_rect(rect, body)
	draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, 6.0), body.lightened(0.2))
	draw_rect(Rect2(rect.position.x, rect.end.y - 8.0, rect.size.x, 8.0), body.darkened(0.3))
	if rect.size.x > rect.size.y * 1.4:

		draw_rect(Rect2(rect.position.x + 3.0, rect.position.y + 8.0, rect.size.x - 6.0, 8.0), 
			body.darkened(0.14))
		for door in range(2):
			var dx: = rect.position.x + 5.0 + float(door) * (rect.size.x - 10.0) * 0.5
			draw_rect(Rect2(dx, rect.position.y + 20.0, (rect.size.x - 14.0) * 0.5, rect.size.y - 32.0), 
				body.lightened(0.06))
			if not low_spec:
				draw_circle(Vector2(dx + (rect.size.x - 14.0) * 0.5 - 7.0, 
					rect.position.y + rect.size.y * 0.55), 3.0, Color("#c8b487") * modulate)
	else:

		var rows: = 3
		var drawer_h: = (rect.size.y - 18.0) / float(rows)
		for row in range(rows):
			var dy: = rect.position.y + 9.0 + float(row) * drawer_h
			var inset: = 4.0 if row > 0 else 1.0
			draw_rect(Rect2(rect.position.x + inset, dy, rect.size.x - inset * 2.0, drawer_h - 4.0), 
				body.lightened(0.08 if row == 0 else 0.02))
			draw_rect(Rect2(rect.position.x + inset, dy, rect.size.x - inset * 2.0, 2.0), 
				body.lightened(0.24))
			if not low_spec:
				draw_rect(Rect2(rect.position.x + rect.size.x * 0.5 - 11.0, dy + drawer_h * 0.4, 22.0, 4.0), 
					Color("#c0aa7e") * modulate)
			if row == 0:

				draw_rect(Rect2(rect.position.x + 8.0, dy + 3.0, rect.size.x - 16.0, drawer_h * 0.4), 
					Color("#2b2724") * modulate)


func draw_prop_lesson_board(rect: Rect2, modulate: Color) -> void :
	var tray_h: = 12.0
	draw_rect(rect, Color("#8a7f6c") * modulate)
	var face: = Rect2(rect.position.x + 6.0, rect.position.y + 6.0, 
		rect.size.x - 12.0, rect.size.y - tray_h - 12.0)
	draw_rect(face, Color("#eef0e8") * modulate)
	if not low_spec:

		for line in range(6):
			var ly: = face.position.y + 10.0 + float(line) * (face.size.y - 20.0) / 6.0
			var width: = face.size.x * (0.34 + float(posmod(line * 37, 5)) * 0.11)
			var ink: = Color("#2f3f55") if line % 2 == 0 else Color("#8c3630")
			draw_line(Vector2(face.position.x + 9.0, ly), Vector2(face.position.x + 9.0 + width, ly), 
				ink * modulate, 2.0)

		var chart: = Rect2(face.end.x - face.size.x * 0.28, face.position.y + 6.0, 
			face.size.x * 0.24, face.size.y * 0.4)
		draw_rect(chart, Color("#f6f2e2") * modulate)
		draw_rect(chart, Color("#b7b09c") * modulate)
		draw_rect(Rect2(chart.position.x + 2.0, chart.position.y + 2.0, chart.size.x - 4.0, chart.size.y - 4.0), 
			Color("#fbf8ec") * modulate)
		for bar in range(3):
			var bh: = chart.size.y * (0.3 + float(bar) * 0.2)
			draw_rect(Rect2(chart.position.x + 5.0 + float(bar) * (chart.size.x - 10.0) / 3.0, 
				chart.end.y - 4.0 - bh, (chart.size.x - 12.0) / 3.0, bh), Color("#5b7f6d") * modulate)

	var tray: = Rect2(rect.position.x + 6.0, rect.end.y - tray_h - 4.0, rect.size.x - 12.0, tray_h)
	draw_rect(tray, Color("#6f6555") * modulate)
	draw_rect(Rect2(tray.position.x, tray.position.y, tray.size.x, 3.0), Color("#93887456") * modulate)
	if not low_spec:
		for pen in range(3):
			var px: = tray.position.x + 8.0 + float(pen) * 20.0
			var pen_tint: = Color("#2c3a4c")
			match posmod(pen, 3):
				1: pen_tint = Color("#8e3a33")
				2: pen_tint = Color("#3d6b4a")
			draw_rect(Rect2(px, tray.position.y + 3.0, 15.0, 4.0), pen_tint * modulate)
		draw_rect(Rect2(tray.end.x - 26.0, tray.position.y + 2.0, 20.0, 6.0), Color("#d8d2c0") * modulate)



func draw_prop_notice_panel(rect: Rect2, modulate: Color) -> void :
	draw_rect(rect, Color("#6d5c46") * modulate)
	var cork: = Rect2(rect.position.x + 7.0, rect.position.y + 7.0, rect.size.x - 14.0, rect.size.y * 0.62)
	draw_rect(cork, Color("#b08e5f") * modulate)
	if not low_spec:

		for fleck in range(18):
			var fx: = cork.position.x + 4.0 + float(posmod(fleck * 47, int(maxf(cork.size.x - 8.0, 1.0))))
			var fy: = cork.position.y + 3.0 + float(posmod(fleck * 61, int(maxf(cork.size.y - 6.0, 1.0))))
			draw_rect(Rect2(fx, fy, 2.0, 2.0), Color(0, 0, 0, 0.12))

	for sheet in range(3):
		var seed: = posmod(sheet * 29, 100)
		var sw: = cork.size.x * 0.26
		var sh: = cork.size.y * 0.62
		var sx: = cork.position.x + 6.0 + float(sheet) * (cork.size.x - 12.0 - sw) * 0.5
		var sy: = cork.position.y + 5.0 + float(seed % 3) * 3.0
		var paper: = Color("#f2eddc")
		match posmod(seed, 3):
			1: paper = Color("#e6d98f")
			2: paper = Color("#dfe8ec")
		draw_rect(Rect2(sx, sy, sw, sh), paper * modulate)
		if not low_spec:
			for line in range(4):
				draw_line(Vector2(sx + 4.0, sy + 7.0 + float(line) * (sh - 12.0) / 4.0), 
					Vector2(sx + sw - 5.0, sy + 7.0 + float(line) * (sh - 12.0) / 4.0), 
					Color(0, 0, 0, 0.22), 1.0)
			draw_circle(Vector2(sx + sw * 0.5, sy + 4.0), 2.5, Color("#b8402f") * modulate)

	var box: = Rect2(rect.position.x + rect.size.x * 0.32, cork.end.y + 8.0, 
		rect.size.x * 0.36, rect.end.y - cork.end.y - 14.0)
	draw_rect(box, Color("#585f61") * modulate)
	draw_rect(Rect2(box.position.x, box.position.y, box.size.x, 3.0), Color("#7d8486") * modulate)
	if not low_spec:
		draw_rect(Rect2(box.position.x + 5.0, box.position.y + 6.0, box.size.x - 10.0, box.size.y * 0.3), 
			Color("#233c33") * modulate)
		for key in range(6):
			draw_rect(Rect2(box.position.x + 6.0 + float(key % 3) * (box.size.x - 12.0) / 3.0, 
				box.position.y + box.size.y * 0.48 + float(key / 3) * 9.0, 7.0, 6.0), 
				Color("#9aa1a2") * modulate)
		draw_circle(Vector2(box.end.x - 6.0, box.position.y + 8.0), 2.5, Color("#d8503c") * modulate)



func draw_prop_teller_counter(rect: Rect2, modulate: Color) -> void :
	var stone: = Color("#8d8577") * modulate
	var counter_top: = rect.position.y + rect.size.y * 0.46

	var glass: = Rect2(rect.position.x + 8.0, rect.position.y + 4.0, rect.size.x - 16.0, counter_top - rect.position.y)
	draw_rect(glass, Color(0.71, 0.79, 0.8, 0.34) * modulate)
	var stations: = 3
	for station in range(stations):
		var sx: = glass.position.x + float(station) * glass.size.x / float(stations)
		var sw: = glass.size.x / float(stations)

		draw_rect(Rect2(sx, glass.position.y, 5.0, glass.size.y), stone.darkened(0.24))
		if not low_spec:

			var grille_x: = sx + sw * 0.5
			for slot in range(4):
				draw_line(Vector2(grille_x - 9.0, glass.end.y - 22.0 + float(slot) * 4.0), 
					Vector2(grille_x + 9.0, glass.end.y - 22.0 + float(slot) * 4.0), 
					Color(0, 0, 0, 0.3), 1.0)
			draw_line(Vector2(sx + 8.0, glass.end.y - 6.0), Vector2(sx + sw * 0.6, glass.position.y + 6.0), 
				Color(1, 1, 1, 0.12), 4.0)
	draw_rect(Rect2(glass.end.x - 5.0, glass.position.y, 5.0, glass.size.y), stone.darkened(0.24))

	draw_rect(Rect2(rect.position.x, counter_top, rect.size.x, 14.0), stone.lightened(0.14))
	draw_rect(Rect2(rect.position.x, counter_top + 11.0, rect.size.x, 4.0), stone.darkened(0.26))
	draw_rect(Rect2(rect.position.x + 6.0, counter_top + 15.0, rect.size.x - 12.0, rect.end.y - counter_top - 15.0), 
		stone.darkened(0.12))
	if not low_spec:

		for panel in range(5):
			var px: = rect.position.x + 14.0 + float(panel) * (rect.size.x - 28.0) / 5.0
			draw_rect(Rect2(px, counter_top + 22.0, (rect.size.x - 40.0) / 5.0, rect.end.y - counter_top - 30.0), 
				stone.darkened(0.2))
		for station2 in range(stations):
			var dx: = glass.position.x + (float(station2) + 0.5) * glass.size.x / float(stations)
			draw_rect(Rect2(dx - 16.0, counter_top + 3.0, 32.0, 6.0), Color("#3a3d3c") * modulate)



func draw_prop_recorder_rack(rect: Rect2, modulate: Color) -> void :
	var shell: = Color("#43494b") * modulate
	draw_rect(rect, shell)
	draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, 5.0), shell.lightened(0.2))
	var bay: = Rect2(rect.position.x + 7.0, rect.position.y + 9.0, rect.size.x - 14.0, rect.size.y * 0.72)
	draw_rect(bay, Color("#1d2223") * modulate)
	var decks: = 4
	var deck_h: = bay.size.y / float(decks)
	for deck in range(decks):
		var dy: = bay.position.y + float(deck) * deck_h
		draw_rect(Rect2(bay.position.x + 3.0, dy + 2.0, bay.size.x - 6.0, deck_h - 4.0), 
			Color("#2f3739") * modulate)
		if low_spec:
			continue
		draw_rect(Rect2(bay.position.x + 3.0, dy + 2.0, bay.size.x - 6.0, 2.0), Color("#4b5557") * modulate)

		draw_rect(Rect2(bay.position.x + 8.0, dy + deck_h * 0.45, bay.size.x * 0.4, 3.0), 
			Color("#151a1b") * modulate)
		draw_circle(Vector2(bay.end.x - 12.0, dy + deck_h * 0.5), 2.0, 
			(Color("#57c46a") if posmod(deck, 2) == 0 else Color("#d6a13a")) * modulate)
		draw_circle(Vector2(bay.end.x - 21.0, dy + deck_h * 0.5), 2.0, Color("#2f4a52") * modulate)
	if not low_spec:

		var step: = 9.0
		var gx: = bay.position.x + step
		while gx < bay.end.x - 2.0:
			draw_line(Vector2(gx, bay.position.y + 2.0), Vector2(gx, bay.end.y - 2.0), Color(0, 0, 0, 0.2), 1.0)
			gx += step

		draw_arc(Vector2(rect.position.x + rect.size.x * 0.3, rect.end.y - 10.0), 12.0, 
			0.0, PI, 12, Color("#1a1d1e") * modulate, 3.0)
		draw_arc(Vector2(rect.position.x + rect.size.x * 0.55, rect.end.y - 8.0), 9.0, 
			0.0, PI, 10, Color("#1a1d1e") * modulate, 3.0)

	draw_rect(Rect2(rect.position.x + 4.0, rect.end.y - 7.0, rect.size.x - 8.0, 7.0), shell.darkened(0.34))



func draw_prop_floor_safe(rect: Rect2, modulate: Color) -> void :
	var body: = Color("#4e5457") * modulate
	draw_rect(rect, body)
	draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, 6.0), body.lightened(0.22))
	draw_rect(Rect2(rect.position.x, rect.end.y - 9.0, rect.size.x, 9.0), body.darkened(0.36))
	var door: = Rect2(rect.position.x + 9.0, rect.position.y + 11.0, rect.size.x - 18.0, rect.size.y - 26.0)
	draw_rect(door, body.darkened(0.16))
	draw_rect(Rect2(door.position.x, door.position.y, door.size.x, 3.0), Color(0, 0, 0, 0.26))
	draw_rect(Rect2(door.position.x + 3.0, door.position.y + 3.0, door.size.x - 6.0, door.size.y - 6.0), 
		body.lightened(0.06))
	var centre: = Vector2(door.position.x + door.size.x * 0.44, door.position.y + door.size.y * 0.44)
	var dial_r: = minf(door.size.x, door.size.y) * 0.21
	draw_circle(centre, dial_r + 4.0, body.darkened(0.28))
	draw_circle(centre, dial_r, Color("#9ba2a4") * modulate)
	draw_circle(centre, dial_r * 0.62, Color("#6f7679") * modulate)
	if not low_spec:

		for tick in range(12):
			var angle: = float(tick) * TAU / 12.0
			draw_line(centre + Vector2(cos(angle), sin(angle)) * (dial_r - 3.0), 
				centre + Vector2(cos(angle), sin(angle)) * dial_r, Color(0, 0, 0, 0.4), 1.0)
		draw_line(centre, centre + Vector2(0.4, -0.9) * dial_r * 0.8, Color("#202526") * modulate, 2.0)
		draw_line(Vector2(centre.x, centre.y - dial_r - 6.0), Vector2(centre.x, centre.y - dial_r - 2.0), 
			Color("#d8d2c0") * modulate, 2.0)

		for hinge in range(2):
			draw_rect(Rect2(door.end.x - 4.0, door.position.y + door.size.y * (0.2 + float(hinge) * 0.5), 
				5.0, door.size.y * 0.16), body.lightened(0.18))

	var handle: = Vector2(door.end.x - door.size.x * 0.2, centre.y + door.size.y * 0.16)
	draw_arc(handle, dial_r * 0.6, 0.0, TAU, 16, Color("#aab1b3") * modulate, 3.0)
	for spoke in range(3):
		var sa: = float(spoke) * PI / 3.0
		draw_line(handle - Vector2(cos(sa), sin(sa)) * dial_r * 0.6, 
			handle + Vector2(cos(sa), sin(sa)) * dial_r * 0.6, Color("#aab1b3") * modulate, 2.0)

