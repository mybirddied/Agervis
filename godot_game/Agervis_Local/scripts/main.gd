			{"question": "The machine shakes violently.", "answers": ["Stop it and rebalance the load", "Sit on it", "Turn up the music", "Call it agitation training"]}, 
			{"question": "A customer returns for the wrong bag.", "answers": ["Check the tag before release", "Trust the confidence", "Trade for cash", "Hide both bags"]}, 
