		draw_rect(Rect2(bx + 1.0, caddy.position.y - 14.0, 4.0, 3.0), (tint * modulate).darkened(0.3))

	draw_colored_polygon(PackedVector2Array([
		Vector2(rect.end.x - 26.0, rect.end.y - 4.0), 
		Vector2(rect.end.x - 16.0, rect.end.y - 30.0), 
		Vector2(rect.end.x - 6.0, rect.end.y - 4.0), 
	]), Color("#d8b03f") * modulate)


