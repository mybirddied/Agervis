			draw_text("EMPTY RESIDENT FILE", rect.position + Vector2(72, 45), 17, Color("#0a0c0e"))
			draw_text("EMPTY RESIDENT FILE", rect.position + Vector2(70, 43), 17, Color("#6a6560"))


			draw_centered("+ CREATE NEW RESIDENT", rect.get_center() + Vector2(200, 0), 14, Color("#5a5d52"))


	for premium_index in range(ReleaseSave.PREMIUM_SLOTS):
