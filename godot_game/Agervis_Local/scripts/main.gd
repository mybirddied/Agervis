func draw_vector_barber_chair(rect: Rect2, modulate: Color) -> void :
	var chrome: = Color("#9ea7ab") * modulate
	var hide: = Color("#7a2f34") * modulate
	var cx: = rect.position.x + rect.size.x * 0.5
	draw_rect(Rect2(rect.position.x + 10.0, rect.end.y - 8.0, rect.size.x - 20.0, 11.0), Color(0, 0, 0, 0.26))

	for spoke in range(5):
		var angle: = PI + float(spoke) * PI / 4.0
		var reach: = rect.size.x * 0.42
		draw_line(Vector2(cx, rect.end.y - 12.0), 
			Vector2(cx + cos(angle) * reach, rect.end.y - 6.0 + sin(angle) * 3.0), chrome.darkened(0.2), 6.0)
		if not low_spec:
			draw_circle(Vector2(cx + cos(angle) * reach, rect.end.y - 5.0), 3.0, Color("#33383a") * modulate)

	var seat_y: = rect.position.y + rect.size.y * 0.52
	draw_rect(Rect2(cx - 9.0, seat_y + 14.0, 18.0, rect.end.y - seat_y - 26.0), chrome)
	draw_line(Vector2(cx - 9.0, seat_y + 18.0), Vector2(cx - 9.0, rect.end.y - 14.0), Color(1, 1, 1, 0.22), 2.0)
	draw_rect(Rect2(cx - 14.0, seat_y + 30.0, 28.0, 9.0), chrome.darkened(0.28))
	if not low_spec:

		draw_line(Vector2(cx + 12.0, seat_y + 36.0), Vector2(cx + 34.0, seat_y + 44.0), chrome.darkened(0.34), 3.0)

	draw_arc(Vector2(cx, seat_y + 6.0), rect.size.x * 0.3, 0.15 * PI, 0.85 * PI, 16, chrome, 4.0)

	var back_w: = rect.size.x * 0.56
	var back_top: = rect.position.y + rect.size.y * 0.16
	draw_rect(Rect2(cx - back_w * 0.5, back_top, back_w, seat_y - back_top + 6.0), hide)
	draw_rect(Rect2(cx - back_w * 0.5, back_top, back_w, 5.0), hide.lightened(0.18))
	if not low_spec:

		for seam in range(2):
			var sx: = cx - back_w * 0.17 + float(seam) * back_w * 0.34
			draw_line(Vector2(sx, back_top + 8.0), Vector2(sx, seat_y), hide.darkened(0.26), 2.0)
	var head_w: = back_w * 0.68
	draw_rect(Rect2(cx - head_w * 0.5, rect.position.y + 2.0, head_w, rect.size.y * 0.14 - 2.0), hide.lightened(0.08))

	var seat_w: = rect.size.x * 0.66
	draw_rect(Rect2(cx - seat_w * 0.5, seat_y, seat_w, 16.0), hide.lightened(0.12))
	draw_rect(Rect2(cx - seat_w * 0.5, seat_y + 12.0, seat_w, 4.0), hide.darkened(0.3))

	for side in range(2):
		var ax: = cx + (-1.0 if side == 0 else 1.0) * seat_w * 0.5
		draw_rect(Rect2(ax - 7.0, seat_y - 20.0, 14.0, 8.0), Color("#2f3335") * modulate)
		draw_rect(Rect2(ax - 4.0, seat_y - 12.0, 8.0, 13.0), chrome.darkened(0.16))



func draw_vector_barber_style_wall(rect: Rect2, modulate: Color) -> void :
	var board_h: = rect.size.y * 0.6
	var frame: = Color("#59493a") * modulate
	draw_rect(Rect2(rect.position.x + 4.0, rect.end.y - 6.0, rect.size.x - 8.0, 9.0), Color(0, 0, 0, 0.22))

	draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, board_h), frame)
	var inner: = Rect2(rect.position.x + 6.0, rect.position.y + 6.0, rect.size.x - 12.0, board_h - 12.0)
	draw_rect(inner, Color("#e7e0cf") * modulate)


	var cols: = 4
	var rows: = 2
	var cell_w: = inner.size.x / float(cols)
	var cell_h: = inner.size.y / float(rows)
	for row in range(rows):
		for col in range(cols):
			var seed: = posmod(row * 31 + col * 17, 100)
			var photo: = Rect2(inner.position.x + float(col) * cell_w + 3.0, 
				inner.position.y + float(row) * cell_h + 3.0, cell_w - 6.0, cell_h - 6.0)
			var backdrop: = Color("#8ea3ac")
			match posmod(seed, 3):
				1: backdrop = Color("#a99a86")
				2: backdrop = Color("#94a58f")
			draw_rect(photo, backdrop * modulate)

			var hx: = photo.position.x + photo.size.x * 0.5
			var skin: = Color("#8a6247") if seed % 2 == 0 else Color("#c69a76")
			draw_rect(Rect2(hx - photo.size.x * 0.3, photo.end.y - photo.size.y * 0.3, 
				photo.size.x * 0.6, photo.size.y * 0.3), skin.darkened(0.4) * modulate)
			var head_r: = minf(photo.size.x, photo.size.y) * 0.22
			draw_circle(Vector2(hx, photo.end.y - photo.size.y * 0.42), head_r, skin * modulate)
			if not low_spec:

				var hair: = Color("#2a2320") * modulate
				match posmod(seed, 4):
					0: draw_arc(Vector2(hx, photo.end.y - photo.size.y * 0.42), head_r, PI, TAU, 12, hair, 4.0)
					1: draw_rect(Rect2(hx - head_r, photo.end.y - photo.size.y * 0.42 - head_r - 3.0, 
						head_r * 2.0, 5.0), hair)
					2: draw_circle(Vector2(hx, photo.end.y - photo.size.y * 0.48), head_r * 0.95, hair)
					_: draw_arc(Vector2(hx, photo.end.y - photo.size.y * 0.44), head_r * 1.1, 
						1.1 * PI, 1.9 * PI, 12, hair, 5.0)

	var cab: = Rect2(rect.position.x + 12.0, rect.position.y + board_h + 6.0, 
		rect.size.x - 24.0, rect.end.y - rect.position.y - board_h - 6.0)
	draw_rect(cab, Color("#6f6154") * modulate)
	draw_rect(Rect2(cab.position.x, cab.position.y, cab.size.x, 5.0), Color("#8d7d6d") * modulate)
	if not low_spec:

		for item in range(4):
			var ix: = cab.position.x + 10.0 + float(item) * (cab.size.x - 20.0) / 3.0
			var ih: = 9.0 + float(posmod(item * 19, 3)) * 4.0
			var bottle: = Color("#4f7f86")
			match posmod(item, 3):
				1: bottle = Color("#c0913f")
				2: bottle = Color("#9c4a52")
			draw_rect(Rect2(ix, cab.position.y - ih, 6.0, ih), bottle * modulate)
			draw_rect(Rect2(ix + 1.0, cab.position.y - ih - 3.0, 4.0, 3.0), Color("#d8d2c4") * modulate)

		for seam in range(2):
			var sy: = cab.position.y + 12.0 + float(seam) * (cab.size.y - 16.0) * 0.5
			draw_line(Vector2(cab.position.x + 4.0, sy), Vector2(cab.end.x - 4.0, sy), 
				Color(0, 0, 0, 0.24), 1.0)
			draw_rect(Rect2(cab.position.x + cab.size.x * 0.5 - 9.0, sy + 3.0, 18.0, 3.0), 
				Color("#b9ad9c") * modulate)

