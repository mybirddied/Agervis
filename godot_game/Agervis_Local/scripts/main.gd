func named_room_fixture_solids() -> Array[Rect2]:
	var points: Array[Vector2] = []
	match area:
		"store":
			if room_id == "stockroom": points = [Vector2(285, 205), Vector2(650, 205)]
			elif room_id in ["safe", "dvr"]: points = [Vector2(500, 205)]
		"backroom": points = [Vector2(360, 205), Vector2(650, 205)]
		"restaurant":
			if room_id in ["kitchen", "office", "delivery"]: points = [Vector2(500, 220)]
		"tutorial", "school":
			if room_id in ["safety", "scholarship"]: points = [Vector2(500, 220)]
		"bank", "hospital", "jail", "precinct", "pillmill", "clinic":
			if not room_id in ["lobby", "intake", "booking", "tier", "waiting"]: points = [Vector2(500, 205)]
		"social", "apartment", "barber", "laundromat", "pawn":
			if not room_id in ["lobby", "floor", "sales"]: points = [Vector2(500, 205)]
	var solids: Array[Rect2] = []
	for point in points:
		solids.append(Rect2(point.x - 100.0, point.y - 8.0, 200.0, 28.0))
	return solids

func draw_named_workstation(world_point: Vector2, label: String, body: Color, accent: Color = Color("#242826")) -> void :
	var point: = scene_position(world_point)
	var frame: = Rect2(point.x - 108, point.y - 116, 216, 98)
	draw_rect(frame, body.darkened(0.35))
	draw_rect(frame.grow(-7), body)
	draw_rect(Rect2(frame.position + Vector2(13, 18), Vector2(190, 34)), accent.darkened(0.1))
	for slot in range(4):
		draw_rect(Rect2(frame.position + Vector2(20 + slot * 43, 62), Vector2(29, 22)), body.lightened(0.16))
	draw_rect(Rect2(point.x - 118, point.y - 20, 236, 26), Color("#171a1a"))
	draw_centered(label, Vector2(point.x, point.y - 2), 11, PAPER)

