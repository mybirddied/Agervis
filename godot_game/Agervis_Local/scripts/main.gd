func handle_driveby_shot(car: Dictionary) -> void :
	var is_police: = bool(car.get("police", false))

	if is_police:

		car["shots_remaining"] = rng.randi_range(6, 8)
		car["shot_interval"] = rng.randf_range(0.3, 0.4)
		car["shot_timer"] = car["shot_interval"]
