func study_choice_count(difficulty_tier: int, intelligence_level: int, classroom_max_level: int) -> int:



	var base_counts: = [4, 6, 8]
	var count: = int(base_counts[clampi(difficulty_tier, 0, base_counts.size() - 1)])
	if classroom_max_level > 0 and intelligence_level >= classroom_max_level:
		count -= 1
	return maxi(2, count)

func prepare_visible_question(source: Dictionary, requested_choices: int) -> Dictionary:
	var source_answers: Array = source.get("answers", [])
	if source_answers.size() < 2:
		return source.duplicate(true)
	var correct_text: = String(source_answers[clampi(int(source.get("correct", 0)), 0, source_answers.size() - 1)])
	var distractors: Array[String] = []
	for answer in source_answers:
		if String(answer) != correct_text: distractors.append(String(answer))
	distractors.shuffle()
	var choice_count: = clampi(requested_choices, 2, source_answers.size())
	var visible: Array[String] = [correct_text]
	for index in range(mini(choice_count - 1, distractors.size())):
		visible.append(distractors[index])
	visible.shuffle()
	return {
		"subject": source.get("subject", "Practical Reasoning"), 
		"question": source.get("question", "Question unavailable"), 
		"answers": visible, 
		"correct": visible.find(correct_text), 
	}

func begin_education_test(context: String, question_count: int, choice_count: int, required_correct: int) -> void :
	quiz_context = context
	education_test_queue.clear()
	var pool: Array = quiz_bank.duplicate(true)
	if context.begins_with("skill_class_"):
		var classroom_skill: = context.trim_prefix("skill_class_").capitalize()
		pool = EducationQuestions.questions_for_skill(classroom_skill)
	if pool.is_empty():
		pool = quiz_bank.duplicate(true)
	pool.shuffle()
	for index in range(mini(question_count, pool.size())):
		education_test_queue.append(prepare_visible_question(pool[index], choice_count))
	education_test_index = 0
	education_test_score = 0
	education_test_correct = 0
	education_test_required = required_correct
	show_next_education_question()

func show_next_education_question() -> void :
	if education_test_index >= education_test_queue.size():
		finish_education_test()
		return
	quiz_question = education_test_queue[education_test_index]
	menu_cursor = -1
	mode = ScreenMode.QUIZ

func handle_quiz_key(key: InputEventKey) -> void :

	if key.keycode == KEY_ESCAPE:
		notify("ASSESSMENT IN PROGRESS  -  FINISH THE FILED QUESTIONS", ACCENT, 2.0)
		return
	var answer_index: = numeric_index(key)
	var answers: Array = quiz_question.get("answers", [])
	if answer_index < 0 or answer_index >= answers.size():
		return
	submit_quiz_answer(answer_index)

func submit_quiz_answer(answer_index: int) -> void :
	var answers: Array = quiz_question.get("answers", [])
	if answer_index < 0 or answer_index >= answers.size():
		return
	if not education_server_quiz_id.is_empty():
		education_server_answers.append(answer_index)
		education_test_index += 1
		if education_test_index < education_test_queue.size():
			show_next_education_question()
		else:
			mode = ScreenMode.PLAY
			submit_online_economy_request("SCHOOL_STUDY_COMPLETE", {
				"quiz_id": education_server_quiz_id, 
				"desk_instance_id": education_server_desk_instance_id, 
				"answers": education_server_answers.duplicate(), 
			}, true, {"skill": quiz_context.trim_prefix("skill_class_").capitalize()})
		return
	var correct: = answer_index == int(quiz_question["correct"])
	var reward: = Build9.temporary_question_reward(answers.size(), 2)
	education_test_score += reward if correct else -2
	if correct: education_test_correct += 1
	education_test_index += 1
	show_next_education_question()

func finish_education_test() -> void :
	mode = ScreenMode.PLAY
	if quiz_context != "jail" and reject_unsupported_online_mutation("EDUCATION REWARD"):
		return
	var passed: = education_test_correct >= education_test_required
	var point_change: = education_test_score
	if not online_authority_enforced():
		education_points = maxi(0, education_points + point_change)
	if quiz_context.begins_with("skill_class_"):
		var classroom_skill: = quiz_context.trim_prefix("skill_class_").capitalize()
		var classroom_max_level: = current_skill_classroom_max_level()
		if passed and skill_level(classroom_skill) < classroom_max_level:
			grant_xp(classroom_skill, 95)
			notify("%s PRACTICAL PASSED - LEVEL %d / %d | SCHOLARSHIP %+d" % [classroom_skill.to_upper(), skill_level(classroom_skill), classroom_max_level, point_change], GOOD, 4.0)
		else:
			notify("%s PRACTICAL FILED - NO TUTORIAL ADVANCEMENT | SCHOLARSHIP %+d" % [classroom_skill.to_upper(), point_change], ACCENT, 4.0)
	elif quiz_context.begins_with("course_"):
		var course_id: = quiz_context.trim_prefix("course_")
		if passed:
			secondary_course_credits[course_id] = true
			ged_lessons = completed_course_count()
			grant_course_xp(course_id, 170)
			notify("COURSE CREDIT FILED  -  %d/4 | SCHOLARSHIP %+d" % [completed_course_count(), point_change], GOOD, 4.0)
		else:
			grant_xp("Intelligence", 25)
			notify("COURSE CREDIT NOT FILED  -  PRACTICE RETAINED | SCHOLARSHIP %+d" % point_change, ACCENT, 4.0)
	elif quiz_context == "diploma_final":
		if passed:
			credentials.append("High School Diploma")
			grant_xp("Intelligence", 520)
			grant_xp("Civics", 260)
			maybe_issue_college_letter()
			notify("HIGH SCHOOL DIPLOMA AWARDED  -  %d/%d CORRECT" % [education_test_correct, education_test_queue.size()], GOOD, 5.0)
		else:
			notify("DIPLOMA FINAL NOT PASSED  -  %d/6 CORRECT; COURSE CREDITS REMAIN" % education_test_correct, DANGER, 5.0)
	elif quiz_context == "ged_assessment":
		if passed:
			credentials.append("GED")
			grant_xp("Intelligence", 620)
			grant_xp("Civics", 220)
			maybe_issue_college_letter()
			notify("GED AWARDED  -  %d/%d CORRECT" % [education_test_correct, education_test_queue.size()], GOOD, 5.0)
		else:
			notify("GED ASSESSMENT NOT PASSED  -  %d/12 CORRECT" % education_test_correct, DANGER, 5.0)
	elif quiz_context == "secondary_practice":
		if passed:
			grant_xp("Intelligence", 44)
			notify("PRACTICE CORRECT  -  REDUCED CREDENTIAL XP | SCHOLARSHIP %+d" % point_change, GOOD, 3.0)
		else:
			notify("PRACTICE FILED  -  NO PERMANENT XP | SCHOLARSHIP %+d" % point_change, ACCENT, 3.0)
	elif quiz_context == "jail":
		if passed:
			if not online_authority_enforced():
				grant_xp("Intelligence", 110)
				grant_xp("Civics", 55)
			complete_sentence_credit("JAIL EDUCATION")
		if passed: notify("JAIL COURSE ANSWER CORRECT  -  SCHOLARSHIP %+d" % point_change, GOOD, 3.0)
		else: notify("JAIL COURSE COMPLETED  -  ATTENTION NOT CONFIRMED", ACCENT, 3.0)
	save_current_character()

func grant_course_xp(course_id: String, amount: int) -> void :
	for course in Build9.CORE_COURSES:
		if String(course["id"]) != course_id: continue
		for skill_name in course["skills"]:
			grant_xp(String(skill_name), amount)
		return

