	draw_rect(Rect2(right_mount_x - 6, screen.position.y - 4, 12, 8), mount_bracket_color)


	var player_screen_pos: = scene_position(player_position)
	var player_blocks_light: = false
	if player_screen_pos.y > beam_end.y and player_screen_pos.y < beam_start.y:

