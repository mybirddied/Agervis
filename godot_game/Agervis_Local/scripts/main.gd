		notify("REQUIRES %s" % permanent_harm_requirement_text(fatal).to_upper(), DANGER, 3.5)
		return
	inventory.erase("Prepared Tool")
	mode = ScreenMode.PLAY
	var crime: = "ATTEMPTED MURDER" if fatal else "ATTEMPTED LASTING INJURY"
	add_crime(crime)
	activate_mark()
	var target_marked: = selected_actor.mark_time > 0.0 or selected_actor.role in ["Robber", "Betrayer"]
	var roll: = rng.randi_range(1, 16)
	var success: = Rules.fatality_succeeds(roll, target_marked)
	record_camera_event(crime, player_name, "%s disposition attempt; roll retained server-side." % crime, 45, player_position)
	if success:
		if fatal:
			selected_actor.removed = true
			notify("d16=%d  -  FATALITY TOOK" % roll, DANGER, 5.0)
		else:
			selected_actor.maimed = true
