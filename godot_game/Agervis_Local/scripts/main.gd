func draw_admin_tile_record(record: Dictionary) -> void :
	var point: Variant = record.get("position", Vector2.ZERO)
	var size: Variant = record.get("size", Vector2(64, 64))
	var source: Variant = record.get("source_rect", Rect2(0, 0, 256, 256))
	if not point is Vector2 or not size is Vector2 or not source is Rect2:
		return
	var destination: = world_rect_to_screen_rect(Rect2((point as Vector2) - (size as Vector2) * 0.5, size as Vector2))
