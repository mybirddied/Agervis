func add_world_note(description: String) -> void :
	camera_audit.append({
		"action": "WORLD NOTE", "actor": "SERVER", "description": description, 
		"strength": 0, "time": time_stamp(), 
	})

func time_stamp() -> String:
	var minute: = int(elapsed / 2.0) % 60
	var hour: = 18 + int(elapsed / 120.0)
	return "%02d:%02d" % [hour % 24, minute]

func camera_for_position(event_area: String, point: Vector2) -> String:


	if event_area == "backroom":
		return "STORE-SAFE" if point.distance_to(Vector2(650, 205)) <= 150.0 else ""
	if event_area == "restaurant" and room_id == "office":
		return "ALIBIS-OFFICE"
	var interior_cameras: = {
		"store": "STORE-INTERIOR", "bank": "BANK-LOBBY", 
		"school": "SCHOOL-HALL", "social": "SOCIAL-SERVICES-HALL", "restaurant": "ALIBIS-COUNTER", 
		"laundromat": "LAUNDRY-OFFICE", "pawn": "PAWN-COUNTER", 
		"pillmill": "PILLMILL-LOBBY", "clinic": "CLINIC-LOBBY", 
	}
	if event_area == "precinct" and room_id == "lobby":
		return "PRECINCT-LOBBY"
	if event_area in interior_cameras:
		return String(interior_cameras[event_area])
	if event_area == "jail" and point.x >= 540.0 and point.x <= 720.0:
		return "JAIL-TIER-CAMERA"
	if event_area == "street":
		for zone in [
			[1480.0, 1840.0, "SCHOOL-EXTERIOR"], [2880.0, 3200.0, "ALIBIS-EXTERIOR"], 
			[4920.0, 5280.0, "STORE-EXTERIOR"], [5680.0, 5960.0, "PAWN-EXTERIOR"], 
			[6400.0, 6680.0, "HOSPITAL-EXTERIOR"], [7120.0, 7440.0, "PRECINCT-EXTERIOR"], 
			[7860.0, 8200.0, "BANK-EXTERIOR"], 
		]:
			if point.x >= float(zone[0]) and point.x <= float(zone[1]): return String(zone[2])
	return ""

func record_camera_event(
	event_type: String, 
	subject: String, 
	description: String, 
	strength: int, 
	point: Vector2
) -> void :
	if subject == player_name and camera_evasion_timer > 0.0:
		return
	var camera_id: = camera_for_position(area, point)
	if camera_id.is_empty():
		return
	var feed_mode: = camera_feed_mode(camera_id)
	strength = int(round(float(strength) * (0.55 + float(camera_quality(camera_id)) * 0.09)))
	var recorded_type: = event_type
	var recorded_subject: = subject
	var recorded_description: = description
	var recorded_strength: = strength
	var substituted: = false
	if feed_mode == "FROZEN":
		recorded_type = "NO MOTION"
		recorded_subject = "EMPTY FRAME"
		recorded_description = "The retained frame shows no motion during this interval."
		recorded_strength = 0
		substituted = true
	elif feed_mode == "DUMMY":
		recorded_type = "ROUTINE"
		recorded_subject = "CUSTOMER LOOP"
		recorded_description = "Routine customer traffic retained by the recorder."
		recorded_strength = 0
		substituted = true
	camera_events.append(EvidenceRecords.camera_record(
		"CAMERA-%d" % next_evidence_record_id, next_event_id, camera_id, area, room_id, point, 
		recorded_type, recorded_subject, recorded_description, recorded_strength, time_stamp(), 
		int(Time.get_unix_time_from_system() * 1000.0), false, false, substituted
	))
	next_event_id += 1
	next_evidence_record_id += 1
	if recorded_subject == player_name and not substituted:
		mark_carried_handoffs_witnessed("A camera retained the handoff carrier on this incident.")

func camera_quality(camera_id: String) -> int:
	if "BANK" in camera_id or "PRECINCT" in camera_id: return 5
	if "SCHOOL" in camera_id or "PAWN" in camera_id: return 4
	if "STORE" in camera_id or "ALIBIS" in camera_id: return 3
	if "JAIL" in camera_id: return 2
	return 1

func camera_feed_mode(camera_id: String) -> String:
	var state: Variant = camera_feed_states.get(camera_id, {})
	if state is Dictionary:
		return String(state.get("mode", "LIVE"))
	return "LIVE"

func selected_dvr_camera() -> String:
	var cameras: Array = dvr_camera_ids_for_current_room()
	if cameras.is_empty():
		return ""
	camera_feed_cursor = clampi(camera_feed_cursor, 0, cameras.size() - 1)
	return String(cameras[camera_feed_cursor])

func dvr_camera_ids_for_current_room() -> Array[String]:
	if area == "restaurant" and room_id == "office":
		return RESTAURANT_DVR_CAMERA_IDS
	if has_physical_dvr_access():
		return STORE_DVR_CAMERA_IDS
	return []

func has_physical_dvr_access() -> bool:
	return (area == "store" and room_id == "dvr") or area == "backroom" or (area == "restaurant" and room_id == "office")

func can_tamper_dvr() -> bool:
	return has_physical_dvr_access() and skill_level("Safety") >= 2 and skill_level("Intelligence") >= 2

func set_dvr_feed_mode(feed_mode: String) -> void :
	if not has_physical_dvr_access():
		notify("PHYSICAL DVR ACCESS REQUIRED", DANGER, 2.5)
		return
	if feed_mode != "LIVE" and not can_tamper_dvr():
		notify("SECURITY 2 + INTELLIGENCE 2 REQUIRED", DANGER, 3.0)
		return
	var camera_id: = selected_dvr_camera()
	if feed_mode == "LIVE":
		camera_feed_states.erase(camera_id)
		camera_audit.append({"action": "RESTORE", "actor": player_name, "camera": camera_id, "description": "A camera input returned to live service.", "strength": 2, "time": time_stamp()})
		notify("%s RESTORED TO LIVE INPUT" % camera_id, GOOD, 2.5)
		return
	camera_feed_states[camera_id] = {"mode": feed_mode, "actor": player_name, "time": time_stamp()}
	camera_audit.append({"action": "TAMPER", "actor": player_name, "camera": camera_id, "description": "A non-live input was installed on one camera channel.", "strength": 10, "time": time_stamp()})
	add_crime("OBSTRUCTION")
	grant_xp("Safety", 70)
	grant_xp("Stealth", 55)
	notify("%s  -  %s INPUT ARMED" % [camera_id, feed_mode], DANGER, 3.5)

func update_case() -> void :
	if online_authority_enforced():
		return
	var strength: = 0
	var counted_event_ids: Dictionary = {}
	for event in camera_events:
		if event.get("subject", "") == player_name and not bool(event.get("deleted", false)):
			strength += int(event.get("strength", 0))
			counted_event_ids[int(event.get("id", -1))] = true
	for exported in camera_exports:
		var export_id: = int(exported.get("id", -1))
		if exported.get("subject", "") == player_name and not counted_event_ids.has(export_id):
			strength += int(exported.get("strength", 0))
	for entry in camera_audit:
		if entry.get("actor", "") == player_name and entry.get("action", "") in ["DELETE", "TAMPER", "WITNESS"]:
			strength += int(entry.get("strength", 12))
	case_strength = Rules.normalized_heat(strength - int(case_decay_progress))
	wanted = wanted or case_strength >= Rules.CASE_LEAD_MIN_HEAT
	if case_strength >= Rules.CASE_PROBABLE_CAUSE_MIN_HEAT:
		warrant = true

func dvr_event_indices() -> Array[int]:
	var indices: Array[int] = []
	for index in range(camera_events.size()):
		if String(camera_events[index].get("camera", "")) in dvr_camera_ids_for_current_room(): indices.append(index)
	return indices

func dvr_has_events() -> bool:
	return not dvr_event_indices().is_empty()

func move_dvr_cursor(direction: int) -> void :
	var indices: = dvr_event_indices()
	if indices.is_empty(): camera_cursor = 0;return
	var position: = indices.find(camera_cursor)
	if position < 0: position = 0
	camera_cursor = indices[posmod(position + direction, indices.size())]

func open_camera_terminal() -> void :
	if not has_physical_dvr_access():
		notify("THIS SCREEN IS NOT CONNECTED TO A RECORDER IN THIS ROOM", DANGER, 3.0)
		return
	mode = ScreenMode.CAMERA
	menu_cursor = 0
	var indices: = dvr_event_indices()
	camera_cursor = indices[0] if not indices.is_empty() else 0
	camera_audit.append({
		"action": "VIEW", "actor": player_name, "description": "Terminal session opened.", 
		"strength": 4, "time": time_stamp(), 
	})
	grant_xp("Safety", 35)
	if on_duty:
		security_checkpoint("camera")

func open_restaurant_camera_terminal() -> bool:
	if not (area == "restaurant" and room_id == "office"):
		notify("THE ALIBI DVR IS IN THE OFFICE", DANGER, 2.5)
		return false
	open_camera_terminal()
	return true

func handle_camera_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE or key.keycode == KEY_6:
		mode = ScreenMode.PLAY
		return
	if key.keycode == KEY_LEFT:
		var cameras: = dvr_camera_ids_for_current_room()
		if not cameras.is_empty(): camera_feed_cursor = posmod(camera_feed_cursor - 1, cameras.size())
		return
	if key.keycode == KEY_RIGHT:
		var cameras: = dvr_camera_ids_for_current_room()
		if not cameras.is_empty(): camera_feed_cursor = posmod(camera_feed_cursor + 1, cameras.size())
		return
	if key.keycode == KEY_UP and dvr_has_events():
		move_dvr_cursor(-1)
	elif key.keycode == KEY_DOWN and dvr_has_events():
		move_dvr_cursor(1)
	elif key.keycode == KEY_1:
		export_camera_event()
	elif key.keycode == KEY_2:
		delete_camera_event()
	elif key.keycode == KEY_3:
		set_dvr_feed_mode("FROZEN")
	elif key.keycode == KEY_4:
		set_dvr_feed_mode("DUMMY")
	elif key.keycode == KEY_5:
		set_dvr_feed_mode("LIVE")

