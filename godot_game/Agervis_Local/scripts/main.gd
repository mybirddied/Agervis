func handle_disposition_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE or key.keycode == KEY_5:
		cancel_disposition()
		return
	if selected_actor == null and lan_selected_peer <= 0:
		mode = ScreenMode.PLAY
		return
	var index: = numeric_index(key)
	if index >= 0:
		activate_disposition_selection(index)

func cancel_disposition() -> void :
	mode = ScreenMode.PLAY
	selected_actor = null
	lan_selected_peer = 0

func activate_disposition_selection(index: int) -> void :
	if selected_actor == null and lan_selected_peer <= 0:
		mode = ScreenMode.PLAY
		return
	if selected_actor != null and lan_session.active and is_laundry_office_actor(selected_actor):
		var office_actions: = ["rob", "restrain", "maim", "fatal", "leave", "help"]
		if index < 0 or index >= office_actions.size():
			return
		var office_action: = String(office_actions[index])
		if office_action == "leave":
			cancel_disposition()
			return
		if office_action in ["maim", "fatal"] and not permanent_harm_requirements_met(office_action == "fatal"):
			notify("REQUIRES %s" % permanent_harm_requirement_text(office_action == "fatal").to_upper(), DANGER, 3.5)
			return
		lan_session.request_office_npc_disposition(selected_actor.actor_id, office_action, local_lan_state())
		notify("SERVER DISPOSITION REQUEST SENT", ACCENT, 2.0)
		mode = ScreenMode.PLAY
		selected_actor = null
		return
	if lan_selected_peer > 0:
		var options: = disposition_menu_options()
		if index < 0 or index >= options.size():
			return
		request_lan_disposition(String(options[index].get("action", "leave")))
		return
	match index:
		0: rob_downed_actor()
		1: restrain_downed_actor()
		2: attempt_permanent_harm(false)
		3: attempt_permanent_harm(true)
		4: cancel_disposition()
		5: help_downed_actor()

func request_lan_disposition(action: String) -> void :
	if action == "leave":
		cancel_disposition()
		return
	if action in ["maim", "fatal"]:
		var fatal: = action == "fatal"
		if not permanent_harm_requirements_met(fatal):
			notify("REQUIRES %s" % permanent_harm_requirement_text(fatal).to_upper(), DANGER, 3.5)
			return
	lan_session.request_disposition(lan_selected_peer, action)
	if action in ["maim", "fatal"]:
		notify("PERMANENT-HARM ATTEMPT COMMITTED  -  RESULT SEALED", DANGER, 3.0)
	else:
		notify("SERVER DISPOSITION REQUEST SENT", ACCENT, 2.0)
	mode = ScreenMode.PLAY
	lan_selected_peer = 0

func disposition_menu_options() -> Array[Dictionary]:
	if lan_selected_peer > 0:
		var state: Dictionary = lan_remote_states.get(lan_selected_peer, {})
		if not bool(state.get("downed", false)):
			var heat: = Rules.normalized_heat(int(state.get("heat", 0)))
			var arrest_eligible: = Rules.arrest_is_eligible(heat, bool(state.get("warrant", false)))
			var custody_options: Array[Dictionary] = []
			if bool(state.get("detained", false)):
				if arrest_eligible:
					custody_options.append({"label": "Arrest detained Resident", "action": "arrest"})
				custody_options.append({"label": "Release temporary detention", "action": "release_detention"})
			else:
				if heat >= Rules.LEO_DETENTION_MIN_HEAT:
					custody_options.append({"label": "Temporarily detain  /  Heat %d+" % Rules.LEO_DETENTION_MIN_HEAT, "action": "detain"})
				if arrest_eligible:
					custody_options.append({"label": "Arrest  /  Heat %d+ or warrant" % Rules.LEO_ARREST_MIN_HEAT, "action": "arrest"})
			custody_options.append({"label": "Walk away", "action": "leave"})
			return custody_options
	return [
		{"label": "Rob carried cash", "action": "rob"}, 
		{"label": "Restrain and arrest (authority required)", "action": "restrain"}, 
		{"label": "Attempt Lasting Injury", "action": "maim"}, 
		{"label": "Attempt fatality", "action": "fatal"}, 
		{"label": "Walk away", "action": "leave"}, 
		{"label": "Stabilize and help", "action": "help"}, 
	]

