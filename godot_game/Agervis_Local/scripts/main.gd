func handle_controller_button(event: InputEventJoypadButton) -> void :
	var button: = event.button_index

	if lt_radial_active:
		if button == JOY_BUTTON_DPAD_DOWN:
			activate_lt_slot("down")
		elif button == JOY_BUTTON_DPAD_RIGHT:
			activate_lt_slot("right")
		elif button == JOY_BUTTON_DPAD_LEFT:
			activate_lt_slot("left")
		elif button == JOY_BUTTON_DPAD_UP:
			activate_lt_slot("up")
		return
	if rt_radial_active:
		if button == JOY_BUTTON_DPAD_DOWN:
			activate_rt_slot("down")
		elif button == JOY_BUTTON_DPAD_RIGHT:
			activate_rt_slot("right")
		elif button == JOY_BUTTON_DPAD_LEFT:
			activate_rt_slot("left")
		elif button == JOY_BUTTON_DPAD_UP:
			activate_rt_slot("up")
		return
	if contingency_radial_active:
		if button == JOY_BUTTON_DPAD_LEFT:
			activate_contingency_slot("contingency_1")
		elif button == JOY_BUTTON_DPAD_RIGHT:
			activate_contingency_slot("contingency_2")
		return

	if radial_wheel_active:
		return
	if mode == ScreenMode.SAFETY_NOTICE:
		advance_from_safety_notice()
		return
	if mode == ScreenMode.OVERDOSE_AWARENESS:
		advance_from_overdose_awareness()
		return
	if mode == ScreenMode.GAME_MENU:
		if button == JOY_BUTTON_B or button == JOY_BUTTON_START: close_game_menu()
		elif button == JOY_BUTTON_DPAD_UP: game_menu_cursor = posmod(game_menu_cursor - 1, game_menu_options().size())
		elif button == JOY_BUTTON_DPAD_DOWN: game_menu_cursor = posmod(game_menu_cursor + 1, game_menu_options().size())
		elif button == JOY_BUTTON_A: activate_game_menu_selection()
		return
	if mode == ScreenMode.LAN:
		if button == JOY_BUTTON_B: close_lan_menu()
		elif button == JOY_BUTTON_DPAD_UP: menu_cursor = posmod(menu_cursor - 1, lan_menu_options().size())
		elif button == JOY_BUTTON_DPAD_DOWN: menu_cursor = posmod(menu_cursor + 1, lan_menu_options().size())
		elif button == JOY_BUTTON_DPAD_LEFT and not lan_nearby_hosts.is_empty(): lan_nearby_cursor = posmod(lan_nearby_cursor - 1, lan_nearby_hosts.size())
		elif button == JOY_BUTTON_DPAD_RIGHT and not lan_nearby_hosts.is_empty(): lan_nearby_cursor = posmod(lan_nearby_cursor + 1, lan_nearby_hosts.size())
		elif button == JOY_BUTTON_A: activate_lan_menu_selection()
		return
	if mode == ScreenMode.FEEDBACK:
		if button == JOY_BUTTON_B: close_feedback()
		elif button == JOY_BUTTON_LEFT_SHOULDER: feedback_category = posmod(feedback_category - 1, feedback_categories.size())
		elif button == JOY_BUTTON_RIGHT_SHOULDER: feedback_category = posmod(feedback_category + 1, feedback_categories.size())
		elif button == JOY_BUTTON_A: save_feedback(false)
		return
	if mode == ScreenMode.SUSPENSE:
		return
	if mode == ScreenMode.LAUNDRY_SORT:
		if button == JOY_BUTTON_B: mode = ScreenMode.PLAY
		elif button == JOY_BUTTON_DPAD_LEFT: laundry_bin_cursor = posmod(maxi(0, laundry_bin_cursor) - 1, Build9.LAUNDRY_BINS.size())
		elif button == JOY_BUTTON_DPAD_RIGHT: laundry_bin_cursor = posmod(maxi(0, laundry_bin_cursor) + 1, Build9.LAUNDRY_BINS.size())
		elif button == JOY_BUTTON_DPAD_UP: laundry_bin_cursor = 0
