func show_tip(tip_id: String, text: String) -> void :
	if not tips_enabled or bool(tip_seen.get(tip_id, false)): return
	tip_seen[tip_id] = true
	begin_self_guidance(tip_id)
	var duration: = clampf(8.0 + float(text.length()) / 42.0, 10.0, 15.0)
	if tip_timer > 0.0:
		tip_queue.append({"text": text, "duration": duration})
		return
	tip_text = text
	tip_timer = duration

func begin_self_guidance(tip_id: String) -> void :
	var jail_thoughts: = [
		"Time to work on skills while the clock runs.", 
		"Plenty of connections to make in here.", 
		"Not a bad time to catch up on a few things.", 
		"Different routine, same opportunities.", 
		"Might as well make use of the time.", 
		"Not dead time. Just a different hustle.", 
		"Different economy in here. Time to grind it out.", 
		"Time to work the system and build some credit.", 
		"Credits won't earn themselves. Time to get to work."
	]
	var random_jail: String = jail_thoughts[randi() % jail_thoughts.size()]

	var thought: String = String({
		"movement": "All right. Feet first. The block can explain the rest later.", 
		"context": "The button shows what I can actually do here. No guessing.", 
		"parkour": "I need space for a running start. The route tells me where to aim.", 
		"jobs": "A job is a promise with a time limit and somebody waiting to be disappointed.", 
		"heat": "Nobody has proved it yet. That does not mean nobody saw it.", 
		"jail": random_jail, 
		"network": "If this connection drops, I should leave clean instead of gambling my resident file.", 
	}.get(tip_id, ""))
	if thought.is_empty():
		return
	self_guidance_text = thought
	self_guidance_timer = 12.0

func draw_self_guidance_bubble() -> void :
	if self_guidance_timer <= 0.0 or mode != ScreenMode.PLAY:
		return
	var anchor: = scene_position(player_position) + Vector2(0, -104)
	var width: = 350.0
	var bubble: = Rect2(clampf(anchor.x - width * 0.5, 24.0, VIEW_SIZE.x - width - 24.0), clampf(anchor.y - 64.0, 94.0, 365.0), width, 62)
	draw_rect(bubble, Color("#e4d9bb"))
	draw_rect(bubble, Color("#3d3128"), false, 2.0)
	var tail_x: = clampf(anchor.x, bubble.position.x + 18.0, bubble.end.x - 18.0)
	draw_colored_polygon(PackedVector2Array([Vector2(tail_x - 9, bubble.end.y), Vector2(tail_x + 9, bubble.end.y), Vector2(tail_x, bubble.end.y + 11)]), Color("#e4d9bb"))
	draw_text("I THINK:", bubble.position + Vector2(12, 18), 10, Color("#584235"))
	draw_wrapped(self_guidance_text, Rect2(bubble.position + Vector2(66, 7), bubble.size - Vector2(78, 12)), 16, INK)

func update_contextual_tips() -> void :
	if not tips_enabled or phase != "adult" or tip_timer > 0.0: return
	if not bool(tip_seen.get("movement", false)):
		show_tip("movement", "MOVE: use the left thumb control, left stick / D-pad, or WASD. Sprint is optional; arriving alive is also optional.")
		return
	if not current_prompt().is_empty() and not bool(tip_seen.get("context", false)):
		show_tip("context", "ACTION BUTTONS rename themselves near people, signs, doors, and work objects. The button prompt tells you what is in range.")
		return
	if area == "street" and not bool(tip_seen.get("parkour", false)):
		for route in parkour_routes():
			if near_parkour_x(float(route["center"])):
				show_tip("parkour", "CLIMB routes reach alleys, roofs, and camera cut-throughs. Sidewalk vaulting by itself is not the objective.")
				return
	if active_job != "None" and not bool(tip_seen.get("jobs", false)):
		show_tip("jobs", "JOBS pay for completed assignments. Employer standing raises later pay; disappearing for too long eventually costs the job.")
		return
	if case_strength > 0 and not bool(tip_seen.get("heat", false)):
		show_tip("heat", "HEAT needs a witness, live camera, audit trail, or physical evidence. Unseen crimes still happened; the case may not know yet.")
		return
	if area == "jail" and not bool(tip_seen.get("jail", false)):
		show_tip("jail", "JAIL IS PLAYABLE: labor, education, recovery, infirmary access, favors, and tier choices reduce or reshape the sentence.")
		return
	if lan_session.active and not bool(tip_seen.get("network", false)):
		show_tip("network", "PRIVATE GAME: the host is authoritative. Use Game Menu -> Network Diagnostics for ping, packet loss, invite, and router status.")

func toggle_contextual_tips() -> void :
	tips_enabled = not tips_enabled
	if tips_enabled:
		tip_seen.clear()
		tip_queue.clear()
		tip_timer = 0.0
	else:
		tip_queue.clear()
		tip_timer = 0.0
		tip_text = ""
	roster["settings"] = {"low_spec": low_spec, "tips_enabled": tips_enabled, "close_chat_after_enter": close_chat_after_enter}
	persist_roster()
	game_menu_status = "CONTEXTUAL TIPS %s" % ("ON" if tips_enabled else "OFF")

func toggle_close_chat_after_enter() -> void :
