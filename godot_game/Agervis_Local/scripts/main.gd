			draw_text("%s  %s  %-10s  %s" % [event["time"], event["camera"], event["type"], status], row.position + Vector2(13, 25), 13, PAPER)
		var current: = camera_events[camera_cursor]
		draw_rect(Rect2(720, 185, 430, 290), Color("#151a1b"))
