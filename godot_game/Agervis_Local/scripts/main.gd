func complete_bank_job_deposit() -> void :
	if not deposit_active:
		notify("THE JOB-DEPOSIT BOX REQUIRES A SEALED EMPLOYER HANDOFF", ACCENT, 3.0)
		return
	if online_economy_enabled():
		var nonce: = active_sealed_deposit_nonce()
		if nonce.is_empty():
			notify("THE SERVER CANNOT FIND THAT DEPOSIT'S CUSTODY NONCE", DANGER, 3.0)
			return
		submit_online_economy_request("HANDOFF_COMPLETE", {
			"nonce": nonce, "area": area, "room_id": room_id, 
		}, false)
		return
	var delivered_value: = deposit_value
	var delivered_source: = deposit_source
	var wage: = 36 if delivered_source == "store" else 32 if delivered_source == "restaurant" else 30
	deposit_active = false
	report_handoff_outcome(handoff_id_for_deposit_source(delivered_source), "COMPLETED", "The sealed $%d employer deposit reached the bank box intact." % delivered_value, true)
	for deposit_item in ["Entrusted Deposit Bag", "Sealed Deposit Bag", "Restaurant Deposit", "Sealed Restaurant Deposit", "Laundry Deposit", "Sealed Laundry Deposit"]:
		inventory.erase(deposit_item)
	deliveries_completed += 1
	deposit_value = 0
	deposit_source = "store"
	cash += wage
	close_job_contract("shift complete")
	active_job = "None"
	cashier_tasks = {"stock": false, "register": false, "clean": false}
	restaurant_tasks = {"prep": false, "counter": false, "delivery": false}
	laundry_tasks = {"wash": false, "fold": false, "deposit": false}
	refresh_active_task_text()
	grant_xp("Enterprise", 220)
	objective = "The block is open: study, patrol, trade, investigate, or offend."
	notify("%s DEPOSIT FILED  -  EMPLOYER $%d  /  WAGE $%d" % [delivered_source.to_upper(), delivered_value, wage], GOOD, 4.0)

