	if fatal:
		return "Prepared Tool  /  Fighting %d  /  Stealth %d" % [FATAL_FIGHTING_LEVEL, FATAL_STEALTH_LEVEL]
	return "Prepared Tool  /  Fighting %d" % MAIM_FIGHTING_LEVEL

