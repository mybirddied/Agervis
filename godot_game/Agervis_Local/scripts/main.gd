			activate_game_menu_selection()
			return

func activate_game_menu_selection() -> void :
	var options: = game_menu_options()
	game_menu_cursor = clampi(game_menu_cursor, 0, options.size() - 1)
	var selected_option: String = String(options[game_menu_cursor])
	if selected_option.begins_with("TIPS:"):
		toggle_contextual_tips()
		return
	if selected_option.begins_with("CHAT ENTER:"):
		toggle_close_chat_after_enter()
		return
	match selected_option:
		"RESUME":
			close_game_menu()
		"INVENTORY + EQUIPMENT":
			open_equipment()
		"PHONE + JOB CONTRACT":
			open_phone(ScreenMode.GAME_MENU)
		"JOURNAL":
			open_information("JOURNAL")
		"CONTROLS":
			open_dialog("CONTROLS  -  THE CITY ACCEPTS SEVERAL FORMS", [
				"Keyboard: WASD move, Shift sprint, E context action, F strike, Space climb, T chat, Esc menu.", 
				"Controller: left stick or D-pad move, A action, X strike, RB climb, RS chat, Start menu.", 
				"Touch: left thumb movement; action buttons rename themselves near people, signs, doors, and work fixtures.", 
			], [])
		"DISCORD INVITE":
			open_discord_invite()
		"LEAVE WORLD":
			return_to_title_now()
		"SAVE + RETURN TO MAIN MENU":
			if lan_session.active:
				game_menu_exit_active = true
				game_menu_exit_timer = 5.0
				game_menu_open_health = health
				game_menu_status = "SAFE RETURN REQUESTED  -  DAMAGE OR CUSTODY CANCELS IT"
			else:
				return_to_title_now()
		"EXIT GAME":
			save_current_character("EXIT GAME")
			lan_session.close_session()
			get_tree().quit()

