	var target_name: = selected_actor.display_name if selected_actor != null else String(lan_remote_states.get(lan_selected_peer, {}).get("name", "LAN RESIDENT"))
	var lan_target: Dictionary = lan_remote_states.get(lan_selected_peer, {}) if lan_selected_peer > 0 else {}
