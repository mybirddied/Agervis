				Vector2( - head_radii.x + 3, -53), 
				Vector2( - head_radii.x + 2, -46), 
				Vector2( - head_radii.x, -38), 
				Vector2( - head_radii.x + 1, -32), 
				Vector2(-15, -28), 
				Vector2(-13, -26), 
				Vector2(-11, -28), 
				Vector2(-12, -32), 
				Vector2(-13, -38), 
				Vector2(-14, -44), 
				Vector2(-16, -50)
			]), hair_color)

			draw_colored_polygon(PackedVector2Array([
				Vector2(head_radii.x - 3, -53), 
				Vector2(head_radii.x - 2, -46), 
				Vector2(head_radii.x, -38), 
				Vector2(head_radii.x - 1, -32), 
				Vector2(15, -28), 
				Vector2(13, -26), 
				Vector2(11, -28), 
				Vector2(12, -32), 
				Vector2(13, -38), 
				Vector2(14, -44), 
				Vector2(16, -50)
			]), hair_color)

			if not low_spec:

				draw_line(Vector2( - head_radii.x + 2, -48), Vector2(-13, -36), hair_color.darkened(0.18), 2.0)
				draw_line(Vector2( - head_radii.x + 1, -44), Vector2(-12, -32), hair_color.darkened(0.15), 1.5)
				draw_line(Vector2(-14, -46), Vector2(-13, -30), hair_color.lightened(0.1), 1.2)

				draw_line(Vector2(head_radii.x - 2, -48), Vector2(13, -36), hair_color.darkened(0.18), 2.0)
				draw_line(Vector2(head_radii.x - 1, -44), Vector2(12, -32), hair_color.darkened(0.15), 1.5)
				draw_line(Vector2(14, -46), Vector2(13, -30), hair_color.lightened(0.1), 1.2)

			draw_polyline(PackedVector2Array([
				Vector2( - head_radii.x + 3, -53), 
				Vector2( - head_radii.x + 2, -46), 
				Vector2( - head_radii.x, -38), 
				Vector2(-15, -28), 
				Vector2(-13, -26)
			]), hair_color.darkened(0.25), 1.5, true)
			draw_polyline(PackedVector2Array([
				Vector2(head_radii.x - 3, -53), 
				Vector2(head_radii.x - 2, -46), 
				Vector2(head_radii.x, -38), 
				Vector2(15, -28), 
				Vector2(13, -26)
			]), hair_color.darkened(0.25), 1.5, true)
		"imperial":

			draw_line(Vector2(-8 + face_offset_x, -38), Vector2(-1 + face_offset_x, -36), hair_color, 3.5)
			draw_line(Vector2(1 + face_offset_x, -36), Vector2(8 + face_offset_x, -38), hair_color, 3.5)

			draw_arc(Vector2(-10 + face_offset_x, -40), 3, PI * 1.5, TAU, 6, hair_color, 2.5)
			draw_arc(Vector2(10 + face_offset_x, -40), 3, PI, PI * 1.5, 6, hair_color, 2.5)

			draw_colored_polygon(PackedVector2Array([
