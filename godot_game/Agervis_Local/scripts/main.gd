func open_capone_dialog() -> void :
	var employment: = capone_record.duplicate(true)
	if employment.is_empty():
		var lines: Array[String] = [
			"Criminal PATH only. No tourists. 30 Moth runs minimum or don't waste my time.", 
		]
		var options: Array[Dictionary] = []
		if allegiance_label() == "CRIMINAL" and capone_moth_run_count() >= lan_session.CAPONE_MOTH_RUN_REQUIREMENT:
			options.append({"label": "Apply for Capone's courier desk", "id": "capone_apply"})
		else:
			lines.append("You: %s PATH, %d/%d Moth runs. Come back when qualified." % [allegiance_label(), capone_moth_run_count(), lan_session.CAPONE_MOTH_RUN_REQUIREMENT])
		options.append({"label": "Leave the desk", "id": "close"})
		open_dialog("CAPONE  -  COURIER DESK", lines, options)
		return
	var status: = String(employment.get("status", ""))
	if status == "fired":
		var start_runs: = int(employment.get("requalification_start_runs", capone_moth_run_count()))
		var fresh_runs: = maxi(0, capone_moth_run_count() - start_runs)
		var options: Array[Dictionary] = []
		if fresh_runs >= lan_session.CAPONE_MOTH_RUN_REQUIREMENT and allegiance_label() == "CRIMINAL":
			options.append({"label": "Reapply for the courier desk", "id": "capone_apply"})
		options.append({"label": "Leave the desk", "id": "close"})
		open_dialog("CAPONE  -  REQUALIFICATION", [
			"You got fired for missing assignments. Do 30 more Moth runs, stay Criminal PATH, maybe I rehire you.", 
			"Fresh runs: %d/%d. Current PATH: %s." % [fresh_runs, lan_session.CAPONE_MOTH_RUN_REQUIREMENT, allegiance_label()], 
		], options)
		return
	var task: = active_capone_task()
	var options: Array[Dictionary] = [{"label": "Leave the desk", "id": "close"}]
	var lines: Array[String] = ["The phone is the assignment board. One task remains active at a time."]
	if task.is_empty():
		options.push_front({"label": "Request the next phone assignment", "id": "capone_assign"})
		lines.append("No assignment is currently active. Report to the office to request the next one.")
	else:
		lines.append("Active: %s. The recipient is named in your phone contract." % String(task.get("label", "assigned task")))
	open_dialog("CAPONE  -  COURIER DESK", lines, options)

