func update_radial_wheel_selection() -> void :
	if controller_device < 0:
		return
	var right_x: = Input.get_joy_axis(controller_device, JOY_AXIS_RIGHT_X)
	var right_y: = Input.get_joy_axis(controller_device, JOY_AXIS_RIGHT_Y)
	var magnitude: = Vector2(right_x, right_y).length()
	if magnitude < 0.3:
		radial_wheel_selection = -1
		return
	var angle: = atan2(right_y, right_x)
	var options: = radial_wheel_options()
	var segment: = TAU / float(options.size())
	var adjusted_angle: = fposmod(angle + segment * 0.5, TAU)
	radial_wheel_selection = int(adjusted_angle / segment)

func activate_radial_wheel_selection(index: int) -> void :
	var options: = radial_wheel_options()
	if index < 0 or index >= options.size():
		return
	var action: = String(options[index].get("action", ""))
	match action:
		"equipment": open_equipment()
		"phone": open_phone()
		"storage":

			if apartment_home_owned():
				open_storage("apartment")
			else:
				open_storage("home")
		"skills": open_skills_screen()
		"journal": open_information("JOURNAL")
		"chat": open_chat()

func radial_wheel_geometry() -> Dictionary:






	var option_count: = maxi(1, radial_wheel_options().size())
	var segment: = TAU / float(option_count)
	var radius: = 200.0
	var hub_radius: = 58.0
	var icon_radius: = 112.0
	var icon_size: = 100.0
	var icon_size_idle: = 90.0
	var label_radius: = 182.0
	return {
		"center": Vector2(640, 360), 
		"radius": radius, 
		"hub_radius": hub_radius, 
		"icon_radius": icon_radius, 
		"icon_size": icon_size, 
		"icon_size_idle": icon_size_idle, 
		"label_radius": label_radius, 
		"segment": segment, 

		"wedge_span_at_icon": 2.0 * icon_radius * sin(segment * 0.5), 
	}

func draw_radial_wheel() -> void :
	var geometry: = radial_wheel_geometry()
	var center: Vector2 = geometry["center"]
	var radius: float = geometry["radius"]
	var hub_radius: float = geometry["hub_radius"]
	var icon_radius: float = geometry["icon_radius"]
	var label_radius: float = geometry["label_radius"]
	var segment: float = geometry["segment"]
	var options: = radial_wheel_options()


	draw_circle(center, radius + 10.0, Color(0.02, 0.025, 0.03, 0.95))
	draw_arc(center, radius + 10.0, 0, TAU, 64, ACCENT, 3.0)



	for i in range(options.size()):
		var start_angle: = float(i) * segment - segment * 0.5
		var end_angle: = start_angle + segment
		var selected: = i == radial_wheel_selection
		var points: = PackedVector2Array()
		points.append(center)
		for angle_step in range(17):
			var a: = start_angle + (end_angle - start_angle) * float(angle_step) / 16.0
			points.append(center + Vector2(cos(a), sin(a)) * radius)
		draw_colored_polygon(points, Color("#4a5a5f") if selected else Color("#2a3438"))
		draw_arc(center, radius, start_angle, end_angle, 16, ACCENT if selected else Color("#555a59"), 2.0 if selected else 1.0)
		draw_line(center + Vector2(cos(start_angle), sin(start_angle)) * hub_radius, 
			center + Vector2(cos(start_angle), sin(start_angle)) * radius, 
			ACCENT if selected else Color("#555a59"), 2.0 if selected else 1.0)

	draw_circle(center, hub_radius, Color("#1a1e20"))
	draw_arc(center, hub_radius, 0, TAU, 32, Color("#555a59"), 2.0)


	for i in range(options.size()):
		var mid_angle: = float(i) * segment
		var direction: = Vector2(cos(mid_angle), sin(mid_angle))
		var selected: = i == radial_wheel_selection
		var icon_size: float = geometry["icon_size"] if selected else geometry["icon_size_idle"]
		var icon_name: = String(options[i].get("icon", "face_south"))
		draw_controller_icon(center + direction * icon_radius, icon_size, icon_name, selected)
		draw_centered(String(options[i].get("label", "")), center + direction * label_radius, 13 if selected else 11, PAPER if selected else Color("#aaa49a"))



	if radial_wheel_selection >= 0 and radial_wheel_selection < options.size():
		draw_centered(String(options[radial_wheel_selection].get("label", "")), center + Vector2(0, 5), 15, ACCENT)
	else:
		draw_centered("LB+RB", center + Vector2(0, 5), 15, Color("#aaa49a"))
	draw_centered("RIGHT STICK TO SELECT  -  RELEASE TO OPEN", center + Vector2(0, radius + 34.0), 13, Color("#aaa49a"))



