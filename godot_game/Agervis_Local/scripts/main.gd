func use_quick_access_item(item_name: String) -> void :

	lt_radial_active = false
	rt_radial_active = false


	var item_index: = inventory.find(item_name)
	if item_index < 0:
		notify("ITEM NOT IN INVENTORY: %s" % item_name.to_upper(), DANGER, 2.0)
		return


	if ItemUseRules.is_standard_consumable(item_name):

		var prev_cursor: = equipment_cursor
		equipment_cursor = item_index
		use_selected_standard_item()
		equipment_cursor = prev_cursor
	elif not Build10.equipment_slot(item_name).is_empty():

		var prev_cursor: = equipment_cursor
		var prev_focus: = equipment_focus
		equipment_cursor = item_index
		equipment_focus = 0
		activate_equipment_selection()
		equipment_cursor = prev_cursor
		equipment_focus = prev_focus
	else:
		notify("CANNOT USE %s FROM QUICK ACCESS" % item_name.to_upper(), ACCENT, 2.0)

func swap_to_wieldable(item_name: String) -> void :

	rt_radial_active = false


	var item_index: = inventory.find(item_name)
	if item_index < 0:
		notify("WIELDABLE NOT AVAILABLE: %s" % item_name.to_upper(), DANGER, 2.0)
		return


	var slot_name: = Build10.equipment_slot(item_name)
	if slot_name.is_empty():
		notify("%s IS NOT EQUIPPABLE" % item_name.to_upper(), DANGER, 2.0)
		return

	var prev_cursor: = equipment_cursor
	var prev_focus: = equipment_focus
	equipment_cursor = item_index
	equipment_focus = 0
	activate_equipment_selection()
	equipment_cursor = prev_cursor
	equipment_focus = prev_focus

