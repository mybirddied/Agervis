func make_tone(frequency: float, duration: float, volume: float) -> AudioStreamWAV:
	var rate: = 22050
	var frames: = int(rate * duration)
	var bytes: = PackedByteArray()
	bytes.resize(frames * 2)
	for frame in range(frames):
		var envelope: = 1.0 - float(frame) / float(frames)
		var sample: = int(sin(TAU * frequency * float(frame) / float(rate)) * 32767.0 * volume * envelope)
		bytes.encode_s16(frame * 2, sample)
	var stream: = AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = rate
	stream.stereo = false
	stream.data = bytes
	return stream

func make_button_click_sound() -> AudioStreamWAV:
	var rate: = 22050
	var duration: = 0.08
	var frames: = int(rate * duration)
	var bytes: = PackedByteArray()
	bytes.resize(frames * 2)

	for frame in range(frames):
		var t: = float(frame) / float(rate)
		var envelope: = exp( - t * 35.0)

		var freq: = 880.0 if t < 0.02 else 440.0
		var wave: = sin(TAU * freq * t)

		wave += sin(TAU * freq * 2.0 * t) * 0.3
		wave += sin(TAU * freq * 3.0 * t) * 0.15
		var sample: = int(wave * 32767.0 * 0.28 * envelope)
		bytes.encode_s16(frame * 2, sample)
	var stream: = AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = rate
	stream.stereo = false
	stream.data = bytes
	return stream

func make_thunder_sound() -> AudioStreamWAV:
	var rate: = 22050
	var duration: = 1.2
	var frames: = int(rate * duration)
	var bytes: = PackedByteArray()
	bytes.resize(frames * 2)
	for frame in range(frames):
		var envelope: = exp( - float(frame) / float(frames) * 3.0)
		var noise: = randf_range(-1.0, 1.0)
		var rumble: = sin(TAU * 45.0 * float(frame) / float(rate))
		var sample: = int((noise * 0.7 + rumble * 0.3) * 32767.0 * 0.6 * envelope)
		bytes.encode_s16(frame * 2, sample)
	var stream: = AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = rate
	stream.stereo = false
	stream.data = bytes
	return stream

func make_punch_sound() -> AudioStreamWAV:
	var rate: = 22050
	var duration: = 0.18
	var frames: = int(rate * duration)
	var bytes: = PackedByteArray()
	bytes.resize(frames * 2)


	var impact_freq: = randf_range(85.0, 145.0)
	var snap_freq: = randf_range(2200.0, 3800.0)
	var noise_amount: = randf_range(0.45, 0.65)

	for frame in range(frames):
		var t: = float(frame) / float(frames)
		var envelope: = exp( - t * 18.0)


		var thump: = sin(TAU * impact_freq * float(frame) / float(rate))


		var snap: = sin(TAU * snap_freq * float(frame) / float(rate)) * exp( - t * 35.0)


		var noise: = randf_range(-1.0, 1.0)


		var mixed_signal: = (thump * 0.4 + snap * 0.3 + noise * noise_amount) * envelope
		var sample: = int(clamp(mixed_signal * 32767.0 * 0.55, -32767.0, 32767.0))
		bytes.encode_s16(frame * 2, sample)

	var stream: = AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = rate
	stream.stereo = false
	stream.data = bytes
	return stream

func _process(delta: float) -> void :
	elapsed += delta
	active_input_age += delta
	update_mouse_measurement_timer(delta)
	attack_animation_timer = maxf(0.0, attack_animation_timer - delta)
	attack_impact_flash = maxf(0.0, attack_impact_flash - delta * 8.0)


	if attack_animation_timer > 0.0:
		verify_phase_sync()

	update_blood(delta)
	update_xp_popups(delta)
	update_lightning(delta)
	tip_timer = maxf(0.0, tip_timer - delta)
	self_guidance_timer = maxf(0.0, self_guidance_timer - delta)
	firearms_teacher_reaction_timer = maxf(0.0, firearms_teacher_reaction_timer - delta)
	update_stealth_pickpocket_cooldown(delta)


	if autoplay_attacks_mode and mode == ScreenMode.PLAY and attack_animation_timer <= 0.0:
		autoplay_timer += delta
		if autoplay_timer >= 1.5:
			autoplay_timer = 0.0
			var current_attack: String = autoplay_attacks[autoplay_attack_index]
			attack_type = current_attack
			var attack_data: = get_attack_data(current_attack)
			var actual_duration: = get_attack_total_duration(attack_data)
			attack_animation_timer = actual_duration * 10.0
			stamina = max_stamina
			autoplay_attack_index = (autoplay_attack_index + 1) % autoplay_attacks.size()


	if autoplay_attacks_mode and attack_animation_timer > 0.0:
		var style_display: = current_martial_arts_style.to_upper().replace("_", " ")
		var attack_display: = attack_type.to_upper().replace("_", " ")
		var attack_data: = get_attack_data(attack_type)
		var total_time: = get_attack_total_duration(attack_data) * 10.0
		var elapsed: = total_time - attack_animation_timer
		var timecode: = "%.2fs" % elapsed
		var frame_num: = int(elapsed * 60.0)
		autoplay_current_label = "%s / %s / %s / F%d / %s" % [style_display, attack_display, ANIMATION_PROFILE_VERSION, frame_num, timecode]
	elif autoplay_attacks_mode:
		autoplay_current_label = "AUTOPLAY IDLE"


	if alt_tap_timer > 0.0:
		alt_tap_timer -= delta
		if alt_tap_timer <= 0.0:
			alt_tap_count = 0
	if ctrl_tap_timer > 0.0:
		ctrl_tap_timer -= delta
		if ctrl_tap_timer <= 0.0:
			ctrl_tap_count = 0

	if tip_timer <= 0.0 and not tip_queue.is_empty() and tips_enabled:
		var queued_tip: Dictionary = tip_queue.pop_front()
		tip_text = String(queued_tip.get("text", ""))
		tip_timer = float(queued_tip.get("duration", 10.0))
	for provider in prescription_cooldowns.keys(): prescription_cooldowns[provider] = maxf(0.0, float(prescription_cooldowns[provider]) - delta)
	for stock_id in theft_restock_timers.keys():
		theft_restock_timers[stock_id] = maxf(0.0, float(theft_restock_timers[stock_id]) - delta)
	if notification_timer > 0.0:
		notification_timer -= delta
	interaction_flash_timer = maxf(0.0, interaction_flash_timer - delta)
	shop_button_flash = maxf(0.0, shop_button_flash - delta)
	var quick_lt: = Input.get_joy_axis(controller_device, JOY_AXIS_TRIGGER_LEFT) if controller_device >= 0 else 0.0
	var quick_rt: = Input.get_joy_axis(controller_device, JOY_AXIS_TRIGGER_RIGHT) if controller_device >= 0 else 0.0
	if mode == ScreenMode.STUDIO:
		studio_timer += delta
		if studio_timer >= 1.8:
			safety_notice_timer = 0.0
			mode = ScreenMode.SAFETY_NOTICE
	elif mode == ScreenMode.SAFETY_NOTICE:
		safety_notice_timer += delta
	elif mode == ScreenMode.OVERDOSE_AWARENESS:
		safety_notice_timer += delta
	elif mode == ScreenMode.PLAY:
		update_play(delta)
	elif mode == ScreenMode.GAME_MENU:
		update_game_menu(delta)
	elif overlay_keeps_world_running(mode):
		update_nonplayer_world(delta)
	elif mode == ScreenMode.ARREST:
		update_arrest(delta)
	elif mode == ScreenMode.SUSPENSE:
		update_suspense(delta)
	if mode == ScreenMode.TITLE and not OS.has_feature("web") and not OS.has_feature("headless"):
		ensure_main_server_title_population()
	if radial_wheel_active:
		update_radial_wheel_selection()


	if controller_device >= 0 and mode == ScreenMode.EQUIPMENT and equipment_focus == 0 and not inventory.is_empty():
		var lt_value: = Input.get_joy_axis(controller_device, JOY_AXIS_TRIGGER_LEFT)
		var rt_value: = Input.get_joy_axis(controller_device, JOY_AXIS_TRIGGER_RIGHT)


