			equipment_binding_mode = "lt"
			equipment_binding_start_time = Time.get_ticks_msec() / 1000.0
		elif lt_value <= 0.5 and equipment_binding_mode == "lt":
			equipment_binding_mode = ""


		if rt_value > 0.5 and equipment_binding_mode != "rt":
			equipment_binding_mode = "rt"
			equipment_binding_start_time = Time.get_ticks_msec() / 1000.0
		elif rt_value <= 0.5 and equipment_binding_mode == "rt":
			equipment_binding_mode = ""
	elif equipment_binding_mode != "":

		equipment_binding_mode = ""

	if lan_session.active:
		update_lan(delta)
	if mode == ScreenMode.ADMIN_EDITOR and admin_editor_online and admin_editor_role.is_empty():
		admin_editor_access_retry_timer -= delta
		if admin_editor_access_retry_timer <= 0.0 and lan_session.active:
			lan_session.request_admin_panel()
			admin_editor_notice = "REQUESTING ONLINE ADMIN ACCESS..."
			admin_editor_access_retry_timer = 2.5
	queue_redraw()

func _unhandled_input(event: InputEvent) -> void :
	track_movement_input_source(event)
	track_transition_movement_release(event)
	if (event is InputEventKey and event.pressed) or (event is InputEventJoypadButton and event.pressed) or (event is InputEventScreenTouch and event.pressed) or (event is InputEventMouseButton and event.pressed) or (event is InputEventJoypadMotion and absf(event.axis_value) > 0.38):
		active_input_age = 0.0
	if event is InputEventMouseButton:


		if mobile_controls_enabled:
			return
		last_input_controller = false
		var mouse_event: = event as InputEventMouseButton

		if mouse_event.button_index == MOUSE_BUTTON_LEFT and (mouse_measure_pending or mouse_measurement_enabled()):
			if mouse_event.pressed:
				begin_mouse_measure_gesture(mouse_event.position, mouse_event.ctrl_pressed)
			else:
				end_mouse_measure_gesture(mouse_event.position)
			return
		if mouse_event.pressed:

			track_button_press(mouse_event.position)
			if mode == ScreenMode.SAFETY_NOTICE or mode == ScreenMode.OVERDOSE_AWARENESS:
				advance_from_safety_notice() if mode == ScreenMode.SAFETY_NOTICE else advance_from_overdose_awareness()
				return
			if mouse_event.button_index == MOUSE_BUTTON_RIGHT:
				handle_pointer_click(mouse_event.position, true)
			elif mouse_event.button_index == MOUSE_BUTTON_LEFT:
				handle_pointer_click(mouse_event.position, false)
		else:

			button_press_state = ""
			button_press_rect = Rect2()
			queue_redraw()
		return
	if event is InputEventMouseMotion:
		update_mouse_measure_gesture((event as InputEventMouseMotion).position)
		return
	if event is InputEventScreenTouch:
		last_input_controller = false
		handle_mobile_touch(event as InputEventScreenTouch)
		return
	if event is InputEventScreenDrag:
		handle_mobile_drag(event as InputEventScreenDrag)
		return
	if event is InputEventJoypadMotion:
		var motion: = event as InputEventJoypadMotion
		if absf(motion.axis_value) > 0.38:
			last_input_controller = true
			controller_device = motion.device
		handle_controller_axis_navigation(motion)
		return
	if event is InputEventJoypadButton and event.pressed:
		last_input_controller = true
		controller_device = event.device

		if event.button_index == JOY_BUTTON_LEFT_SHOULDER:
			lb_held = true
		elif event.button_index == JOY_BUTTON_RIGHT_SHOULDER:
			rb_held = true

		if lb_held and rb_held and mode == ScreenMode.PLAY and not radial_wheel_active:
			radial_wheel_active = true
			radial_wheel_selection = -1
			return


		handle_controller_button(event as InputEventJoypadButton)
		return
	if event is InputEventJoypadButton and not event.pressed:

		if event.button_index == JOY_BUTTON_LEFT_SHOULDER:
			lb_held = false
		elif event.button_index == JOY_BUTTON_RIGHT_SHOULDER:
			rb_held = false

		if radial_wheel_active and not lb_held and not rb_held:
			if radial_wheel_selection >= 0:
				activate_radial_wheel_selection(radial_wheel_selection)
			radial_wheel_active = false
			radial_wheel_selection = -1
		return
	if event is InputEventKey and event.pressed and not event.echo:
		last_input_controller = false
		var key: = event as InputEventKey

		if key.keycode == KEY_ESCAPE and OS.has_feature("android"):
			handle_android_back_event()
			return
		match mode:
			ScreenMode.STUDIO:
				pass
			ScreenMode.SAFETY_NOTICE:
				handle_safety_notice_key(key)
			ScreenMode.OVERDOSE_AWARENESS:
				handle_overdose_awareness_key(key)
			ScreenMode.GAME_MENU:
				handle_game_menu_key(key)
			ScreenMode.TITLE:
