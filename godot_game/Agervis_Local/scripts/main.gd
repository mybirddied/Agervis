func contingency_radial_options() -> Array[Dictionary]:

	var contingency_1: = String(equipment.get("contingency_1", ""))
	var contingency_2: = String(equipment.get("contingency_2", ""))
	return [
		{"slot": "contingency_1", "item": contingency_1, "icon": "dpad_left", "angle": PI}, 
		{"slot": "contingency_2", "item": contingency_2, "icon": "dpad_right", "angle": 0.0}, 
	]

func draw_contingency_radial() -> void :
	var geometry: = contingency_radial_geometry()
	var center: Vector2 = geometry["center"]
	var options: = contingency_radial_options()


	var hold_duration: = (Time.get_ticks_msec() / 1000.0) - maxf(lt_press_time, rt_press_time)
	var animation_progress: = clampf((hold_duration - 0.25) / 0.15, 0.0, 1.0)

	var button_radius: = 22.0 * animation_progress
	var button_size: = 18.0 * animation_progress
	var banner_distance: = 55.0 * animation_progress
	var banner_width: = 130.0 * animation_progress
	var banner_height: = 26.0 * animation_progress
	var item_icon_size: = 22.0 * animation_progress


	for i in range(options.size()):
		var option: Dictionary = options[i]
		var angle: float = option.get("angle", 0.0)
		var item_name: = String(option.get("item", ""))
		var button_icon: = String(option.get("icon", "face_west"))
		var slot: = String(option.get("slot", ""))


		var button_pos: = center + Vector2(cos(angle), sin(angle)) * button_radius


		if animation_progress > 0.1:
			var direction: = Vector2(cos(angle), sin(angle))
			var banner_center: = center + direction * banner_distance

			var banner_rect: Rect2
			var icon_pos: Vector2
			var text_pos: Vector2

			if angle == PI:
				banner_rect = Rect2(banner_center.x - banner_width * 0.5, banner_center.y - banner_height * 0.5, banner_width, banner_height)
				icon_pos = Vector2(banner_rect.position.x + item_icon_size * 0.5 + 4, banner_center.y)
				text_pos = Vector2(banner_rect.position.x + item_icon_size + 12, banner_center.y + 4)
			else:
				banner_rect = Rect2(banner_center.x - banner_width * 0.5, banner_center.y - banner_height * 0.5, banner_width, banner_height)
				icon_pos = Vector2(banner_rect.position.x + banner_width - item_icon_size * 0.5 - 4, banner_center.y)
				text_pos = Vector2(banner_rect.position.x + banner_width - item_icon_size - 12, banner_center.y + 4)


			draw_rect(banner_rect, Color("#2a2e30"))
			draw_rect(banner_rect, GOOD, false, 2.0)


			var icon_rect: = Rect2(icon_pos - Vector2(item_icon_size, item_icon_size) * 0.5, Vector2(item_icon_size, item_icon_size))
			draw_rect(icon_rect, Color("#8b4a8b"))
			draw_rect(icon_rect, Color("#1a1e20"), false, 1.0)


			var label_lines: = inventory_item_label_lines(item_name, banner_width - item_icon_size - 20)
			var label_text: = label_lines[0] if not label_lines.is_empty() else item_name.to_upper()
			draw_text(label_text, text_pos, 8, PAPER)


		draw_controller_icon(button_pos, button_size, button_icon, false)

func parse_network_endpoint(value: String, default_port: int) -> Dictionary:
	var text: = value.strip_edges()
	var host: = text
	var target_port: = default_port
	var colon: = text.rfind(":")
	if colon > 0 and colon < text.length() - 1:
		var port_text: = text.substr(colon + 1)
		if port_text.is_valid_int():
			host = text.substr(0, colon)
			target_port = clampi(int(port_text), 1, 65535)
	if host.is_empty(): host = "127.0.0.1"
	return {"host": host, "port": target_port}

func ensure_main_server_title_population() -> void :
	if main_server_title_probe_started or lan_session.active:
		return
	main_server_title_probe_started = true
	prepare_for_server_connection()
	active_world_is_main_server = true
	main_server_population_probe = true
	main_server_connection_state = "checking"
	lan_join_address = Build10.MAIN_SERVER_HOST + ":" + str(Build10.MAIN_SERVER_PORT)
	lan_join_port = Build10.MAIN_SERVER_PORT
	var result: Error = lan_session.join_server(Build10.MAIN_SERVER_HOST, server_lobby_state(), Build10.MAIN_SERVER_PORT)
	if result == OK:
		lan_status = "CHECKING MAIN SERVER POPULATION"
	else:
		main_server_connection_state = "unavailable"
		main_server_online_players = -1
		main_server_population_probe = false
func start_main_server_join() -> void :
	var direct_from_title: = mode == ScreenMode.TITLE
	prepare_for_server_connection()
	main_server_title_probe_started = true
	main_server_population_probe = false
	active_world_is_main_server = true
	main_server_direct_entry = direct_from_title
	main_server_connection_state = "checking"
	DisplayServer.virtual_keyboard_hide()
	lan_input_target = ""
	lan_join_address = Build10.MAIN_SERVER_HOST + ":" + str(Build10.MAIN_SERVER_PORT)
	lan_join_port = Build10.MAIN_SERVER_PORT
	var result: Error = lan_session.join_server(Build10.MAIN_SERVER_HOST, server_lobby_state(), Build10.MAIN_SERVER_PORT)
	mode = ScreenMode.TITLE if direct_from_title else ScreenMode.LAN
	if result == OK:
		lan_status = "CONTACTING MAIN SERVER  -  WAITING FOR ITS RESIDENT ROSTER"
		release_notice = "CHECKING MAIN SERVER  -  WAITING FOR ROSTER"
	else:
		main_server_connection_state = "unavailable"
		lan_status = "Unable to connect to server"
		release_notice = "Unable to connect to server. Make sure the Agervis server and Playit are running, then try again."
		main_server_direct_entry = false
