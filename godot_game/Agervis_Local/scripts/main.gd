	var target_room: = String(service_door["target_room"])
	enter_area(target_area, Vector2(500, 270))
	room_id = target_room
	var return_door: = nearest_build10_room_door_to("rear")
	var spawn_point: = Vector2(500, 270) if return_door.is_empty() else room_door_arrival_position(return_door)
	player_position = resolve_safe_position(spawn_point)
	notify("REAR DOOR OPENED  -  ESCAPE ROUTE RESTORED", GOOD, 2.4)
