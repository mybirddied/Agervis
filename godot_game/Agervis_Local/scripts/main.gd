func _ready() -> void :
	var startup_arguments: = command_line_arguments()
	if OS.has_feature("main_server") or "--main-server" in startup_arguments:
		visible = true
		main_server_mode = true
		font = ThemeDB.fallback_font
		DisplayServer.window_set_title("Agervis Main Server - Status")
		var server_port: = Build10.LOCAL_SERVER_PORT
		var server_profile_path: String = "user://agervis_main_server_profiles.save"
		for argument in startup_arguments:
			var text: = String(argument)
			if text.begins_with("--port=") and text.trim_prefix("--port=").is_valid_int():
				server_port = clampi(int(text.trim_prefix("--port=")), 1, 65535)
			elif text.begins_with("--profile-path="):
				var requested_profile_path: = text.trim_prefix("--profile-path=").strip_edges()
				if requested_profile_path.begins_with("user://") or requested_profile_path.is_absolute_path() or (requested_profile_path.length() > 2 and requested_profile_path[1] == ":"):
					server_profile_path = requested_profile_path.replace("\\", "/")
		lan_session.status_changed.connect(_on_main_server_status_changed)
		var server_result: Error = lan_session.host_main_server(server_port, server_profile_path)
		if server_result != OK:
			push_error("AGERVIS MAIN SERVER FAILED: %s" % error_string(server_result))
			get_tree().quit(2)
			return
		print("AGERVIS MAIN SERVER READY")
		print("Local UDP port: %d" % server_port)
		print("Public playit.gg endpoint: %s:%d" % [Build10.MAIN_SERVER_HOST, Build10.MAIN_SERVER_PORT])
		queue_redraw()
		set_process(false)
		set_process_unhandled_input(false)
		return
	font = ThemeDB.fallback_font
	rng.randomize()
	configure_controller_input()
	initialize_audio()
	lan_session.status_changed.connect(_on_lan_status_changed)
	lan_session.peer_snapshot_received.connect(_on_lan_snapshot_received)
	lan_session.chat_received.connect(_on_lan_chat_received)
