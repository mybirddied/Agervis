		"sample_count": maxi(0, int(record.get("sample_count", 0))), 
	})

func nearest_blood_evidence() -> Dictionary:
	var best: Dictionary = {}
	var best_distance: = INF
	for record in blood_evidence_effects:
		if not room_effect_visible_in_current_room(record):
			continue
		var point: = record.get("position", Vector2.ZERO) as Vector2
		var distance: = player_position.distance_to(point)
		if distance <= 125.0 and distance < best_distance:
			best = record
			best_distance = distance
	return best

func _on_lan_xp_event_received(payload: Dictionary) -> void :
	if not room_effect_visible_in_current_room({
		"area": String(payload.get("area", "")), 
		"room": String(payload.get("room_id", "")), 
		"home_instance_id": String(payload.get("home_instance_id", "")), 
	}):
		return
	var point_value: Variant = payload.get("position", Vector2.ZERO)
	var point: = point_value as Vector2 if point_value is Vector2 else Vector2.ZERO
	var peer_id: = int(payload.get("peer_id", 0))
	var occupied_slots: Dictionary = {}
	for popup in xp_popups:
		var popup_position: = popup.get("position", Vector2.ZERO) as Vector2
		if int(popup.get("peer_id", 0)) == peer_id and popup_position.distance_to(point) <= 72.0:
			occupied_slots[int(popup.get("stack_slot", 0))] = true
	var stack_slot: = 0
	while occupied_slots.has(stack_slot):
		stack_slot += 1
	xp_popups.append({
		"peer_id": peer_id, 
		"skill": String(payload.get("skill", "Skill")), 
		"amount": clampi(int(payload.get("amount", 1)), 1, 5000), 
		"area": String(payload.get("area", "")), 
		"room": String(payload.get("room_id", "")), 
		"home_instance_id": String(payload.get("home_instance_id", "")), 
		"position": point, 
		"remaining": 2.4, 
		"rise": 0.0, 
		"stack_slot": stack_slot, 
	})
	while xp_popups.size() > 16:
		xp_popups.pop_front()

func update_xp_popups(delta: float) -> void :
	for index in range(xp_popups.size() - 1, -1, -1):
		xp_popups[index]["remaining"] = float(xp_popups[index].get("remaining", 0.0)) - delta
		xp_popups[index]["rise"] = float(xp_popups[index].get("rise", 0.0)) + 16.0 * delta
		if float(xp_popups[index]["remaining"]) <= 0.0:
			xp_popups.remove_at(index)

func update_lightning(delta: float) -> void :
	if lightning_active:
		lightning_timer -= delta
		if lightning_timer <= 0.0:
			lightning_active = false
	elif is_raining and lightning_cooldown <= 0.0:
		if randf() < 0.5 * delta:
			lightning_active = true
			lightning_timer = 2.0
			lightning_cooldown = randf_range(8.0, 20.0)
			audio_player.stream = tone_thunder
			audio_player.volume_db = -8.0
			audio_player.play()
	if lightning_cooldown > 0.0:
		lightning_cooldown -= delta

func draw_xp_popups() -> void :
	for popup in xp_popups:
		if not room_effect_visible_in_current_room(popup):
			continue
		var stack_offset: = float(int(popup.get("stack_slot", 0)) * 24)
		var rise: = float(popup.get("rise", 0.0))
		var point: = scene_position(popup.get("position", Vector2.ZERO) as Vector2) + Vector2(0, -96.0 - stack_offset - rise)
		var remaining: = float(popup.get("remaining", 0.0))
		var alpha: = clampf(remaining / 0.5, 0.0, 1.0)

		var skill_name: = String(popup.get("skill", "SKILL")).to_upper()
		var amount: = int(popup.get("amount", 0))
		var text_value: = "+%d %s XP" % [amount, skill_name]


		var skill_color: = get_skill_icon_color(skill_name.capitalize())


		var text_size: = font.get_string_size(text_value, HORIZONTAL_ALIGNMENT_CENTER, -1, 14)
		var bg_rect: = Rect2(point.x - text_size.x * 0.5 - 8.0, point.y - 18.0, text_size.x + 16.0, 28.0)


		if not low_spec and remaining > 1.8:
			var glow_alpha: = (remaining - 1.8) / 0.6 * alpha
			draw_rect(bg_rect.grow(4.0), Color(skill_color.r, skill_color.g, skill_color.b, glow_alpha * 0.3))


		draw_rect(bg_rect, Color(0.05, 0.06, 0.07, alpha * 0.9))
		draw_rect(bg_rect, Color(skill_color.r, skill_color.g, skill_color.b, alpha * 0.8), false, 2.0)


		draw_centered("+%d" % amount, Vector2(point.x, point.y - 4.0), 16, Color(skill_color.r, skill_color.g, skill_color.b, alpha))


		draw_centered("%s XP" % skill_name, Vector2(point.x, point.y + 12.0), 11, Color(ACCENT.r, ACCENT.g, ACCENT.b, alpha * 0.9))

func remote_state_position(state: Dictionary) -> Vector2:
	var value: Variant = state.get("position", Vector2.ZERO)
	if value is Vector2: return value
	if value is Array and value.size() >= 2: return Vector2(float(value[0]), float(value[1]))
	return Vector2.ZERO

func nearest_lan_downed_peer(radius: float = 110.0) -> int:
	return nearest_lan_disposition_peer(radius, true)

func local_resident_has_leo_authority() -> bool:
	return official_function == "Law Enforcement Officer" or "Law Enforcement Credential" in credentials or "Police Officer Credential" in credentials

func nearest_lan_disposition_peer(radius: float = 110.0, downed_only: bool = false) -> int:
	if not lan_session.active: return 0
	var local_id: int = lan_session.local_peer_id()
	var best_id: = 0
	var best_distance: = radius
	for peer_id in lan_remote_states.keys():
		if int(peer_id) == local_id: continue
		var state: Dictionary = lan_remote_states[peer_id]
		if not remote_visible_in_current_room(state) or bool(state.get("deceased", false)): continue
		var is_downed: = bool(state.get("downed", false))
		var is_eligible_custody: = local_resident_has_leo_authority() and (bool(state.get("detained", false)) or int(state.get("heat", 0)) >= Rules.LEO_DETENTION_MIN_HEAT or bool(state.get("warrant", false)))
		if downed_only and not is_downed: continue
		if not downed_only and not is_downed and not is_eligible_custody: continue
		var distance: = player_position.distance_to(remote_state_position(state))
		if distance < best_distance:
			best_distance = distance
			best_id = int(peer_id)
	return best_id

func _on_lan_attack_requested(attacker_id: int) -> void :



	if not lan_session.hosting or attacker_id != lan_session.local_peer_id():
		return
	host_attack_nearest_npc()

func host_attack_nearest_npc() -> void :
	var target: = nearest_facing_actor(92.0, true) if active_attack_weapon() == "Fists" else nearest_actor(92.0, true)
	if target == null: return
	var downed_now: = target.take_damage(34.0 + minf(10.0, skill_level("Fighting") * 0.4))
	if downed_now: notify("%s IS DOWNED  -  USE DISPOSITION" % target.display_name.to_upper(), DANGER, 4.0)

func _on_lan_disposition_requested(attacker_id: int, target_id: int, action: String) -> void :
	if not lan_session.hosting or attacker_id not in lan_session.peer_states or target_id not in lan_session.peer_states: return
	var attacker: Dictionary = lan_session.peer_states[attacker_id]
	var target: Dictionary = lan_session.peer_states[target_id]
	if not bool(target.get("downed", false)): return
	if not lan_session.states_share_room_instance(attacker, target): return
	if remote_state_position(attacker).distance_to(remote_state_position(target)) > 125.0: return
	match action:
		"help":
			lan_session.host_patch_peer(target_id, {"health": 30.0, "downed": false})
			lan_session.submit_chat("SYSTEM", "%s stabilized %s." % [attacker.get("name", "Resident"), target.get("name", "Resident")])
		"restrain":
			lan_session.host_patch_peer(target_id, {"health": 70.0, "downed": false, "area": "jail"})
			lan_session.submit_chat("SYSTEM", "%s transported %s alive." % [attacker.get("name", "Resident"), target.get("name", "Resident")])
		"rob":
			lan_session.host_patch_peer(target_id, {"health": 22.0, "downed": false, "mark": 30.0})
			lan_session.host_patch_peer(attacker_id, {"mark": 55.0})
			lan_session.submit_chat("SYSTEM", "A downed resident was robbed. Shared economy is not enabled in this private alpha.")
		"maim", "fatal":
			var fatal: = action == "fatal"
			var marked: = float(target.get("mark", 0.0)) > 0.0
			var roll: = rng.randi_range(1, 16)
			var success: = Rules.fatality_succeeds(roll, marked)
			var interrupted: = fatal and success and bool(target.get("contingency", false))
			if interrupted: success = false
			var duration: = rng.randf_range(5.0, 8.0)
			var payload: = {"lan": true, "fatal": fatal, "success": success, "roll": roll, "duration": duration, "attacker": String(attacker.get("name", "Resident")), "interrupted": interrupted}
			lan_pending_outcomes.append({"target": target_id, "fatal": fatal, "success": success, "remaining": duration})
			lan_session.host_patch_peer(attacker_id, {"mark": 55.0})
			lan_session.send_permanent_outcome(target_id, payload)
			lan_session.submit_chat("SYSTEM", "%s committed to a permanent-harm attempt. The result is sealed." % attacker.get("name", "Resident"))

func _on_lan_permanent_outcome_received(payload: Dictionary) -> void :
	begin_suspense(payload)

func begin_suspense(payload: Dictionary) -> void :
	suspense_payload = payload.duplicate(true)
	suspense_timer = 0.0
	suspense_duration = clampf(float(payload.get("duration", rng.randf_range(5.0, 8.0))), 5.0, 8.0)
	mode = ScreenMode.SUSPENSE

func update_suspense(delta: float) -> void :
	suspense_timer += delta
	if suspense_timer >= suspense_duration:
		finish_suspense()

func finish_suspense() -> void :
	var fatal: = bool(suspense_payload.get("fatal", false))
	var success: = bool(suspense_payload.get("success", false))
	var interrupted: = bool(suspense_payload.get("interrupted", false))
	var attacker_name: = String(suspense_payload.get("attacker", "Someone trusted too far"))
	if interrupted:
		var spent_beacon: = consume_equipped_contingency(["Emergency Beacon"])
		if not spent_beacon.is_empty():
			notify("EMERGENCY BEACON SPENT - THE RESULT WAS INTERRUPTED", GOOD, 4.0)
	if fatal and success:
		mode = ScreenMode.DEATH
		notification = "%s completed the attempt. The result held." % attacker_name
		if not bool(suspense_payload.get("lan", false)):
			character_deceased = true
			save_current_character("DEATH RECORD")
		return
	if not fatal and success and "Damaged Knee" not in injuries:
		injuries.append("Damaged Knee")
	to_hospital("The permanent outcome %s." % ("was interrupted by a contingency" if interrupted else "failed" if not success else "left a lasting injury"))

func handle_android_back_event() -> void :



	if OS.has_feature("android"):
		if android_back_last_event_at >= 0.0 and elapsed - android_back_last_event_at < 0.5:
			return
		android_back_last_event_at = elapsed
	handle_android_back()

func handle_android_back() -> void :
	match mode:
		ScreenMode.PLAY:
			open_game_menu()
		ScreenMode.GAME_MENU:
			close_game_menu()
		ScreenMode.CHAT:
			close_chat()
		ScreenMode.PHONE:
			close_phone()
		ScreenMode.FEEDBACK:
			close_feedback()
		ScreenMode.SHOP:
			if barber_preview_active: close_barber_preview()
			else: mode = ScreenMode.PLAY
		ScreenMode.EQUIPMENT:
			if inventory_edit_active(): reset_inventory_edit_state()
			else: mode = ScreenMode.PLAY
		ScreenMode.SKILLS:
			mode = ScreenMode.PLAY
		ScreenMode.TITLE:
			get_tree().quit()
		ScreenMode.STUDIO, ScreenMode.SUSPENSE, ScreenMode.ARREST:
			pass
		_:
			DisplayServer.virtual_keyboard_hide()
			mode = return_mode if mode == ScreenMode.DIALOG else ScreenMode.PLAY

