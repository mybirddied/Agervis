func draw_custom_store_fixture(world_point: Vector2, size: Vector2, kind: String) -> void :
	var point: = scene_position(world_point)
	var rect: = Rect2(point.x - size.x * 0.5, point.y - size.y + 18.0, size.x, size.y)
	var frame: = Color("#27251f")
	draw_rect(rect, Color("#504737"))
	draw_rect(rect, frame, false, 4.0)
	if kind == "COOLER":
		draw_rect(rect.grow(-8), Color(0.36, 0.48, 0.49, 0.55))
		draw_line(Vector2(rect.get_center().x, rect.position.y + 8), Vector2(rect.get_center().x, rect.end.y - 8), frame, 3.0)
		for row in range(4):
			for column in range(4): draw_rect(Rect2(rect.position + Vector2(13 + column * 21, 20 + row * 31), Vector2(10, 22)), [DANGER, ACCENT, GOOD, Color("#8293a4")][(row + column) % 4])
	elif kind == "JERSEYS":
		for column in range(3):
			var shirt: = rect.position + Vector2(12 + column * 29, 25 + (column % 2) * 12)
			draw_colored_polygon(PackedVector2Array([shirt, shirt + Vector2(11, -9), shirt + Vector2(20, 0), shirt + Vector2(15, 62), shirt + Vector2(-4, 62), shirt + Vector2(-9, 0)]), [Color("#75443d"), Color("#3f596b"), Color("#746a3f")][column])
	else:
		var rows: = 3 if kind != "AISLE" else 2
		for row in range(rows):
			var shelf_y: = rect.position.y + 28 + row * ((rect.size.y - 34) / rows)
			draw_line(Vector2(rect.position.x + 6, shelf_y + 25), Vector2(rect.end.x - 6, shelf_y + 25), frame, 5.0)
			for column in range(maxi(3, int(rect.size.x / 31.0))):
				var product_x: = rect.position.x + 10 + column * 29
				draw_rect(Rect2(product_x, shelf_y, 18, 23), [Color("#ab6c45"), Color("#6c7a55"), Color("#77618b"), Color("#b29b55")][(row + column) % 4])

