func permanent_harm_requirements_met(fatal: bool) -> bool:
	if "Prepared Tool" not in inventory:
		return false
	if skill_level("Fighting") < (FATAL_FIGHTING_LEVEL if fatal else MAIM_FIGHTING_LEVEL):
		return false
	if fatal and skill_level("Stealth") < FATAL_STEALTH_LEVEL:
		return false
	return true

