	draw_colored_polygon(cap_points, Color("#33393d"))
	draw_polyline(cap_points, Color.BLACK, 1.5)


	draw_circle(Vector2(lamp_center.x - 8, lamp_center.y - 12), 1.5, Color("#0f1315"))
