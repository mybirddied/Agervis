		return
	var center: = scene_position(point as Vector2)
	var pulse: = 1.0 + sin(elapsed * 4.0) * 0.12
	draw_circle(center, 18.0 * pulse, Color(0.26, 0.84, 0.55, 0.18), false, 3.0)
