func update_medicine_training_drill(delta: float) -> void :
	if not in_medicine_practice_room():
		return
	medicine_drill_feedback_timer = maxf(0.0, medicine_drill_feedback_timer - maxf(0.0, delta))
	if medicine_drill_feedback_timer <= 0.0 and not medicine_drill_active:
		medicine_drill_feedback = ""
	if medicine_drill_active:
		return
	medicine_drill_timer -= maxf(0.0, delta)
	if medicine_drill_timer > 0.0:
		return
	medicine_drill_active = true
	medicine_drill_feedback = ""
	notify("MEDICINE DRILL - NURSE MERCY NEEDS THE EMERGENCY RESPONSE KIT", DANGER, 4.0)

func respond_to_medicine_training_drill() -> void :
	if not in_medicine_practice_room():
		return
	if not medicine_drill_active:
		open_dialog("EMERGENCY RESPONSE KIT", [
			"This classroom kit is for a timed Medicine drill. It never enters inventory and does not change the Resident's health, money, or substances.", 
			"In a real overdose emergency, call emergency services, follow the response-kit instructions, and stay with the person until help arrives.", 
		], [{"label": "Return to class", "id": "close"}])
		return
	medicine_drill_active = false
	medicine_drill_timer = rng.randf_range(240.0, 300.0)
	var lines: = medicine_training_lines()
	medicine_drill_feedback = lines[medicine_drill_line_index % lines.size()]
	medicine_drill_line_index = posmod(medicine_drill_line_index + 1, lines.size())
	medicine_drill_feedback_timer = 8.0
	notify("MEDICINE DRILL COMPLETE - EMERGENCY RESPONSE PRACTICED", GOOD, 3.5)

func in_stealth_practice_room() -> bool:
	return is_school_area() and room_id == "class_stealth"

func current_stealth_teacher_record() -> Dictionary:
	if not in_stealth_practice_room():
		return {}
	for record in current_room_object_records():
		if String(record.get("action_id", "")) == "school_teacher" and String(record.get("skill_name", "")) == "Stealth":
			return record.duplicate(true)
	return {}

func reset_stealth_practice() -> void :
	stealth_teacher_pickpocket_cooldown = 0.0

func update_stealth_pickpocket_cooldown(delta: float) -> void :
	stealth_teacher_pickpocket_cooldown = maxf(0.0, stealth_teacher_pickpocket_cooldown - maxf(0.0, delta))

func stealth_teacher_pickpocket_success_chance(target_defense: float = STEALTH_TEACHER_DEFENSE) -> float:
	return minf(0.9, float(skill_level("Stealth")) / maxf(1.0, target_defense))

func resolve_stealth_teacher_pickpocket(roll: float) -> bool:
	if not in_stealth_practice_room():
		return false
	if stealth_teacher_pickpocket_cooldown > 0.0:
		notify("WAIT %.1f SECONDS BEFORE ANOTHER PRACTICE ATTEMPT" % stealth_teacher_pickpocket_cooldown, ACCENT, 2.5)
		return false
	if online_authority_enforced():
		var teacher: = current_stealth_teacher_record()
		if teacher.is_empty():
			return false
		submit_online_economy_request("SCHOOL_STEALTH_ATTEMPT", {
			"teacher_instance_id": String(teacher.get("instance_id", "")), 
		}, true)
		return false
	stealth_teacher_pickpocket_cooldown = STEALTH_PICKPOCKET_COOLDOWN
	if clampf(roll, 0.0, 1.0) < stealth_teacher_pickpocket_success_chance():
		cash += 1
		notify("PRACTICE PICKPOCKET SUCCESS - $1 ENVELOPE RECOVERED", GOOD, 3.0)
		return true
	notify("CAUGHT BY MR. QUIET - THE $1 ENVELOPE REMAINS EDUCATIONAL", ACCENT, 3.0)
	return false

func attempt_stealth_teacher_pickpocket() -> void :
	resolve_stealth_teacher_pickpocket(rng.randf())

