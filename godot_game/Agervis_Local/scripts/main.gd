func handle_firearms_dialog_choice(choice_id: String) -> bool:
	if not choice_id.begins_with("firearms_"):
		return false
	match choice_id:
		"firearms_down":
			mode = ScreenMode.PLAY
			resolve_firearms_dummy_outcome("down")
		"firearms_disposition_menu": open_firearms_disposition_options()
		"firearms_injury_menu": open_firearms_lasting_injury_options()
		"firearms_review": review_firearms_practice_limits()
		"firearms_review_outcome":
			open_dialog("MR. SIGHTS - OUTCOME REVIEW", [firearms_dummy_outcome_summary(firearms_dummy_outcome), firearms_teacher_reaction(firearms_dummy_outcome)], [])
		"firearms_back": open_firearms_disposition_dummy()
		"firearms_reset":
			mode = ScreenMode.PLAY
			if online_authority_enforced():
				var dummy: = current_firearms_dummy_record()
				if not dummy.is_empty():
					submit_online_economy_request("SCHOOL_DUMMY_RESET", {"dummy_instance_id": String(dummy.get("instance_id", ""))}, false)
				return true
			firearms_dummy_state = "ready"
			firearms_dummy_outcome = ""
			firearms_teacher_reaction_text = ""
			firearms_teacher_reaction_timer = 0.0
			notify("DISPOSITION DUMMY RESET", ACCENT, 2.0)
		"firearms_rob", "firearms_restrain", "firearms_stabilize", "firearms_leave", "firearms_fatal":
			mode = ScreenMode.PLAY
			resolve_firearms_dummy_outcome(choice_id.trim_prefix("firearms_"))
		_:
			if choice_id.begins_with("firearms_injury_"):
				mode = ScreenMode.PLAY
				resolve_firearms_dummy_outcome(choice_id.trim_prefix("firearms_"))
			else:
				return false
	return true

