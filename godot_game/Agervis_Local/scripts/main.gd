		draw_wrapped(String(current["description"]), Rect2(745, 410, 380, 60), 15, PAPER)
	var camera_actions: = [["EXPORT", "export"], ["DELETE", "delete"], ["FREEZE", "freeze"], ["DUMMY", "dummy"], ["LIVE", "live"], ["CLOSE", "close"]]
	for index in range(camera_actions.size()):
		var rect: = camera_action_rect(index)
		draw_rect(rect, Color("#26302f"))
		draw_rect(rect, DANGER if String(camera_actions[index][1]) == "delete" else Color("#7ed0ad"), false, 2.0)
