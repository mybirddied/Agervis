	draw_text(recorder_scope, Vector2(125, 620), 12, Color("#a7a198"))

func draw_camera_reconstruction(event: Dictionary, rect: Rect2) -> void :
	draw_rect(rect, Color("#202629"))
	for x in range(0, int(rect.size.x), 38):
		draw_line(rect.position + Vector2(x, 0), rect.position + Vector2(x + 20, rect.size.y), Color(0.2, 0.3, 0.28, 0.22), 1)
	if bool(event.get("deleted", false)):
		for noise_y in range(12, int(rect.size.y), 17):
			draw_line(rect.position + Vector2(0, noise_y), rect.position + Vector2(rect.size.x, noise_y + 3), Color(0.55, 0.58, 0.56, 0.18), 2)
		draw_centered("CONTENT DELETED", rect.get_center() + Vector2(0, -4), 21, DANGER)
		draw_centered("WHAT IT SHOWED IS NOT RETAINED", rect.get_center() + Vector2(0, 24), 11, PAPER)
	else:
		draw_character_figure(rect.position + Vector2(rect.size.x * 0.55, rect.size.y * 0.72), Color("#8a786d"), String(event.get("subject", "UNKNOWN")), false, false)
		draw_text("RECONSTRUCTED  /  %s  /  %s" % [event.get("time", "--"), event.get("camera", "UNKNOWN")], rect.position + Vector2(12, 22), 12, Color("#7ed0ad"))

