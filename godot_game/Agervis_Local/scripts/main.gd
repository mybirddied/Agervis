func capone_job_contract(employment: Dictionary) -> Dictionary:
	var contract: = make_job_contract("Capone's Courier Desk", "capone", "Criminal P.A.T.H. + 30 Moth runs", 0, 0, 0, [], lan_session.CAPONE_TASK_TIMEOUT_SECONDS, 20)
	contract["status"] = String(employment.get("status", "active"))
	contract["requirement_filed"] = true
	var base_trust: = maxi(0, 100 - int(employment.get("failure_count", 0)) * 30)


	for actor in actors:
		if actor.actor_id == "capone":
			base_trust = apply_gun_presence_modifier(actor, base_trust)
			break

	contract["trust"] = base_trust
	contract["failure_count"] = int(employment.get("failure_count", 0))
	contract["failure_limit"] = lan_session.CAPONE_FAILURE_LIMIT
	contract["task_state"] = {
		"required": [], "completed": {}, 
		"active": String(Dictionary(employment.get("active_task", {})).get("label", "")), 
		"director": Dictionary(task_directors.get("capone", {})).duplicate(true), 
	}
	return contract


func active_capone_task() -> Dictionary:
	var director: Dictionary = Dictionary(task_directors.get("capone", {}))
	if String(director.get("owner", "")) != player_name or String(director.get("state", "")) != "assigned":
		return {}
	return Dictionary(director.get("task_record", {})).duplicate(true)

func sync_capone_employment(employment: Dictionary) -> void :
	capone_record = employment.duplicate(true)
	if employment.is_empty():
		task_directors.erase("capone")
		if active_job == "Capone Courier":
			active_job = "None"
			job_contract.clear()
		return
	if String(employment.get("status", "")) != "active":
		task_directors.erase("capone")
		if active_job == "Capone Courier":
			active_job = "None"
		job_contract = capone_job_contract(employment)
		objective = "Complete 30 fresh Moth runs before reapplying to Capone."
		return
	active_job = "Capone Courier"
	var task: Dictionary = Dictionary(employment.get("active_task", {})).duplicate(true)
	if task.is_empty():
		objective = "Report to Capone's office for a phone-directed assignment."
		task_directors["capone"] = {"owner": player_name, "state": "waiting", "task": "", "task_record": {}}
	else:
		objective = "%s. Speak to %s before the five-minute window closes." % [String(task.get("label", "Complete the assignment")), String(task.get("recipient_name", "the recipient"))]
		task_directors["capone"] = {"owner": player_name, "state": "assigned", "task": String(task.get("id", "")), "task_record": task}
	job_contract = capone_job_contract(employment)

