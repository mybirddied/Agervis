func get_skill_description(skill_name: String) -> String:
	match skill_name:
		"Intelligence": return "Intelligence governs education, quiz performance, and technical knowledge. Higher Intelligence unlocks advanced coursework and speeds scholarship progression."
		"Endurance": return "Endurance determines stamina capacity, fatigue resistance, and recovery speed. Physical labor, running, and combat all demand Endurance."
		"Agility": return "Agility affects vault success, parkour routes, and evasion. Higher Agility opens advanced movement challenges and reduces stamina costs."
		"Fighting": return "Fighting improves unarmed combat effectiveness, strike damage, and defense. Trained fighters resolve confrontations with less injury."
		"Firearms": return "Firearms skill increases accuracy, reduces recoil, and improves safety handling. Practice at the range builds competence and unlocks certifications."
		"Stealth": return "Stealth enables pickpocketing, theft, and evasion. Higher Stealth reduces detection risk and improves success rates for quiet operations."
		"Awareness": return "Awareness sharpens perception, situational judgment, and threat recognition. Aware residents notice details others miss."
		"Safety": return "Safety training prepares residents for emergency response, patrol duty, and protective roles. Safety credentials open law enforcement pathways."
		"Medicine": return "Medicine skill enables first aid, injury treatment, and pharmaceutical knowledge. Trained medics assist recovery and manage health resources."
		"Chemistry": return "Chemistry knowledge supports laboratory work, substance analysis, and synthesis. Advanced chemistry unlocks research and production opportunities."
		"Cooking": return "Cooking skill improves meal preparation, recipe complexity, and nutrition quality. Institutional kitchens reward culinary competence with XP and credentials."
		"Influence": return "Influence affects negotiation, persuasion, and social navigation. High Influence residents build relationships and resolve conflicts diplomatically."
		"Enterprise": return "Enterprise represents business acumen, employment performance, and economic judgment. Enterprise skill advances careers and unlocks trade opportunities."
		"Civics": return "Civics knowledge covers legal systems, institutional processes, and civic engagement. Understanding Civics helps residents navigate bureaucracy and advocacy."
		_: return "A skill that shapes your resident's capabilities and opportunities."

func format_number_with_commas(number: int) -> String:
	var str: = String.num_int64(number)
	var result: = ""
	var count: = 0
	for i in range(str.length() - 1, -1, -1):
		if count > 0 and count % 3 == 0:
			result = "," + result
		result = str[i] + result
		count += 1
	return result

func inventory_item_tone(item_name: String) -> Color:
	var data: = inventory_item_data(item_name)
	var kind: = String(data.get("kind", "ITEM"))
	var tag: = String(data.get("tag", "CLEAN"))
	if kind in ["GEAR", "CLOTHING", "CONTINGENCY"]:
		return GOOD
	if kind in ["DOCUMENT", "PASS", "KEY", "VOUCHER"]:
		return Color("#7895a2")
	if kind in ["PACKAGE", "DEPOSIT"] or tag == "TRUSTED":
		return ACCENT
	if tag in ["QUESTIONABLE", "STOLEN", "CONTRABAND", "CONTROLLED"]:
		return DANGER
	return Color("#9b9180")

func inventory_item_label_lines(item_name: String, max_width: float) -> Array[String]:
	var lines: Array[String] = []
	var current: = ""
	for word_value in item_name.split(" ", false):
		var word: = String(word_value)
		var candidate: = word if current.is_empty() else current + " " + word
		if font.get_string_size(candidate, HORIZONTAL_ALIGNMENT_LEFT, -1, 10).x <= max_width or current.is_empty():
			current = candidate
		elif lines.is_empty():
			lines.append(current)
			current = word
		else:
			current += "..."
			break
	if not current.is_empty() and lines.size() < 2:
		lines.append(current)
	if lines.size() == 2:
		while font.get_string_size(lines[1], HORIZONTAL_ALIGNMENT_LEFT, -1, 10).x > max_width and lines[1].length() > 3:
			lines[1] = lines[1].left(lines[1].length() - 4) + "..."
	return lines

func equipment_action_label() -> String:
	if equipment_focus == 1:
		var slot_name: = equipment_slot_at(equipment_cursor)
		return "UNEQUIP SELECTED" if not String(equipment.get(slot_name, "")).is_empty() else "EMPTY EQUIPMENT SLOT"
	if inventory.is_empty():
		return "NO ITEM SELECTED"
	var item: = String(inventory[clampi(equipment_cursor, 0, inventory.size() - 1)])
	if ItemUseRules.is_standard_consumable(item):
		return "USE SELECTED"
	return "EQUIP SELECTED" if not Build10.equipment_slot(item).is_empty() else "INSPECT SELECTED"

