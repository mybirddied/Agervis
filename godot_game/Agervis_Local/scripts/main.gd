func draw_fatback_tv(world_point: Vector2) -> void :
	var point: = scene_position(world_point)


	var tv_case: = Color("#3a3d3a")
	var tv_plastic: = Color("#2d2f2d")
	var tv_vent: = Color("#1a1c1a")
	var tv_metal: = Color("#52595c")
	var screen_glow: = Color("#4a6d7a")


	var tv_width: = 140.0
	var tv_height: = 95.0
	var tv_depth: = 65.0


	draw_rect(Rect2(point.x - tv_width * 0.5, point.y - tv_height, tv_width, tv_height), tv_case)
	draw_rect(Rect2(point.x - tv_width * 0.5, point.y - tv_height, tv_width, tv_height), tv_case.darkened(0.3), false, 2.5)


	var top_trapezoid: = PackedVector2Array([
		Vector2(point.x - tv_width * 0.5, point.y - tv_height), 
		Vector2(point.x + tv_width * 0.5, point.y - tv_height), 
		Vector2(point.x + tv_width * 0.35, point.y - tv_height - tv_depth * 0.4), 
		Vector2(point.x - tv_width * 0.35, point.y - tv_height - tv_depth * 0.4)
	])
	draw_colored_polygon(top_trapezoid, tv_case.lightened(0.12))
	draw_polyline(top_trapezoid, tv_case.darkened(0.3), 2.0, true)


	for vent_row in range(8):
		var vent_y: = point.y - tv_height + 15 + vent_row * 9
		draw_line(Vector2(point.x - 50, vent_y), Vector2(point.x + 50, vent_y), tv_vent, 3.0)
		draw_line(Vector2(point.x - 50, vent_y + 1), Vector2(point.x + 50, vent_y + 1), tv_case.lightened(0.08), 1.0)


	var label_rect: = Rect2(point.x - 35, point.y - 45, 70, 24)
	draw_rect(label_rect, Color("#d4c8a8"))
	draw_rect(label_rect, Color("#8a7a5a"), false, 1.5)
	draw_text("! HIGH VOLTAGE !", Vector2(point.x - 32, point.y - 32), 7, Color("#aa2a1a"))
	draw_text("NO USER SERVICEABLE", Vector2(point.x - 32, point.y - 24), 5, Color("#2a2a2a"))


	draw_rect(Rect2(point.x + 35, point.y - 70, 18, 12), tv_plastic.darkened(0.2))
	draw_circle(Vector2(point.x + 40, point.y - 64), 3, tv_vent)
	draw_circle(Vector2(point.x + 48, point.y - 64), 3, tv_vent)


	for port in range(3):
		var port_x: = point.x - 45 + port * 15
		draw_circle(Vector2(port_x, point.y - 18), 4, Color("#c4b454") if port == 1 else Color.WHITE if port == 0 else Color.RED)
		draw_circle(Vector2(port_x, point.y - 18), 4, tv_plastic.darkened(0.4), false, 1.5)
		draw_circle(Vector2(port_x, point.y - 18), 2, tv_vent)


	var antenna_base_x: = point.x
	var antenna_base_y: = point.y - tv_height - tv_depth * 0.4


	draw_circle(Vector2(antenna_base_x, antenna_base_y), 8, tv_plastic)
	draw_circle(Vector2(antenna_base_x, antenna_base_y), 8, tv_plastic.darkened(0.4), false, 2.0)
	draw_circle(Vector2(antenna_base_x, antenna_base_y), 4, tv_vent)


	var left_antenna_points: = PackedVector2Array([
		Vector2(antenna_base_x - 2, antenna_base_y), 
		Vector2(antenna_base_x - 25, antenna_base_y - 45), 
		Vector2(antenna_base_x - 35, antenna_base_y - 82)
	])
	draw_polyline(left_antenna_points, tv_metal, 3.5)
	draw_polyline(left_antenna_points, tv_metal.lightened(0.3), 1.5)

	draw_circle(Vector2(antenna_base_x - 25, antenna_base_y - 45), 2.5, tv_metal.darkened(0.3))

	draw_circle(Vector2(antenna_base_x - 35, antenna_base_y - 82), 4, tv_metal)


	var right_antenna_points: = PackedVector2Array([
		Vector2(antenna_base_x + 2, antenna_base_y), 
		Vector2(antenna_base_x + 30, antenna_base_y - 50), 
		Vector2(antenna_base_x + 38, antenna_base_y - 88)
	])
	draw_polyline(right_antenna_points, tv_metal, 3.5)
	draw_polyline(right_antenna_points, tv_metal.lightened(0.3), 1.5)

	draw_circle(Vector2(antenna_base_x + 30, antenna_base_y - 50), 2.5, tv_metal.darkened(0.3))

	draw_circle(Vector2(antenna_base_x + 38, antenna_base_y - 88), 4, tv_metal)


	var glow_alpha: = 0.15 + sin(elapsed * 1.8) * 0.05
	var glow_trapezoid: = PackedVector2Array([
		Vector2(point.x - 45, point.y - tv_height - tv_depth * 0.4), 
		Vector2(point.x + 45, point.y - tv_height - tv_depth * 0.4), 
		Vector2(point.x + 85, point.y - tv_height - tv_depth * 0.4 - 110), 
		Vector2(point.x - 85, point.y - tv_height - tv_depth * 0.4 - 110)
	])
	draw_colored_polygon(glow_trapezoid, Color(screen_glow, glow_alpha))


	for i in range(3):
		var shimmer_alpha: = (glow_alpha * 0.6) * (1.0 - i * 0.3)
		draw_polyline(glow_trapezoid, Color(screen_glow.lightened(0.3), shimmer_alpha), 2.0 - i * 0.5, true)

func world_rect_to_screen_rect(world_rect: Rect2) -> Rect2:
	var top_left: = scene_position(world_rect.position)
	var bottom_right: = scene_position(world_rect.end)
	return Rect2(top_left, bottom_right - top_left)

