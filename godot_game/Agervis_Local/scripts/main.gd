func start_laundry_sorting() -> void :
	laundry_sort_queue.clear()
	var pool: Array = Build9.LAUNDRY_ITEMS.duplicate(true)
	pool.shuffle()
	for index in range(mini(8, pool.size())):
		laundry_sort_queue.append(Dictionary(pool[index]).duplicate(true))
	laundry_sort_index = 0
	laundry_sort_correct = 0
	laundry_sort_rework = 0
	laundry_bin_cursor = -1
	mode = ScreenMode.LAUNDRY_SORT

func handle_laundry_sort_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.PLAY
		return
	var index: = numeric_index(key)
	if index >= 0 and index < Build9.LAUNDRY_BINS.size():
		submit_laundry_bin(index)

func laundry_bin_rect(index: int) -> Rect2:
	return Rect2(160 + index * 198, 440, 178, 72)

func handle_laundry_sort_pointer(point: Vector2) -> void :
	for index in range(Build9.LAUNDRY_BINS.size()):
		if laundry_bin_rect(index).has_point(point):
			laundry_bin_cursor = index
			submit_laundry_bin(index)
			return
	if Rect2(1000, 105, 120, 46).has_point(point): mode = ScreenMode.PLAY

func submit_laundry_bin(bin_index: int) -> void :
	if laundry_sort_index >= laundry_sort_queue.size(): return
	var item: = laundry_sort_queue[laundry_sort_index]
	var selected_bin: String = String(Build9.LAUNDRY_BINS[clampi(bin_index, 0, Build9.LAUNDRY_BINS.size() - 1)])
	if selected_bin == String(item["bin"]):
		laundry_sort_correct += 1
		laundry_sort_index += 1
		laundry_bin_cursor = -1
		if laundry_sort_index >= laundry_sort_queue.size():
			mode = ScreenMode.PLAY
			if not online_authority_enforced():
				grant_xp("Endurance", 150)
				grant_xp("Awareness", 70)
			complete_sentence_credit("LAUNDRY SORT")
	else:
		laundry_sort_rework += 1
		laundry_bin_cursor = -1
		notify("WRONG BIN  -  ITEM RETURNED WITH ADDITIONAL PAPERWORK", DANGER, 2.0)

