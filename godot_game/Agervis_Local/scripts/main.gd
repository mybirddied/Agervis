func draw_gym_obstacle(record: Dictionary) -> void :
	var point: = scene_position(record.get("position", Vector2.ZERO) as Vector2)
	var aged: = String(record.get("condition", "clean")) == "aged"
	var frame: = Color("#555a55") if aged else Color("#42636a")
	var pad: = Color("#80605a") if aged else Color("#4f7890")
	var metal: = Color("#6a6d68") if aged else Color("#9ca5a8")
	match String(record.get("obstacle_kind", "vault")):
		"rope":

			draw_line(point + Vector2(-54, -112), point + Vector2(54, -112), frame.darkened(0.32), 10.0)
			draw_rect(Rect2(point.x - 58, point.y - 118, 116, 12), frame.darkened(0.28))
			draw_line(point + Vector2(0, -108), point + Vector2(0, 15), Color("#766348") if aged else Color("#b59462"), 7.0)
			for knot_y in [-75.0, -42.0, -9.0]:
				draw_circle(point + Vector2(0, knot_y), 6.0, Color("#5d4e3d") if aged else Color("#8d704c"))
			draw_flat_ellipse(point + Vector2(0, 24), Vector2(52, 12), pad)

			for stripe_x in range(-46, 47, 12):
				draw_line(point + Vector2(stripe_x, 18), point + Vector2(stripe_x, 28), pad.darkened(0.15), 1.5)
		"ledge":

			var solid: = world_rect_to_screen_rect(record.get("solid_rect", Rect2(455, 202, 140, 28)) as Rect2)
			draw_line(Vector2(solid.position.x + 15, solid.end.y), Vector2(solid.position.x + 15, solid.position.y - 54), frame, 9.0)
			draw_line(Vector2(solid.end.x - 15, solid.end.y), Vector2(solid.end.x - 15, solid.position.y - 54), frame, 9.0)
			draw_rect(Rect2(solid.position.x, solid.position.y - 64, solid.size.x, 18), Color("#75664f") if aged else Color("#b78c58"))
			draw_rect(Rect2(solid.position.x, solid.position.y - 64, solid.size.x, 18), frame.darkened(0.28), false, 3.0)

