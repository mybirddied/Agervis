func handle_title_key(key: InputEventKey) -> void :
	if key.keycode in [KEY_UP, KEY_LEFT]:
		title_cursor = posmod(title_cursor - 1, title_menu_count())
		return
	if key.keycode in [KEY_DOWN, KEY_RIGHT, KEY_TAB]:
		title_cursor = posmod(title_cursor + 1, title_menu_count())
		return
	if key.keycode == KEY_G:
		toggle_low_spec()
		return
	if key.keycode == KEY_R or key.keycode == KEY_N:
		if not OS.has_feature("itch_release"): enter_local_test_world(key.keycode == KEY_N)
		return
	if key.keycode == KEY_L:
		if not OS.has_feature("itch_release"): open_lan_menu()
		return
	if key.keycode == KEY_F10:
		if not OS.has_feature("itch_release"): open_feedback(ScreenMode.TITLE)
		return
	if key.keycode == KEY_ENTER or key.keycode == KEY_SPACE:
		activate_title_selection()

func toggle_low_spec() -> void :
	play_button_click()
	low_spec = not low_spec
	roster["settings"] = {"low_spec": low_spec, "tips_enabled": tips_enabled, "close_chat_after_enter": close_chat_after_enter}
	persist_roster()
	release_notice = "LOW-SPEC MODE %s" % ("ON" if low_spec else "OFF")

func enter_local_test_world(prefer_new: bool = false) -> void :
	play_button_click()
	if lan_session.active:
		lan_session.close_session()
		lan_remote_states.clear()
		lan_remote_attacks.clear()
		lan_remote_hostile_arrows.clear()
		body_evidence_effects.clear()
	active_world_is_main_server = false
	main_server_population_probe = false
	main_server_online_players = -1
	roster_server_owned = false
	resident_world_id = "LOCAL-TEST-WORLD"
	roster = ReleaseSave.load_roster()
	active_slot = int(roster.get("active_slot", -1))
	release_notice = "LOCAL TEST WORLD  -  THESE RESIDENTS NEVER MOVE TO A SERVER"
	open_roster(prefer_new)

func open_roster(prefer_new: bool) -> void :
	pending_delete_slot = -1
	pending_delete_online_commit = false
	var resume_slot: = int(roster.get("active_slot", active_slot))
	if resume_slot < 0:
		resume_slot = int(roster.get("active_tutorial_slot", -1))
	roster_cursor = first_available_slot() if prefer_new else maxi(0, resume_slot)
	mode = ScreenMode.ROSTER

func tutorial_draft_at(slot_index: int) -> Variant:
	var drafts: Array = roster.get("tutorial_drafts", [])
	if slot_index < 0 or slot_index >= drafts.size():
		return null
	return drafts[slot_index]

func tutorial_candidate_with_authority(candidate: Dictionary, slot_index: int) -> Dictionary:
	var authorized: = candidate.duplicate(true)
	var existing: Variant = tutorial_draft_at(slot_index)
	if existing is Dictionary:
		for field_name in ["draft_id", "revision", "world_id", "updated_unix_ms"]:
			if (existing as Dictionary).has(field_name):
				authorized[field_name] = (existing as Dictionary)[field_name]
	return authorized

func leave_roster_to_title() -> void :
	if roster_server_owned:
		lan_session.close_session()
		lan_remote_states.clear()
		lan_remote_attacks.clear()
		lan_remote_hostile_arrows.clear()
		body_evidence_effects.clear()
		roster = ReleaseSave.default_roster()
		active_slot = -1
		resident_world_id = ""
		roster_server_owned = false
	release_notice = ""
	main_server_title_probe_started = false
	main_server_population_probe = false
	main_server_online_players = -1
	mode = ScreenMode.TITLE

func roster_world_label() -> String:
	if roster_server_owned:
		return "SERVER " + resident_world_id
	return "LOCAL TEST WORLD"

func activate_title_primary() -> void :
	play_button_click()
	if OS.has_feature("web"):
		enter_local_test_world(false)
		return
	if main_server_population_probe and lan_session.active:
		main_server_population_probe = false
		main_server_direct_entry = true
		if roster_server_owned:
			release_notice = "MAIN SERVER CONNECTED  -  CHOOSE OR CREATE A RESIDENT"
			open_roster(false)
		else:
			release_notice = "MAIN SERVER ANSWERED  -  WAITING FOR YOUR RESIDENT ROSTER"
		return
	start_main_server_join()
func handle_roster_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		leave_roster_to_title()
		return
	if key.keycode == KEY_UP:
		roster_cursor = posmod(roster_cursor - 1, ReleaseSave.FREE_SLOTS + ReleaseSave.PREMIUM_SLOTS)
	elif key.keycode == KEY_DOWN:
		roster_cursor = posmod(roster_cursor + 1, ReleaseSave.FREE_SLOTS + ReleaseSave.PREMIUM_SLOTS)
	elif key.keycode >= KEY_1 and key.keycode <= KEY_7:
		roster_cursor = int(key.keycode - KEY_1)
	elif key.keycode == KEY_DELETE or key.keycode == KEY_D:
		request_resident_deletion()
	elif key.keycode == KEY_ENTER:
		activate_roster_selection()

func activate_roster_selection() -> void :
	play_button_click()
	if roster_cursor >= ReleaseSave.FREE_SLOTS:
		release_notice = "PREMIUM CHARACTER SLOT  -  NOT SOLD IN RELEASE 1"
		return
	var slot: Variant = roster["slots"][roster_cursor]
	if slot is Dictionary:
		load_character(slot as Dictionary, roster_cursor)
	elif tutorial_draft_at(roster_cursor) is Dictionary:
		load_character(tutorial_draft_at(roster_cursor) as Dictionary, roster_cursor)
	else:
		begin_new_character(roster_cursor)

func request_resident_deletion() -> void :
	if not ALLOW_OFFLINE_RESIDENT_DELETION:
		release_notice = "RESIDENT DELETION REQUIRES OFFLINE RELEASE MODE"
		return
	if roster_cursor < 0 or roster_cursor >= ReleaseSave.FREE_SLOTS:
		release_notice = "RESERVED SLOTS DO NOT CONTAIN LOCAL RESIDENTS"
		return
	var slot: Variant = roster["slots"][roster_cursor]
	var draft: Variant = tutorial_draft_at(roster_cursor)
	if slot is not Dictionary and draft is not Dictionary:
		release_notice = "THAT RESIDENT FILE IS ALREADY EMPTY"
		return
	pending_delete_slot = roster_cursor
	pending_delete_online_commit = false
	release_notice = ""
	mode = ScreenMode.ROSTER_DELETE

func handle_roster_delete_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE or key.keycode == KEY_BACKSPACE:
		cancel_resident_deletion()
	elif key.keycode == KEY_ENTER:
		confirm_resident_deletion()

func cancel_resident_deletion() -> void :
	if pending_delete_online_commit:
		return
	pending_delete_slot = -1
	mode = ScreenMode.ROSTER
	release_notice = "RESIDENT DELETION CANCELED"

func confirm_resident_deletion() -> void :
	if pending_delete_online_commit:
		return
	if pending_delete_slot < 0 or pending_delete_slot >= ReleaseSave.FREE_SLOTS:
		cancel_resident_deletion()
		return
	var slot: Variant = roster["slots"][pending_delete_slot]
	var draft: Variant = tutorial_draft_at(pending_delete_slot)
	if slot is not Dictionary and draft is not Dictionary:
		cancel_resident_deletion()
		return
	var deleted_name: = String((slot as Dictionary).get("name", "UNNAMED")).to_upper() if slot is Dictionary else "UNFINISHED TUTORIAL"
	var deleted_index: = pending_delete_slot
	if roster_server_owned:
		if not lan_session.active:
			pending_delete_slot = -1
			mode = ScreenMode.ROSTER
			release_notice = "DELETE FAILED  -  SERVER CONNECTION IS CLOSED"
			return
		pending_delete_online_commit = true
		release_notice = "SERVER IS DELETING THE SELECTED FILE"
		lan_session.delete_server_resident(deleted_index)
		return
	var previous_roster: = roster
	roster = ReleaseSave.delete_resident(roster, deleted_index)
	if not persist_roster():
		roster = previous_roster
		pending_delete_slot = -1
		mode = ScreenMode.ROSTER
		release_notice = "DELETE FAILED  -  RESIDENT FILE WAS NOT CHANGED"
		return
	active_slot = int(roster.get("active_slot", -1))
	roster_cursor = deleted_index
	pending_delete_slot = -1
	mode = ScreenMode.ROSTER
	release_notice = "%s DELETED FROM %s" % [deleted_name, roster_world_label()]

func first_available_slot() -> int:
	for index in range(ReleaseSave.FREE_SLOTS):
		if roster["slots"][index] == null and tutorial_draft_at(index) == null:
			return index
	return maxi(0, active_slot)

func current_saved_slot() -> Variant:
	if active_slot < 0 or active_slot >= ReleaseSave.FREE_SLOTS:
		return null
	return roster["slots"][active_slot]

func begin_new_character(slot_index: int) -> void :
	if not prepare_slot_switch(slot_index):
		mode = ScreenMode.ROSTER
		return
	reset_character_state()
	active_slot = clampi(slot_index, 0, ReleaseSave.FREE_SLOTS - 1)
	roster["active_tutorial_slot"] = active_slot
	start_character_creation_flow()

