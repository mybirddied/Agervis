func draw_street_trash_can(world_x: float, offset: float, variant: int) -> void :
	var x: = world_x - offset
	if x < -60.0 or x > VIEW_SIZE.x + 60.0:
		return

	var can_y: = 380.0
	var can_height: = 58.0
	var can_width: = 32.0


	draw_flat_ellipse(Vector2(x, 438.0), Vector2(can_width * 0.6, 8.0), Color(0.0, 0.0, 0.0, 0.4))


	var drum_color: = Color("#2a3236") if variant % 2 == 0 else Color("#323538")
	var drum_rect: = Rect2(x - can_width * 0.5, can_y, can_width, can_height)


	draw_rect(drum_rect.grow(1.5), Color(0.0, 0.0, 0.0, 0.35))
	draw_rect(drum_rect, drum_color)
	draw_rect(drum_rect, Color.BLACK, false, 2.0)


	var dent_x: = x - can_width * 0.3
	var dent_y: = can_y + 22.0
	draw_circle(Vector2(dent_x, dent_y), 9.0, drum_color.darkened(0.25))
	draw_arc(Vector2(dent_x, dent_y), 9.0, 0.0, PI, 8, drum_color.darkened(0.35), 1.5, false)


	for streak in range(3):
		var rust_x: = x - can_width * 0.35 + streak * 11.0
		var rust_start_y: = can_y + 8.0 + streak * 4.0
		var rust_end_y: = can_y + can_height - 6.0
		draw_line(Vector2(rust_x, rust_start_y), Vector2(rust_x, rust_end_y), Color("#6b4a3a"), 2.5)
		draw_line(Vector2(rust_x + 1, rust_start_y), Vector2(rust_x + 1, rust_end_y), Color("#8a5a42"), 1.0)


	for band_offset in [12.0, 34.0]:
		var band_y: float = can_y + band_offset
		draw_line(Vector2(x - can_width * 0.5, band_y), Vector2(x + can_width * 0.5, band_y), drum_color.darkened(0.3), 2.5)
		draw_line(Vector2(x - can_width * 0.5, band_y - 1), Vector2(x + can_width * 0.5, band_y - 1), drum_color.lightened(0.15), 1.0)


	var tag_y: = can_y + 25.0
	if variant % 3 == 0:

		draw_line(Vector2(x - 8, tag_y), Vector2(x + 2, tag_y), Color("#c84a52"), 3.5)
		draw_line(Vector2(x - 6, tag_y + 5), Vector2(x + 5, tag_y + 5), Color("#c84a52"), 3.0)
		draw_line(Vector2(x - 8, tag_y), Vector2(x - 8, tag_y + 5), Color("#c84a52"), 3.0)
	elif variant % 3 == 1:

		draw_circle(Vector2(x, tag_y + 3), 6.0, Color("#4a7d6b"), false, 2.5)
		draw_line(Vector2(x - 4, tag_y), Vector2(x + 4, tag_y + 6), Color("#4a7d6b"), 2.5)
		draw_line(Vector2(x + 4, tag_y), Vector2(x - 4, tag_y + 6), Color("#4a7d6b"), 2.5)
	else:

		draw_line(Vector2(x - 6, tag_y + 8), Vector2(x, tag_y - 2), Color("#9a7d4a"), 3.0)
		draw_line(Vector2(x, tag_y - 2), Vector2(x + 6, tag_y + 8), Color("#9a7d4a"), 3.0)
		draw_line(Vector2(x - 3, tag_y + 3), Vector2(x + 3, tag_y + 3), Color("#9a7d4a"), 2.5)


	var overflow_top: = can_y - 8.0


	draw_circle(Vector2(x - 4, overflow_top), 12.0, Color("#0e1012"))
	draw_circle(Vector2(x - 4, overflow_top), 12.0, Color.BLACK, false, 1.5)

	draw_line(Vector2(x - 9, overflow_top - 8), Vector2(x + 1, overflow_top - 8), Color("#1a1c1e"), 2.5)


	var bottle_x: = x + 8
	var bottle_top: = overflow_top - 6.0
	draw_line(Vector2(bottle_x, bottle_top), Vector2(bottle_x, bottle_top + 16), Color("#3a5247"), 3.5)
	draw_circle(Vector2(bottle_x, bottle_top + 2), 2.5, Color("#2a4237"))


	var wrapper_x: = x - can_width * 0.45
	var wrapper_y: = can_y + 16.0
	draw_circle(Vector2(wrapper_x, wrapper_y), 4.0, Color("#c8a872"))
	draw_circle(Vector2(wrapper_x + 2, wrapper_y + 6), 3.5, Color("#b89662"))


	if not low_spec:

		draw_rect(Rect2(x + can_width * 0.6, 432, 8, 4), Color("#6a4a3a"))
		draw_rect(Rect2(x + can_width * 0.6, 432, 8, 1), Color("#8a6a5a"))


		for butt in range(2):
			var butt_x: = x - can_width * 0.7 + butt * 6.0
			var butt_y: = 434.0 + butt * 2.0
			draw_line(Vector2(butt_x, butt_y), Vector2(butt_x + 3, butt_y), Color("#d4c8a8"), 1.0)

