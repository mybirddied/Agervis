		for i in range(3):
			var trail_offset: float = (i + 1) * -8.0 * sign(cooking_indicator_speed)
			var trail_alpha: = 0.3 - i * 0.1
			draw_rect(Rect2(indicator_x + trail_offset - 2, 340, 4, 60), Color(ACCENT.r, ACCENT.g, ACCENT.b, trail_alpha))


