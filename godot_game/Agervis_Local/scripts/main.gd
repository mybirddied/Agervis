func start_jail_sequence(title: String, sequence: Array[String]) -> void :
	dialog_title = title
	jail_sequence = sequence.duplicate()
	jail_progress = 0
	mode = ScreenMode.JAIL_TASK

func handle_jail_task_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.PLAY
		return
	if jail_progress >= jail_sequence.size():
		return
	var pressed: = OS.get_keycode_string(key.keycode)
	handle_jail_task_symbol(pressed)

func handle_jail_task_symbol(pressed: String) -> void :
	if jail_progress >= jail_sequence.size():
		return
	if pressed == jail_sequence[jail_progress]:
		jail_progress += 1
		if jail_progress >= jail_sequence.size():
			mode = ScreenMode.PLAY
			if not online_authority_enforced():
				grant_xp("Endurance", 110)
			complete_sentence_credit("MANDATORY LABOR")
	else:
		jail_progress = 0
		notify("WORK SEQUENCE RESTARTED", DANGER, 1.5)

func complete_sentence_credit(source: String) -> void :
	if online_authority_enforced():
		var source_label: = source.to_upper()
		var source_id: = String(JAIL_ASSIGNMENT_SOURCE_IDS.get(source_label, ""))
		if source_id.is_empty():
			notify("THAT ASSIGNMENT IS NOT ON THE ONLINE SENTENCE LEDGER", DANGER, 3.0)
			return
		submit_online_economy_request("JAIL_ASSIGNMENT_COMPLETE", {"source_id": source_id}, true, {"source_label": source_label})
		return
	sentence_credits = maxi(0, sentence_credits - 1)
	notify("%s COMPLETE  -  %d CREDITS REMAIN" % [source, sentence_credits], GOOD, 3.5)
	if sentence_credits <= 0:
		objective = "Report to the release door."

func begin_arrest(reason: String) -> void :
	if mode == ScreenMode.ARREST: return
	player_arrested = true
	notify("PIKE: " + arrest_barks[rng.randi_range(0, arrest_barks.size() - 1)], DANGER, 4.0)
	vault_active = false
	player_downed = false
	downed_timer = 0.0
	downed_reason = ""
	downed_disposition_resolved = true
	health = maxf(1.0, health)
	mode = ScreenMode.ARREST
	arrest_timer = 0.0
	arrest_penalty_multiplier = 1.0
	arrest_surrendered = false
	arrest_reason = reason
	stamina = 0.0
	var lines: = [
		"THE LONG, OVERFUNDED ARM OF THE LAW HAS ENTERED THE CHAT.", 
		"STOP RESISTING MY PERFORMANCE REVIEW.", 
		"PREPARE TO BE PROCESSED WITH MAXIMUM ADMINISTRATIVE FORCE.", 
	]
	notify(lines[rng.randi_range(0, lines.size() - 1)], DANGER, 4.0)

func handle_arrest_key(key: InputEventKey) -> void :
	if key.keycode in [KEY_E, KEY_S, KEY_ENTER]:
		surrender_during_arrest()
	elif key.keycode == KEY_F and arrest_timer < 3.0:
		player_attack()

func surrender_reduction() -> float:
	var elapsed_seconds: = clampi(int(floor(arrest_timer)), 0, 10)
	return lerpf(0.5, 0.15, float(elapsed_seconds) / 10.0)

func surrender_during_arrest() -> void :
	if mode != ScreenMode.ARREST or arrest_surrendered: return
	arrest_surrendered = true
	var reduction: = surrender_reduction()
	arrest_penalty_multiplier = 1.0 - reduction
	notify("SURRENDER FILED AFTER %.1fs  -  PENALTY REDUCED %d%%" % [arrest_timer, int(round(reduction * 100.0))], GOOD, 4.0)
	send_to_jail()

func update_arrest(delta: float) -> void :
	arrest_timer += delta
	if arrest_timer >= 10.0:
		send_to_jail()

func send_to_jail() -> void :
	mode = ScreenMode.PLAY
	player_arrested = true
	var base_credits: = Rules.sentence_credits(crimes)
	sentence_credits = maxi(1, int(ceil(float(base_credits) * arrest_penalty_multiplier)))
	arrest_timer = 0.0
	area = "jail"
	room_id = String(Build10.DEFAULT_ROOM.get("jail", "tier"))
	player_position = resolve_safe_position(Vector2(100, 220))
	player_downed = false
	health = 70.0
	stamina = 70.0
	warrant = false
	wanted = false
	mark_timer = 0.0
	dirty_cash = 0
	resolve_carried_handoffs("LOST", "Custody intake separated you from the carried handoff.")
	deposit_active = false
	deposit_value = 0
	deposit_source = "store"
	for deposit_item in ["Entrusted Deposit Bag", "Restaurant Deposit", "Laundry Deposit"]: inventory.erase(deposit_item)
	crimes.clear()
	booking_authorized = false
	objective = "Complete %d jail assignment credits." % sentence_credits
	notify("SENTENCE ASSIGNED  -  DIRTY CASH BOOKED AS EVIDENCE", DANGER, 4.0)

func release_from_jail() -> void :
	if online_authority_enforced():
		submit_online_economy_request("JAIL_RELEASE")
		return
	player_arrested = false
	area = "home"
	room_id = String(Build10.DEFAULT_ROOM.get("home", "lobby"))
	vault_active = false
	player_position = resolve_safe_position(Vector2(850, 220))
	health = 82.0
	stamina = 80.0
	clear_active_case()
	objective = "Released to Home Turf. The served case is closed; the city still remembers your record."
	notify("RELEASED  -  HEAT AND SERVED PROBABLE CAUSE RESET", GOOD, 4.0)

func clear_active_case() -> void :
	wanted = false
	warrant = false
	case_strength = 0
	mark_timer = 0.0
	crimes.clear()
	camera_events.clear()
	camera_exports.clear()
	camera_audit.clear()
	exported_event_ids.clear()

