func draw_classroom_desk(row: int, desk_col: int) -> void :
	var aged: = area == "school" and phase != "tutorial"
	var desk_x: = 240 + desk_col * 240
	var desk_y: = 537 + row * 12
	var desk_wood: = Color("#5d524a") if not aged else Color("#4d443c")
	var desk_wood_dark: = desk_wood.darkened(0.15)
	var desk_wood_light: = desk_wood.lightened(0.08)
	var desk_metal: = Color("#4a4d47") if not aged else Color("#3a3d37")
	var desk_metal_highlight: = desk_metal.lightened(0.2)


	draw_rect(Rect2(desk_x, desk_y, 85, 42), desk_wood)

	for grain in range(5):
		var grain_y: = desk_y + 8 + grain * 7
		draw_line(Vector2(desk_x + 4, grain_y), Vector2(desk_x + 81, grain_y), desk_wood_dark.lerp(desk_wood, 0.7), 0.5)


	draw_line(Vector2(desk_x, desk_y), Vector2(desk_x + 85, desk_y), desk_wood_light, 2.0)
	draw_line(Vector2(desk_x, desk_y), Vector2(desk_x, desk_y + 42), desk_wood_light, 1.5)
	draw_line(Vector2(desk_x + 85, desk_y), Vector2(desk_x + 85, desk_y + 42), desk_wood_dark, 1.5)
	draw_line(Vector2(desk_x, desk_y + 42), Vector2(desk_x + 85, desk_y + 42), desk_wood_dark, 2.0)


	var cubby: = Rect2(desk_x + 8, desk_y + 30, 69, 10)
	draw_rect(cubby, desk_wood_dark.darkened(0.25))
	draw_rect(cubby, desk_wood_dark, false, 1.0)



	draw_line(Vector2(desk_x + 8, desk_y + 42), Vector2(desk_x + 8, desk_y + 58), desk_metal, 4.0)
	draw_line(Vector2(desk_x + 7, desk_y + 42), Vector2(desk_x + 7, desk_y + 56), desk_metal_highlight, 1.0)

	draw_line(Vector2(desk_x + 77, desk_y + 42), Vector2(desk_x + 77, desk_y + 58), desk_metal, 4.0)
	draw_line(Vector2(desk_x + 76, desk_y + 42), Vector2(desk_x + 76, desk_y + 56), desk_metal_highlight, 1.0)

	draw_line(Vector2(desk_x + 8, desk_y + 52), Vector2(desk_x + 77, desk_y + 52), desk_metal, 2.0)

	draw_circle(Vector2(desk_x + 8, desk_y + 58), 3, desk_metal.darkened(0.2))
	draw_circle(Vector2(desk_x + 77, desk_y + 58), 3, desk_metal.darkened(0.2))


	if aged:

		for scratch in range(3):
			var scratch_x: = desk_x + 15 + scratch * 22
			var scratch_y: = desk_y + 12 + (scratch * 7) % 15
			draw_line(Vector2(scratch_x, scratch_y), Vector2(scratch_x + 18, scratch_y + 3), desk_wood_dark.darkened(0.3), 1.0)

		draw_circle(Vector2(desk_x + 65, desk_y + 22), 4, desk_wood_dark.darkened(0.35))

		draw_circle(Vector2(desk_x + 8, desk_y + 48), 2, Color("#6b3a28"))
		draw_circle(Vector2(desk_x + 77, desk_y + 54), 2, Color("#6b3a28"))
		if (row + desk_col) % 3 == 0:

			draw_line(Vector2(desk_x + 12, desk_y + 8), Vector2(desk_x + 35, desk_y + 14), Color("#3d342a"), 2.5)
			draw_line(Vector2(desk_x + 14, desk_y + 18), Vector2(desk_x + 28, desk_y + 22), Color("#3d342a"), 1.5)
	else:

		draw_circle(Vector2(desk_x + 42, desk_y + 18), 2, desk_wood_dark.darkened(0.2))

		draw_line(Vector2(desk_x + 60, desk_y + 28), Vector2(desk_x + 68, desk_y + 30), Color("#2a2d2a").lerp(desk_wood, 0.3), 0.5)

func draw_classroom_clock_and_poster() -> void :
	var aged: = area == "school" and phase != "tutorial"


	var clock_center: = Vector2(950, 195)
	var clock_face: = Color("#dbd5c2") if not aged else Color("#b8b0a2")
	draw_circle(clock_center, 22, Color("#1a1c1a"))
	draw_circle(clock_center, 20, clock_face)
	draw_circle(clock_center, 20, Color("#2f312e"), false, 1.5)
	var hour_angle: = deg_to_rad(110.0 if aged else elapsed * 30.0)
	var minute_angle: = deg_to_rad(282.0 if aged else elapsed * 360.0)
	draw_line(clock_center, clock_center + Vector2(cos(hour_angle - PI / 2) * 10, sin(hour_angle - PI / 2) * 10), Color("#2a2d2a"), 2.5)
	draw_line(clock_center, clock_center + Vector2(cos(minute_angle - PI / 2) * 15, sin(minute_angle - PI / 2) * 15), Color("#2a2d2a"), 1.5)


	var poster: = Rect2(15, 160, 145, 65)
	var poster_bg: = Color("#6b5848") if not aged else Color("#5a4a3a")
	draw_rect(poster.grow(4), Color("#1c1e1c"))
	draw_rect(poster, poster_bg)
	if not aged:
		draw_centered("SKILLS DETERMINE", poster.get_center() + Vector2(0, -10), 9, PAPER)
		draw_centered("AVAILABLE OPTIONS", poster.get_center() + Vector2(0, 6), 9, Color("#d4cdb8"))
	else:
		draw_centered("SKILLS DETERMINE", poster.get_center() + Vector2(0, -10), 9, Color("#a8a295"))
		draw_centered("AVAILABLE OPTIONS", poster.get_center() + Vector2(0, 6), 9, Color("#8a8578"))

		draw_line(poster.position + Vector2(poster.size.x - 8, 0), poster.end - Vector2(8, 0), Color("#32342f"), 3.0)

