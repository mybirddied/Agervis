func handoff_belongs_to_active_resident(handoff: Dictionary) -> bool:
	var owner_key: = String(handoff.get("owner_tester_id", ""))
	if owner_key.is_empty():
		return true
	return owner_key == handoff_owner_key() and int(handoff.get("owner_resident_slot", -2)) == active_slot and String(handoff.get("owner_world_id", resident_world_id)) == resident_world_id
func issue_handoff(item_id: String, display_name: String, employer: String, source_object: String, destination: String, deadline_seconds: float, value: int = 0) -> bool:
	if reject_unsupported_online_mutation("LEGACY HANDOFF"):
		return false
	if not source_object.is_empty() and not task_object_is_visible(source_object):
		notify("THAT HANDOFF DOES NOT EXIST IN THIS ROOM", DANGER, 3.0)
		return false
	if handoff_items.has(item_id) and String(Dictionary(handoff_items[item_id]).get("state", "")) == "carried":
		notify("YOU ARE ALREADY CARRYING %s" % display_name.to_upper(), ACCENT, 2.5)
		return false
	var handoff: = {
		"id": item_id, 
		"owner_tester_id": handoff_owner_key(), 
		"owner_resident_slot": active_slot, 
		"owner_world_id": resident_world_id, 
		"owner_name": player_name, 
		"source_area": area, 
		"source_room_id": room_id, 
		"display_name": display_name, 
		"employer": employer, 
		"source_room": task_room_key(), 
		"destination": destination, 
		"issued_at": elapsed, 
		"deadline": elapsed + deadline_seconds, 
		"value": value, 
		"state": "carried", 
		"outcome": "PENDING", 
		"witnessed": false, 
		"tampered": false, 
		"delay_reported": false, 
	}
	if display_name not in inventory and not try_add_inventory_item(display_name):
		notify("NO CARRY SPACE FOR %s - MAKE ROOM BEFORE TAKING THE HANDOFF" % display_name.to_upper(), DANGER, 3.0)
		return false
	handoff_sequence += 1
	handoff["authority_nonce"] = "%s-%d-%d-%d" % [handoff_owner_key(), active_slot, Time.get_ticks_msec(), handoff_sequence]
	handoff_items[item_id] = handoff
	notify("HANDOFF RECEIVED  -  %s" % display_name.to_upper(), ACCENT, 3.0)
	return true

func handoff_id_for_deposit_source(source: String) -> String:
	match source:
		"restaurant": return "restaurant_deposit"
		"laundromat": return "laundry_deposit"
		_: return "sealed_deposit_bag"

func issue_job_deposit(source: String, item_id: String, display_name: String, employer: String, source_object: String, value: int, destination: String) -> bool:
	if not issue_handoff(item_id, display_name, employer, source_object, destination, 180.0, value):
		return false
	deposit_active = true
	deposit_source = source
	deposit_value = value
	objective = "Carry the sealed %s deposit to the bank." % source
	return true
func carried_handoff(item_id: String) -> bool:
	if not handoff_items.has(item_id):
		return false
	var handoff: Dictionary = handoff_items[item_id]
	return String(handoff.get("state", "")) == "carried" and handoff_belongs_to_active_resident(handoff)

func active_moth_package_handoff() -> Dictionary:
	for tier_id_variant in MothContent.RUN_TIERS.keys():
		var tier: = MothContent.run_tier(String(tier_id_variant))
		var item_id: = String(tier.get("item_id", ""))
		if carried_handoff(item_id):
			return Dictionary(handoff_items.get(item_id, {})).duplicate(true)
	return {}

func moth_relationship() -> Dictionary:
	return MothContent.normalize_relationship(dealer_relationships.get(MothContent.DEALER_ID, {}))

func moth_hostility_active() -> bool:
	return int(moth_relationship().get("hostile_until_unix_ms", 0)) > int(Time.get_unix_time_from_system() * 1000.0)

func set_local_moth_relationship(relationship: Dictionary) -> void :
	dealer_relationships[MothContent.DEALER_ID] = MothContent.normalize_relationship(relationship)

func start_offline_moth_run(tier_id: String) -> void :
	if moth_hostility_active():
		notify("MOTH HAS SUSPENDED BUSINESS FOR TEN MINUTES AFTER THE MISSED DELIVERY", DANGER, 3.5)
		return
	var tier: = MothContent.run_tier(tier_id)
	var relationship: = moth_relationship()
	if tier.is_empty() or int(relationship.get("trust", 0)) < int(tier.get("trust_required", 0)):
		notify("MOTH HAS NOT OPENED THAT PACKAGE SIZE TO YOU", DANGER, 2.8)
		return
	if skill_level("Stealth") < 3:
		notify("MOTH REQUIRES STEALTH LEVEL 3  -  DISCRETION HAS COURSEWORK NOW", ACCENT, 3.5)
		return
	var route: = MothContent.route_for_run(handoff_owner_key(), int(relationship.get("completed_runs", 0)))
	var item_id: = String(tier.get("item_id", ""))
	var display_name: = String(tier.get("item_display", "Sealed Package"))
	var payout: = MothContent.payout_cents(handoff_owner_key(), int(relationship.get("completed_runs", 0)), tier_id) / 100
	if not issue_handoff(item_id, display_name, "Moth's Errand Desk", "moth", "%s at %s" % [String(route.get("recipient_name", "Customer")), String(route.get("destination_label", "the arranged location"))], float(tier.get("active_seconds", 300.0)), payout):
		return
	var handoff: Dictionary = Dictionary(handoff_items[item_id]).duplicate(true)
	handoff["route_id"] = route.get("id", "")
	handoff["recipient_actor_id"] = route.get("recipient_actor_id", "")
	handoff["recipient_name"] = route.get("recipient_name", "Customer")
	handoff["destination_label"] = route.get("destination_label", "the arranged location")
	handoff["destination_area"] = route.get("area", "street")
	handoff["destination_room_id"] = route.get("room_id", "")
	handoff["destination_point"] = route.get("point", Vector2.ZERO)
	handoff["run_tier"] = tier_id
	handoff["payment_cents"] = payout * 100
	handoff_items[item_id] = handoff
	sealed_packages = 1
	objective = "Carry the sealed %s to %s at %s." % [String(tier.get("display", "package")).to_lower(), String(route.get("recipient_name", "the customer")), String(route.get("destination_label", "the arranged location"))]
	notify("MOTH ISSUED A SEALED %s  -  TRUST %d/100" % [String(tier.get("display", "PACKAGE")).to_upper(), int(relationship.get("trust", 0))], ACCENT, 3.5)

func exchange_offline_moth_package(actor: AgervisActor, package: Dictionary) -> void :
	if String(package.get("recipient_actor_id", "")) != actor.actor_id:
		open_dialog(actor.display_name.to_upper(), ["That package is for somebody else. The seal is doing more verification than either of you."], [])
		return
	var route: = MothContent.route(String(package.get("route_id", "")))
	var item_id: = String(package.get("id", ""))
	report_handoff_outcome(item_id, "COMPLETED", "%s accepted the sealed package at %s." % [actor.display_name, String(route.get("destination_label", "the arranged location"))], true)
	if issue_handoff("sealed_customer_envelope", "Sealed Customer Envelope", "Moth's Errand Desk", "", "Return the envelope to Moth", 300.0, int(package.get("payment_cents", 0)) / 100):
		var envelope: Dictionary = Dictionary(handoff_items["sealed_customer_envelope"]).duplicate(true)
		envelope["route_id"] = package.get("route_id", "")
		envelope["run_tier"] = package.get("run_tier", "dime")
		envelope["payment_cents"] = int(package.get("payment_cents", 0))
		handoff_items["sealed_customer_envelope"] = envelope
		sealed_packages = 0
		objective = "Return %s's sealed customer envelope to Moth." % actor.display_name

func complete_offline_moth_run() -> void :
	if not carried_handoff("sealed_customer_envelope"):
		return
	var envelope: Dictionary = Dictionary(handoff_items["sealed_customer_envelope"]).duplicate(true)
	var tier_id: = String(envelope.get("run_tier", "dime"))
	var tier: = MothContent.run_tier(tier_id)
	var payout: = int(envelope.get("payment_cents", 0)) / 100
	report_handoff_outcome("sealed_customer_envelope", "COMPLETED", "Moth received the sealed customer envelope without opening it in public.", true)
	dirty_cash += payout
	grant_xp("Stealth", int(tier.get("stealth_xp", 0)))
	grant_xp("Enterprise", int(tier.get("enterprise_xp", 0)))
	criminal_errands_completed += 1
	var relationship: = moth_relationship()
	relationship["trust"] = mini(100, int(relationship.get("trust", 0)) + int(tier.get("trust_gain", 0)))
	relationship["completed_runs"] = int(relationship.get("completed_runs", 0)) + 1
	var completed_by_tier: Dictionary = relationship.get("completed_by_tier", {})
	completed_by_tier[tier_id] = int(completed_by_tier.get(tier_id, 0)) + 1
	relationship["completed_by_tier"] = completed_by_tier
	set_local_moth_relationship(relationship)
	objective = "The block is open: study, work, trade, investigate, or offend."
	notify("MOTH RUN COMPLETE  -  DIRTY CASH +$%d  /  TRUST %d/100" % [payout, int(relationship.get("trust", 0))], GOOD, 3.8)

func buy_offline_moth_wholesale(item_id: String) -> void :
	var offer: = MothContent.wholesale_offer(item_id)
	var relationship: = moth_relationship()
	var price: = int(offer.get("price_cents", 0)) / 100
	if offer.is_empty() or int(relationship.get("trust", 0)) < int(offer.get("trust_required", 0)):
		notify("MOTH HAS NOT OPENED THAT INVENTORY TO YOU", DANGER, 2.8)
		return
	if dirty_cash < price:
		notify("DIRTY CASH $%d REQUIRED" % price, DANGER, 2.8)
		return
	if not try_add_inventory_item(item_id):
		return
	dirty_cash -= price
	relationship["wholesale_purchases"] = int(relationship.get("wholesale_purchases", 0)) + 1
	set_local_moth_relationship(relationship)
	notify("MOTH WHOLESALE  -  %s  /  DIRTY $%d" % [item_id.to_upper(), price], GOOD, 3.5)

func authoritative_inventory_records() -> Array[Dictionary]:
	if active_slot < 0:
		return []
	var slots: Array = roster.get("slots", [])
	if active_slot >= slots.size() or slots[active_slot] is not Dictionary:
		return []
	var resident: = SaveMigration.migrate_resident(slots[active_slot] as Dictionary)
	return SaveMigration.inventory_records(resident.get("inventory", []))

func authoritative_inventory_record_for_display_index(display_index: int) -> Dictionary:
	var selection: = authoritative_inventory_selection_for_display_index(display_index)
	return Dictionary(selection.get("record", {})).duplicate(true)

func authoritative_inventory_selection_for_display_index(display_index: int) -> Dictionary:
	if display_index < 0:
		return {}
	var flattened_index: = 0
	var records: = authoritative_inventory_records()
	for record_index in range(records.size()):
		var record: Dictionary = records[record_index]
		var quantity: = maxi(1, int(record.get("quantity", 1)))
		if display_index >= flattened_index and display_index < flattened_index + quantity:
			return {
				"record_index": record_index, 
				"unit_offset": display_index - flattened_index, 
				"display_start": flattened_index, 
				"record": record.duplicate(true), 
			}
		flattened_index += quantity
	return {}

func first_powder_batch(unidentified_only: bool = false) -> Dictionary:
	for record in authoritative_inventory_records():
		var metadata: Dictionary = record.get("metadata", {})
		if String(metadata.get("substance_id", "")) != "powder":
			continue
		if unidentified_only and bool(metadata.get("purity_known", false)):
			continue
		return record.duplicate(true)
	return {}

