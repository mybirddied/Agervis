func draw_building_utility_details(x: float, width: float, building_top: float, building_bottom: float, wall_tile: int) -> void :

	var seed: = wall_tile

	if posmod(seed, 3) == 1:
		var pipe_x: = x + 12
		draw_line(Vector2(pipe_x, building_top + 30), Vector2(pipe_x, building_bottom - 40), Color("#4a4238"), 4.0)
		draw_line(Vector2(pipe_x + 1, building_top + 30), Vector2(pipe_x + 1, building_bottom - 40), Color("#5a5248"), 2.0)

		for bracket_y in range(int(building_top + 60), int(building_bottom - 60), 80):
			draw_rect(Rect2(pipe_x - 3, bracket_y, 8, 4), Color("#35342f"))

	if posmod(seed + 2, 4) == 0:
		var conduit_x: = x + width - 18
		draw_line(Vector2(conduit_x, building_top + 40), Vector2(conduit_x, building_bottom - 80), Color("#3a3a36"), 2.5)

		draw_rect(Rect2(conduit_x - 6, building_top + 45, 12, 16), Color("#44443f"))
		draw_rect(Rect2(conduit_x - 6, building_top + 45, 12, 16), Color("#24241f"), false, 1.0)

	if posmod(seed, 4) == 2:
		var ac_window_x: = x + width * 0.6
		var ac_window_y: = building_bottom - 120
		draw_rect(Rect2(ac_window_x, ac_window_y, 20, 12), Color("#4a4c48"))
		draw_rect(Rect2(ac_window_x, ac_window_y, 20, 12), Color("#2a2c28"), false, 1.0)

		for line in range(4):
			var ly: = ac_window_y + 3 + line * 2
			draw_line(Vector2(ac_window_x + 2, ly), Vector2(ac_window_x + 18, ly), Color("#35372f"), 0.5)

func draw_building_exterior(center_x: float, width: float, building_id: String, label: String, wall_tile: int, _door_tile: int, color: Color, offset: float) -> void :
	var x: = center_x - width * 0.5 - offset
	if x > 1320 or x + width < -40:
		return
	var stories: = int(Build10.BUILDING_STORIES.get(building_id, 3))
	var building_top: = 82.0 if stories >= 6 else 105.0 if stories == 5 else 128.0 if stories == 4 else 150.0
	var building_bottom: = 416.0
	var columns: = maxi(2, int(ceil(width / 118.0)))
	var facade_color: = color.darkened(0.15)

	for column in range(columns):
		var tile_x: = x + column * width / columns
		var tile_width: = width / columns + 1.0
		draw_rect(Rect2(tile_x, building_top, tile_width, building_bottom - building_top), facade_color)
		draw_facade_material_column(Rect2(tile_x, building_top, tile_width, building_bottom - building_top), wall_tile, column)

	var floor_height: = (building_bottom - building_top - 20.0) / float(stories)
	for floor_index in range(stories):
		var floor_y: = building_bottom - 18.0 - (floor_index + 1) * floor_height

		draw_line(Vector2(x, floor_y + floor_height + 1), Vector2(x + width, floor_y + floor_height + 1), Color(0.02, 0.025, 0.02, 0.35), 3.0)
		draw_line(Vector2(x, floor_y + floor_height), Vector2(x + width, floor_y + floor_height), Color(0.04, 0.045, 0.04, 0.52), 2.0)
		for window_index in range(maxi(2, columns - 1)):
			var window_x: = x + 24.0 + window_index * ((width - 86.0) / float(maxi(1, columns - 2)))
			if absf(window_x + 24.0 - (center_x - offset)) > 76.0 or floor_index > 0:
				draw_exterior_window(Rect2(window_x, floor_y + 10.0, 48.0, minf(42.0, floor_height - 14.0)), posmod(floor_index + window_index, 5) == 0)

	if not low_spec:

		if stories >= 4 and posmod(wall_tile, 3) == 0:
			draw_building_fire_escape(x, width, building_top, building_bottom, stories, floor_height)

		draw_building_rooftop_details(x, width, building_top, wall_tile)

		draw_building_utility_details(x, width, building_top, building_bottom, wall_tile)

	draw_colored_polygon(PackedVector2Array([Vector2(x, building_top), Vector2(x + 18, building_top + 14), Vector2(x + 18, building_bottom), Vector2(x, building_bottom)]), color.darkened(0.42))
	draw_polyline(PackedVector2Array([Vector2(x, building_top), Vector2(x + 18, building_top + 14), Vector2(x + 18, building_bottom)]), Color.BLACK, 1.5)
	draw_colored_polygon(PackedVector2Array([Vector2(x + width, building_top), Vector2(x + width - 18, building_top + 14), Vector2(x + width - 18, building_bottom), Vector2(x + width, building_bottom)]), color.darkened(0.48))
	draw_polyline(PackedVector2Array([Vector2(x + width, building_top), Vector2(x + width - 18, building_top + 14), Vector2(x + width - 18, building_bottom)]), Color.BLACK, 1.5)

	var door_variant: = posmod(wall_tile + 3, 9)
	if "HOSPITAL" in label or "CONSEQUENCE" in label: door_variant = 2
	elif "PUBLIC REASSURANCE" in label: door_variant = 8
	elif building_id == "apartment": door_variant = 1
	elif "PAWN" in label: door_variant = 3
	var exterior_door_rect: = Rect2(center_x - offset - EXTERIOR_DOOR_WIDTH * 0.5, 438.0 - EXTERIOR_DOOR_HEIGHT, EXTERIOR_DOOR_WIDTH, EXTERIOR_DOOR_HEIGHT)
	if building_id == "social":
		draw_social_exterior_door(exterior_door_rect)
	else:
		draw_exterior_door_leaf(exterior_door_rect, door_variant)

	if posmod(wall_tile, 3) == 1:
		draw_building_bush(x, width, wall_tile)

	var sign_rect: = Rect2(center_x - offset - 126, maxf(76.0, building_top - 68.0), 252, 61)
	draw_rect(sign_rect.grow(2), Color(0, 0, 0, 0.35))
	draw_rect(sign_rect, Color(0.03, 0.032, 0.035, 0.92))
	draw_rect(sign_rect, color.lightened(0.2), false, 2.0)

	var lines: = label.split("\n")
	for index in range(lines.size()):
		var text_pos: = Vector2(center_x - offset, sign_rect.position.y + 27 + index * 20)
		draw_centered(String(lines[index]), text_pos + Vector2(1, 1), 15, Color(0, 0, 0, 0.5))
		draw_centered(String(lines[index]), text_pos, 15, PAPER)

