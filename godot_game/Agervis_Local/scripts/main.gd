func draw_fixture_stock_shelving(rect: Rect2, modulate: Color) -> void :
	var frame: = Color("#6d7375") * modulate
	draw_rect(rect, frame.darkened(0.42))
	draw_rect(rect, frame, false, 2.0)
	var decks: = 4
	var deck_h: = (rect.size.y - 10.0) / float(decks)
	for deck in range(decks):
		var shelf_y: = rect.position.y + 6.0 + float(deck + 1) * deck_h

		var slot_x: = rect.position.x + 6.0
		var slot: = 0
		while slot_x < rect.end.x - 12.0:
			var seed: = posmod(deck * 37 + slot * 23, 100)
			var box_w: = 12.0 + float(seed % 3) * 5.0
			if slot_x + box_w > rect.end.x - 6.0:
				break
			var box_h: = deck_h * (0.5 + float(seed % 4) * 0.09)
			var tint: = Color("#a8563f")
			match posmod(seed, 5):
				1: tint = Color("#c39b4a")
				2: tint = Color("#4d7a86")
				3: tint = Color("#8a8f7a")
				4: tint = Color("#9c5d78")
			draw_rect(Rect2(slot_x, shelf_y - box_h, box_w, box_h), tint * modulate)
			if not low_spec:

				draw_rect(Rect2(slot_x + 1.0, shelf_y - box_h * 0.6, box_w - 2.0, 3.0), 
					(tint * modulate).lightened(0.4))
				draw_line(Vector2(slot_x + 1.0, shelf_y - box_h + 1.0), Vector2(slot_x + 1.0, shelf_y - 1.0), 
					Color(1, 1, 1, 0.12), 1.0)
			slot_x += box_w + 3.0
			slot += 1
		draw_rect(Rect2(rect.position.x + 2.0, shelf_y, rect.size.x - 4.0, 4.0), frame.lightened(0.16))
		draw_line(Vector2(rect.position.x + 2.0, shelf_y), Vector2(rect.end.x - 2.0, shelf_y), Color(1, 1, 1, 0.16), 1.0)

		if not low_spec:
			draw_rect(Rect2(rect.position.x + 4.0, shelf_y + 4.0, rect.size.x - 8.0, 3.0), Color("#e2dcc8") * modulate)

	draw_rect(Rect2(rect.position.x, rect.position.y, 5.0, rect.size.y), frame)
	draw_rect(Rect2(rect.end.x - 5.0, rect.position.y, 5.0, rect.size.y), frame)
	draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, 8.0), frame.lightened(0.2))
	draw_rect(Rect2(rect.position.x + 6.0, rect.position.y + 2.0, rect.size.x - 12.0, 4.0), Color("#b8452f") * modulate)


func draw_fixture_drink_cooler(rect: Rect2, modulate: Color) -> void :
	var shell: = Color("#4a5153") * modulate
	draw_rect(rect, shell)
	draw_rect(rect, shell.darkened(0.4), false, 2.0)

	var header: = Rect2(rect.position.x + 3.0, rect.position.y + 3.0, rect.size.x - 6.0, 15.0)
	draw_rect(header, Color("#2c4c56") * modulate)
	draw_rect(Rect2(header.position.x + 3.0, header.position.y + 4.0, header.size.x - 6.0, 6.0), Color("#8fd4e0") * modulate)
	var glass: = Rect2(rect.position.x + 6.0, header.end.y + 4.0, rect.size.x - 12.0, rect.end.y - header.end.y - 16.0)
	draw_rect(glass, Color("#1f2b2d") * modulate)
	var decks: = 4
	var deck_h: = glass.size.y / float(decks)
	for deck in range(decks):
		var shelf_y: = glass.position.y + float(deck + 1) * deck_h
		if not low_spec:
			var can_x: = glass.position.x + 4.0
			while can_x < glass.end.x - 8.0:
				var seed: = posmod(deck * 41 + int(can_x), 100)
				var tint: = Color("#c4453a")
				match posmod(seed, 4):
					1: tint = Color("#2f6fa8")
					2: tint = Color("#3f8f56")
					3: tint = Color("#c9a03c")
				var can_h: = deck_h * 0.62
				draw_rect(Rect2(can_x, shelf_y - can_h - 2.0, 7.0, can_h), tint * modulate)

				draw_line(Vector2(can_x + 2.0, shelf_y - can_h - 1.0), Vector2(can_x + 2.0, shelf_y - 3.0), 
					Color(1, 1, 1, 0.2), 1.0)
				draw_line(Vector2(can_x + 6.0, shelf_y - can_h - 1.0), Vector2(can_x + 6.0, shelf_y - 3.0), 
					Color(0, 0, 0, 0.2), 1.0)
				can_x += 9.0
		draw_rect(Rect2(glass.position.x + 1.0, shelf_y - 2.0, glass.size.x - 2.0, 2.0), Color("#8b9294") * modulate)

	draw_rect(glass, shell.lightened(0.22), false, 2.0)
	draw_rect(Rect2(glass.get_center().x - 1.0, glass.position.y, 2.0, glass.size.y), shell.lightened(0.16))
	draw_line(glass.position + Vector2(4.0, glass.size.y - 6.0), glass.position + Vector2(glass.size.x * 0.62, 6.0), 
		Color(1, 1, 1, 0.13), 5.0)
	draw_rect(Rect2(glass.get_center().x - 8.0, glass.position.y + glass.size.y * 0.4, 5.0, 26.0), Color("#aab1b2") * modulate)
	draw_rect(Rect2(rect.position.x + 4.0, rect.end.y - 12.0, rect.size.x - 8.0, 9.0), shell.darkened(0.24))


func draw_fixture_jersey_wall(rect: Rect2, modulate: Color) -> void :
	var board: = Color("#7c705f") * modulate
	draw_rect(rect, board)
	draw_rect(rect, board.darkened(0.34), false, 1.0)
	if not low_spec:
		var slat_y: = rect.position.y + 8.0
		while slat_y < rect.end.y - 6.0:
			draw_line(Vector2(rect.position.x + 3.0, slat_y), Vector2(rect.end.x - 3.0, slat_y), board.darkened(0.2), 1.0)
			slat_y += 9.0

	var rail_y: = rect.position.y + rect.size.y * 0.2
	draw_rect(Rect2(rect.position.x + 4.0, rail_y, rect.size.x - 8.0, 3.0), Color("#9ba2a3") * modulate)
	var count: = 3
	var slot_w: = (rect.size.x - 14.0) / float(count)
	for shirt in range(count):
		var cx: = rect.position.x + 7.0 + slot_w * (float(shirt) + 0.5)
		var tint: = Color("#3f5f97")
		match posmod(shirt, 3):
			1: tint = Color("#a8382f")
			2: tint = Color("#d6cfbb")
		tint *= modulate
		var body_top: = rail_y + 9.0
		var body_h: = rect.size.y * 0.46
		var half: = slot_w * 0.34

		draw_arc(Vector2(cx, rail_y + 4.0), 4.0, PI, TAU, 8, Color("#b6bcbc") * modulate, 1.5)
		var shoulders: = PackedVector2Array([
			Vector2(cx - half, body_top + 5.0), 
			Vector2(cx - half * 0.45, body_top), 
			Vector2(cx + half * 0.45, body_top), 
			Vector2(cx + half, body_top + 5.0), 
			Vector2(cx + half * 0.8, body_top + body_h), 
			Vector2(cx - half * 0.8, body_top + body_h), 
		])
		draw_colored_polygon(shoulders, tint)

		draw_colored_polygon(PackedVector2Array([
			Vector2(cx - half, body_top + 5.0), 
			Vector2(cx - half * 1.35, body_top + 16.0), 
			Vector2(cx - half * 0.95, body_top + 22.0), 
			Vector2(cx - half * 0.7, body_top + 9.0), 
		]), tint.darkened(0.14))
		draw_colored_polygon(PackedVector2Array([
			Vector2(cx + half, body_top + 5.0), 
			Vector2(cx + half * 1.35, body_top + 16.0), 
			Vector2(cx + half * 0.95, body_top + 22.0), 
			Vector2(cx + half * 0.7, body_top + 9.0), 
		]), tint.darkened(0.14))
		if not low_spec:

			draw_arc(Vector2(cx, body_top + 2.0), 6.0, 0.2, PI - 0.2, 8, tint.lightened(0.35), 2.0)
			draw_rect(Rect2(cx - 6.0, body_top + body_h * 0.34, 12.0, 14.0), tint.lightened(0.45))
			draw_rect(Rect2(cx - 3.0, body_top + body_h * 0.34 + 3.0, 6.0, 8.0), tint.darkened(0.4))
			draw_line(Vector2(cx + half * 0.3, body_top + 8.0), Vector2(cx + half * 0.34, body_top + body_h - 2.0), 
				Color(0, 0, 0, 0.12), 3.0)

	var shelf_y: = rect.end.y - 16.0
	draw_rect(Rect2(rect.position.x + 4.0, shelf_y, rect.size.x - 8.0, 4.0), board.lightened(0.2))
	for pile in range(2):
		var px: = rect.position.x + 12.0 + float(pile) * (rect.size.x - 46.0)
		for layer in range(3):
			var tint2: = Color("#6d7f9a") if posmod(layer + pile, 2) == 0 else Color("#9a8272")
			draw_rect(Rect2(px, shelf_y - 4.0 - float(layer) * 4.0, 26.0, 4.0), tint2 * modulate)


