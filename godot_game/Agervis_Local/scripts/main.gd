				"interactive": false, "solid_rect": Rect2(750, 225, 145, 52), 
			})
	return records

func current_room_object_record_for_action(action_id: String) -> Dictionary:
	for record in current_room_object_records():
		if String(record.get("action_id", "")) == action_id:
			return record
	return {}

func nearest_room_owned_interaction() -> Dictionary:
	var best: Dictionary = {}
	var best_distance: = INF
	for record in current_room_object_records():
		if not bool(record.get("interactive", false)):
			continue
		var point: = record.get("position", Vector2.ZERO) as Vector2
		var distance: = player_position.distance_to(point)
		if distance <= float(record.get("radius", 80.0)) and distance < best_distance:
			best = record
			best_distance = distance
	return best

