func contextual_action_label() -> String:
	var prompt: = current_prompt().to_lower()
	if prompt.is_empty(): return "USE"
	if prompt.begins_with("speak") or prompt.begins_with("hear") or prompt.begins_with("deal with"): return "TALK"
	if prompt.begins_with("enter"): return "ENTER"
	if prompt.begins_with("exit") or prompt.begins_with("return"): return "EXIT"
	if "stash" in prompt or "safe" in prompt: return "OPEN"
	if prompt.begins_with("inspect") or prompt.begins_with("review"): return "READ"
	if prompt.begins_with("deposit"): return "DEPOSIT"
	if "work" in prompt or "assignment" in prompt or "patrol" in prompt: return "WORK"
	if "endurance" in prompt or "weighted supply cart" in prompt or "stair-step" in prompt: return "TRAIN"
	if "disposition dummy" in prompt: return "PRACTICE"
	if prompt.begins_with("climb") or prompt.begins_with("cross practice") or prompt.begins_with("vault practice") or "parkour" in prompt or "fire escape" in prompt: return "CLIMB"
	if "blood" in prompt: return "COLLECT"
	return "USE"

func nearby_context_hotspot() -> Dictionary:
	var actor: = nearest_actor(105.0, true)
	if actor != null:
		var actor_owner: = RoomObjects.room_key(area, room_id) if current_room_is_authored() else area
		return {
			"point": actor.position, "label": actor.display_name, "kind": "actor", 
			"object_id": "actor.runtime", "instance_id": "%s/actor:%s" % [actor_owner, actor.actor_id], 
			"graphic_id": "character.runtime.%s.v1" % actor.actor_id, "owner_room": actor_owner, 


			"stature": actor.stature, 
		}
	var best: Dictionary = {}
	var best_distance: = INF
	for hotspot in hotspots_for_area():
		if String(hotspot.get("kind", "")) == "door":
			continue
		var point: = hotspot["point"] as Vector2
		var distance: = player_position.distance_to(point)
		var in_range: = distance < float(hotspot.get("radius", 128.0))
		if in_range and distance < best_distance:
			best_distance = distance
			best = hotspot
	return best

func contextual_prompt_hotspot() -> Dictionary:
	return nearby_context_hotspot()

func contextual_prompt_rect() -> Rect2:
	if mode != ScreenMode.PLAY:
		return Rect2()
	var hotspot: = contextual_prompt_hotspot()
	if hotspot.is_empty() or current_prompt().is_empty():
		return Rect2()
	var point: = scene_position(hotspot["point"] as Vector2)
	var hotspot_kind: = String(hotspot.get("kind", ""))
	if hotspot_kind == "door" and area not in ["street", "rear", "rooftop"]:
		point.y = ARCH_FLOOR_Y - AUTHORED_DOOR_HEIGHT - 24.0
	elif hotspot_kind == "climb":
		point.y -= 150.0
	elif String(hotspot.get("action_id", "")) == "endurance_station":
		point.y -= 130.0
	elif hotspot_kind in ["actor", "npc"]:




		var stature: = String(hotspot.get("stature", "average"))
		if hotspot.has("render_scale"):


			point.y -= actor_prompt_lift_with_scale(point.y, stature, float(hotspot["render_scale"]))
		else:

			point.y -= actor_prompt_lift(point.y, stature)
	else:
		point.y -= 92.0
	return Rect2(point - Vector2(48, 25), Vector2(96, 50))

