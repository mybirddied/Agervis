func controller_menu_hints() -> Array[Dictionary]:
	match mode:
		ScreenMode.SHOP:
			if barber_preview_active:
				return [{"button": "dpad_up", "label": "CATEGORY"}, {"button": "dpad_left", "label": "PREVIEW"}, {"button": "l1", "label": "PAYMENT"}, {"button": "face_south", "label": "CONFIRM"}, {"button": "face_east", "label": "CANCEL"}]
			return [{"button": "dpad_up", "label": "CHOOSE"}, {"button": "dpad_left", "label": "AMOUNT"}, {"button": "l1", "label": "PAYMENT"}, {"button": "face_south", "label": "BUY"}, {"button": "face_west", "label": "SELL"}, {"button": "face_east", "label": "CLOSE"}]
		ScreenMode.STORAGE:
			return [{"button": "dpad_up", "label": "ITEM"}, {"button": "dpad_left", "label": "PANEL"}, {"button": "face_south", "label": "MOVE"}, {"button": "face_east", "label": "CLOSE"}]
		ScreenMode.EQUIPMENT:
			return [{"button": "dpad_up", "label": "ITEM"}, {"button": "l1", "label": "PANEL"}, {"button": "face_south", "label": "ACTION"}, {"button": "face_east", "label": "CLOSE"}]
		ScreenMode.QUIZ:
			return [{"button": "face_south", "label": "ANSWERS 1-4"}, {"button": "dpad_up", "label": "ANSWERS 5-8"}]
		ScreenMode.DIALOG:
			return [{"button": "dpad_up", "label": "CHOOSE"}, {"button": "face_south", "label": "SELECT"}, {"button": "face_east", "label": "CLOSE"}]
	return [{"button": "dpad_up", "label": "NAVIGATE"}, {"button": "face_south", "label": "SELECT"}, {"button": "face_east", "label": "BACK"}]

func draw_controller_hint_row(items: Array, center_y: float, center_x: float = 640.0, icon_size: float = 24.0, text_size: int = 11) -> void :
	if items.is_empty():
		return
	var widths: Array[float] = []
	var total_width: = 0.0
	for item_value in items:
		var item: Dictionary = item_value
		var label: = String(item.get("label", ""))
		var item_width: = icon_size + 6.0 + font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, text_size).x + 18.0
		widths.append(item_width)
		total_width += item_width
	var x: = center_x - total_width * 0.5
	for index in range(items.size()):
		var item: Dictionary = items[index]
		draw_controller_icon(Vector2(x + icon_size * 0.5, center_y), icon_size, String(item.get("button", "face_south")))
		draw_text(String(item.get("label", "")), Vector2(x + icon_size + 6.0, center_y + float(text_size) * 0.38), text_size, PAPER)
		x += widths[index]

func draw_contingency_pouch() -> void :
	var rect: = Rect2(742, 570, 280, 51) if mobile_controls_enabled else Rect2(898, 566, 354, 55)
	draw_rect(rect, Color(0.035, 0.038, 0.042, 0.91))
	draw_rect(rect, ACCENT.darkened(0.35), false, 2.0)
