	var director: Dictionary = Dictionary(task_directors.get("first_block_security", {}))
	if String(director.get("state", "")) != "assigned":
		choose_next_security_assignment()
		director = Dictionary(task_directors.get("first_block_security", {}))
	return String(director.get("task", "")) == checkpoint
