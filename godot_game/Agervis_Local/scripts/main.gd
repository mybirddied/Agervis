func open_lan_menu(previous_mode: int = ScreenMode.TITLE) -> void :
	if OS.has_feature("web"):
		release_notice = "BROWSER EDITION IS OFFLINE - USE LOCAL TEST WORLD"
		if previous_mode == ScreenMode.GAME_MENU:
			game_menu_status = "BROWSER EDITION CANNOT USE UDP - LOCAL RESIDENT REMAINS PLAYABLE"
		queue_redraw()
		return
	lan_menu_return_mode = previous_mode
	menu_cursor = 0
	lan_input_target = ""
	lan_status = lan_session.status
	mode = ScreenMode.LAN

func close_lan_menu() -> void :
	DisplayServer.virtual_keyboard_hide()
	lan_input_target = ""
	lan_session.stop_nearby_discovery()
	mode = lan_menu_return_mode

func handle_lan_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		close_lan_menu()
	elif key.keycode == KEY_UP:
		menu_cursor = posmod(menu_cursor - 1, lan_menu_options().size())
	elif key.keycode == KEY_DOWN or key.keycode == KEY_TAB:
		menu_cursor = posmod(menu_cursor + 1, lan_menu_options().size())
	elif key.keycode == KEY_ENTER:
		activate_lan_menu_selection()
	elif key.keycode == KEY_BACKSPACE and not lan_input_target.is_empty():
		if lan_input_target == "invite": lan_join_invite = lan_join_invite.left(maxi(0, lan_join_invite.length() - 1))
		else: lan_join_address = lan_join_address.left(maxi(0, lan_join_address.length() - 1))
	elif key.unicode >= 32 and not lan_input_target.is_empty():
		if lan_input_target == "invite": lan_join_invite = (lan_join_invite + char(key.unicode)).left(160)
		elif char(key.unicode) in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-:": lan_join_address = (lan_join_address + char(key.unicode)).left(80)

func lan_option_rect(index: int) -> Rect2:
	return Rect2(165, 210 + index * 52, 390, 43)

func handle_lan_pointer(point: Vector2) -> void :
	for index in range(lan_menu_options().size()):
		if lan_option_rect(index).has_point(point):
			menu_cursor = index
			activate_lan_menu_selection()
			return
	for index in range(mini(4, lan_nearby_hosts.size())):
		if Rect2(595, 365 + index * 45, 500, 38).has_point(point):
			lan_nearby_cursor = index
			start_nearby_join()
			return
	if Rect2(595, 277, 500, 55).has_point(point) and lan_session.hosting:
		copy_host_invite()

func activate_lan_menu_selection() -> void :
	var options: = lan_menu_options()
	menu_cursor = clampi(menu_cursor, 0, options.size() - 1)
	match options[menu_cursor]:
		"TEST THIS DEVICE":
			lan_report = lan_session.test_local_connection(LAN_PORT)
			lan_status = String(lan_report.get("summary", "TEST COMPLETE"))
		"JOIN MAIN SERVER": start_main_server_join()
		"HOST PRIVATE GAME": start_lan_host()
		"FIND / JOIN NEARBY":
			if lan_nearby_hosts.is_empty():
				var result: Error = lan_session.begin_nearby_discovery()
				if result == OK: lan_status = "SCANNING THIS WI-FI  -  WAIT A MOMENT, THEN PRESS AGAIN"
			else: start_nearby_join()
		"JOIN WITH INVITE":
			if lan_join_invite.strip_edges().is_empty():
				lan_input_target = "invite"
				lan_status = "PASTE OR TYPE THE HOST'S AGV10 INVITE, THEN PRESS JOIN AGAIN"
				DisplayServer.virtual_keyboard_show(lan_join_invite)
			else: start_invite_join()
		"ADVANCED: MANUAL ADDRESS":
			if lan_input_target != "address":
				lan_input_target = "address"
				lan_status = "ADVANCED MODE - TYPE HOSTNAME OR IP, OPTIONAL :PORT, THEN PRESS AGAIN"
				DisplayServer.virtual_keyboard_show(lan_join_address)
			else: start_manual_join()
		"COPY HOST INVITE": copy_host_invite()
		"BACK": close_lan_menu()

