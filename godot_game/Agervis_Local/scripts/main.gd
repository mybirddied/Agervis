	var slot_width: = 129.0 if mobile_controls_enabled else 161.0
	var slot_gap: = 134.0 if mobile_controls_enabled else 168.0
	for slot in range(max_contingencies):
		var item: = contingencies[slot] if slot < contingencies.size() else "EMPTY"
		var slot_rect: = Rect2(rect.position.x + 7 + slot * slot_gap, rect.position.y + 21, slot_width, 23)
		var slot_filled: = slot < contingencies.size()

		draw_rect(slot_rect, Color("#24282b"))
		draw_rect(slot_rect, GOOD.darkened(0.2) if slot_filled else Color("#55534f"), false, 1.0)
		if not low_spec and slot_filled:

			draw_rect(slot_rect.grow(1), GOOD.darkened(0.5), false, 1.0)
		draw_text("%d  %s" % [slot + 1, item.left(14 if mobile_controls_enabled else 19)], slot_rect.position + Vector2(6, 16), 10 if mobile_controls_enabled else 11, PAPER)

func counted_items(items: Array[String]) -> String:
	if items.is_empty(): return "empty"
	var order: Array[String] = []
	var counts: Dictionary = {}
	for item in items:
		if item not in counts: order.append(item)
		counts[item] = int(counts.get(item, 0)) + 1
	var result: Array[String] = []
	for item in order: result.append(item + ("x%d" % int(counts[item]) if int(counts[item]) > 1 else ""))
	return ", ".join(result)

func draw_bar(point: Vector2, width: float, ratio: float, color: Color, label: String) -> void :

	draw_rect(Rect2(point, Vector2(width, 15)), Color("#27292b"))
	draw_rect(Rect2(point, Vector2(width, 15)), Color.BLACK, false, 1.5)

	var filled_width: = width * clampf(ratio, 0.0, 1.0)
	if filled_width > 0:
		draw_rect(Rect2(point, Vector2(filled_width, 15)), color)
		if not low_spec:

			draw_rect(Rect2(point.x + 2, point.y + 2, max(0, filled_width - 4), 5), color.lightened(0.2))

			if filled_width < width:
				draw_line(Vector2(point.x + filled_width, point.y), Vector2(point.x + filled_width, point.y + 15), color.darkened(0.3), 2)
	draw_text(label, point + Vector2(5, 12), 10, PAPER)

func current_prompt() -> String:
	if player_downed:
		return "DOWNED  -  awaiting intervention"
	if player_detained:
		return "TEMPORARILY DETAINED  -  awaiting review"
	if not endurance_training.is_empty():
		return "complete timed endurance drill"
	if not active_blood_cleaning.is_empty():
		return "cancel blood cleaning"
	if area in ["rear", "rooftop"]:
		for route in parkour_routes():
			if parkour_route_can_activate(route): return "climb " + String(route["name"]).to_lower()
	var nearby_blood: = nearest_blood_evidence()
	if not nearby_blood.is_empty():
		return "collect blood sample" if "Test Tube" in inventory else "inspect blood evidence"
	var actor: = nearest_actor(86.0, true)
	if actor != null:
		return "deal with %s" % actor.display_name
	var room_interaction: = nearest_room_owned_interaction()
	if not room_interaction.is_empty():
		match String(room_interaction.get("action_id", "")):
			"tutorial_counselor": return "talk to Ms. Vale"
			"tutorial_pike": return "hear Officer Pike"
			"tutorial_detainee": return "hear the restrained guest"
			"tutorial_student_guide": return "talk to hallway student"
			"tutorial_doz": return "talk to Doz"
			"tutorial_controls_coach": return "talk to movement coach"
			"school_teacher": return "speak with " + String(room_interaction.get("label", "classroom teacher")).to_lower()
