func handle_phone_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		close_phone()
	elif key.keycode in [KEY_TAB, KEY_LEFT]:
		phone_tab = posmod(phone_tab - 1, phone_tab_count())
		phone_cursor = 0
	elif key.keycode == KEY_RIGHT:
		phone_tab = posmod(phone_tab + 1, phone_tab_count())
		phone_cursor = 0
	elif key.keycode == KEY_UP:
		phone_cursor = maxi(0, phone_cursor - 1)
	elif key.keycode == KEY_DOWN:
		phone_cursor = mini(phone_visible_count() - 1, phone_cursor + 1)

