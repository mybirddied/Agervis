func make_job_contract(employer: String, employer_id: String, required_credential: String, pay_min: int, pay_max: int, deposit_bonus: int, required_tasks: Array[String], threshold_seconds: float, trust: int = 0) -> Dictionary:
	var completed: Dictionary = {}
	for task_name in required_tasks:
		completed[task_name] = false
	return {
		"employer": employer, 
		"employer_id": employer_id, 
		"required_credential": required_credential, 
		"pay_range": {"min": pay_min, "max": pay_max, "deposit_bonus": deposit_bonus}, 
		"task_state": {"required": required_tasks.duplicate(), "completed": completed, "active": "", "shift_complete": false}, 
		"attendance": {"on_site_seconds": 0.0, "away_seconds": 0.0, "warning_stage": 0, "last_employer_text": ""}, 
		"trust": trust, 
		"firing_threshold": {"absence_seconds": threshold_seconds, "trust_min": 20}, 
		"status": "active", 
	}

