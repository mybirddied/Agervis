func choose_next_security_assignment() -> void :
	if active_job != "Security Guard" or not on_duty:
		return
	var director: Dictionary = Dictionary(task_directors.get("first_block_security", {})).duplicate(true)
	if String(director.get("state", "")) == "assigned" and String(director.get("owner", "")) == player_name:
		sync_security_contract()
		return
	var available: Array[String] = []
	for checkpoint_variant in security_checkpoints.keys():
		var checkpoint: = String(checkpoint_variant)
		if not bool(security_checkpoints.get(checkpoint, false)):
			available.append(checkpoint)
	if available.is_empty():
		sync_security_contract()
		return
	if available.size() > 1 and last_security_checkpoint in available:
		available.erase(last_security_checkpoint)
	available.shuffle()
	var target: = available[0]
	task_directors["first_block_security"] = {"owner": player_name, "task": target, "variation": rng.randi_range(0, 2), "state": "assigned", "generation": int(director.get("generation", 0)) + 1, "issued_at": elapsed}
	objective = "Security patrol: reach the assigned %s check without leaving the contract behind." % target
	sync_security_contract()
	notify("SECURITY ASSIGNMENT - PATROL %s" % target.to_upper(), ACCENT, 2.8)

func security_checkpoint_is_current(checkpoint: String) -> bool:
