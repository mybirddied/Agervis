	draw_rect(Rect2(lamp_center.x - lamp_width * 0.5, lamp_center.y - lamp_height * 0.5, lamp_width, lamp_height), Color.BLACK, false, 1.5)


	var lens_rect: = Rect2(lamp_center.x - lamp_width * 0.35, lamp_center.y + 2, lamp_width * 0.7, lamp_height * 0.45)
	var is_lit: = (variant + int(world_x / 100.0)) % 4 != 0
	var lens_color: = Color("#ffefc4", 0.65) if is_lit else Color("#3a3d3f", 0.4)
	draw_rect(lens_rect, lens_color)

	if is_lit and not low_spec:

		draw_circle(lamp_center + Vector2(0, 8), 16.0, Color("#ffe8a8", 0.12))
