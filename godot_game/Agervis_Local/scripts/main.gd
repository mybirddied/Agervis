func handle_pointer_click(screen_point: Vector2, secondary: bool) -> void :
	if mode != ScreenMode.PLAY: click_move_active = false
	match mode:
		ScreenMode.PLAY:
			if mobile_touch_controls_active() and handle_mobile_control_press(screen_point): return
			if secondary: open_context_menu(screen_point)
			else: begin_pointer_walk(screen_point, true)
		ScreenMode.SAFETY_NOTICE:
			advance_from_safety_notice()
		ScreenMode.OVERDOSE_AWARENESS:
			advance_from_overdose_awareness()
		ScreenMode.GAME_MENU:
			handle_game_menu_pointer(screen_point)
		ScreenMode.DIALOG:
			for index in range(dialog_options.size()):
				if dialog_option_rect(index).has_point(screen_point):
					handle_dialog_choice(String(dialog_options[index]["id"]))
					return

			var dialog_close_rect: = Rect2(170, 105, 940, 510)
			if dialog_options.is_empty() and dialog_close_rect.has_point(screen_point): mode = return_mode
		ScreenMode.QUIZ:
			var answers: Array = quiz_question.get("answers", [])
			for index in range(answers.size()):
				if quiz_option_rect(index).has_point(screen_point): submit_quiz_answer(index);return
		ScreenMode.CAMERA:
			handle_camera_pointer(screen_point)
		ScreenMode.DISPOSITION:
			for index in range(disposition_menu_options().size()):
				if disposition_option_rect(index).has_point(screen_point): activate_disposition_selection(index);return
		ScreenMode.JAIL_TASK:
			handle_jail_task_pointer(screen_point)
		ScreenMode.LAUNDRY_SORT:
			handle_laundry_sort_pointer(screen_point)
		ScreenMode.RECOVERY_GROUP:
			handle_recovery_group_pointer(screen_point)
		ScreenMode.CHAT:
			handle_chat_pointer(screen_point)
		ScreenMode.ADMIN_EDITOR:
			handle_admin_editor_pointer(screen_point)
		ScreenMode.DEATH:
			if Rect2(455, 505, 370, 62).has_point(screen_point): reset_to_title()
		ScreenMode.ARREST:
			if Rect2(365, 480, 260, 62).has_point(screen_point) and arrest_timer < 3.0: player_attack()
			elif Rect2(655, 480, 260, 62).has_point(screen_point): surrender_during_arrest()
		ScreenMode.ROSTER_DELETE:
			if Rect2(355, 474, 260, 56).has_point(screen_point): confirm_resident_deletion()
			elif Rect2(665, 474, 260, 56).has_point(screen_point): cancel_resident_deletion()
		ScreenMode.STORAGE:
			handle_storage_pointer(screen_point, secondary)
		ScreenMode.SHOP:
			handle_shop_pointer(screen_point, secondary)
		ScreenMode.EQUIPMENT:
			handle_equipment_pointer(screen_point)
		ScreenMode.SKILLS:
			handle_skills_pointer(screen_point)
		ScreenMode.PHONE:
			handle_phone_pointer(screen_point)
		ScreenMode.CONTEXT:
			for index in range(context_options.size()):
				if context_option_rect(index).has_point(screen_point): activate_context_option(index);return
			mode = ScreenMode.PLAY
		ScreenMode.TITLE:
			if Rect2(735, 555, 490, 48).has_point(screen_point):
				activate_title_primary()
			elif OS.has_feature("itch_release") and Rect2(985, 613, 240, 42).has_point(screen_point):
				toggle_low_spec()
			elif not OS.has_feature("itch_release") and Rect2(735, 613, 240, 42).has_point(screen_point):
				enter_local_test_world(false)
			elif not OS.has_feature("itch_release") and Rect2(985, 613, 240, 42).has_point(screen_point):
				toggle_low_spec()
		ScreenMode.LAN:
			handle_lan_pointer(screen_point)
		ScreenMode.FEEDBACK:
			handle_feedback_pointer(screen_point)
		ScreenMode.SUSPENSE:
			pass
		ScreenMode.ROSTER:
			var current_time: = Time.get_ticks_msec() / 1000.0
			for index in range(ReleaseSave.FREE_SLOTS):
				if Rect2(70, 145 + index * 91, 760, 72).has_point(screen_point):
					var is_double_click: = (current_time - roster_last_click_time) < 0.3 and roster_last_click_slot == index
					roster_cursor = index
					if is_double_click:
						activate_roster_selection()
						roster_last_click_time = 0.0
						roster_last_click_slot = -1
					else:
						release_notice = "RESIDENT FILE %d SELECTED  -  TAP THE PLAY BUTTON" % (index + 1)
						roster_last_click_time = current_time
						roster_last_click_slot = index
					return
			for premium_index in range(ReleaseSave.PREMIUM_SLOTS):
				var premium_slot: = ReleaseSave.FREE_SLOTS + premium_index
				if Rect2(875, 175 + premium_index * 120, 330, 92).has_point(screen_point):
					var is_double_click: = (current_time - roster_last_click_time) < 0.3 and roster_last_click_slot == premium_slot
					roster_cursor = premium_slot
					if is_double_click:
						activate_roster_selection()
						roster_last_click_time = 0.0
						roster_last_click_slot = -1
					else:
						release_notice = "PREMIUM SLOT RESERVED  -  MEMBERSHIP IS NOT SOLD IN THIS ALPHA"
						roster_last_click_time = current_time
						roster_last_click_slot = premium_slot
					return
			if roster_play_rect().has_point(screen_point): activate_roster_selection()
			elif roster_delete_rect().has_point(screen_point): request_resident_deletion()
			elif roster_back_rect().has_point(screen_point): leave_roster_to_title()
		ScreenMode.CREATION:
			if creation_stage == "name":
				if Rect2(126, 278, 700, 70).has_point(screen_point):
					DisplayServer.virtual_keyboard_show(creation_name)
					return
				if Rect2(126, 452, 330, 58).has_point(screen_point):
					confirm_creation_name()
					return
			elif creation_stage == "appearance":
				if Rect2(912, 588, 260, 52).has_point(screen_point):
					complete_character_creation()
					return

				for local_index in range(16):
					var index: = local_index + 1
					var column: = local_index / 8
					var row: = local_index % 8
					var field_rect: = Rect2(82 + column * 402, 181 + row * 42, 378, 36)
					var left_arrow_rect: = Rect2(field_rect.position.x + 330, field_rect.position.y + 8, 24, 20)
					var right_arrow_rect: = Rect2(field_rect.position.x + 356, field_rect.position.y + 8, 24, 20)

					if left_arrow_rect.has_point(screen_point):
						creation_field = index
						adjust_creation_field(-1)
						return
					elif right_arrow_rect.has_point(screen_point):
						creation_field = index
						adjust_creation_field(1)
						return
					elif field_rect.has_point(screen_point):
						creation_field = index
						return
			elif creation_stage == "confirm":
				if creation_confirm_button_rect().has_point(screen_point):
					commit_character_creation()
				elif creation_back_button_rect().has_point(screen_point):
					creation_stage = "appearance"
					creation_field = 1
					queue_redraw()

func begin_pointer_walk(screen_point: Vector2, interact_if_hotspot: bool) -> void :
	if player_detained or (player_arrested and area != "jail"):
		return

	if screen_point.y <= 70.0 or screen_point.y >= 628.0:
		return
	var hotspot: = hotspot_at_screen(screen_point)
	if not hotspot.is_empty():
		click_move_target = hotspot["point"] as Vector2


		click_interact_when_close = interact_if_hotspot and String(hotspot.get("kind", "")) != "door"
	else:
		click_move_target = clamp_position_to_area(screen_to_world(screen_point))
		click_interact_when_close = false
		if player_position_hits_solid(click_move_target):
			return
	click_move_target = clamp_position_to_area(click_move_target)
	click_move_active = true
	click_move_sprint = false

func screen_to_world(screen_point: Vector2) -> Vector2:
	var world_x: = screen_point.x + camera_offset_x() if area in ["street", "rear", "rooftop"] else screen_point.x - 130.0
	var world_y: = world_depth_for_screen_y(screen_point.y)
	return Vector2(world_x, world_y)

func hotspot_at_screen(screen_point: Vector2) -> Dictionary:
	if phase != "tutorial":
		for actor in actors:
			if actor.area == area and not actor.removed and scene_position(actor.position).distance_to(screen_point) <= 52.0:
				return {"point": actor.position, "label": actor.display_name, "kind": "actor"}
	for hotspot in hotspots_for_area():
		if scene_position(hotspot["point"] as Vector2).distance_to(screen_point) <= float(hotspot.get("radius", 58.0)):
			return hotspot
	return {}

func normalize_authored_room(area_name: String, candidate_room: String) -> String:
	if area_name not in Build10.ROOM_LAYOUTS:
		return ""
	candidate_room = normalize_legacy_school_room(area_name, candidate_room)
	if candidate_room in Build10.room_ids(area_name):
		return candidate_room
