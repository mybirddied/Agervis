			shadow_alpha = 0.7 * (1.0 - clampf(distance_into_fade / fade_distance, 0.0, 1.0))

		if shadow_alpha > 0.0:
			draw_filled_ellipse(Rect2(shadow_center.x - shadow_size.x / 2, shadow_center.y - shadow_size.y / 2, shadow_size.x, shadow_size.y), Color(0.05, 0.05, 0.05, shadow_alpha))

