func spawn_blood(point: Vector2, _kind: String = "impact", amount: int = 5) -> void :
	spawn_network_blood(point, area, room_id, amount, rng.randi(), home_instance_id)

func spawn_network_blood(point: Vector2, event_area: String, event_room: String, amount: int, seed_value: int, event_home_instance_id: String = "") -> void :
	if low_spec:
		amount = mini(amount, 3)
	var effect_rng: = RandomNumberGenerator.new()
	effect_rng.seed = seed_value
	for index in range(maxi(1, amount)):
		blood_effects.append({
			"area": event_area, 
			"room": event_room, 
			"home_instance_id": event_home_instance_id, 
			"position": point + Vector2(effect_rng.randf_range(-22.0, 22.0), effect_rng.randf_range(-12.0, 16.0)), 
			"radius": effect_rng.randf_range(2.5, 8.0), 
			"life": effect_rng.randf_range(8.0, 20.0), 
		})
	while blood_effects.size() > (34 if low_spec else 90):
		blood_effects.pop_front()

func update_blood(delta: float) -> void :
	for index in range(blood_effects.size() - 1, -1, -1):
		blood_effects[index]["life"] = float(blood_effects[index].get("life", 0.0)) - delta
		if float(blood_effects[index]["life"]) <= 0.0:
			blood_effects.remove_at(index)

func draw_blood_effects() -> void :
	for stain in blood_effects:
		if not room_effect_visible_in_current_room(stain):
			continue
		var point: = scene_position(stain.get("position", Vector2.ZERO) as Vector2)
		var alpha: = clampf(float(stain.get("life", 0.0)) / 4.0, 0.18, 0.78)
		draw_flat_ellipse(point + Vector2(0, 25), Vector2(float(stain.get("radius", 4.0)) * 1.8, float(stain.get("radius", 4.0)) * 0.62), Color(0.36, 0.015, 0.02, alpha))
	for evidence in blood_evidence_effects:
		if not room_effect_visible_in_current_room(evidence):
			continue
		var point: = evidence.get("position", Vector2.ZERO) as Vector2
		var effect_rng: = RandomNumberGenerator.new()
		effect_rng.seed = int(evidence.get("seed", 1))
		var amount: = mini(int(evidence.get("amount", 1)), 3 if low_spec else 12)
		for index in range(maxi(1, amount)):
			var stain_point: = point + Vector2(effect_rng.randf_range(-22.0, 22.0), effect_rng.randf_range(-12.0, 16.0))
			var radius: = effect_rng.randf_range(2.5, 8.0)
			draw_flat_ellipse(scene_position(stain_point) + Vector2(0, 25), Vector2(radius * 1.8, radius * 0.62), Color(0.36, 0.015, 0.02, 0.74))

func room_effect_visible_in_current_room(effect: Dictionary) -> bool:
	if String(effect.get("area", "")) != area or String(effect.get("room", "")) != room_id:
		return false
	if area == "apartment" and room_id == "unit":
		return not home_instance_id.is_empty() and String(effect.get("home_instance_id", "")) == home_instance_id
	return true

func body_evidence_visible_in_current_room(effect: Dictionary) -> bool:
