	var feed_mode: = camera_feed_mode(feed_id)
	var feed_tone: = GOOD if feed_mode == "LIVE" else DANGER
	draw_rect(Rect2(720, 105, 430, 48), Color("#111719"))
	draw_text("<  %s  >  Q%d  INPUT: %s" % [feed_id, camera_quality(feed_id), feed_mode], Vector2(738, 137), 14, feed_tone)
	var indices: = dvr_event_indices()
	if indices.is_empty():
		draw_text("NO RETAINED EVENTS FROM THIS RECORDER", Vector2(130, 215), 19, PAPER)
	else:
		var selected_position: = maxi(0, indices.find(camera_cursor))
		var start: = maxi(0, selected_position - 4)
		for display_index in range(start, mini(indices.size(), start + 8)):
			var global_index: = indices[display_index]
			var event: = camera_events[global_index]
			var selected: = global_index == camera_cursor
			var row: = Rect2(115, 185 + (display_index - start) * 42, 570, 36)
			draw_rect(row, Color("#5d8d7a") if selected else Color("#282f30"))
