		var beam_width_at_player: = beam_width_end + (beam_width_start - beam_width_end) * player_depth_ratio
		var beam_center_x: = beam_start.x
		if abs(player_screen_pos.x - beam_center_x) < beam_width_at_player / 2:
			player_blocks_light = true


	draw_rect(screen.grow(5), screen_frame)
