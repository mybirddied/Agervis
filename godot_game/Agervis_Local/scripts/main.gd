func draw_furniture_clinic_bed(rect: Rect2, modulate: Color) -> void :
	var frame: = Color("#939ea0") * modulate
	var sheet: = Color("#e6eded") * modulate
	var blanket: = Color("#7d97a2") * modulate
	var deck_y: = rect.position.y + rect.size.y * 0.44
	for leg in range(2):
		var lx: = rect.position.x + 14.0 + float(leg) * (rect.size.x - 36.0)
		draw_rect(Rect2(lx, deck_y + 24.0, 8.0, rect.end.y - deck_y - 30.0), frame.darkened(0.34))
		draw_circle(Vector2(lx + 4.0, rect.end.y - 6.0), 5.0, Color("#313536"))
		draw_circle(Vector2(lx + 4.0, rect.end.y - 6.0), 2.0, Color("#5d6263"))

	draw_rect(Rect2(rect.position.x + 12.0, deck_y + 20.0, rect.size.x - 26.0, 7.0), frame.darkened(0.22))
	var mattress: = Rect2(rect.position.x + 10.0, deck_y, rect.size.x - 22.0, 22.0)
	draw_rect(mattress, sheet)
	draw_rect(mattress, sheet.darkened(0.3), false, 1.0)

	var cover: = Rect2(mattress.position.x + mattress.size.x * 0.42, mattress.position.y + 3.0, 
		mattress.size.x * 0.58 - 2.0, mattress.size.y - 4.0)
	draw_rect(cover, blanket)
	draw_line(cover.position + Vector2(0.0, 4.0), Vector2(cover.end.x, cover.position.y + 4.0), blanket.lightened(0.22), 2.0)
	if not low_spec:
		for fold in range(3):
			var fx: = cover.position.x + 8.0 + float(fold) * (cover.size.x - 16.0) / 3.0
			draw_line(Vector2(fx, cover.position.y + 7.0), Vector2(fx, cover.end.y - 2.0), blanket.darkened(0.18), 1.0)

	var pillow: = Rect2(mattress.position.x + 6.0, mattress.position.y - 9.0, mattress.size.x * 0.3, 14.0)
	draw_rect(pillow, sheet.lightened(0.12))
	draw_rect(pillow, sheet.darkened(0.26), false, 1.0)

	draw_rect(Rect2(rect.position.x + 4.0, deck_y - 34.0, 8.0, 54.0), frame)
	draw_rect(Rect2(rect.position.x + 2.0, deck_y - 38.0, 26.0, 8.0), frame.lightened(0.14))
	draw_rect(Rect2(rect.end.x - 14.0, deck_y - 16.0, 8.0, 36.0), frame)
	draw_rect(Rect2(rect.end.x - 22.0, deck_y - 20.0, 22.0, 7.0), frame.lightened(0.14))

	var rail_y: = mattress.end.y - 2.0
	draw_rect(Rect2(mattress.position.x + 14.0, rail_y - 16.0, mattress.size.x * 0.52, 4.0), frame.lightened(0.1))
	draw_rect(Rect2(mattress.position.x + 14.0, rail_y - 5.0, mattress.size.x * 0.52, 4.0), frame.lightened(0.1))
	for post in range(2):
		var px: = mattress.position.x + 16.0 + float(post) * (mattress.size.x * 0.52 - 6.0)
		draw_rect(Rect2(px, rail_y - 16.0, 3.0, 15.0), frame.darkened(0.2))

	if not low_spec:
		draw_rect(Rect2(rect.end.x - 30.0, deck_y - 14.0, 13.0, 17.0), Color("#e9e4d5") * modulate)
		draw_rect(Rect2(rect.end.x - 30.0, deck_y - 14.0, 13.0, 4.0), Color("#8d9295") * modulate)



func draw_furniture_desk(rect: Rect2, modulate: Color, flavour: int) -> void :
	var body: = Color("#6f5c48")
	var top: = Color("#8a7259")
	match flavour:
		1:
			body = Color("#565d5f")
			top = Color("#6d7679")
		2:
			body = Color("#5f5a52")
			top = Color("#7d7668")
	body *= modulate
	top *= modulate
	var work_y: = rect.position.y + rect.size.y * 0.46

	var carcass: = Rect2(rect.position.x + 8.0, work_y + 8.0, rect.size.x - 16.0, rect.end.y - work_y - 12.0)
	draw_rect(carcass, body)
	draw_rect(carcass, body.darkened(0.34), false, 1.0)

	draw_rect(Rect2(carcass.position.x + 4.0, carcass.end.y - 9.0, carcass.size.x - 8.0, 9.0), body.darkened(0.42))
	var worktop: = Rect2(rect.position.x, work_y, rect.size.x, 10.0)
	draw_rect(worktop, top)
	draw_line(worktop.position, Vector2(worktop.end.x, worktop.position.y), top.lightened(0.28), 2.0)
	draw_line(Vector2(worktop.position.x, worktop.end.y), Vector2(worktop.end.x, worktop.end.y), top.darkened(0.4), 2.0)

	var bank: = Rect2(carcass.end.x - carcass.size.x * 0.4, carcass.position.y + 3.0, 
		carcass.size.x * 0.4 - 4.0, carcass.size.y - 14.0)
	for drawer in range(3):
		var dh: = bank.size.y / 3.0 - 3.0
		var dr: = Rect2(bank.position.x, bank.position.y + float(drawer) * (bank.size.y / 3.0), bank.size.x, dh)
		draw_rect(dr, body.lightened(0.1))
		draw_rect(dr, body.darkened(0.3), false, 1.0)
		draw_rect(Rect2(dr.get_center().x - 9.0, dr.get_center().y - 2.0, 18.0, 3.0), body.lightened(0.42))
	if not low_spec:
		draw_rect(Rect2(carcass.position.x + 5.0, carcass.position.y + 5.0, 
			carcass.size.x * 0.5, carcass.size.y - 18.0), body.darkened(0.12))
	match flavour:
		1:

			var screen: = Rect2(rect.position.x + rect.size.x * 0.14, work_y - 34.0, rect.size.x * 0.3, 26.0)
			draw_rect(screen.grow(2.0), Color("#2a2e2f") * modulate)
			draw_rect(screen, Color("#1d3b44") * modulate)
			draw_line(screen.position + Vector2(3.0, screen.size.y - 4.0), 
				screen.position + Vector2(screen.size.x * 0.55, 3.0), Color(1, 1, 1, 0.12), 3.0)
			draw_rect(Rect2(screen.get_center().x - 4.0, screen.end.y + 2.0, 8.0, 6.0), Color("#3a3f40") * modulate)
			draw_rect(Rect2(screen.get_center().x - 13.0, work_y - 3.0, 26.0, 3.0), Color("#3a3f40") * modulate)
			var pad: = Rect2(rect.end.x - rect.size.x * 0.38, work_y - 9.0, rect.size.x * 0.2, 8.0)
			draw_rect(pad, Color("#9fb0b4") * modulate)
			draw_rect(pad, Color("#4a5254") * modulate, false, 1.0)
		2:

			draw_line(Vector2(rect.position.x + 22.0, work_y), Vector2(rect.position.x + 22.0, work_y - 30.0), 
				Color("#4d5250") * modulate, 3.0)
			draw_line(Vector2(rect.position.x + 22.0, work_y - 30.0), Vector2(rect.position.x + 38.0, work_y - 34.0), 
				Color("#4d5250") * modulate, 3.0)
			draw_rect(Rect2(rect.position.x + 34.0, work_y - 36.0, 14.0, 7.0), Color("#c9ccc4") * modulate)
			draw_rect(Rect2(rect.position.x + 34.0, work_y - 29.0, 14.0, 3.0), Color("#f0e6b8") * modulate)
			for stack in range(3):
				draw_rect(Rect2(rect.end.x - 54.0 + float(stack), work_y - 5.0 - float(stack) * 4.0, 40.0, 4.0), 
					Color("#ddd6c2").darkened(float(stack) * 0.06) * modulate)
		_:

			draw_rect(Rect2(rect.position.x + rect.size.x * 0.2, work_y - 6.0, rect.size.x * 0.26, 6.0), 
				Color("#e3dcc7") * modulate)
			draw_rect(Rect2(rect.position.x + rect.size.x * 0.24, work_y - 9.0, rect.size.x * 0.2, 5.0), 
				Color("#efe9d8") * modulate)
			var plate: = Rect2(rect.end.x - rect.size.x * 0.34, work_y - 12.0, rect.size.x * 0.24, 11.0)
			draw_rect(plate, Color("#33373a") * modulate)
			draw_rect(Rect2(plate.position.x + 2.0, plate.position.y + 3.0, plate.size.x - 4.0, 3.0), 
				Color("#c2b98f") * modulate)



func draw_furniture_case_unit(rect: Rect2, modulate: Color, timber: bool) -> void :
	var body: = (Color("#7a6047") if timber else Color("#5b6365")) * modulate
	var face: = (Color("#8d7053") if timber else Color("#6d7679")) * modulate
	var carcass: = Rect2(rect.position.x + 6.0, rect.position.y + 8.0, rect.size.x - 12.0, rect.size.y - 12.0)
	draw_rect(carcass, body)
	draw_rect(carcass, body.darkened(0.36), false, 2.0)

	draw_rect(Rect2(rect.position.x + 2.0, rect.position.y + 2.0, rect.size.x - 4.0, 8.0), face.lightened(0.16))
	draw_rect(Rect2(carcass.position.x + 3.0, carcass.end.y - 8.0, carcass.size.x - 6.0, 8.0), body.darkened(0.3))
	var inner: = Rect2(carcass.position.x + 5.0, carcass.position.y + 11.0, carcass.size.x - 10.0, carcass.size.y - 23.0)
	if timber:

		for drawer in range(4):
			var dh: = inner.size.y / 4.0 - 3.0
			var dr: = Rect2(inner.position.x, inner.position.y + float(drawer) * (inner.size.y / 4.0), inner.size.x, dh)
			if drawer == 2:
				dr.position.x += 5.0
				draw_rect(Rect2(dr.position.x - 5.0, dr.position.y, 5.0, dr.size.y), Color("#241d18") * modulate)
			draw_rect(dr, face)
			draw_rect(dr, face.darkened(0.32), false, 1.0)
			draw_line(dr.position + Vector2(2.0, 2.0), Vector2(dr.end.x - 2.0, dr.position.y + 2.0), face.lightened(0.2), 1.0)
			draw_rect(Rect2(dr.get_center().x - 11.0, dr.get_center().y - 2.0, 22.0, 4.0), Color("#b39758") * modulate)
			if not low_spec:
				draw_rect(Rect2(dr.get_center().x - 11.0, dr.get_center().y + 2.0, 22.0, 2.0), Color("#77602f") * modulate)
	else:

		for side in range(2):
			var dw: = inner.size.x * 0.5 - 3.0
			var dr: = Rect2(inner.position.x + float(side) * (inner.size.x * 0.5 + 1.0), inner.position.y, dw, inner.size.y)
			draw_rect(dr, face)
			draw_rect(dr, face.darkened(0.3), false, 1.0)
			var mesh: = dr.grow(-5.0)
			draw_rect(mesh, Color("#23292a") * modulate)
			if not low_spec:
				var step: = 7.0
				var gx: = mesh.position.x + step
				while gx < mesh.end.x:
					draw_line(Vector2(gx, mesh.position.y), Vector2(gx, mesh.end.y), Color(1, 1, 1, 0.07), 1.0)
					gx += step
				var gy: = mesh.position.y + step
				while gy < mesh.end.y:
					draw_line(Vector2(mesh.position.x, gy), Vector2(mesh.end.x, gy), Color(1, 1, 1, 0.05), 1.0)
					gy += step

			draw_rect(Rect2(dr.position.x + 4.0, dr.position.y + 4.0, dr.size.x - 8.0, 8.0), Color("#d8d3c0") * modulate)
			draw_rect(Rect2(dr.position.x + 4.0, dr.position.y + 4.0, dr.size.x - 8.0, 8.0), face.darkened(0.3), false, 1.0)
		var hasp_y: = inner.get_center().y
		draw_rect(Rect2(inner.get_center().x - 5.0, hasp_y - 7.0, 10.0, 14.0), Color("#a8adad") * modulate)
		draw_arc(Vector2(inner.get_center().x, hasp_y + 8.0), 5.0, PI, TAU, 10, Color("#c6cbcb") * modulate, 2.0)
		draw_rect(Rect2(inner.get_center().x - 4.0, hasp_y + 8.0, 8.0, 8.0), Color("#7e8384") * modulate)


func draw_furniture_glass_case(rect: Rect2, modulate: Color) -> void :
	var frame: = Color("#4c443c") * modulate
	var glass: = Color("#2c3436") * modulate
	var base: = Rect2(rect.position.x + 4.0, rect.position.y + rect.size.y * 0.55, rect.size.x - 8.0, rect.size.y * 0.45 - 4.0)
	draw_rect(base, frame)
	draw_rect(base, frame.darkened(0.35), false, 1.0)
	draw_rect(Rect2(base.position.x + 4.0, base.end.y - 8.0, base.size.x - 8.0, 8.0), frame.darkened(0.42))

	var box: = Rect2(rect.position.x + 6.0, rect.position.y + 6.0, rect.size.x - 12.0, rect.size.y * 0.5)
	draw_rect(box, glass)
	draw_rect(box, frame.lightened(0.2), false, 3.0)

	draw_rect(Rect2(box.position.x + 5.0, box.position.y + 4.0, box.size.x - 10.0, 4.0), Color("#f2ecc8") * modulate)
	draw_rect(Rect2(box.position.x + 5.0, box.position.y + 8.0, box.size.x - 10.0, 5.0), Color(0.95, 0.92, 0.76, 0.16))

	var shelf_y: = box.position.y + box.size.y * 0.62
	draw_line(Vector2(box.position.x + 4.0, shelf_y), Vector2(box.end.x - 4.0, shelf_y), Color(1, 1, 1, 0.22), 2.0)
	if not low_spec:
		var slots: = 5
		for slot in range(slots):
			var cx: = box.position.x + 12.0 + float(slot) * (box.size.x - 24.0) / float(slots - 1)
			match posmod(slot, 3):
				0:
					draw_circle(Vector2(cx, shelf_y - 5.0), 3.5, Color("#d8c684") * modulate)
					draw_circle(Vector2(cx, shelf_y - 5.0), 1.6, glass.darkened(0.3))
				1:
					draw_rect(Rect2(cx - 5.0, shelf_y - 9.0, 10.0, 9.0), Color("#9aa3a6") * modulate)
					draw_rect(Rect2(cx - 3.0, shelf_y - 7.0, 6.0, 5.0), Color("#2f3a3d") * modulate)
				_:
					draw_rect(Rect2(cx - 7.0, shelf_y - 7.0, 14.0, 4.0), Color("#3f4446") * modulate)
					draw_rect(Rect2(cx - 2.0, shelf_y - 3.0, 5.0, 4.0), Color("#3f4446") * modulate)

	draw_line(box.position + Vector2(6.0, box.size.y - 6.0), box.position + Vector2(box.size.x * 0.5, 14.0), 
		Color(1, 1, 1, 0.12), 4.0)
	draw_line(box.position + Vector2(box.size.x * 0.5, box.size.y - 6.0), box.position + Vector2(box.size.x - 8.0, 16.0), 
		Color(1, 1, 1, 0.07), 3.0)


func draw_furniture_service_counter(rect: Rect2, modulate: Color) -> void :
	var body: = Color("#6a5344") * modulate
	var top: = Color("#8e8272") * modulate
	var counter_y: = rect.position.y + rect.size.y * 0.38
	var front: = Rect2(rect.position.x + 4.0, counter_y + 10.0, rect.size.x - 8.0, rect.end.y - counter_y - 14.0)
	draw_rect(front, body)
	draw_rect(front, body.darkened(0.36), false, 1.0)

	if not low_spec:
		var bx: = front.position.x + 12.0
		while bx < front.end.x - 6.0:
			draw_line(Vector2(bx, front.position.y + 3.0), Vector2(bx, front.end.y - 10.0), body.darkened(0.22), 1.0)
			bx += 12.0
	draw_rect(Rect2(front.position.x + 6.0, front.end.y - 12.0, front.size.x - 12.0, 4.0), Color("#a68a4f") * modulate)
	draw_rect(Rect2(front.position.x, counter_y, front.size.x, 12.0), top)
	draw_line(Vector2(front.position.x, counter_y), Vector2(front.end.x, counter_y), top.lightened(0.3), 2.0)
	draw_line(Vector2(front.position.x, counter_y + 12.0), Vector2(front.end.x, counter_y + 12.0), top.darkened(0.42), 2.0)

	var till: = Rect2(rect.position.x + rect.size.x * 0.58, counter_y - 24.0, rect.size.x * 0.26, 24.0)
	draw_rect(till, Color("#4a5052") * modulate)
	draw_rect(till, Color("#2c3132") * modulate, false, 1.0)
	draw_rect(Rect2(till.position.x + 3.0, till.position.y + 3.0, till.size.x - 6.0, 8.0), Color("#20383a") * modulate)
	if not low_spec:
		for key_row in range(2):
			for key in range(3):
				draw_rect(Rect2(till.position.x + 4.0 + float(key) * 7.0, till.position.y + 14.0 + float(key_row) * 5.0, 
					5.0, 3.0), Color("#9ba1a2") * modulate)

	draw_rect(Rect2(rect.position.x + 16.0, counter_y - 13.0, 16.0, 13.0), Color("#b9bdb6") * modulate)
	draw_rect(Rect2(rect.position.x + 38.0, counter_y - 17.0, 11.0, 17.0), Color("#d8d2c0") * modulate)

	var rail: = Rect2(rect.position.x + rect.size.x * 0.18, rect.position.y + 2.0, rect.size.x * 0.64, 20.0)
	draw_rect(rail, Color("#2f3634") * modulate)
	draw_rect(rail, Color("#575e5a") * modulate, false, 1.0)
	if not low_spec:
		for line in range(3):
			draw_rect(Rect2(rail.position.x + 5.0, rail.position.y + 4.0 + float(line) * 5.0, 
				rail.size.x * (0.7 - float(line) * 0.16), 3.0), Color("#e0d6a8") * modulate)


func draw_furniture_kitchen_range(rect: Rect2, modulate: Color) -> void :
	var steel: = Color("#7f8789") * modulate
	var dark: = Color("#4a5052") * modulate
	var hood: = Rect2(rect.position.x + 2.0, rect.position.y + 2.0, rect.size.x - 4.0, rect.size.y * 0.24)
	draw_rect(hood, steel.lightened(0.12))
	draw_rect(hood, dark, false, 1.0)

	draw_rect(Rect2(hood.position.x - 2.0, hood.end.y, hood.size.x + 4.0, 6.0), steel.lightened(0.26))
	draw_line(Vector2(hood.position.x - 2.0, hood.end.y), Vector2(hood.end.x + 2.0, hood.end.y), Color(1, 1, 1, 0.2), 1.0)
	if not low_spec:
		for baffle in range(4):
			var bx: = hood.position.x + 8.0 + float(baffle) * (hood.size.x - 16.0) / 4.0
			draw_rect(Rect2(bx, hood.position.y + 4.0, 6.0, hood.size.y - 8.0), dark.lightened(0.12))
	var body: = Rect2(rect.position.x + 8.0, rect.position.y + rect.size.y * 0.44, rect.size.x - 16.0, 
		rect.end.y - (rect.position.y + rect.size.y * 0.44) - 6.0)
	draw_rect(body, steel)
	draw_rect(body, dark, false, 1.0)

	var hob: = Rect2(body.position.x, body.position.y, body.size.x, 12.0)
	draw_rect(hob, dark.darkened(0.2))
	for burner in range(3):
		var cx: = hob.position.x + 14.0 + float(burner) * (hob.size.x - 28.0) / 2.0
		draw_circle(Vector2(cx, hob.get_center().y), 6.0, Color("#22282a") * modulate)
		draw_arc(Vector2(cx, hob.get_center().y), 4.0, 0.0, TAU, 12, Color("#d8792f") * modulate, 2.0)
	var oven: = Rect2(body.position.x + 5.0, hob.end.y + 5.0, body.size.x - 10.0, body.size.y - hob.size.y - 16.0)
	draw_rect(oven, steel.darkened(0.16))
	draw_rect(oven, dark, false, 1.0)
	draw_rect(Rect2(oven.position.x + 5.0, oven.position.y + 5.0, oven.size.x - 10.0, oven.size.y * 0.45), 
		Color("#2b3335") * modulate)
	draw_rect(Rect2(oven.position.x + 3.0, oven.end.y - 12.0, oven.size.x - 6.0, 4.0), steel.lightened(0.3))
	for knob in range(3):
		draw_circle(Vector2(oven.position.x + 12.0 + float(knob) * 14.0, oven.end.y - 4.0), 3.0, Color("#b8bdbd") * modulate)

	draw_rect(Rect2(hob.position.x + 8.0, hob.position.y - 13.0, 20.0, 13.0), Color("#9ba2a3") * modulate)
	draw_rect(Rect2(hob.position.x + 6.0, hob.position.y - 15.0, 24.0, 3.0), Color("#b6bcbc") * modulate)
	draw_rect(Rect2(hob.end.x - 30.0, hob.position.y - 10.0, 17.0, 10.0), Color("#8d9495") * modulate)

func draw_furniture_kitchen_cupboard(rect: Rect2, modulate: Color) -> void :
	var wood: = Color("#6b5842") * modulate
	var dark: = Color("#3d3228") * modulate
	var handle: = Color("#8a8378") * modulate
	var wood_light: = wood.lightened(0.15)

	draw_rect(rect, wood)
	draw_rect(rect, dark, false, 2.0)

	if not low_spec:
		draw_rect(Rect2(rect.position.x + 2.0, rect.end.y - 1.0, rect.size.x - 4.0, 2.0), Color(0, 0, 0, 0.3))

	var door_w: = rect.size.x * 0.48
	var door_h: = rect.size.y * 0.85
	var left_door: = Rect2(rect.position.x + 4.0, rect.position.y + rect.size.y * 0.08, door_w, door_h)
	var right_door: = Rect2(rect.position.x + rect.size.x - door_w - 4.0, rect.position.y + rect.size.y * 0.08, door_w, door_h)

	for door in [left_door, right_door]:
		draw_rect(door, wood_light)
		draw_rect(door, dark, false, 1.5)

		var panel: = Rect2(door.position.x + 5.0, door.position.y + 5.0, door.size.x - 10.0, door.size.y - 10.0)
		draw_rect(panel, wood)
		draw_rect(panel, dark.lightened(0.15), false, 1.0)

		if not low_spec:
			for i in range(3):
				var grain_y: = panel.position.y + 8.0 + i * 12.0
				draw_line(Vector2(panel.position.x + 3.0, grain_y), Vector2(panel.end.x - 3.0, grain_y), wood.darkened(0.1), 0.5)

	var left_handle: = Rect2(left_door.end.x - 8.0, left_door.get_center().y - 3.0, 6.0, 6.0)
	var right_handle: = Rect2(right_door.position.x + 2.0, right_door.get_center().y - 3.0, 6.0, 6.0)
	draw_rect(left_handle, handle)
	draw_rect(right_handle, handle)
	if not low_spec:

		draw_circle(Vector2(left_handle.get_center().x, left_handle.position.y + 1.5), 1.0, dark)
		draw_circle(Vector2(left_handle.get_center().x, left_handle.end.y - 1.5), 1.0, dark)
		draw_circle(Vector2(right_handle.get_center().x, right_handle.position.y + 1.5), 1.0, dark)
		draw_circle(Vector2(right_handle.get_center().x, right_handle.end.y - 1.5), 1.0, dark)

	if not low_spec:
		draw_line(Vector2(rect.position.x + 4.0, rect.get_center().y), Vector2(rect.end.x - 4.0, rect.get_center().y), dark.lightened(0.2), 1.0)

		draw_line(Vector2(rect.get_center().x, left_door.position.y), Vector2(rect.get_center().x, left_door.end.y), Color(0, 0, 0, 0.4), 2.0)

func draw_furniture_refrigerator(rect: Rect2, modulate: Color) -> void :
	var body: = Color("#e8e4dc") * modulate
	var trim: = Color("#4a4a44") * modulate
	var handle: = Color("#b8b8b0") * modulate
	var shadow: = Color(0, 0, 0, 0.2)

	draw_rect(rect, body)
	draw_rect(rect, trim, false, 2.5)

	if not low_spec:
		var side_w: = 4.0
		draw_polygon(PackedVector2Array([
			rect.position, 
			Vector2(rect.position.x + side_w, rect.position.y - side_w), 
			Vector2(rect.position.x + side_w, rect.end.y - side_w), 
			Vector2(rect.position.x, rect.end.y)
		]), PackedColorArray([body.darkened(0.15)]))

	var freezer: = Rect2(rect.position.x + 3.0, rect.position.y + 3.0, rect.size.x - 6.0, rect.size.y * 0.3)
	draw_rect(freezer, body.darkened(0.05))
	draw_rect(freezer, trim, false, 1.5)

	if not low_spec:
		var f_panel: = Rect2(freezer.position.x + 4.0, freezer.position.y + 3.0, freezer.size.x - 20.0, freezer.size.y - 6.0)
		draw_rect(f_panel, body.darkened(0.08), false, 1.0)

	var fridge: = Rect2(rect.position.x + 3.0, freezer.end.y + 2.0, rect.size.x - 6.0, rect.end.y - freezer.end.y - 5.0)
	draw_rect(fridge, body.darkened(0.05))
	draw_rect(fridge, trim, false, 1.5)

	if not low_spec:
		var r_panel: = Rect2(fridge.position.x + 4.0, fridge.position.y + 4.0, fridge.size.x - 20.0, fridge.size.y - 8.0)
		draw_rect(r_panel, body.darkened(0.08), false, 1.0)

	var fridge_handle: = Rect2(fridge.end.x - 10.0, fridge.position.y + 8.0, 6.0, 18.0)
	var freezer_handle: = Rect2(freezer.end.x - 10.0, freezer.position.y + 6.0, 6.0, 12.0)
	draw_rect(fridge_handle, handle)
	draw_rect(fridge_handle, trim, false, 1.0)
	draw_rect(freezer_handle, handle)
	draw_rect(freezer_handle, trim, false, 1.0)
	if not low_spec:

		draw_circle(Vector2(fridge_handle.get_center().x, fridge_handle.position.y + 2.0), 1.5, trim)
		draw_circle(Vector2(fridge_handle.get_center().x, fridge_handle.end.y - 2.0), 1.5, trim)
		draw_circle(Vector2(freezer_handle.get_center().x, freezer_handle.position.y + 2.0), 1.5, trim)
		draw_circle(Vector2(freezer_handle.get_center().x, freezer_handle.end.y - 2.0), 1.5, trim)

	if not low_spec:

		draw_circle(Vector2(fridge.position.x + 15.0, fridge.position.y + 20.0), 5.0, Color("#cf554d") * modulate)
		draw_circle(Vector2(fridge.position.x + 15.0, fridge.position.y + 20.0), 3.0, Color("#e8dcd0") * modulate)

		draw_rect(Rect2(fridge.position.x + 8.0, fridge.get_center().y - 5.0, 12.0, 10.0), Color("#e7b65a") * modulate)
		draw_line(Vector2(fridge.position.x + 9.0, fridge.get_center().y - 2.0), Vector2(fridge.position.x + 19.0, fridge.get_center().y - 2.0), Color("#5a4a3c") * modulate, 0.5)
		draw_line(Vector2(fridge.position.x + 9.0, fridge.get_center().y + 1.0), Vector2(fridge.position.x + 17.0, fridge.get_center().y + 1.0), Color("#5a4a3c") * modulate, 0.5)

	if not low_spec:
		var vent: = Rect2(rect.position.x + 8.0, rect.end.y - 8.0, rect.size.x - 16.0, 6.0)
		draw_rect(vent, trim.darkened(0.2))
		for i in range(6):
			var slot_x: = vent.position.x + 4.0 + i * 14.0
			draw_line(Vector2(slot_x, vent.position.y + 1.0), Vector2(slot_x, vent.end.y - 1.0), Color(0, 0, 0, 0.6), 2.0)

func draw_furniture_utility_sink(rect: Rect2, modulate: Color) -> void :
	var steel: = Color("#8a9092") * modulate
	var dark: = Color("#3a3c3e") * modulate
	var counter_color: = Color("#6a6560") * modulate

	var counter: = Rect2(rect.position.x, rect.position.y + rect.size.y * 0.4, rect.size.x, rect.size.y * 0.15)
	draw_rect(counter, counter_color)
	draw_rect(counter, dark, false, 1.5)

	if not low_spec:
		draw_line(Vector2(counter.position.x, counter.position.y), Vector2(counter.end.x, counter.position.y), counter_color.lightened(0.15), 1.0)

	var basin: = Rect2(rect.position.x + 12.0, counter.position.y + 4.0, rect.size.x - 24.0, counter.size.y + 8.0)
	draw_rect(basin, steel.darkened(0.3))
	draw_rect(basin, steel.darkened(0.15), false, 2.0)

	if not low_spec:
		draw_rect(Rect2(basin.position.x + 2.0, basin.position.y + 2.0, basin.size.x - 4.0, 3.0), Color(0, 0, 0, 0.2))

		draw_circle(Vector2(basin.get_center().x, basin.end.y - 4.0), 3.5, dark)
		draw_circle(Vector2(basin.get_center().x, basin.end.y - 4.0), 2.0, Color(0, 0, 0, 0.8))

		for i in range(3):
			var stain_x: = basin.position.x + 8.0 + i * 12.0
			draw_circle(Vector2(stain_x, basin.end.y - 8.0), 2.0, steel.darkened(0.2))

	var faucet_x: = basin.get_center().x
	var faucet_base_y: = counter.position.y - 2.0

	draw_circle(Vector2(faucet_x, faucet_base_y), 5.0, steel)
	draw_circle(Vector2(faucet_x, faucet_base_y), 4.0, steel.lightened(0.1))

	draw_rect(Rect2(faucet_x - 3.0, basin.position.y - 18.0, 6.0, 18.0), steel)
	draw_rect(Rect2(faucet_x - 3.0, basin.position.y - 18.0, 6.0, 18.0), steel.lightened(0.2), false, 1.0)

	draw_rect(Rect2(faucet_x - 8.0, basin.position.y - 22.0, 16.0, 6.0), steel)
	draw_rect(Rect2(faucet_x - 8.0, basin.position.y - 22.0, 16.0, 6.0), steel.lightened(0.2), false, 1.0)

	if not low_spec:
		draw_circle(Vector2(faucet_x, basin.position.y - 25.0), 3.0, Color("#cf554d") * modulate)
		draw_circle(Vector2(faucet_x, basin.position.y - 25.0), 2.0, Color("#cf554d").darkened(0.2) * modulate)

	var cabinet: = Rect2(rect.position.x + 4.0, counter.end.y + 2.0, rect.size.x - 8.0, rect.end.y - counter.end.y - 6.0)
	var wood: = Color("#5a4e42") * modulate
	draw_rect(cabinet, wood)
	draw_rect(cabinet, dark, false, 1.5)

	if not low_spec:
		var panel: = Rect2(cabinet.position.x + 4.0, cabinet.position.y + 4.0, cabinet.size.x - 8.0, cabinet.size.y - 8.0)
		draw_rect(panel, wood.darkened(0.08), false, 1.0)

		var handle_rect: = Rect2(panel.end.x - 8.0, panel.get_center().y - 3.0, 5.0, 6.0)
		draw_rect(handle_rect, Color("#8a8378") * modulate)

		draw_line(Vector2(basin.get_center().x, counter.end.y + 3.0), Vector2(basin.get_center().x, counter.end.y + 12.0), steel.darkened(0.2), 4.0)

func draw_furniture_coin_washer(rect: Rect2, modulate: Color) -> void :
	var body: = Color("#d8dcd8") * modulate
	var trim: = Color("#5a615e") * modulate
	var dark: = Color("#2a3335") * modulate

	draw_rect(rect, body)
	draw_rect(rect, trim, false, 2.5)

	if not low_spec:
		var side_w: = 3.0
		draw_polygon(PackedVector2Array([
			rect.position, 
			Vector2(rect.position.x + side_w, rect.position.y - side_w), 
			Vector2(rect.position.x + side_w, rect.end.y - side_w), 
			Vector2(rect.position.x, rect.end.y)
		]), PackedColorArray([body.darkened(0.12)]))

	var panel: = Rect2(rect.position.x + 4.0, rect.position.y + 4.0, rect.size.x - 8.0, rect.size.y * 0.2)
	draw_rect(panel, trim)
	draw_rect(panel, trim.lightened(0.1), false, 1.0)

	if not low_spec:

		var slot: = Rect2(panel.position.x + 8.0, panel.get_center().y - 2.0, 15.0, 4.0)
		draw_rect(slot, dark)
		draw_rect(slot, Color(0, 0, 0, 0.5), false, 1.0)

		draw_circle(Vector2(panel.end.x - 25.0, panel.get_center().y), 2.5, Color("#4a8a45") * modulate)
		draw_circle(Vector2(panel.end.x - 15.0, panel.get_center().y), 2.5, Color("#8a5a45") * modulate)

		draw_circle(Vector2(panel.get_center().x, panel.get_center().y), 6.0, body.darkened(0.2))
		draw_circle(Vector2(panel.get_center().x, panel.get_center().y), 5.0, trim.lightened(0.15))
		draw_line(Vector2(panel.get_center().x, panel.get_center().y), Vector2(panel.get_center().x + 3.0, panel.get_center().y - 2.0), Color.WHITE, 1.0)

	var door_center: = Vector2(rect.get_center().x, rect.position.y + rect.size.y * 0.55)
	var door_radius: = rect.size.x * 0.35

	draw_circle(door_center, door_radius + 4.0, body.darkened(0.15))
	draw_circle(door_center, door_radius + 3.0, body.lightened(0.1))

	draw_circle(door_center, door_radius, dark)
	draw_circle(door_center, door_radius, trim, false, 3.0)

	if not low_spec:
		draw_circle(door_center, door_radius * 0.75, dark.lightened(0.1))

		for ring in range(2):
			var hole_radius: = door_radius * (0.4 + ring * 0.2)
			var holes: = 8 + ring * 4
			for i in range(holes):
				var angle: = (TAU / holes) * i
				var hole_pos: = door_center + Vector2(cos(angle), sin(angle)) * hole_radius
				draw_circle(hole_pos, 2.0, Color(0, 0, 0, 0.6))

		draw_arc(door_center + Vector2( - door_radius * 0.3, - door_radius * 0.3), door_radius * 0.6, PI * 0.75, PI * 1.5, 12, Color(1, 1, 1, 0.18), 2.5)

	draw_rect(Rect2(door_center.x + door_radius + 2.0, door_center.y - 5.0, 6.0, 10.0), trim.lightened(0.25))
	draw_circle(Vector2(door_center.x + door_radius + 5.0, door_center.y), 2.0, trim)

	if not low_spec:
		var vent: = Rect2(rect.position.x + 6.0, rect.end.y - 10.0, rect.size.x - 12.0, 8.0)
		draw_rect(vent, trim.darkened(0.15))
		for i in range(8):
			var slot_x: = vent.position.x + 4.0 + i * 12.0
			draw_line(Vector2(slot_x, vent.position.y + 2.0), Vector2(slot_x, vent.end.y - 2.0), Color(0, 0, 0, 0.5), 2.0)

func draw_furniture_coin_dryer(rect: Rect2, modulate: Color) -> void :
	var body: = Color("#d8dcd8") * modulate
	var trim: = Color("#5a615e") * modulate
	var dark: = Color("#2a3335") * modulate

	draw_rect(rect, body)
	draw_rect(rect, trim, false, 2.5)

	if not low_spec:
		var side_w: = 3.0
		draw_polygon(PackedVector2Array([
			rect.position, 
			Vector2(rect.position.x + side_w, rect.position.y - side_w), 
			Vector2(rect.position.x + side_w, rect.end.y - side_w), 
			Vector2(rect.position.x, rect.end.y)
		]), PackedColorArray([body.darkened(0.12)]))

	var panel: = Rect2(rect.position.x + 4.0, rect.position.y + 4.0, rect.size.x - 8.0, rect.size.y * 0.2)
	draw_rect(panel, trim)
	draw_rect(panel, trim.lightened(0.1), false, 1.0)

	if not low_spec:

		var slot: = Rect2(panel.position.x + 8.0, panel.get_center().y - 2.0, 15.0, 4.0)
		draw_rect(slot, dark)
		draw_rect(slot, Color(0, 0, 0, 0.5), false, 1.0)

		draw_circle(Vector2(panel.get_center().x, panel.get_center().y), 6.0, body.darkened(0.2))
		draw_circle(Vector2(panel.get_center().x, panel.get_center().y), 5.0, Color("#cf554d") * modulate)
		draw_line(Vector2(panel.get_center().x, panel.get_center().y), Vector2(panel.get_center().x + 4.0, panel.get_center().y - 1.0), Color.WHITE, 1.0)

		draw_circle(Vector2(panel.end.x - 20.0, panel.get_center().y), 6.0, body.darkened(0.2))
		draw_circle(Vector2(panel.end.x - 20.0, panel.get_center().y), 5.0, trim.lightened(0.15))

		draw_circle(Vector2(panel.position.x + 35.0, panel.get_center().y), 2.5, Color("#8a5a45") * modulate)

	var lint_warning: = Rect2(rect.position.x + 8.0, panel.end.y + 4.0, rect.size.x - 16.0, 4.0)
	draw_rect(lint_warning, Color("#cf554d") * modulate)
	if not low_spec:

		draw_line(Vector2(lint_warning.position.x + 2.0, lint_warning.get_center().y), Vector2(lint_warning.end.x - 2.0, lint_warning.get_center().y), Color("#ffe8dc") * modulate, 1.0)

	var door_center: = Vector2(rect.get_center().x, rect.position.y + rect.size.y * 0.55)
	var door_radius: = rect.size.x * 0.35

	draw_circle(door_center, door_radius + 4.0, body.darkened(0.15))
	draw_circle(door_center, door_radius + 3.0, body.lightened(0.1))

	draw_circle(door_center, door_radius, dark)
	draw_circle(door_center, door_radius, trim, false, 3.0)

	if not low_spec:
		draw_circle(door_center, door_radius * 0.75, dark.lightened(0.15))

		for i in range(3):
			var angle: = (TAU / 3.0) * i + 0.3
			var baffle_start: = door_center + Vector2(cos(angle), sin(angle)) * (door_radius * 0.2)
			var baffle_end: = door_center + Vector2(cos(angle), sin(angle)) * (door_radius * 0.7)
			draw_line(baffle_start, baffle_end, trim.lightened(0.2), 3.0)

		draw_arc(door_center + Vector2( - door_radius * 0.3, - door_radius * 0.3), door_radius * 0.6, PI * 0.75, PI * 1.5, 12, Color(1, 1, 1, 0.18), 2.5)

	draw_rect(Rect2(door_center.x + door_radius + 2.0, door_center.y - 5.0, 6.0, 10.0), trim.lightened(0.25))
	draw_circle(Vector2(door_center.x + door_radius + 5.0, door_center.y), 2.0, trim)

	if not low_spec:
		var vent: = Rect2(rect.position.x + 6.0, rect.end.y - 10.0, rect.size.x - 12.0, 8.0)
		draw_rect(vent, trim.darkened(0.15))
		for i in range(8):
			var slot_x: = vent.position.x + 4.0 + i * 12.0
			draw_line(Vector2(slot_x, vent.position.y + 2.0), Vector2(slot_x, vent.end.y - 2.0), Color(0, 0, 0, 0.5), 2.0)

		draw_rect(Rect2(vent.position.x + 2.0, vent.position.y + 1.0, 15.0, 2.0), Color("#4a3a2f") * modulate * Color(1, 1, 1, 0.3))


func draw_furniture_washer_bank(rect: Rect2, modulate: Color) -> void :
	var shell: = Color("#b7bcbc") * modulate
	var trim: = Color("#6b7273") * modulate
	var count: = 3
	var gap: = 3.0
	var unit_w: = (rect.size.x - gap * float(count - 1)) / float(count)
	for unit in range(count):
		var ur: = Rect2(rect.position.x + float(unit) * (unit_w + gap), rect.position.y + 4.0, unit_w, rect.size.y - 8.0)
		draw_rect(ur, shell)
		draw_rect(ur, trim, false, 1.0)

		var fascia: = Rect2(ur.position.x + 2.0, ur.position.y + 2.0, ur.size.x - 4.0, ur.size.y * 0.2)
		draw_rect(fascia, shell.darkened(0.16))
		draw_rect(fascia, trim, false, 1.0)
		draw_circle(Vector2(fascia.position.x + 9.0, fascia.get_center().y), 3.5, trim.lightened(0.3))
		if not low_spec:
			for lamp in range(2):
				draw_rect(Rect2(fascia.end.x - 12.0 + float(lamp) * 5.0, fascia.get_center().y - 2.0, 3.0, 4.0), 
					(Color("#8fd08a") if lamp == 0 else Color("#d0a05f")) * modulate)

		var centre: = Vector2(ur.get_center().x, ur.position.y + ur.size.y * 0.58)
		var radius: = minf(ur.size.x, ur.size.y) * 0.3
		draw_circle(centre, radius + 3.0, shell.darkened(0.24))
		draw_arc(centre, radius + 3.0, 0.0, TAU, 24, trim, 2.0)
		draw_circle(centre, radius, Color("#39413f") * modulate)
		draw_circle(centre, radius * 0.72, Color("#252c2b") * modulate)
		if not low_spec:
			draw_arc(centre + Vector2( - radius * 0.22, - radius * 0.22), radius * 0.55, PI * 0.75, PI * 1.55, 12, 
				Color(1, 1, 1, 0.16), 2.0)

		draw_rect(Rect2(centre.x + radius + 1.0, centre.y - 4.0, 5.0, 8.0), trim.lightened(0.28))
		draw_rect(Rect2(ur.position.x + 3.0, ur.end.y - 6.0, ur.size.x - 6.0, 6.0), trim.darkened(0.2))


func draw_furniture_folding_table(rect: Rect2, modulate: Color) -> void :
	var top: = Color("#9a9484") * modulate
	var leg: = Color("#5c6162") * modulate
	var table_y: = rect.position.y + rect.size.y * 0.42

	for side in range(2):
		var inner_x: = rect.position.x + 22.0 + float(side) * (rect.size.x - 44.0)
		var outer_x: = rect.position.x + 12.0 + float(side) * (rect.size.x - 24.0)
		draw_line(Vector2(inner_x, table_y + 8.0), Vector2(outer_x, rect.end.y - 4.0), leg, 4.0)
		draw_line(Vector2(outer_x, table_y + 8.0), Vector2(inner_x, rect.end.y - 4.0), leg.darkened(0.2), 4.0)
	draw_line(Vector2(rect.position.x + 18.0, table_y + 30.0), Vector2(rect.end.x - 18.0, table_y + 30.0), 
		leg.darkened(0.28), 2.0)
	var slab: = Rect2(rect.position.x + 2.0, table_y, rect.size.x - 4.0, 11.0)
	draw_rect(slab, top)
	draw_line(slab.position, Vector2(slab.end.x, slab.position.y), top.lightened(0.26), 2.0)
	draw_rect(Rect2(slab.position.x, slab.end.y - 3.0, slab.size.x, 3.0), top.darkened(0.36))

	var piles: Array[float] = [0.16, 0.58]
	for pile_index in range(piles.size()):
		var px: = slab.position.x + slab.size.x * piles[pile_index]
		var layers: = 3 + pile_index
		for layer in range(layers):
			var lw: = 30.0 - float(layer) * 2.0
			var tint: = Color("#dcd6c6") if posmod(layer + pile_index, 2) == 0 else Color("#b9c4c6")
			draw_rect(Rect2(px + float(layer), table_y - 5.0 - float(layer) * 5.0, lw, 5.0), tint * modulate)
			if not low_spec:
				draw_line(Vector2(px + float(layer), table_y - 5.0 - float(layer) * 5.0), 
					Vector2(px + float(layer) + lw, table_y - 5.0 - float(layer) * 5.0), 
					(tint * modulate).lightened(0.2), 1.0)

