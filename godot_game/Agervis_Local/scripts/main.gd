func move_equipment_cursor(horizontal: int, vertical: int) -> void :
	if equipment_focus == 1:
		equipment_cursor = clampi(equipment_cursor + vertical, 0, maxi(0, Build10.EQUIPMENT_SLOTS.size() - 1))
		return
	if inventory.is_empty():
		equipment_cursor = 0
		return
	var next_cursor: = equipment_cursor

	if horizontal < 0:
		if equipment_cursor % INVENTORY_GRID_COLUMNS > 0:
			next_cursor -= 1
		elif equipment_cursor >= INVENTORY_GRID_COLUMNS:

			next_cursor = equipment_cursor - 1
	elif horizontal > 0:
		if equipment_cursor % INVENTORY_GRID_COLUMNS < INVENTORY_GRID_COLUMNS - 1:
			next_cursor += 1
		elif equipment_cursor + 1 < inventory.size():

			next_cursor = equipment_cursor + 1
	next_cursor += vertical * INVENTORY_GRID_COLUMNS
	equipment_cursor = clampi(next_cursor, 0, inventory.size() - 1)

func equipment_slot_at(index: int) -> String:
	if index < 0 or index >= Build10.EQUIPMENT_SLOTS.size(): return ""
	return String(Build10.EQUIPMENT_SLOTS[index])

func sync_contingencies_from_equipment() -> void :
	contingencies.clear()
	for slot_name in ["contingency_1", "contingency_2"]:
		var item: = String(equipment.get(slot_name, ""))
		if not item.is_empty():
			contingencies.append(item)

func activate_equipment_selection() -> void :
	if equipment_focus == 0 and not inventory.is_empty():
		equipment_cursor = clampi(equipment_cursor, 0, inventory.size() - 1)
		var selected_item: = String(inventory[equipment_cursor])

		# Handle pharmaceutical packs and street substance packages
		if selected_item.ends_with("-pack)") or selected_item.ends_with("(1g)") or selected_item.contains("(10-pack)") or selected_item.contains("(pint)"):
			var options: Array[Dictionary] = []
			options.append({"label": "Break down package", "id": "breakdown_package"})
			if not selected_item.ends_with("(1g)") and not selected_item.contains("(pint)") and not selected_item.contains("Revivar"):
				options.append({"label": "Press pill (Chemistry %d)" % SubstancePackaging.PILL_PRESS_CHEMISTRY_LEVEL, "id": "press_pill"})
			options.append({"label": "Inspect", "id": "inspect_substance"})
			options.append({"label": "Cancel", "id": "close"})
			open_dialog(selected_item.to_upper(), ["Package containing multiple doses."], options)
			return

		# Handle single doses
		if selected_item.contains("(single)") or selected_item.contains("(0.1g dose)") or selected_item.contains("(oz)"):
			var options: Array[Dictionary] = []
			options.append({"label": "Consume substance", "id": "consume_substance"})
			options.append({"label": "Inspect", "id": "inspect_substance"})
			options.append({"label": "Cancel", "id": "close"})
			open_dialog(selected_item.to_upper(), ["Single dose ready for consumption."], options)
			return

		if selected_item in ["Powder (point)", "Powder (½gram)", "Powder (gram)", "Powder (8-ball)", "Powder (cue ball)", "Powder (½ zip)", "Powder (¾ zip)", "Powder (zip)", "Powder (QP)", "Powder (HP)", "Powder (¾P)", "Powder (P)"]:
			var powder_record: = authoritative_inventory_record_for_display_index(equipment_cursor)
			if powder_record.is_empty():
				notify("THE SERVER CANNOT FIND THAT BATCH", DANGER, 2.8)
			else:
				open_powder_batch(powder_record)
			return
		if ItemUseRules.is_standard_consumable(selected_item):
			use_selected_standard_item()
			return
	if equipment_focus == 0:
		if inventory.is_empty():
			return
		equipment_cursor = clampi(equipment_cursor, 0, inventory.size() - 1)
		var item: = String(inventory[equipment_cursor])
		if online_economy_enabled() and item in ["sealed_deposit_boss", "Sealed Deposit Bag"]:
			var nonce: = active_sealed_deposit_nonce()
			if nonce.is_empty():
				notify("THE SERVER CANNOT FIND THAT DEPOSIT'S CUSTODY NONCE", DANGER, 3.0)
				return
			open_dialog("SEALED EMPLOYER DEPOSIT", [
				"The amount is unknown while the seal remains intact.", 
				"Breaking it is irreversible. The contents become dirty cash and the custody record names who broke it.", 
			], [{"label": "Break the seal", "id": "break_sealed_deposit"}, {"label": "Keep it sealed", "id": "close"}])
			return
		var slot_name: = Build10.equipment_slot(item)
		if slot_name.is_empty():
			var item_data: = inventory_item_data(item)
			open_dialog(item.to_upper(), [
				"%s  /  %s" % [String(item_data.get("kind", "ITEM")), String(item_data.get("tag", "CLEAN"))], 
				String(item_data.get("description", "A carried item.")), 
			], [])
			return
		if online_authority_enforced():
			submit_online_economy_request("EQUIPMENT_EQUIP", {"item_id": item}, true, {"item_id": item})
			return
		if slot_name.begins_with("contingency"):
			slot_name = contingency_slot_for_item(item)
			if slot_name.is_empty():
				notify("CONTINGENCY POUCH IS FULL", DANGER, 2.0)
				return
		var previous: = String(equipment.get(slot_name, ""))
		var projected_count: = inventory.size() - 1 + (1 if not previous.is_empty() else 0)
		if projected_count > projected_carry_capacity(slot_name, item):
			notify("EQUIPPING %s WOULD OVERFILL YOUR CARRY SPACE" % item.to_upper(), DANGER, 3.0)
			return
		inventory.remove_at(equipment_cursor)
		if not previous.is_empty():
			inventory.append(previous)
		equipment[slot_name] = item
		sync_contingencies_from_equipment()
		stamina = minf(stamina, max_stamina_value())
		equipment_cursor = clampi(equipment_cursor, 0, maxi(0, inventory.size() - 1))
		notify("EQUIPPED %s" % item.to_upper(), GOOD, 2.2)
	else:
		var slot_name: = equipment_slot_at(equipment_cursor)
		var item: = String(equipment.get(slot_name, ""))
		if item.is_empty():
			return
		if online_authority_enforced():
			submit_online_economy_request("EQUIPMENT_UNEQUIP", {"slot": slot_name}, true, {"item_id": item, "slot": slot_name})
			return
		var projected_count: = inventory.size() + 1
		if projected_count > projected_carry_capacity(slot_name, ""):
			notify("NO CARRY SPACE TO UNEQUIP %s" % item.to_upper(), DANGER, 2.2)
			return
		equipment[slot_name] = ""
		inventory.append(item)
		sync_contingencies_from_equipment()
		stamina = minf(stamina, max_stamina_value())
		notify("UNEQUIPPED %s" % item.to_upper(), ACCENT, 2.2)
	save_current_character("EQUIPMENT UPDATED")
func handle_equipment_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		if inventory_edit_active(): reset_inventory_edit_state()
		else: mode = ScreenMode.PLAY
	elif equipment_split_active:
		if key.keycode == KEY_LEFT: adjust_inventory_split_quantity(-1)
		elif key.keycode == KEY_RIGHT: adjust_inventory_split_quantity(1)
		elif key.keycode in [KEY_ENTER, KEY_SPACE]: confirm_inventory_split()
		elif key.keycode == KEY_S: reset_inventory_edit_state()
	elif key.keycode == KEY_TAB and equipment_move_source_record_index < 0:
		equipment_focus = 1 - equipment_focus
		equipment_cursor = 0
	elif key.keycode == KEY_LEFT:
		move_equipment_cursor(-1, 0)
	elif key.keycode == KEY_RIGHT:
		move_equipment_cursor(1, 0)
	elif key.keycode == KEY_UP:
		move_equipment_cursor(0, -1)
	elif key.keycode == KEY_DOWN:
		move_equipment_cursor(0, 1)
	elif key.keycode == KEY_M:
		if equipment_move_source_record_index >= 0: reset_inventory_edit_state()
		else: start_inventory_move()
	elif key.keycode == KEY_S:
		start_inventory_split()
	elif key.keycode in [KEY_ENTER, KEY_SPACE]:
		if equipment_move_source_record_index >= 0: confirm_inventory_move()
		else: activate_equipment_selection()

func equipment_inventory_rect(index: int) -> Rect2:
	var column: = index % INVENTORY_GRID_COLUMNS
	var row: = index / INVENTORY_GRID_COLUMNS
	var cell_width: = 64.0
	var cell_height: = 78.0
	var spacing_x: = 72.0
	var spacing_y: = 88.0
	var base_rect: = Rect2(105 + column * spacing_x, 205 + row * spacing_y, cell_width, cell_height)


	if equipment_focus == 0 and equipment_cursor == (equipment_page_start() + index) and index < inventory.size():
		var enlarge: = 0.1
		var grow_x: = cell_width * enlarge * 0.5
		var grow_y: = cell_height * enlarge * 0.5
		base_rect.position.x -= grow_x
		base_rect.position.y -= grow_y
		base_rect.size.x += grow_x * 2.0
		base_rect.size.y += grow_y * 2.0

	return base_rect

func equipment_slot_rect(index: int) -> Rect2:
	return Rect2(705, 180 + index * 39, 455, 34)

func handle_equipment_pointer(point: Vector2) -> void :
	if Rect2(1080, 105, 80, 43).has_point(point):
		if inventory_edit_active(): reset_inventory_edit_state()
		else: mode = ScreenMode.PLAY
		return
	if equipment_split_active:
		if equipment_split_minus_rect().has_point(point): adjust_inventory_split_quantity(-1)
		elif equipment_split_confirm_rect().has_point(point): confirm_inventory_split()
		elif equipment_split_action_rect().has_point(point): adjust_inventory_split_quantity(1)
		return
	if equipment_page_button_rect(false).has_point(point):
		equipment_focus = 0;equipment_cursor = maxi(0, equipment_cursor - equipment_items_per_page());return
	if equipment_page_button_rect(true).has_point(point):
		equipment_focus = 0;equipment_cursor = mini(maxi(0, inventory.size() - 1), equipment_cursor + equipment_items_per_page());return
	var start: = equipment_page_start()
	for cell in range(mini(equipment_items_per_page(), maxi(0, inventory.size() - start))):
		if equipment_inventory_rect(cell).has_point(point):
			equipment_focus = 0;equipment_cursor = start + cell;return
	for index in range(Build10.EQUIPMENT_SLOTS.size()):
		if equipment_slot_rect(index).has_point(point):
			if equipment_move_source_record_index >= 0: return
			equipment_focus = 1;equipment_cursor = index;return
	if equipment_primary_action_rect().has_point(point):
		if equipment_move_source_record_index >= 0: reset_inventory_edit_state()
		else: activate_equipment_selection()
	elif equipment_move_action_rect().has_point(point):
		if equipment_move_source_record_index >= 0: confirm_inventory_move()
		else: start_inventory_move()
	elif equipment_split_action_rect().has_point(point):
		start_inventory_split()

func inventory_item_data(item_name: String) -> Dictionary:
	var data: Dictionary = Build7.item_info(item_name).duplicate(true)
	var use_definition: = ItemUseRules.definition(item_name)
	if not use_definition.is_empty():
		data["kind"] = "CONSUMABLE"
		data["description"] = String(use_definition.get("description", data.get("description", "A standard consumable.")))
	var equipment_data: Dictionary = Build10.EQUIPMENT_CATALOG.get(item_name, {})
	if not equipment_data.is_empty():
		data["kind"] = "GEAR"
		data["tag"] = "READY"
		data["description"] = String(equipment_data.get("description", data.get("description", "Wearable gear.")))
		data["slot"] = String(equipment_data.get("slot", ""))
	return data

func handle_skills_key(key: InputEventKey) -> void :
