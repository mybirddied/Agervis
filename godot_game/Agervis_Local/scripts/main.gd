func handle_creation_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		if creation_stage == "confirm":
			creation_stage = "appearance"
			creation_field = 1
		return
	if creation_stage == "name" or creation_stage == "nickname":
		if key.keycode == KEY_BACKSPACE:
			creation_name = creation_name.left(maxi(0, creation_name.length() - 1))
		elif key.keycode == KEY_ENTER:
			if creation_stage == "name":
				confirm_creation_name()
			else:
				confirm_creation_nickname()
		elif key.unicode >= 32 and key.unicode <= 1114111 and creation_name.length() < 16:
			creation_name += char(key.unicode)
	elif creation_stage == "appearance":
		if key.keycode == KEY_UP or key.keycode == KEY_W:

			if creation_field == 1:
				creation_field = 17
			elif creation_field == 17:
				creation_field = 16
			else:
				creation_field -= 1
		elif key.keycode == KEY_DOWN or key.keycode == KEY_TAB or key.keycode == KEY_S:
			if creation_field == 16:
				creation_field = 17
			elif creation_field == 17:
				creation_field = 1
			else:
				creation_field = posmod(creation_field, 16) + 1
		elif key.keycode == KEY_LEFT or key.keycode == KEY_A:
			adjust_creation_field(-1)
		elif key.keycode == KEY_RIGHT or key.keycode == KEY_D:
			adjust_creation_field(1)
		elif key.keycode == KEY_ENTER:
			if creation_field == 16:
				complete_character_creation()
			else:
				complete_character_creation()
	elif creation_stage == "confirm" and key.keycode == KEY_ENTER:
		commit_character_creation()

func adjust_creation_field(direction: int) -> void :
	match creation_field:
		0:
			controller_name_cursor = posmod(controller_name_cursor + direction, controller_names.size())
			creation_name = controller_names[controller_name_cursor]
		1: creation_expression_index = posmod(creation_expression_index + direction, creation_expressions.size())
		2: creation_body_index = posmod(creation_body_index + direction, creation_body_styles.size())
		3: creation_boobs_index = posmod(creation_boobs_index + direction, creation_boobs.size())
		4: creation_skin_index = posmod(creation_skin_index + direction, creation_skin_colors.size())
		5: creation_face_index = posmod(creation_face_index + direction, creation_face_styles.size())
		6: creation_eye_index = posmod(creation_eye_index + direction, creation_eye_styles.size())
		7: creation_hair_index = posmod(creation_hair_index + direction, creation_hair_styles.size())
		8: creation_hair_color_index = posmod(creation_hair_color_index + direction, creation_hair_colors.size())
		9: creation_facial_hair_index = posmod(creation_facial_hair_index + direction, creation_facial_hair_styles.size())
		10: creation_facial_hair_color_index = posmod(creation_facial_hair_color_index + direction, creation_hair_colors.size())
		11: creation_stature_index = posmod(creation_stature_index + direction, creation_statures.size())
		12: creation_outfit_index = posmod(creation_outfit_index + direction, creation_outfit_styles.size())
		13: creation_color_index = posmod(creation_color_index + direction, creation_colors.size())
		14: creation_pants_index = posmod(creation_pants_index + direction, creation_pants_colors.size())
		15: creation_surreal_index = posmod(creation_surreal_index + direction, creation_surreal_traits.size())
		16: creation_accessory_index = posmod(creation_accessory_index + direction, creation_accessories.size())

func complete_character_creation() -> void :
	if creation_stage == "name":
		confirm_creation_name()
		return
	if creation_stage == "nickname":
		confirm_creation_nickname()
		return
	if creation_stage == "appearance":
		creation_stage = "confirm"
		creation_name_check_state = ""
		notify("REVIEW THE RESIDENT FILE, THEN CONFIRM FINAL CREATION.", ACCENT, 3.0)
		queue_redraw()
		return
	if creation_stage != "confirm":
		return
	commit_character_creation()

