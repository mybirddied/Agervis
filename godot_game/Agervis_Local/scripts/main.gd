func update_job_contract_attendance(delta: float) -> void :
	if online_authority_enforced():
		return
	if job_contract.is_empty() or String(job_contract.get("status", "")) != "active":
		return
	var attendance: Dictionary = Dictionary(job_contract.get("attendance", {})).duplicate(true)
	var employer_id: = String(job_contract.get("employer_id", ""))
	var on_site: = false
	if employer_id == "boss_store":
		on_site = area in ["store", "backroom"]
	elif employer_id == "first_block_security":
		on_site = area in ["home", "store", "backroom", "street", "bank"]
	elif employer_id == "alibis":
		on_site = area == "restaurant"
	elif employer_id == "spin_cycle":
		on_site = area == "laundromat"
	if on_site:
		attendance["on_site_seconds"] = float(attendance.get("on_site_seconds", 0.0)) + delta
	else:
		attendance["away_seconds"] = float(attendance.get("away_seconds", 0.0)) + delta
	var threshold: = float(Dictionary(job_contract.get("firing_threshold", {})).get("absence_seconds", 1800.0))
	var away: = float(attendance.get("away_seconds", 0.0))
	var warning_stage: = int(attendance.get("warning_stage", 0))
	var employer: = String(job_contract.get("employer", "EMPLOYER"))
	if warning_stage < 1 and away >= threshold * 0.5:
		warning_stage = 1
		send_employer_text(employer, "You still work here. That was not a philosophical question. Report back soon.")
	if warning_stage < 2 and away >= threshold * 0.8:
		warning_stage = 2
		send_employer_text(employer, "This is the last polite reminder. The next message becomes payroll documentation.")
	if warning_stage < 3 and away >= threshold:
		warning_stage = 3
		attendance["warning_stage"] = warning_stage
		job_contract["attendance"] = attendance
		send_employer_text(employer, "Your contract has been ended for absence. Return any work property you still have.")
		if carried_handoff("shift_radio"):
			report_handoff_outcome("shift_radio", "LOST", "The shift radio was still out when the contract ended.", true)
		close_job_contract("fired for absence")
		active_job = "None"
		on_duty = false
		return
	attendance["warning_stage"] = warning_stage
	job_contract["attendance"] = attendance
