func dialog_option_rect(index: int, total_options: int = 0) -> Rect2:
	if dialog_uses_overhead_bubble():
		var column: = index % 2
		var row: = index / 2
		return Rect2(96 + column * 548, 500 + row * 39, 520, 33)


	var use_two_columns: = total_options > 4

	var x: = 220.0
	var width: = 840.0
	if not dialog_speakers.is_empty():
		x = 295.0
		width = 690.0
	elif mode != ScreenMode.QUIZ and portrait_index_for_title(dialog_title) >= 0:
		x = 470.0
		width = 590.0

