func _on_resident_name_check_received(result: Dictionary) -> void :
	if mode != ScreenMode.CREATION or creation_stage != "name":
		return
	var result_name: = String(result.get("name", creation_name)).strip_edges()
	if not creation_name_check_request.is_empty() and not result_name.is_empty() and result_name.to_lower() != creation_name_check_request.to_lower():
		return
	creation_name_check_state = "accepted" if bool(result.get("ok", false)) else "rejected"
	if not bool(result.get("ok", false)):
		notify(String(result.get("message", "THAT RESIDENT NAME IS NOT AVAILABLE")).to_upper(), DANGER, 3.2)
		queue_redraw()
		return
	creation_name = result_name.left(16)
	creation_stage = "appearance"
	creation_field = 1
	DisplayServer.virtual_keyboard_hide()
	notify("NAME ACCEPTED  -  CHOOSE THE APPEARANCE ON THE NEXT SCREEN", GOOD, 3.0)
	queue_redraw()

func _on_resident_save_result(result: Dictionary) -> void :
	var result_kind: = String(result.get("kind", ""))
	if result_kind == "resident_deleted":
		var deleted_slot: = int(result.get("slot_index", pending_delete_slot))
		if pending_delete_slot >= 0 and deleted_slot != pending_delete_slot:
			return
		pending_delete_online_commit = false
		pending_delete_slot = -1
		mode = ScreenMode.ROSTER
		roster_cursor = clampi(deleted_slot, 0, ReleaseSave.FREE_SLOTS - 1)
		if not bool(result.get("ok", false)):
			release_notice = String(result.get("message", "DELETE FAILED  -  RESIDENT FILE WAS NOT CHANGED")).to_upper()
			queue_redraw()
			return
		var canonical_roster: Variant = result.get("roster", null)
		if canonical_roster is not Dictionary:
			release_notice = "DELETE FAILED  -  SERVER RETURNED AN INVALID ROSTER"
			queue_redraw()
			return
		roster = ReleaseSave.normalize_roster(canonical_roster)
		active_slot = int(roster.get("active_slot", -1))
		var deleted_label: = String(result.get("deleted_name", "RESIDENT FILE")).to_upper()
		release_notice = "%s DELETED FROM %s" % [deleted_label, roster_world_label()]
		queue_redraw()
		return
	if result_kind == "tutorial_draft":
		if not bool(result.get("ok", false)):
			pending_tutorial_save_reason = ""
			notify(String(result.get("message", "THE SERVER COULD NOT SAVE THE TUTORIAL")).to_upper(), DANGER, 3.5)
			queue_redraw()
			return
		var saved_slot: = int(result.get("slot_index", active_slot))
		var saved_draft: Variant = result.get("draft", null)
		var drafts: Array = roster.get("tutorial_drafts", ReleaseSave.empty_tutorial_drafts())
		if saved_slot >= 0 and saved_slot < drafts.size() and saved_draft is Dictionary:
			drafts[saved_slot] = (saved_draft as Dictionary).duplicate(true)
			roster["tutorial_drafts"] = drafts
			roster["active_tutorial_slot"] = saved_slot
		if not pending_tutorial_save_reason.is_empty():
			release_notice = "SAVED TO %s  -  %s" % [resident_world_id, pending_tutorial_save_reason]
		pending_tutorial_save_reason = ""
		queue_redraw()
		return
	if not pending_creation_online_commit or mode != ScreenMode.CREATION:
		return
	pending_creation_online_commit = false
	if not bool(result.get("ok", false)):
		var error_code: = String(result.get("error_code", ""))



		if error_code in ["NAME_ALREADY_TAKEN", "INVALID_RESIDENT_NAME"]:
			creation_stage = "name"
			creation_name_check_state = "rejected"
			creation_name_check_request = String(result.get("name", creation_name)).strip_edges()
			creation_name = creation_name_check_request.left(16)
		else:
			creation_stage = "confirm"
			if error_code == "STALE_TUTORIAL_DRAFT":
				var refreshed_draft: Variant = result.get("draft", null)
				var drafts: Array = roster.get("tutorial_drafts", ReleaseSave.empty_tutorial_drafts())
				if refreshed_draft is Dictionary and active_slot >= 0 and active_slot < drafts.size():
					drafts[active_slot] = (refreshed_draft as Dictionary).duplicate(true)
					roster["tutorial_drafts"] = drafts
					roster["active_tutorial_slot"] = active_slot
		pending_creation_candidate.clear()
		notify(String(result.get("message", "THE SERVER COULD NOT FILE THAT RESIDENT")).to_upper(), DANGER, 3.5)
		queue_redraw()
		return
	var canonical: Variant = result.get("resident", null)
	if canonical is not Dictionary:
		pending_creation_candidate.clear()
		creation_stage = "name"
		notify("THE SERVER RETURNED AN INVALID RESIDENT FILE", DANGER, 3.5)
		queue_redraw()
		return
	if active_slot >= 0 and active_slot < Array(roster.get("slots", [])).size():
		roster["slots"][active_slot] = (canonical as Dictionary).duplicate(true)
		var drafts: Array = roster.get("tutorial_drafts", ReleaseSave.empty_tutorial_drafts())
		drafts[active_slot] = null
		roster["tutorial_drafts"] = drafts
		roster["active_slot"] = active_slot
		roster["active_tutorial_slot"] = -1
	pending_creation_candidate.clear()
	load_character(canonical as Dictionary, active_slot)
	notify("INTAKE COMPLETE: AGE 21+ CONFIRMED  -  BED 6B ASSIGNED", GOOD, 5.0)
	queue_redraw()

func _on_lan_status_changed(message: String) -> void :
	lan_status = message
	var upper: = message.to_upper()
	if active_world_is_main_server:
		if "CONNECTED" in upper and not ("DISCONNECTED" in upper):
			main_server_connection_state = "online" if roster_server_owned else "checking"
		elif "RETRY" in upper or "RECONNECT" in upper or "CONTACTING" in upper:
			main_server_connection_state = "checking"
		elif "UNABLE TO CONNECT" in upper or "COULD NOT REACH" in upper or "SESSION ENDED" in upper:
			main_server_connection_state = "unavailable"
			main_server_online_players = -1
			lan_status = "Unable to connect to server"
			release_notice = "Unable to connect to server. Make sure the Agervis server and Playit are running, then try again."
			if main_server_direct_entry:
				mode = ScreenMode.TITLE
			main_server_direct_entry = false
	if "FAILED" in upper or "DISCONNECTED" in upper or "COULD NOT REACH" in upper or "UNABLE TO CONNECT" in upper:
