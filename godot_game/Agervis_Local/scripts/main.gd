func draw_facade_material_column(rect: Rect2, wall_tile: int, column: int) -> void :
	var material: = posmod(wall_tile, 6)
	var base: = Color("#6b6a63")
	match material:
		0: base = Color("#7d6a58")
		1: base = Color("#8a8579")
		2: base = Color("#5f6b70")
		3: base = Color("#6e6455")
		4: base = Color("#4f5453")
		5: base = Color("#847a66")

	var ashlar: = material == 1 or material == 4
	var course_h: = 22.0 if ashlar else 11.0
	var courses: = int(ceil(rect.size.y / course_h))
	for course in range(courses):
		var top: = rect.position.y + float(course) * course_h
		var band_h: = minf(course_h, rect.end.y - top)
		if band_h <= 0.0:
			break
		var shade: = float(posmod(course * 31 + column * 17, 4)) * 0.02
		draw_rect(Rect2(rect.position.x, top, rect.size.x, band_h), base.darkened(shade))

		draw_line(Vector2(rect.position.x, top + band_h - 1.0), Vector2(rect.end.x, top + band_h - 1.0), 
			base.darkened(0.26) if ashlar else base.lightened(0.14), 1.0)
		if low_spec:
			continue

		var unit_w: = 46.0 if ashlar else 26.0
		var stagger: = unit_w * 0.5 if posmod(course, 2) == 1 else 0.0
		var joint_x: = rect.position.x - stagger
		while joint_x < rect.end.x:
			if joint_x > rect.position.x:
				draw_line(Vector2(joint_x, top), Vector2(joint_x, top + band_h - 1.0), 
					base.darkened(0.22) if ashlar else base.lightened(0.1), 1.0)
			joint_x += unit_w

	if not low_spec:
		for streak in range(2):
			var sx: = rect.position.x + float(posmod(column * 53 + streak * 37, int(maxf(rect.size.x, 1.0))))
			draw_line(Vector2(sx, rect.position.y), Vector2(sx, rect.end.y), Color(0, 0, 0, 0.06), 5.0)

		if posmod(column, 5) == 2:
			var stain_x: = rect.position.x + float(posmod(column * 73, int(maxf(rect.size.x - 40, 1.0))))
			var stain_y: = rect.position.y + 60
			draw_circle(Vector2(stain_x, stain_y), 18, Color(0.1, 0.08, 0.06, 0.15))
			draw_circle(Vector2(stain_x + 3, stain_y + 25), 12, Color(0.08, 0.06, 0.04, 0.12))

		if posmod(column, 7) == 3:
			var rust_x: = rect.position.x + float(posmod(column * 89, int(maxf(rect.size.x - 20, 1.0))))
			draw_line(Vector2(rust_x, rect.position.y + 40), Vector2(rust_x - 2, rect.position.y + 90), Color(0.4, 0.2, 0.1, 0.2), 3.0)

		if posmod(column, 11) == 4:
			var graf_x: = rect.position.x + 20
			var graf_y: = rect.position.y + rect.size.y * 0.6

			draw_circle(Vector2(graf_x + 10, graf_y), 8, Color(0.15, 0.12, 0.18, 0.08))
			draw_line(Vector2(graf_x, graf_y - 5), Vector2(graf_x + 20, graf_y - 5), Color(0.12, 0.1, 0.15, 0.06), 2.0)

		if posmod(column, 13) == 5:
			var damage_x: = rect.position.x + float(posmod(column * 67, int(maxf(rect.size.x - 30, 1.0))))
			var damage_y: = rect.position.y + rect.size.y * 0.4
			draw_rect(Rect2(damage_x, damage_y, 12, 8), Color(0.05, 0.05, 0.05, 0.8))

			draw_rect(Rect2(damage_x + 2, damage_y + 2, 8, 4), Color("#1a1c1e"))

	draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, 7.0), base.lightened(0.16))
	draw_line(Vector2(rect.position.x, rect.position.y + 7.0), Vector2(rect.end.x, rect.position.y + 7.0), base.darkened(0.34), 2.0)
	draw_rect(Rect2(rect.position.x, rect.end.y - 10.0, rect.size.x, 10.0), base.darkened(0.22))






func draw_exterior_door_leaf(rect: Rect2, variant: int) -> void :
	var style: = posmod(variant, 9)


	var frame: = Color("#4a4b46")
	var leaf: = Color("#5c5f5e")
	match style:
		0: frame = Color("#5a5449");leaf = Color("#6a6558")
		1: frame = Color("#4f4038");leaf = Color("#6d5744")
		2: frame = Color("#8d9694");leaf = Color("#aab5b2")
		3: frame = Color("#4a3f39");leaf = Color("#5d5048")
		4: frame = Color("#3f4442");leaf = Color("#4d5350")
		5: frame = Color("#575a52");leaf = Color("#676b62")
		6: frame = Color("#453b33");leaf = Color("#5f4f42")
		7: frame = Color("#42403c");leaf = Color("#55524d")
		8: frame = Color("#39424f");leaf = Color("#48566a")
	var institutional: = style == 0 or style == 2 or style == 5 or style == 8
	var vestibule: = style == 1 or style == 6
	var shutter: = style == 3 or style == 7

	draw_rect(rect.grow(9.0), frame.darkened(0.5))
	draw_rect(rect.grow(5.0), frame)
	draw_rect(rect.grow(5.0), frame.darkened(0.45), false, 2.0)

	draw_rect(Rect2(rect.position.x - 11.0, rect.end.y - 5.0, rect.size.x + 22.0, 8.0), frame.lightened(0.22))
	draw_line(Vector2(rect.position.x - 11.0, rect.end.y - 5.0), Vector2(rect.end.x + 11.0, rect.end.y - 5.0), 
		frame.lightened(0.4), 1.0)
	draw_rect(rect, leaf)
	var mid_x: = rect.position.x + rect.size.x * 0.5
	if institutional:

		var transom: = Rect2(rect.position.x + 3.0, rect.position.y + 3.0, rect.size.x - 6.0, 17.0)
		draw_rect(transom, Color("#2b3538"))
		draw_rect(transom, frame.darkened(0.3), false, 1.0)
		draw_line(Vector2(transom.position.x + 2.0, transom.end.y - 3.0), 
			Vector2(transom.position.x + transom.size.x * 0.45, transom.position.y + 3.0), Color(1, 1, 1, 0.16), 2.0)
		for side in range(2):
			var lx: = rect.position.x + 4.0 + float(side) * (rect.size.x * 0.5 - 1.0)
			var light: = Rect2(lx, transom.end.y + 5.0, rect.size.x * 0.5 - 7.0, rect.size.y - (transom.size.y + 8.0) - 16.0)
			draw_rect(light, Color("#2f3b3f"))
			draw_rect(light, frame.darkened(0.28), false, 1.0)

			draw_line(light.position + Vector2(3.0, light.size.y - 4.0), 
				light.position + Vector2(light.size.x * 0.6, 4.0), Color(1, 1, 1, 0.13), 3.0)
			draw_line(light.position + Vector2(light.size.x * 0.45, light.size.y - 4.0), 
				light.position + Vector2(light.size.x - 3.0, light.size.y * 0.35), Color(1, 1, 1, 0.07), 2.0)

			var bar_y: = light.position.y + light.size.y * 0.52
			draw_rect(Rect2(light.position.x + 3.0, bar_y - 2.0, light.size.x - 6.0, 4.0), Color("#b6bcbd"))
			draw_rect(Rect2(light.position.x + 3.0, bar_y + 2.0, light.size.x - 6.0, 2.0), Color("#6f7577"))
		draw_line(Vector2(mid_x, transom.end.y + 5.0), Vector2(mid_x, rect.end.y - 14.0), frame.darkened(0.35), 2.0)
		draw_rect(Rect2(rect.position.x + 3.0, rect.end.y - 15.0, rect.size.x - 6.0, 12.0), leaf.darkened(0.24))
	elif vestibule:

		var fan: = Rect2(rect.position.x + 6.0, rect.position.y + 4.0, rect.size.x - 12.0, 14.0)
		draw_rect(fan, Color("#33403f"))
		draw_rect(fan, frame.darkened(0.3), false, 1.0)
		for ray in range(1, 4):
			var rx: = fan.position.x + float(ray) * fan.size.x / 4.0
			draw_line(Vector2(rx, fan.position.y + 1.0), Vector2(mid_x, fan.end.y - 1.0), Color(1, 1, 1, 0.12), 1.0)
		var body: = Rect2(rect.position.x + 5.0, fan.end.y + 6.0, rect.size.x - 10.0, rect.end.y - fan.end.y - 22.0)
		draw_rect(body, leaf.darkened(0.08))
		for panel in range(3):
			var ph: = body.size.y / 3.0 - 5.0
			var pr: = Rect2(body.position.x + 5.0, body.position.y + float(panel) * (body.size.y / 3.0) + 2.0, 
				body.size.x - 10.0, ph)
			draw_rect(pr, leaf.darkened(0.18))
			draw_rect(pr, leaf.lightened(0.16), false, 1.0)
			draw_line(pr.position + Vector2(2.0, 2.0), Vector2(pr.end.x - 2.0, pr.position.y + 2.0), leaf.darkened(0.34), 1.0)

		draw_circle(Vector2(rect.end.x - 14.0, body.position.y + body.size.y * 0.5), 4.0, Color("#c0a568"))
		draw_circle(Vector2(rect.end.x - 14.0, body.position.y + body.size.y * 0.5), 2.0, Color("#8a743f"))
		draw_rect(Rect2(mid_x - 11.0, body.end.y - 12.0, 22.0, 4.0), Color("#8a8f8c"))
		draw_rect(Rect2(rect.position.x + 3.0, rect.end.y - 16.0, rect.size.x - 6.0, 13.0), leaf.darkened(0.3))
	elif shutter:

		var housing: = Rect2(rect.position.x + 2.0, rect.position.y + 2.0, rect.size.x - 4.0, 12.0)
		draw_rect(housing, frame.lightened(0.12))
		draw_rect(housing, frame.darkened(0.35), false, 1.0)
		var curtain_bottom: = rect.position.y + rect.size.y * 0.46
		draw_rect(Rect2(rect.position.x + 3.0, housing.end.y, rect.size.x - 6.0, curtain_bottom - housing.end.y), 
			leaf.lightened(0.05))
		var slat_y: = housing.end.y + 3.0
		while slat_y < curtain_bottom:
			draw_line(Vector2(rect.position.x + 4.0, slat_y), Vector2(rect.end.x - 4.0, slat_y), leaf.darkened(0.3), 1.0)
			slat_y += 5.0
		draw_rect(Rect2(rect.position.x + 3.0, curtain_bottom - 4.0, rect.size.x - 6.0, 4.0), frame.darkened(0.3))

		var glass: = Rect2(rect.position.x + 5.0, curtain_bottom + 4.0, rect.size.x - 10.0, rect.end.y - curtain_bottom - 20.0)
		draw_rect(glass, Color("#242c2d"))
		draw_rect(glass, frame.darkened(0.3), false, 1.0)
		if not low_spec:
			for bar in range(1, 4):
				var bx: = glass.position.x + float(bar) * glass.size.x / 4.0
				draw_line(Vector2(bx, glass.position.y + 2.0), Vector2(bx, glass.end.y - 2.0), Color("#5a5f5c"), 2.0)
			draw_line(glass.position + Vector2(2.0, glass.size.y - 3.0), 
				glass.position + Vector2(glass.size.x * 0.5, 3.0), Color(1, 1, 1, 0.1), 2.0)
		draw_rect(Rect2(rect.position.x + 3.0, rect.end.y - 16.0, rect.size.x - 6.0, 13.0), leaf.darkened(0.28))
	else:

		draw_rect(rect.grow(-4.0), leaf.darkened(0.1))
		draw_rect(rect.grow(-4.0), leaf.lightened(0.12), false, 1.0)
		var port: = Rect2(mid_x - 13.0, rect.position.y + 16.0, 26.0, 20.0)
		draw_rect(port, Color("#2c3436"))
		draw_rect(port, frame.darkened(0.3), false, 1.0)
		for wire in range(1, 3):
			var wy: = port.position.y + float(wire) * port.size.y / 3.0
			draw_line(Vector2(port.position.x + 2.0, wy), Vector2(port.end.x - 2.0, wy), Color(1, 1, 1, 0.1), 1.0)
		draw_line(Vector2(mid_x, port.position.y + 2.0), Vector2(mid_x, port.end.y - 2.0), Color(1, 1, 1, 0.1), 1.0)

		draw_line(Vector2(rect.position.x + 8.0, rect.position.y + 9.0), Vector2(mid_x + 6.0, rect.position.y + 13.0), 
			Color("#7d8382"), 3.0)
		draw_rect(Rect2(rect.end.x - 20.0, rect.position.y + rect.size.y * 0.55, 13.0, 5.0), Color("#b3b8b8"))
		draw_rect(Rect2(rect.position.x + 3.0, rect.end.y - 20.0, rect.size.x - 6.0, 17.0), leaf.darkened(0.26))
		draw_line(Vector2(rect.position.x + 3.0, rect.end.y - 20.0), Vector2(rect.end.x - 3.0, rect.end.y - 20.0), 
			leaf.lightened(0.1), 1.0)

	draw_rect(Rect2(rect.position.x - 9.0, rect.position.y - 9.0, rect.size.x + 18.0, 5.0), Color(0, 0, 0, 0.22))

func draw_building_fire_escape(x: float, width: float, building_top: float, building_bottom: float, stories: int, floor_height: float) -> void :

	var escape_x: = x + width - 42.0
	var metal: = Color("#3d4244")
	var rust: = Color("#5a3828")

	for floor in range(1, stories):
		var platform_y: = building_bottom - 18.0 - floor * floor_height + floor_height * 0.5

		draw_rect(Rect2(escape_x, platform_y, 32, 3), metal)
		draw_line(Vector2(escape_x, platform_y), Vector2(escape_x + 32, platform_y), metal.lightened(0.15), 1.0)

		for grate in range(4):
			var gx: = escape_x + 6 + grate * 6
			draw_line(Vector2(gx, platform_y + 1), Vector2(gx, platform_y + 3), metal.darkened(0.3), 0.5)

		draw_line(Vector2(escape_x, platform_y - 16), Vector2(escape_x, platform_y), metal, 2.0)
		draw_line(Vector2(escape_x + 32, platform_y - 16), Vector2(escape_x + 32, platform_y), metal, 2.0)
		draw_line(Vector2(escape_x, platform_y - 16), Vector2(escape_x + 32, platform_y - 16), metal, 1.5)
		draw_line(Vector2(escape_x, platform_y - 8), Vector2(escape_x + 32, platform_y - 8), metal, 1.0)

		if floor < stories - 1:
			draw_line(Vector2(escape_x + 28, platform_y + 3), Vector2(escape_x + 28, platform_y + floor_height - 6), metal, 2.5)
			draw_line(Vector2(escape_x + 31, platform_y + 3), Vector2(escape_x + 31, platform_y + floor_height - 6), metal, 2.5)

			for rung in range(int(floor_height / 12)):
				var ry: = platform_y + 8 + rung * 12
				draw_line(Vector2(escape_x + 28, ry), Vector2(escape_x + 31, ry), metal, 2.0)

		if posmod(floor, 2) == 0:
			draw_circle(Vector2(escape_x + 8, platform_y + 1), 1.5, rust)

