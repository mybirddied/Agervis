func objective_guidance_target() -> Dictionary:
	if mode != ScreenMode.PLAY:
		return {}
	if carried_handoff("sealed_customer_envelope"):
		var moth: = actor_by_id("fence_moth")
		if moth != null and actor_visible_in_current_room(moth):
			return {"kind": "actor", "actor_id": "fence_moth"}
	var moth_handoff: = active_moth_package_handoff()
	if not moth_handoff.is_empty():
		var recipient_id: = String(moth_handoff.get("recipient_actor_id", ""))
		var recipient: = actor_by_id(recipient_id)
		if recipient != null and actor_visible_in_current_room(recipient):
			return {"kind": "actor", "actor_id": recipient_id}
	var capone_task: = active_capone_task()
	if not capone_task.is_empty():
		var capone_recipient_id: = String(capone_task.get("recipient_actor_id", ""))
		var capone_recipient: = actor_by_id(capone_recipient_id)
		if capone_recipient != null and actor_visible_in_current_room(capone_recipient):
			return {"kind": "actor", "actor_id": capone_recipient_id, "task_id": String(capone_task.get("id", ""))}
	var employer_target: = employer_guidance_target()
	if not employer_target.is_empty():
		return employer_target
	if phase == "tutorial" and area == "tutorial":
		if room_id == "orientation":
			if not bool(tutorial_flags.get("officer", false)):
				return {"kind": "record", "action_id": "tutorial_pike"}
			if not bool(tutorial_flags.get("detainee", false)):
				return {"kind": "record", "action_id": "tutorial_detainee"}
			return {"kind": "door", "target": "hall_a"}
		if room_id == "orientation_hall":
			if not tutorial_missing_orientation_people().is_empty():
				return {"kind": "door", "target": "orientation"}
			if tutorial_headstart.is_empty():
				return {"kind": "door", "target": "hall_a"}
	if objective.begins_with("File the apartment application"):
		if area == "social" and room_id == "lobby":
			return {"kind": "door", "target": "forms"}
		if area == "social" and room_id == "forms":
			return {"kind": "record", "action_id": "social_forms"}
	if objective.begins_with("Take the apartment application"):
		if area == "social" and room_id == "forms":
			return {"kind": "door", "target": "lobby"}
		if area == "social" and room_id == "lobby":
			return {"kind": "door", "target": "street"}
		if area == "apartment" and room_id == "lobby":
			return {"kind": "record", "action_id": "apartment_leasing"}
	if objective.begins_with("Enter your Mercy Court unit"):
		if area == "apartment" and room_id == "lobby":
			return {"kind": "door", "target": "stairs"}
		if area == "apartment" and room_id == "stairs":
			return {"kind": "record", "action_id": "apartment_elevator"}
		if area == "apartment" and room_id == "floor_1":
			return {"kind": "door", "target": "unit"}
		if area == "apartment" and room_id == "unit":
			return {"kind": "record", "action_id": "player_home_customize"}
	if objective.begins_with("Open your Mercy Court private storage") and area == "apartment" and room_id == "unit":
		return {"kind": "record", "action_id": "player_home_stash"}
	return {}

func employer_guidance_target() -> Dictionary:
	if phase != "adult":
		return {}
	if deposit_active:
		if area == "bank" and room_id == "lobby":
			return {"kind": "record", "action_id": "bank_job_deposit"}
		return {}
	var employer_id: = ""
	var task: = ""
	match active_job:
		"Cashier":
			employer_id = "boss_store"
			task = String(Dictionary(task_directors.get(employer_id, {})).get("task", cashier_current_task))
		"Carryout Worker":
			employer_id = "alibis"
			task = String(Dictionary(task_directors.get(employer_id, {})).get("task", ""))
		"Laundry Attendant":
			employer_id = "spin_cycle"
			task = String(Dictionary(task_directors.get(employer_id, {})).get("task", ""))
		"Capone Courier":
			var capone_task: = active_capone_task()
			if not capone_task.is_empty():
				var recipient: = actor_by_id(String(capone_task.get("recipient_actor_id", "")))
				if recipient != null and actor_visible_in_current_room(recipient):
					return {"kind": "actor", "actor_id": recipient.actor_id}
			return {}
		_:
			return {}
	var director: Dictionary = Dictionary(task_directors.get(employer_id, {}))
	if String(director.get("owner", "")) != player_name or String(director.get("state", "")) != "assigned":
		return {}
	var action_id: = ""
	if employer_id == "boss_store":
		action_id = {"register": "store_register", "stock": "store_stock", "clean": "store_clean"}.get(task, "")
	else:
		action_id = {
		"restaurant_counter": "restaurant_counter", "restaurant_prep": "restaurant_prep", 
		"laundry_washer": "laundry_wash", "laundry_fold_table": "laundry_fold", 
	}.get(service_task_object(employer_id, task), "")
	if action_id.is_empty() or current_room_object_record_for_action(action_id).is_empty():
		return {}
	return {"kind": "record", "action_id": action_id}

func draw_objective_guidance_arrow() -> void :
	if should_draw_tutorial_guidance_arrow():
		return
	var target: = objective_guidance_target()
	if target.is_empty():
		return
	draw_guidance_arrow_target(target)

func draw_guidance_arrow_target(target: Dictionary) -> void :
	var pulse: = 0.0 if low_spec else sin(elapsed * 5.0) * 5.0
	var center: = Vector2.ZERO
	var kind: = String(target.get("kind", ""))
	if kind == "door":
		var door: = nearest_build10_room_door_to(String(target.get("target", "")))
		if door.is_empty():
			return
		var door_screen_x: = scene_position(door.get("point", Vector2.ZERO) as Vector2).x
		center = Vector2(door_screen_x, ARCH_FLOOR_Y - AUTHORED_DOOR_HEIGHT - 28.0 + pulse)
	elif kind == "actor":
		var actor: = actor_by_id(String(target.get("actor_id", "")))
		if actor == null or not actor_visible_in_current_room(actor):
			return
		center = scene_position(actor.position) + Vector2(0, -92.0 + pulse)
	else:
		var record: = current_room_object_record_for_action(String(target.get("action_id", "")))
		if record.is_empty():
			return
		center = scene_position(record.get("position", Vector2.ZERO) as Vector2) + Vector2(0, -92.0 + pulse)
	draw_guidance_arrow_at(center, Color(0.32, 0.92, 0.42, tutorial_guidance_arrow_alpha(elapsed)))

func draw_guidance_arrow_at(center: Vector2, tone: Color) -> void :
	var outline: = Color(0.04, 0.16, 0.07, minf(0.94, tone.a + 0.26))
	var stem: = Rect2(center + Vector2(-5, -27), Vector2(10, 30))
	draw_rect(stem, outline)
	draw_rect(Rect2(stem.position + Vector2(2, 2), stem.size - Vector2(4, 4)), tone)
	draw_colored_polygon(PackedVector2Array([
		center + Vector2(-24, 0), 
		center + Vector2(24, 0), 
		center + Vector2(0, 28), 
	]), outline)
	draw_colored_polygon(PackedVector2Array([
		center + Vector2(-17, 2), 
		center + Vector2(17, 2), 
		center + Vector2(0, 21), 
	]), tone)

func draw_hostile_arrow_at(center: Vector2) -> void :
	var pulse: = 0.0 if low_spec else sin(elapsed * 5.0) * 5.0
	draw_guidance_arrow_at(center + Vector2(0, pulse), Color(0.95, 0.2, 0.2, 0.92))

func draw_tutorial_guidance_arrow() -> void :
	if not should_draw_tutorial_guidance_arrow():
		return
	var pulse: = 0.0 if low_spec else sin(elapsed * 5.0) * 5.0
	var flash: = tutorial_guidance_arrow_alpha(elapsed)
	var center: = Vector2.ZERO
	if tutorial_guidance_arrow_targets_door():
		var orientation_door: = nearest_build10_room_door_to("orientation_hall")
		if orientation_door.is_empty():
			return
		var door_screen_x: = scene_position(orientation_door.get("point", Vector2.ZERO) as Vector2).x
		center = Vector2(door_screen_x, ARCH_FLOOR_Y - AUTHORED_DOOR_HEIGHT - 28.0 + pulse)
	else:
		var counselor_record: = current_room_object_record_for_action("tutorial_counselor")
		if counselor_record.is_empty():
			return
		var target: = scene_position(counselor_record.get("position", Vector2.ZERO) as Vector2)
		center = target + Vector2(0, -92.0 + pulse)
	var tone: = Color(0.32, 0.92, 0.42, flash)
	var outline: = Color(0.04, 0.16, 0.07, minf(0.94, flash + 0.26))
	var stem: = Rect2(center + Vector2(-5, -27), Vector2(10, 30))
	draw_rect(stem, outline)
	draw_rect(Rect2(stem.position + Vector2(2, 2), stem.size - Vector2(4, 4)), tone)
	var points: = PackedVector2Array([
		center + Vector2(-24, 0), 
		center + Vector2(24, 0), 
		center + Vector2(0, 28), 
	])
	draw_colored_polygon(points, outline)
	draw_colored_polygon(PackedVector2Array([
		center + Vector2(-17, 2), 
		center + Vector2(17, 2), 
		center + Vector2(0, 21), 
	]), tone)

func should_draw_tutorial_guidance_arrow() -> bool:
	return mode == ScreenMode.PLAY and phase == "tutorial" and area == "tutorial" and room_id == "guidance" and ( not bool(tutorial_flags.get("counselor", false)) or not bool(tutorial_flags.get("guidance_exit", false)))

func tutorial_guidance_arrow_targets_door() -> bool:
	return bool(tutorial_flags.get("counselor", false)) and not bool(tutorial_flags.get("guidance_exit", false))

func tutorial_guidance_arrow_alpha(at_elapsed: float) -> float:
	if low_spec:
		return 0.38 if posmod(floori(at_elapsed * 3.0), 2) == 0 else 0.82
	return 0.42 + (sin(at_elapsed * 7.0) + 1.0) * 0.22
