func face_requirement_lines() -> Array[String]:
	var lines: Array[String] = ["F.A.C.E.  -  FUNCTION, ACCESS, CREDENTIALS & EXPERTISE"]
	lines.append(function_requirement_line("Certified Courier", has_secondary_credential() and skill_level("Enterprise") >= 5 and skill_level("Agility") >= 4 and deliveries_completed >= 3))
	lines.append("  Secondary credential %s | Enterprise %d/5 | Agility %d/4 | sealed deliveries %d/3" % ["YES" if has_secondary_credential() else "NO", skill_level("Enterprise"), skill_level("Agility"), deliveries_completed])
	lines.append(function_requirement_line("Loss Prevention Officer", "Basic Security Orientation" in credentials and skill_level("Safety") >= 5 and skill_level("Awareness") >= 5 and patrols_completed >= 3 and not warrant))
	lines.append("  Safety %d/5 | Awareness %d/5 | patrol loops %d/3 | active warrant %s" % [skill_level("Safety"), skill_level("Awareness"), patrols_completed, "YES" if warrant else "NO"])
	lines.append(function_requirement_line("Lookout", skill_level("Awareness") >= 5 and skill_level("Stealth") >= 5 and criminal_errands_completed >= 3))
	lines.append("  Awareness %d/5 | Stealth %d/5 | criminal errands %d/3" % [skill_level("Awareness"), skill_level("Stealth"), criminal_errands_completed])
	return lines

func function_requirement_line(function_name: String, available: bool) -> String:
	return "%s  -  %s%s" % [function_name, "AVAILABLE" if available else "LOCKED", " (CURRENT)" if official_function == function_name else ""]

func available_second_function() -> String:
	if has_secondary_credential() and skill_level("Enterprise") >= 5 and skill_level("Agility") >= 4 and deliveries_completed >= 3: return "Certified Courier"
	if "Basic Security Orientation" in credentials and skill_level("Safety") >= 5 and skill_level("Awareness") >= 5 and patrols_completed >= 3 and not warrant: return "Loss Prevention Officer"
	if skill_level("Awareness") >= 5 and skill_level("Stealth") >= 5 and criminal_errands_completed >= 3: return "Lookout"
	return ""

