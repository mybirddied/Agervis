	draw_rect(Rect2(left + 10, 350, 100, 12), Color("#545450"))
	draw_rect(Rect2(left + 10, 350, 100, 12), Color.BLACK, false, 1.5)
	draw_line(Vector2(left + 12, 351), Vector2(left + 108, 351), Color("#646460"), 2.0)

	for line_x in [left + 8.0, left + width - 8.0]:
		draw_line(Vector2(line_x, 380), Vector2(line_x, 432), Color("#d6ca91"), 3.0)
		draw_line(Vector2(line_x, 380), Vector2(line_x, 432), Color("#d6ca91").darkened(0.3), 1.0)

	draw_rect(Rect2(left + 20, 272, width - 40, 166), Color("#3b3935"))
	draw_rect(Rect2(left + width * 0.46, 330, 105, 108), Color("#202528"))
	draw_centered("MARROW CUT", Vector2(left + width * 0.46 + 52.5, 352), 10, Color("#8b8178"))
	for seam_y in [348.0, 377.0, 406.0]: draw_line(Vector2(left + width * 0.46, seam_y), Vector2(left + width * 0.46 + 105, seam_y), Color("#555a58"), 2)
	draw_rect(Rect2(left + 92, 338, 55, 72), Color("#4b514e"))
	for conduit in [left + 103.0, left + 124.0, left + 138.0]: draw_line(Vector2(conduit, 264), Vector2(conduit, 338), Color("#676c67"), 4)
	var escape_x: = left + width - 118.0
	for landing_y in [248.0, 312.0, 374.0]:
		draw_rect(Rect2(escape_x, landing_y, 88, 8), Color("#24292a"))
		draw_line(Vector2(escape_x, landing_y), Vector2(escape_x + 88, landing_y), Color("#69706e"), 2)
	for rail_x in [escape_x, escape_x + 22.0, escape_x + 44.0, escape_x + 66.0, escape_x + 88.0]: draw_line(Vector2(rail_x, 240), Vector2(rail_x, 390), Color("#4f5655"), 3)
	draw_line(Vector2(escape_x + 75, 382), Vector2(escape_x + 20, 438), Color("#555d5b"), 5)
	draw_line(Vector2(escape_x + 88, 382), Vector2(escape_x + 34, 438), Color("#555d5b"), 5)
	for trash_x in [left + 180.0, left + 210.0, left + width - 180.0]: draw_circle(Vector2(trash_x, 425), 17, Color("#171a1b"))

func draw_parkour_routes(offset: float) -> void :
	var routes: = parkour_routes()
	for index in range(routes.size()):
		var route: Dictionary = routes[index]
		var route_x: = float(route["center"]) - offset
		if route_x < -100.0 or route_x > 1380.0: continue
		var route_kind: = String(route.get("kind", "fence"))
		match route_kind:
			"dumpster":

				draw_flat_ellipse(Vector2(route_x, 425), Vector2(75, 8), Color(0.02, 0.025, 0.028, 0.5))

				draw_rect(Rect2(route_x - 68, 365, 136, 58), Color("#344446"))
				draw_rect(Rect2(route_x - 74, 354, 148, 15), Color("#222d30"))

				draw_line(Vector2(route_x - 61, 377), Vector2(route_x + 61, 377), Color("#667477"), 3)
				draw_line(Vector2(route_x - 54, 389), Vector2(route_x + 54, 408), Color("#556467"), 2)

				draw_rect(Rect2(route_x + 28, 382, 24, 17), Color("#9d873c"))

				draw_circle(Vector2(route_x - 46, 429), 9, Color("#171b1c"))
				draw_circle(Vector2(route_x + 46, 429), 9, Color("#171b1c"))
				if not low_spec:

					draw_line(Vector2(route_x - 35, 370), Vector2(route_x - 28, 378), Color("#2a3638"), 2)
					draw_line(Vector2(route_x + 15, 395), Vector2(route_x + 22, 402), Color("#2a3638"), 2)

					draw_rect(Rect2(route_x - 8, 358, 16, 8), Color("#3a3f41"))
					draw_circle(Vector2(route_x, 362), 3, Color("#1a1d1e"))
			"fence":

				draw_rect(Rect2(route_x - 62, 435, 124, 3), Color(0.02, 0.025, 0.028, 0.3))

				draw_rect(Rect2(route_x - 62, 350, 124, 88), Color("#303735"))
				for rail_x in range(-54, 55, 18):
					draw_line(Vector2(route_x + rail_x, 352), Vector2(route_x + rail_x, 438), Color("#69706d"), 2)
				for mesh_y in range(360, 431, 18):
					draw_line(Vector2(route_x - 60, mesh_y), Vector2(route_x + 60, mesh_y), Color(0.44, 0.47, 0.45, 0.55), 1)
				if not low_spec:

					draw_line(Vector2(route_x + 12, 380), Vector2(route_x + 20, 395), Color("#69706d"), 3)

					draw_line(Vector2(route_x - 62, 352), Vector2(route_x + 62, 352), Color("#5a615e"), 1.5)
					for spike_x in range(int(route_x - 54), int(route_x + 55), 12):
						draw_line(Vector2(spike_x, 352), Vector2(spike_x + 3, 348), Color("#5a615e"), 1)
			"fire_escape":

				draw_flat_ellipse(Vector2(route_x, 435), Vector2(60, 6), Color(0.02, 0.025, 0.028, 0.4))
				for landing_y in [318.0, 362.0, 406.0]:

					draw_rect(Rect2(route_x - 55, landing_y, 110, 7), Color("#5c6461"))
					draw_line(Vector2(route_x - 55, landing_y), Vector2(route_x + 55, landing_y), Color("#6c7371"), 1.5)

					if not low_spec:
						for grate_x in range(int(route_x - 50), int(route_x + 50), 8):
							draw_line(Vector2(grate_x, landing_y + 1), Vector2(grate_x, landing_y + 6), Color("#4a504d"), 1)
				for rail_x in [-48.0, -24.0, 0.0, 24.0, 48.0]:
					draw_line(Vector2(route_x + rail_x, 310), Vector2(route_x + rail_x, 434), Color("#4f5655"), 3)
				if not low_spec:

					for bolt_y in [320.0, 365.0, 410.0]:
						for bolt_x in [-48.0, 0.0, 48.0]:
							draw_circle(Vector2(route_x + bolt_x, bolt_y), 2, Color("#2a2f30"))
			"ladder":

				draw_rect(Rect2(route_x - 22, 435, 44, 3), Color(0.02, 0.025, 0.028, 0.3))

				draw_line(Vector2(route_x - 20, 310), Vector2(route_x - 20, 438), Color("#656c69"), 5)
				draw_line(Vector2(route_x + 20, 310), Vector2(route_x + 20, 438), Color("#656c69"), 5)

				draw_line(Vector2(route_x - 19, 310), Vector2(route_x - 19, 438), Color("#757c79"), 1.5)
				draw_line(Vector2(route_x + 21, 310), Vector2(route_x + 21, 438), Color("#757c79"), 1.5)

				for rung_y in range(320, 431, 18):
					draw_line(Vector2(route_x - 20, rung_y), Vector2(route_x + 20, rung_y), Color("#7b817d"), 3)
					if not low_spec:
						draw_line(Vector2(route_x - 20, rung_y - 1), Vector2(route_x + 20, rung_y - 1), Color("#8b918d"), 1)
			"gap":

				for stripe in range(-54, 55, 18):
					draw_line(Vector2(route_x + stripe, 410), Vector2(route_x + stripe + 12, 432), DANGER.darkened(0.2), 4)

				if not low_spec:
					draw_rect(Rect2(route_x - 60, 408, 8, 24), DANGER.darkened(0.3))
					draw_rect(Rect2(route_x + 52, 408, 8, 24), DANGER.darkened(0.3))
		var approach: = parkour_route_approach_point(route)
		if player_position.distance_to(approach) < 210.0:
			draw_station(approach, "CLIMB FROM ABOVE" if parkour_route_requires_lower_approach(route) else "CROSS GAP", false)

func draw_traffic(offset: float) -> void :


	var road_stripe_color: = Color("#d4b830")
	var stripe_segments: = 20
	var segment_length: = 80.0
	var segment_gap: = 60.0
	for seg in range(stripe_segments):
		var stripe_x: float = seg * (segment_length + segment_gap) - fmod(offset, segment_length + segment_gap)
		if stripe_x > - segment_length and stripe_x < VIEW_SIZE.x:
			draw_rect(Rect2(stripe_x, 519, segment_length, 6), road_stripe_color)


	var detail_seed: = int(offset / 200.0)
	for detail_offset in range(-2, 8):
		var detail_world_x: = (detail_seed + detail_offset) * 200.0
		var detail_screen_x: float = detail_world_x - offset

		if detail_screen_x < -100 or detail_screen_x > VIEW_SIZE.x + 100:
			continue

		var detail_type: = posmod(detail_seed + detail_offset, 7)

		match detail_type:
			0:
				draw_circle(Vector2(detail_screen_x + 50, 490), 9, Color("#0a0a0a", 0.45))
				draw_circle(Vector2(detail_screen_x + 52, 491), 7, Color("#050505", 0.35))
			1:
				draw_circle(Vector2(detail_screen_x + 80, 505), 16, Color("#1a1614", 0.5))
				draw_circle(Vector2(detail_screen_x + 85, 508), 13, Color("#0f0e0d", 0.4))
			2:
				draw_line(Vector2(detail_screen_x + 30, 495), Vector2(detail_screen_x + 110, 500), Color("#2a2826", 0.6), 3.0)
				draw_line(Vector2(detail_screen_x + 32, 500), Vector2(detail_screen_x + 112, 505), Color("#2a2826", 0.6), 3.0)
			3:
				draw_circle(Vector2(detail_screen_x + 120, 540), 11, Color("#0a0a0a", 0.45))
				draw_circle(Vector2(detail_screen_x + 122, 542), 8, Color("#050505", 0.35))
			4:
				draw_rect(Rect2(detail_screen_x + 60, 510, 8, 6), Color("#3a3634", 0.7))
				draw_circle(Vector2(detail_screen_x + 140, 530), 3, Color("#4a3a2a", 0.8))
			5:
				draw_circle(Vector2(detail_screen_x + 90, 548), 18, Color("#1a1614", 0.5))
				draw_circle(Vector2(detail_screen_x + 95, 551), 14, Color("#0f0e0d", 0.4))
			6:
				draw_line(Vector2(detail_screen_x + 40, 500), Vector2(detail_screen_x + 90, 540), Color("#2a2826", 0.6), 3.0)
				draw_line(Vector2(detail_screen_x + 44, 500), Vector2(detail_screen_x + 94, 540), Color("#2a2826", 0.6), 3.0)

	for car in traffic:
		var x: = float(car["x"]) - offset
		if x < -230 or x > 1510:
			continue
		var direction: = float(car["direction"])
		var color: Color = car["color"]
		var style: = String(car.get("style", "hooptie"))
		var is_police: = bool(car.get("police", false))
		var y_offset: = -50.0 if direction < 0 else 50.0


		var tint_index: = int(car["traffic_id"]) % 4
		var window_tint: Color
		match tint_index:
			0: window_tint = Color("#1b272e")
			1: window_tint = Color("#3a4248")
			2: window_tint = Color("#2d3438")
			_: window_tint = Color("#4a5258")
		if is_police:
			window_tint = Color("#2a2d30")


		draw_flat_ellipse(Vector2(x, 584 + y_offset), Vector2(98, 14), Color(0.02, 0.02, 0.025, 0.54))


		var body: = Rect2(x - 98, 522 + y_offset, 196, 51)
		draw_rect(body.grow(1), Color(0, 0, 0, 0.25))
		draw_rect(body, color.darkened(0.08))


		if is_police:
			var accent_color: Color = car.get("accent_color", Color("#17191b"))
			draw_rect(Rect2(x - 98, 522 + y_offset, 65, 51), accent_color)
			draw_rect(Rect2(x + 33, 522 + y_offset, 65, 51), accent_color)

		draw_rect(body, Color.BLACK, false, 2.0)


		draw_line(Vector2(x - 32, 522 + y_offset), Vector2(x - 32, 573 + y_offset), Color.BLACK.lightened(0.15), 1.0)
		draw_line(Vector2(x + 12, 522 + y_offset), Vector2(x + 12, 573 + y_offset), Color.BLACK.lightened(0.15), 1.0)


		draw_colored_polygon(PackedVector2Array([
			Vector2(x - 62, 522 + y_offset), Vector2(x - 32, 487 + y_offset), 
			Vector2(x + 47, 487 + y_offset), Vector2(x + 76, 522 + y_offset), 
		]), color)
		draw_polyline(PackedVector2Array([
			Vector2(x - 62, 522 + y_offset), Vector2(x - 32, 487 + y_offset), 
			Vector2(x + 47, 487 + y_offset), Vector2(x + 76, 522 + y_offset), 
		]), Color.BLACK, 2.0)


		if is_police:
			var bar: = Rect2(x - 22, 482 + y_offset, 44, 6)
			draw_rect(bar, Color("#2a2d2f"))
			draw_rect(bar, Color.BLACK, false, 1.0)
			var light_pulse: = int(elapsed * 8.0) % 2
			draw_rect(Rect2(x - 18, 483 + y_offset, 8, 4), Color("#e03a42") if light_pulse == 0 else Color("#3a4ade"))
			draw_rect(Rect2(x + 10, 483 + y_offset, 8, 4), Color("#3a4ade") if light_pulse == 0 else Color("#e03a42"))


		draw_colored_polygon(PackedVector2Array([
			Vector2(x - 27, 493 + y_offset), Vector2(x + 6, 493 + y_offset), 
			Vector2(x + 6, 518 + y_offset), Vector2(x - 49, 518 + y_offset)
		]), window_tint)
		draw_polyline(PackedVector2Array([
			Vector2(x - 27, 493 + y_offset), Vector2(x + 6, 493 + y_offset), 
			Vector2(x + 6, 518 + y_offset), Vector2(x - 49, 518 + y_offset), Vector2(x - 27, 493 + y_offset)
		]), Color.BLACK, 1.5)
		draw_line(Vector2(x - 25, 495 + y_offset), Vector2(x + 4, 495 + y_offset), Color(0.3, 0.35, 0.4, 0.4), 2.0)


		draw_colored_polygon(PackedVector2Array([
			Vector2(x + 12, 493 + y_offset), Vector2(x + 43, 493 + y_offset), 
			Vector2(x + 65, 518 + y_offset), Vector2(x + 12, 518 + y_offset)
		]), window_tint.darkened(0.05))
		draw_polyline(PackedVector2Array([
			Vector2(x + 12, 493 + y_offset), Vector2(x + 43, 493 + y_offset), 
			Vector2(x + 65, 518 + y_offset), Vector2(x + 12, 518 + y_offset), Vector2(x + 12, 493 + y_offset)
		]), Color.BLACK, 1.5)
		draw_line(Vector2(x + 14, 495 + y_offset), Vector2(x + 41, 495 + y_offset), Color(0.3, 0.35, 0.4, 0.4), 2.0)


		var mirror_left: = Vector2(x - 62, 508 + y_offset)
		var mirror_right: = Vector2(x + 76, 508 + y_offset)
		draw_colored_polygon(PackedVector2Array([
			mirror_left + Vector2(-8, -4), mirror_left + Vector2(-2, -2), 
			mirror_left + Vector2(-2, 2), mirror_left + Vector2(-8, 4)
		]), color.darkened(0.15))
		draw_colored_polygon(PackedVector2Array([
			mirror_right + Vector2(2, -2), mirror_right + Vector2(8, -4), 
			mirror_right + Vector2(8, 4), mirror_right + Vector2(2, 2)
		]), color.darkened(0.15))


		draw_rect(Rect2(x - 8, 540 + y_offset, 6, 3), Color.BLACK.lightened(0.2))
		draw_rect(Rect2(x + 32, 540 + y_offset, 6, 3), Color.BLACK.lightened(0.2))


		draw_line(Vector2(x - 96, 548 + y_offset), Vector2(x + 96, 548 + y_offset), color.lightened(0.17), 3)
		draw_line(Vector2(x - 96, 547 + y_offset), Vector2(x + 96, 547 + y_offset), color.lightened(0.27), 1.5)


		var light_pos: = x + 89 * direction
		draw_circle(Vector2(light_pos, 540 + y_offset), 7, Color("#2a2d2f"))
		draw_circle(Vector2(light_pos, 540 + y_offset), 6, Color("#e0c078"))
		draw_circle(Vector2(light_pos, 538 + y_offset), 2, Color("#fff4d2"))


		var wheel_radius: = 19.0 if style == "hoodrich" or is_police else 17.0
		for wheel_x in [x - 62.0, x + 62.0]:
			var wheel_center: = Vector2(wheel_x, 571 + y_offset)
			draw_circle(wheel_center + Vector2(1, 2), wheel_radius + 1, Color(0, 0, 0, 0.4))
			draw_circle(wheel_center, wheel_radius, Color("#111315"))
			draw_circle(wheel_center, wheel_radius, Color.BLACK, false, 2.0)

			if not low_spec:
				for tread_angle in range(0, 360, 45):
					var angle_rad: = deg_to_rad(tread_angle)
					var tread_start: = wheel_center + Vector2(cos(angle_rad), sin(angle_rad)) * (wheel_radius - 3)
					var tread_end: = wheel_center + Vector2(cos(angle_rad), sin(angle_rad)) * (wheel_radius - 1)
					draw_line(tread_start, tread_end, Color("#0a0b0c"), 1.5)


			draw_circle(wheel_center, wheel_radius * 0.7, Color("#4a4d4f"))
			draw_circle(wheel_center, wheel_radius * 0.6, Color("#3a3d3f"))
			draw_circle(wheel_center, wheel_radius * 0.6, Color.BLACK, false, 1.5)
			draw_arc(wheel_center, wheel_radius * 0.55, - PI * 0.7, - PI * 0.3, 12, Color("#6a6d6f"), 2.0, true)
			draw_circle(wheel_center, 11 if style == "hoodrich" or is_police else 7, Color("#a6a39b") if style == "hoodrich" or is_police else Color("#68645e"))
			draw_circle(wheel_center, 3, Color("#25282a"))

			if not low_spec and (style == "hoodrich" or is_police):
				for spoke in range(5):
					var spoke_angle: = deg_to_rad(spoke * 72)
					draw_line(wheel_center, wheel_center + Vector2(cos(spoke_angle), sin(spoke_angle)) * 6, Color("#8a8d8b"), 1.5)


		if style == "hoodrich" or is_police:
			draw_line(Vector2(x - 95, 540 + y_offset), Vector2(x + 95, 540 + y_offset), ACCENT.darkened(0.15), 2)
			draw_rect(Rect2(x + (79.0 if direction > 0.0 else -103.0), 496 + y_offset, 24, 6), color.darkened(0.25))
		elif style == "hooptie":
			draw_rect(Rect2(x - 87, 528 + y_offset, 45, 29), color.lightened(0.12))
			draw_line(Vector2(x - 99, 569 + y_offset), Vector2(x - 70, 574 + y_offset), Color("#77726a"), 5)
			if not low_spec:
				for puff in range(2):
					draw_circle(Vector2(x - 108 * direction - puff * 11 * direction, 556 + y_offset - puff * 8), 7 + puff * 3, Color(0.5, 0.52, 0.52, 0.12))


		var plate_x: = x - 85 * direction
		draw_rect(Rect2(plate_x - 12, 552 + y_offset, 24, 8), Color("#e8e4d6"))
		draw_rect(Rect2(plate_x - 12, 552 + y_offset, 24, 8), Color.BLACK, false, 1.0)


		if float(car.get("muzzle_timer", 0.0)) > 0.0:
			var muzzle: = Vector2(x + 31 * direction, 506 + y_offset)
			draw_circle(muzzle, 9, ACCENT)
			draw_circle(muzzle + Vector2(7 * direction, -2), 4, Color("#fff0ba"))


	for car in traffic:
		if bool(car.get("player_noticed", false)) and float(car.get("exclamation_timer", 0.0)) > 0.0:
			var player_screen: = scene_position(player_position)
			draw_circle(player_screen + Vector2(0, -95), 28, Color.WHITE)
			draw_circle(player_screen + Vector2(0, -95), 28, Color.BLACK, false, 2.5)
			draw_circle(player_screen + Vector2(-12, -72), 8, Color.WHITE)
			draw_circle(player_screen + Vector2(-12, -72), 8, Color.BLACK, false, 1.5)
			draw_circle(player_screen + Vector2(-6, -65), 5, Color.WHITE)
			draw_circle(player_screen + Vector2(-6, -65), 5, Color.BLACK, false, 1.0)
			draw_rect(Rect2(player_screen.x - 4, player_screen.y - 108, 8, 18), DANGER)
			draw_circle(player_screen + Vector2(0, -87), 4, DANGER)
			break


	for car in traffic:
		if bool(car.get("officer_dismounted", false)):
			var officer_pos: Vector2 = car["officer_position"]
			var officer_screen: = scene_position(officer_pos)
			draw_circle(officer_screen + Vector2(0, 2), 20, Color(0, 0, 0, 0.3))
			draw_circle(officer_screen, 18, Color("#5e7fa6"))
			draw_circle(officer_screen, 18, Color.BLACK, false, 2.0)
			draw_circle(officer_screen + Vector2(0, -24), 12, Color("#9b664a"))
			draw_circle(officer_screen + Vector2(0, -24), 12, Color.BLACK, false, 1.5)
			var gun_dir: = signf(player_position.x - officer_pos.x)
			draw_line(officer_screen + Vector2(12 * gun_dir, -8), officer_screen + Vector2(32 * gun_dir, -12), Color("#2a2d2f"), 5.0)
			draw_line(officer_screen + Vector2(12 * gun_dir, -8), officer_screen + Vector2(32 * gun_dir, -12), Color("#4a4d4f"), 3.0)

func draw_patrol_point(x: float, completed: bool) -> void :
	var tone: = GOOD if completed else Color("#77736d")

	draw_circle(Vector2(x, 493), 10, Color(0, 0, 0, 0.35))
	draw_circle(Vector2(x, 492), 8, tone)
	draw_circle(Vector2(x, 492), 8, Color.BLACK, false, 1.5)

	if completed:
