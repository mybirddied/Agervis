		draw_rect(rect, premium_bg)


		if not low_spec:
			for stripe in range(12):
				var stripe_x: = rect.position.x + stripe * 30
				draw_line(Vector2(stripe_x, rect.position.y), Vector2(stripe_x + 30, rect.end.y), Color(0.05, 0.05, 0.055, 0.3), 8.0)


		var premium_border: = ACCENT if selected else Color("#4f4d49")
		draw_rect(rect, premium_border, false, 2.0)


