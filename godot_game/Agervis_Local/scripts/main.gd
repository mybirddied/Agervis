func firearms_dummy_outcome_summary(outcome_id: String) -> String:
	if outcome_id.begins_with("injury_"):
		var injury_id: = outcome_id.trim_prefix("injury_")
		var injury: Dictionary = FIREARMS_LASTING_INJURIES.get(injury_id, {})
		return "%s - %s: %s" % [String(injury.get("tool", "Practice Tool")), String(injury.get("label", "Lasting Injury")), String(injury.get("consequence", "Permanent consequence."))]
	match outcome_id:
		"down": return "School BB Gun: the dummy is downed, alive, and inside a disposition window."
		"rob": return "Practice Wallet Tag: unsecured carried property may be taken; credentials, housing, and bank funds remain protected."
		"restrain": return "Foam Restraint Cuff: a living target is preserved for lawful arrest when authority and legal cause exist."
		"stabilize": return "Training Aid Kit: stabilization ends immediate danger and preserves the target for recovery."
		"leave": return "Walk away: no further disposition is committed, but the downed target remains vulnerable until somebody intervenes."
		"fatal": return "Red Finality Key: fatality is permanent, ends arrest, and creates body evidence."
	return "The classroom filed an outcome without a readable category."

func firearms_teacher_reaction(outcome_id: String) -> String:
	if outcome_id.begins_with("injury_"):
		var injury: Dictionary = FIREARMS_LASTING_INJURIES.get(outcome_id.trim_prefix("injury_"), {})
		return String(injury.get("reaction", "That is a permanent injury. Treatment may mitigate it, not erase it."))
	match outcome_id:
		"down": return "Good. The dummy is down, not dead. The city has opened a disposition window and filed the difference under optional literacy."
		"rob": return "Unsecured carried cash and contraband can be taken from a downed person. Bank funds and credentials stay protected. The dummy has now learned to bank."
		"restrain": return "Restraint preserves a target for arrest. Authority, Heat, or a warrant still matter; enthusiasm is not a credential."
		"stabilize": return "Stabilizing ends the immediate danger and preserves the person. The school counts preservation as advanced marksmanship."
		"leave": return "Walking away commits no further disposition. Somebody else may help, rob, restrain, or make a permanent attempt before the window closes."
		"fatal": return "Fatality is permanent, ends arrest, and leaves body evidence. The dummy's family was notified through a reusable label."
	return "The outcome is mechanically real enough for the curriculum and physically harmless enough for the insurance form."

func award_firearms_practice_xp(outcome_id: String) -> int:
	if outcome_id in firearms_practice_completed:
		return 0
	if reject_unsupported_online_mutation("EDUCATION REWARD"):
		return -1
	var max_level: = current_skill_classroom_max_level()
	if skill_level("Firearms") >= max_level:
		return 0
	var current_xp: = int(skills.get("Firearms", 0))
	var ceiling_xp: = Rules.xp_for_level(max_level + 1) - 1
	var reward: = mini(FIREARMS_PRACTICE_XP, maxi(0, ceiling_xp - current_xp))
	if reward <= 0:
		return 0
	grant_xp("Firearms", reward)
	if int(skills.get("Firearms", 0)) > current_xp:
		firearms_practice_completed[outcome_id] = true
		save_current_character("FIREARMS DUMMY PRACTICE")
		return reward
	return -1

func current_firearms_dummy_record() -> Dictionary:
	if not in_firearms_practice_room():
		return {}
	for record in current_room_object_records():
		if String(record.get("action_id", "")) == "firearms_disposition_dummy":
			return record.duplicate(true)
	return {}

func resolve_firearms_dummy_outcome(outcome_id: String) -> bool:
	if not in_firearms_practice_room() or not firearms_practice_kit_issued:
		return false
	if outcome_id == "down":
		if firearms_dummy_state != "ready":
			return false
	else:
		if firearms_dummy_state != "downed":
			return false
	if online_authority_enforced():
		var dummy: = current_firearms_dummy_record()
		if dummy.is_empty():
			return false
		return submit_online_economy_request("SCHOOL_DUMMY_OUTCOME", {
			"dummy_instance_id": String(dummy.get("instance_id", "")), 
			"outcome_id": outcome_id, 
		}, true, {"outcome_id": outcome_id})
	if outcome_id == "down":
		firearms_dummy_state = "downed"
	else:
		firearms_dummy_state = outcome_id
	firearms_dummy_outcome = outcome_id
	firearms_teacher_reaction_text = firearms_teacher_reaction(outcome_id)
	firearms_teacher_reaction_timer = 10.0
	var reward: = award_firearms_practice_xp(outcome_id)
	if reward >= 0:
		var reward_text: = " - FIREARMS XP +%d" % reward if reward > 0 else " - NO NEW PRACTICE XP"
		notify("%s%s" % [firearms_dummy_outcome_summary(outcome_id).get_slice(":", 0).to_upper(), reward_text], GOOD if reward > 0 else ACCENT, 3.5)
	return true

