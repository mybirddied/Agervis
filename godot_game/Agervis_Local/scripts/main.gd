func draw_bank_vault_door(record: Dictionary) -> void :
	var point: = scene_position(record.get("position", Vector2(300, 155)) as Vector2)




	var base: = ARCH_FLOOR_Y + 4.0
	var rect: = Rect2(point.x - 76.0, base - 160.0, 152.0, 160.0)
	draw_rect(rect.grow(8.0), Color("#181b1c"))
	draw_rect(rect, Color("#525a5c"))
	draw_rect(rect.grow(-9.0), Color("#303638"))

	var bolt_radius: = Vector2(57.0, rect.size.y * 0.4)
	for bolt_index in range(8):
		var angle: = TAU * float(bolt_index) / 8.0
		draw_circle(rect.get_center() + Vector2(cos(angle), sin(angle)) * bolt_radius, 4.0, Color("#aaa28e"))
	draw_circle(rect.get_center(), 34.0, Color("#171a1b"))
	draw_circle(rect.get_center(), 27.0, Color("#71797a"), false, 6.0)
	for spoke in range(6):
		var angle: = TAU * float(spoke) / 6.0
		draw_line(rect.get_center(), rect.get_center() + Vector2(cos(angle), sin(angle)) * 39.0, Color("#8f9795"), 6.0)
	draw_rect(Rect2(rect.end.x - 23, rect.position.y + 63, 14, 54), Color("#171a1b"))
	draw_centered("VAULT", Vector2(rect.get_center().x, rect.position.y + 24), 11, Color("#c7c1b4"))

