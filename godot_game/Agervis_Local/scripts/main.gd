func initialize_laundry_office_actors() -> void :
	var suit_colors: = [Color("#37393d"), Color("#26384d"), Color("#414638"), Color("#4a3035")]
	var skin_colors: = [Color("#9b6548"), Color("#70452f"), Color("#b97955"), Color("#875238")]
	var defender_index: = 0
	for record in RoomObjects.records_for("laundromat", "office", "adult"):
		if String(record.get("render_mode", "")) != "runtime_actor":
			continue
		var actor_id: = String(record.get("actor_id", ""))
		var is_capone: = actor_id == "laundry_capone"
		var actor: = Actor.new(
			actor_id, 
			"Capone" if is_capone else "Union Member %d" % (defender_index + 1), 
			"Capone" if is_capone else "Union Defender", 
			"laundromat", 
			record.get("position", Vector2.ZERO) as Vector2, 
			Color("#25282d") if is_capone else suit_colors[defender_index]
		)
		actor.room_id = "office"
		actor.home_position = actor.position
		actor.skin_color = Color("#a96f50") if is_capone else skin_colors[defender_index]
		actor.hair_style = "slicked" if is_capone else ["low fade", "short", "buzz", "low fade"][defender_index]
		actor.hair_color = Color("#17191b")
		actor.body_style = "stocky" if is_capone else ["broad", "standard", "stocky", "standard"][defender_index]
		actor.face_style = "heavy jaw" if is_capone else "angular"
		actor.eye_style = "hooded" if is_capone else "steady"
		actor.stature = "short" if is_capone else "average"
		actor.outfit_style = "suit"
		actor.accessory = "chain" if is_capone else "none"
		actor.facial_hair_style = "mustache" if is_capone else "none"
		actor.render_scale = 1.2 if is_capone else 1.12
		if not is_capone:
			for point_value in Array(record.get("roam_points", [])):
				if point_value is Vector2:
					actor.roam_points.append(point_value as Vector2)
			actor.roam_wait_timer = 25.0 + float(defender_index)
			actor.move_speed = 72.0
			defender_index += 1
		actors.append(actor)

func actor_by_id(actor_id: String) -> AgervisActor:
	for actor in actors:
		if actor.actor_id == actor_id:
			return actor
	return null

func hydrate_authoritative_laundry_office(snapshot: Dictionary) -> void :
	var actor_states_value: Variant = snapshot.get("actors", {})
	if actor_states_value is not Dictionary:
		return
	for actor_id_value in (actor_states_value as Dictionary).keys():
		var actor_id: = String(actor_id_value)
		var actor: = actor_by_id(actor_id)
		var state_value: Variant = (actor_states_value as Dictionary).get(actor_id_value, {})
		if actor == null or state_value is not Dictionary or not is_laundry_office_actor(actor):
			continue
		var state: Dictionary = state_value
		actor.position = lan_session.state_position(state)
		actor.health = clampf(float(state.get("health", actor.health)), 0.0, actor.max_health)
		actor.downed = bool(state.get("downed", false))
		actor.removed = bool(state.get("removed", false))
		actor.restrained = bool(state.get("restrained", false))
		actor.maimed = bool(state.get("maimed", false))
		actor.ai_state = String(state.get("ai_state", actor.ai_state))
		actor.hostile = bool(state.get("hostile", false))
		actor.directly_attacked_by_player = bool(state.get("directly_attacked_by_player", false))
	var remaining_ms: = maxi(0, int(snapshot.get("hostility_remaining_ms", 0)))
	laundry_mob_hostile_until_ms = Time.get_ticks_msec() + remaining_ms if remaining_ms > 0 else 0
	laundry_mob_defeat_pending = bool(snapshot.get("defeat_pending", false))
	laundry_capone_disposition_started = bool(snapshot.get("capone_disposition_started", false))

func update_actors(delta: float) -> void :
	supplier_bark_display_timer = maxf(0.0, supplier_bark_display_timer - delta)
	street_tough_hostility_check_timer -= delta
	if street_tough_hostility_check_timer <= 0.0:
		street_tough_hostility_check_timer = 300.0
		for actor in actors:
			if actor.actor_id.begins_with("street_tough_") and rng.randi_range(0, 3) == 0:
				actor.hostile = true
	if not lan_session.active and area == "laundromat" and room_id == "office" and allegiance_label() == "LAW" and not player_downed:
		activate_laundry_mob_hostility("LEO P.A.T.H. ENTERED THE OFFICE")
	for actor in actors:
		if lan_session.active and is_laundry_office_actor(actor):
			actor.attack_cooldown = maxf(0.0, actor.attack_cooldown - delta)
			continue
		if actor.removed:
			npc_respawn_timers[actor.actor_id] = float(npc_respawn_timers.get(actor.actor_id, rng.randf_range(55.0, 105.0))) - delta
			if float(npc_respawn_timers[actor.actor_id]) <= 0.0:
				npc_respawn_timers.erase(actor.actor_id)
				actor.removed = false
				actor.revive(100.0)
				actor.position = Vector2(clampf(actor.target_x, 120.0, 850.0) if actor.area != "street" else actor.target_x, 185.0)
			continue
		if not actor_visible_in_current_room(actor):
			continue


		update_actor_knockback(actor, delta)


		if actor.knockdown:
			continue

		if actor.actor_id == "fence_moth":
			actor.hostile = moth_hostility_active()
		if actor.restrained:
			actor.restrained_time += delta
			if actor.restrained_time >= 3.0:
				actor.removed = true
				add_world_note("%s was transported alive after arrest." % actor.display_name)
			continue
		if actor.downed:
			actor.downed_time += delta
			if actor.downed_time >= 3.0:
				actor.removed = true
				add_world_note("%s was transported to the hospital after the disposition window." % actor.display_name)
			continue
		actor.attack_cooldown = maxf(0.0, actor.attack_cooldown - delta)
		if actor.ai_state == "flee":
			update_flee_actor(actor, delta)
		elif actor.actor_id == "officer_pike":
			update_officer(actor, delta)
		elif is_laundry_office_actor(actor):
			update_laundry_office_actor(actor, delta)
		elif actor.actor_id == "fence_moth" and actor.hostile:
			update_moth_hostile(actor, delta)
		elif actor.hostile:
			update_hostile(actor, delta)
		elif actor.actor_id == "escort_nico" and escort_trusted:
			update_escort(actor, delta)
		elif actor.actor_id in ["customer_rae", "customer_doz"]:
			update_store_customer(actor, delta)
		elif actor.actor_id == "fence_moth" and actor.distance_to(player_position) < 260.0:
			supplier_bark_timer -= delta
			if supplier_bark_timer <= 0.0:
				supplier_bark_timer = rng.randf_range(12.0, 22.0)
				supplier_bark_text = supplier_barks[rng.randi_range(0, supplier_barks.size() - 1)]
				supplier_bark_display_timer = 4.0

func is_laundry_office_actor(actor: AgervisActor) -> bool:
	return actor.area == "laundromat" and actor.room_id == "office" and (actor.actor_id == "laundry_capone" or actor.actor_id.begins_with("laundry_union_"))

func is_laundry_union_defender(actor: AgervisActor) -> bool:
	return actor.actor_id.begins_with("laundry_union_")

func laundry_money_desk_success_chance() -> float:
	return minf(0.9, maxf(0.0, float(skill_level("Stealth"))) / 20.0)

func resolve_laundry_money_desk_detection(roll: float) -> bool:
	var detected: = clampf(roll, 0.0, 1.0) >= laundry_money_desk_success_chance()
	if detected:
		activate_laundry_mob_hostility("THE GUARDED DESK ATTEMPT FAILED")
		add_crime("ATTEMPTED THEFT")
		record_camera_event("ATTEMPTED THEFT", player_name, "The guarded laundromat office desk was disturbed.", 18, player_position)
	return detected

func laundry_mob_hostility_active() -> bool:
	if laundry_mob_admin_override == 0:
		return false
	return Time.get_ticks_msec() < laundry_mob_hostile_until_ms

func activate_laundry_mob_hostility(reason: String = "OFFICE DEFENSE ACTIVATED") -> void :
	if laundry_mob_admin_override == 0:
		return
	var was_active: = laundry_mob_hostility_active()
	laundry_mob_hostile_until_ms = maxi(
		laundry_mob_hostile_until_ms, 
		Time.get_ticks_msec() + int(LAUNDRY_MOB_HOSTILITY_SECONDS * 1000.0)
	)
	if not was_active and area == "laundromat" and room_id == "office" and not reason.is_empty():
		notify("UNION DEFENSE: %s" % reason, DANGER, 3.0)

func clear_laundry_mob_hostility() -> void :
	laundry_mob_hostile_until_ms = 0
	laundry_mob_defeat_pending = false
	laundry_capone_disposition_started = false
	for actor in actors:
		if not is_laundry_office_actor(actor):
			continue
		actor.hostile = false
		actor.directly_attacked_by_player = false
		actor.ai_state = "idle"

func laundry_office_position_is_valid(point: Vector2) -> bool:


	return point.x >= LAUNDRY_OFFICE_LEFT_WALK_X and point.x <= 955.0 and point.y >= 135.0 and point.y <= 290.0 and not LAUNDRY_OFFICE_DESK_CLEARANCE.has_point(point)

func laundry_office_navigation_target(origin: Vector2, target: Vector2) -> Vector2:
	var segment_bounds: = Rect2(
		Vector2(minf(origin.x, target.x), minf(origin.y, target.y)), 
		Vector2(maxf(1.0, absf(target.x - origin.x)), maxf(1.0, absf(target.y - origin.y)))
	)
	if not LAUNDRY_OFFICE_DESK_CLEARANCE.intersects(segment_bounds, true):
		return target
	var left_x: = LAUNDRY_OFFICE_DESK_CLEARANCE.position.x - 18.0
	var right_x: = LAUNDRY_OFFICE_DESK_CLEARANCE.end.x + 18.0
	var side_x: = left_x if absf(target.x - left_x) <= absf(target.x - right_x) else right_x
	if origin.x > LAUNDRY_OFFICE_DESK_CLEARANCE.position.x and origin.x < LAUNDRY_OFFICE_DESK_CLEARANCE.end.x:
		return Vector2(side_x, origin.y)
	if (origin.y < LAUNDRY_OFFICE_DESK_CLEARANCE.position.y and target.y > LAUNDRY_OFFICE_DESK_CLEARANCE.end.y) or (origin.y > LAUNDRY_OFFICE_DESK_CLEARANCE.end.y and target.y < LAUNDRY_OFFICE_DESK_CLEARANCE.position.y):
		return Vector2(origin.x, LAUNDRY_OFFICE_DESK_CLEARANCE.position.y - 18.0 if origin.y < LAUNDRY_OFFICE_DESK_CLEARANCE.position.y else LAUNDRY_OFFICE_DESK_CLEARANCE.end.y + 18.0)
	return Vector2(side_x, target.y)

func move_laundry_office_actor(actor: AgervisActor, target: Vector2, distance: float) -> void :
	var navigation_target: = laundry_office_navigation_target(actor.position, target)
	var candidate: = actor.position.move_toward(navigation_target, maxf(0.0, distance))
	if laundry_office_position_is_valid(candidate):
		actor.position = candidate
		return
	var horizontal: = Vector2(candidate.x, actor.position.y)
	if laundry_office_position_is_valid(horizontal):
		actor.position = horizontal
		return
	var vertical: = Vector2(actor.position.x, candidate.y)
	if laundry_office_position_is_valid(vertical):
		actor.position = vertical

func update_laundry_office_actor(actor: AgervisActor, delta: float) -> void :

	if actor.knockdown or actor.knockback_active:
		return

	if actor.actor_id == "laundry_capone":
		if actor.directly_attacked_by_player and laundry_mob_hostility_active() and not player_downed:
			actor.hostile = true
			actor.ai_state = "laundry_capone_defense"
			move_laundry_office_actor(actor, player_position, LAUNDRY_DEFENDER_SPEED * delta)
			if actor.distance_to(player_position) < 68.0 and actor.attack_cooldown <= 0.0:
				actor.attack_cooldown = 0.95
				damage_player(19.0, actor)
			return
		actor.hostile = false
		if player_downed and laundry_mob_defeat_pending:
			actor.ai_state = "laundry_capone_disposition"
			move_laundry_office_actor(actor, player_position, LAUNDRY_CAPONE_APPROACH_SPEED * delta)
			if actor.distance_to(player_position) < 62.0:
				attempt_capone_disposition()
			return
		actor.ai_state = "idle"
		move_laundry_office_actor(actor, actor.home_position, actor.move_speed * delta)
		return
	actor.hostile = laundry_mob_hostility_active() and not player_downed
	if actor.hostile:
		actor.ai_state = "laundry_union_defense"
		move_laundry_office_actor(actor, player_position, LAUNDRY_DEFENDER_SPEED * delta)
		if actor.distance_to(player_position) < 68.0 and actor.attack_cooldown <= 0.0:
			actor.attack_cooldown = 0.95
			damage_player(19.0, actor)
		return
	actor.ai_state = "laundry_union_idle"
	if actor.roam_points.is_empty():
		return
	actor.roam_wait_timer = maxf(0.0, actor.roam_wait_timer - delta)
	var roam_target: = actor.roam_points[clampi(actor.roam_index, 0, actor.roam_points.size() - 1)]
	if actor.roam_wait_timer > 0.0:
		return
	actor.ai_state = "laundry_union_roam"
	move_laundry_office_actor(actor, roam_target, actor.move_speed * delta)
	if actor.position.distance_to(roam_target) <= 3.0:
		var next_index: = rng.randi_range(0, actor.roam_points.size() - 1)
		if actor.roam_points.size() > 1 and next_index == actor.roam_index:
			next_index = (next_index + 1) % actor.roam_points.size()
		actor.roam_index = next_index
		actor.roam_wait_timer = rng.randf_range(25.0, 30.0)

func attempt_capone_disposition() -> void :
	if laundry_capone_disposition_started:
		return
	laundry_capone_disposition_started = true
	laundry_mob_defeat_pending = false
	downed_disposition_resolved = true
	notify("CAPONE REACHES THE DOWNED RESIDENT  -  DISPOSITION ATTEMPT RECORDED", DANGER, 3.0)
	add_world_note("Capone approached the downed hostile resident while the union members held the office.")
	var capone: = actor_by_id("laundry_capone")
	if capone != null:
		resolve_permanent_harm_against_player(capone)
	clear_laundry_mob_hostility()

func update_store_customer(actor: AgervisActor, delta: float) -> void :
	var previous_elapsed: = actor.customer_cycle_elapsed
	actor.customer_cycle_elapsed = fmod(previous_elapsed + maxf(0.0, delta), STORE_CUSTOMER_CYCLE_SECONDS)
	if actor.customer_cycle_elapsed < previous_elapsed or actor.customer_cycle_elapsed < STORE_CUSTOMER_PAUSE_SECONDS:
		actor.customer_cycle_moving = false
		return
	var movement_delta: = delta
	if previous_elapsed < STORE_CUSTOMER_PAUSE_SECONDS:
		movement_delta = actor.customer_cycle_elapsed - STORE_CUSTOMER_PAUSE_SECONDS
	if not actor.customer_cycle_moving:
		actor.customer_cycle_moving = true
		actor.target_x = 610.0 if actor.position.x < 450.0 else 275.0
	actor.position.x = move_toward(actor.position.x, actor.target_x, STORE_CUSTOMER_SPEED * maxf(0.0, movement_delta))

func update_flee_actor(actor: AgervisActor, delta: float) -> void :
	actor.position.x = move_toward(actor.position.x, actor.target_x, 205.0 * delta)
	if absf(actor.position.x - actor.target_x) < 8.0:
		actor.removed = true
		add_world_note("%s escaped the failed disposition attempt." % actor.display_name)

func update_officer(officer: AgervisActor, delta: float) -> void :
	if Rules.arrest_is_eligible(case_strength, warrant) and area == "street" and officer.distance_to(player_position) <= Rules.PIKE_CHASE_RADIUS:
		officer_bark_timer -= delta
		if officer_bark_timer <= 0.0:
			officer_bark_timer = rng.randf_range(6.0, 10.0)
			notify("PIKE: " + pursuit_barks[rng.randi_range(0, pursuit_barks.size() - 1)], DANGER, 3.5)
		var pursuit_speed: = clampf(105.0 + case_strength * 0.85, 105.0, 220.0)
		officer.position = officer.position.move_toward(player_position, pursuit_speed * delta)
		if officer.distance_to(player_position) < 72.0 and officer.attack_cooldown <= 0.0:
			officer.attack_cooldown = 1.2
			if not player_downed:
				var arrest_reason_text: = "Officer Pike completed a warrant arrest." if warrant else "Officer Pike completed a Heat 100 arrest."
				begin_arrest(arrest_reason_text)
		return
	if area == "street":
		for car_variant in traffic:
			var car: Dictionary = car_variant
			if not bool(car.get("pike_follow_active", false)) or float(car.get("pike_follow_remaining", 0.0)) <= 0.0:
				continue
			officer.ai_state = "pike_driveby_follow"


			officer.position.x = move_toward(officer.position.x, float(car.get("x", officer.position.x)), 180.0 * delta)
			return
	officer.ai_state = "patrol"
	if absf(officer.position.x - officer.target_x) < 15.0:
		officer.target_x = 6500.0 if officer.target_x > 7200.0 else 7900.0
	officer.position.x = move_toward(officer.position.x, officer.target_x, 58.0 * delta)

func update_moth_hostile(moth: AgervisActor, delta: float) -> void :

	if moth.knockdown or moth.knockback_active:
		return

	var player_in_chase_radius: = MothContent.MOTH_POINT.distance_to(player_position) <= Rules.MOTH_CHASE_RADIUS
	if player_in_chase_radius:
		moth.ai_state = "moth_chase"
		moth.position = moth.position.move_toward(player_position, MothContent.CHASE_SPEED * delta)
		if moth.distance_to(player_position) < 68.0 and moth.attack_cooldown <= 0.0:
			moth.attack_cooldown = 0.95
			damage_player(19.0, moth)
		return
	var officer: = actor_by_id("officer_pike")
	var pike_alert: = officer != null and not officer.removed and officer.area == area and officer.position.distance_to(MothContent.MOTH_POINT) <= MothContent.PIKE_REACTION_RADIUS
	moth.ai_state = "moth_pike_alert" if pike_alert else "moth_return_home"
	moth.position = moth.position.move_toward(MothContent.MOTH_POINT, MothContent.RETURN_SPEED * delta)

func update_hostile(actor: AgervisActor, delta: float) -> void :

	if actor.knockdown or actor.knockback_active:
		return

	if actor.actor_id.begins_with("street_tough_"):
		if actor.distance_to(player_position) < 220.0:
			actor.position = actor.position.move_toward(player_position, 85.0 * delta)
		if actor.distance_to(player_position) < 68.0 and actor.attack_cooldown <= 0.0:
			actor.attack_cooldown = 0.95
			if officer_bark_timer <= 0.0:
				officer_bark_timer = rng.randf_range(8.0, 15.0)
				notify(actor.display_name.to_upper() + ": " + street_tough_barks[rng.randi_range(0, street_tough_barks.size() - 1)], DANGER, 3.5)
			damage_player(19.0, actor)
		return
	actor.position = actor.position.move_toward(player_position, 150.0 * delta)
	if actor.distance_to(player_position) < 68.0 and actor.attack_cooldown <= 0.0:
		actor.attack_cooldown = 0.95
		damage_player(19.0, actor)

func update_escort(actor: AgervisActor, delta: float) -> void :
	if deposit_active and deposit_source == "store" and escort_betrays and player_position.x > 6100.0:
		actor.hostile = true
		actor.role = "Betrayer"
		record_camera_event("ASSAULT", actor.display_name, "Coworker began an ambush after receiving trust.", 22, actor.position)
