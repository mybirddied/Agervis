func try_build10_room_activity() -> bool:
	if area == "home" and room_id == "bed_6b":
		if near_point(Vector2(260, 215), 105):
			sleeping = not sleeping
			if sleeping:
				player_position = Vector2(260, 215)
				notify("RESTING - HEALTH RECOVERS WHILE YOU REMAIN IN BED", GOOD, 2.5)
			else:
				notify("YOU LEAVE BED 6B WITH THE SHEETS AS YOUR WITNESS", ACCENT, 2.0)
			return true
		if near_point(Vector2(610, 215), 105):
			open_stash()
			return true
	if area in ["tutorial", "school"]:
		if room_id == "safety" and near_point(Vector2(500, 220), 230):
			open_school_safety_desk()
			return true
		if room_id == "scholarship" and near_point(Vector2(500, 220), 230):
			open_scholarship_exchange()
			return true
		if room_id == "service_exit" and near_point(Vector2(500, 220), 230):
			open_dialog("OUTSIDE CONTACT - MOTH", [
				"The school calls this ditching. Moth calls it arriving before the supervision.", 
				"Leaving gives a criminal headstart, not a permanent career. Nobody here is organized enough to decide your life for you.", 
			], [{"label": "Keep that information legally unconfirmed", "id": "close"}])
			return true
	if area == "store":
		if room_id == "dvr" and near_point(Vector2(490, 215), 150):
			open_camera_terminal()
			return true
		if room_id == "safe" and near_point(Vector2(485, 215), 150):
			if online_economy_enabled():
				submit_online_economy_request("CASHIER_SAFE_ACCESS", {})
			elif active_job == "Cashier" and cashier_tasks.values().all( func(value): return value) and not deposit_active:
				if issue_job_deposit("store", "sealed_deposit_bag", "Sealed Deposit Bag", "Boss's Corner Store", "store_safe", 160, "First Block Bank teller"):
					notify("SEALED DEPOSIT RECEIVED - $160 MUST REACH THE BANK", ACCENT, 4.0)
					sync_cashier_contract()
			else:
				notify("THE SAFE REQUIRES A COMPLETED SHIFT AND AN EMPTY DEPOSIT ROUTE", ACCENT, 3.0)
			return true
		if room_id == "stockroom" and near_point(Vector2(500, 220), 230):
			if active_job == "Cashier":
				begin_cashier_assignment("stock")
			else:
				notify("STOCK IS NOT ASSIGNED TO YOU", ACCENT, 2.0)
			return true
		if room_id == "sales":
			if active_job == "Cashier" and near_point(Vector2(215, 215), 105):
				begin_cashier_assignment("register")
				return true
			if active_job == "Cashier" and near_point(Vector2(720, 215), 105):
				begin_cashier_assignment("clean")
				return true
			if near_point(Vector2(430, 215), 150):
				open_boss_dialog()
				return true
			return true
	if area == "restaurant":
		if room_id == "dining":
			if near_point(Vector2(500, 215), 220):
