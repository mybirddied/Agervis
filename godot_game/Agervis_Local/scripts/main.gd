func draw_wall_material_column(wall_tile: int, x: float, width: float, tint: Color) -> void :
	var top: = ARCH_WALL_TOP
	var bottom: = ARCH_BASEBOARD_Y
	var right: = x + width
	var seam: = tint.darkened(0.34)
	var lit: = tint.lightened(0.22)
	match posmod(wall_tile, 6):
		0:

			var course_h: = (bottom - top) / 5.0
			for course in range(5):
				var cy: = top + course * course_h
				draw_line(Vector2(x, cy), Vector2(right, cy), seam, 1.0)
				draw_line(Vector2(x, cy + 1.5), Vector2(right, cy + 1.5), lit, 1.0)
				var stagger: = 0.0 if course % 2 == 0 else width * 0.25
				for block in range(3):
					var bx: = x + stagger + block * width * 0.5
					if bx > x + 1.0 and bx < right - 1.0:
						draw_line(Vector2(bx, cy), Vector2(bx, cy + course_h), seam, 1.0)
		1:

			if not low_spec:
				for sweep in range(4):
					var sy: = top + 12.0 + sweep * 36.0
					var arc: = 5.0 if sweep % 2 == 0 else -5.0
					draw_polyline([
						Vector2(x + 6.0, sy), 
						Vector2(x + width * 0.45, sy + arc), 
						Vector2(right - 6.0, sy)
					], tint.lightened(0.06), 2.0)
				if posmod(int(x / 128.0), 3) == 1:
					draw_rect(Rect2(x + 30.0, top + 52.0, 34.0, 22.0), tint.darkened(0.1))
		2:

			var stripes: = 6
			var stripe_w: = width / float(stripes)
			for stripe in range(stripes):
				var sx: = x + stripe * stripe_w
				if stripe % 2 == 0:
					draw_rect(Rect2(sx, top, stripe_w * 0.55, bottom - top), tint.lightened(0.07))
				draw_line(Vector2(sx, top), Vector2(sx, bottom), tint.darkened(0.14), 1.0)
		3:

			var boards: = 5
			var board_w: = width / float(boards)
			for board in range(boards):
				var bx: = x + board * board_w
				draw_rect(Rect2(bx, top, board_w - 2.0, bottom - top), tint.darkened(0.04 + float(board % 3) * 0.03))
				draw_line(Vector2(bx + board_w - 2.0, top), Vector2(bx + board_w - 2.0, bottom), seam, 2.0)
				draw_line(Vector2(bx + 1.0, top), Vector2(bx + 1.0, bottom), lit, 1.0)
		4:

			var tile_w: = width / 5.0
			var tile_h: = (bottom - top) / 6.0
			for row in range(6):
				for col in range(5):
					var tx: = x + col * tile_w
					var ty: = top + row * tile_h
					draw_rect(Rect2(tx + 1.0, ty + 1.0, tile_w - 2.0, tile_h - 2.0), tint.lightened(0.03 + float((row + col) % 2) * 0.06))
					if not low_spec:
						draw_line(Vector2(tx + 3.0, ty + 3.0), Vector2(tx + tile_w * 0.4, ty + 3.0), Color(1, 1, 1, 0.1), 1.0)
		5:

			var brick_h: = (bottom - top) / 8.0
			for course in range(8):
				var by: = top + course * brick_h
				var stagger: = 0.0 if course % 2 == 0 else width / 8.0
				for brick in range(5):
					var bx: = x + stagger + brick * width / 4.0
					var face: = Rect2(bx + 1.0, by + 1.0, width / 4.0 - 2.0, brick_h - 2.0)
					if face.position.x < right:
						draw_rect(face, tint.darkened(0.02 + float((course * 5 + brick) % 4) * 0.05))
				draw_line(Vector2(x, by), Vector2(right, by), tint.lightened(0.16), 1.0)




var floor_row_band_cache: Array[float] = []

func floor_row_bands() -> Array[float]:


	if not floor_row_band_cache.is_empty():
		return floor_row_band_cache
	var bands: Array[float] = []
	var y: = ARCH_FLOOR_Y
	var step: = 13.0
	while y < ARCH_FLOOR_BOTTOM and bands.size() < 24:
		bands.append(y)
		y += step
		step *= 1.24
	bands.append(ARCH_FLOOR_BOTTOM)
	floor_row_band_cache = bands
	return floor_row_band_cache

func draw_floor_material_column(floor_tile: int, x: float, column: int, width: float, tint: Color) -> void :
	var right: = x + width
	var bands: = floor_row_bands()
	var base: = tint.darkened(0.06)

	var is_plank: = posmod(floor_tile, 2) == 1
	for row in range(bands.size() - 1):
		var top: = bands[row]
		var band_h: = bands[row + 1] - top
		var shade: = base.darkened(0.09 - float(row % 2) * 0.07)
		draw_rect(Rect2(x, top, width, band_h), shade)
		if is_plank:

			var joint_x: = x + float(posmod(column * 53 + row * 29, 100)) / 100.0 * width
			draw_line(Vector2(joint_x, top), Vector2(joint_x, top + band_h), base.darkened(0.3), 1.0)
			if not low_spec and band_h > 16.0:
				var grain_y: = top + band_h * 0.45
				draw_line(Vector2(x + 8.0, grain_y), Vector2(right - 8.0, grain_y), base.lightened(0.07), 1.0)
		else:
			var square_w: = maxf(band_h * 2.1, 18.0)
			var squares: = int(ceil(width / square_w))
			for square in range(squares):
				if posmod(square + row + column * 2, 2) == 0:
					continue
				var sx: = x + square * square_w
				draw_rect(Rect2(sx, top, minf(square_w, right - sx), band_h), base.darkened(0.13))
		draw_line(Vector2(x, top), Vector2(right, top), base.darkened(0.22), 1.0)

