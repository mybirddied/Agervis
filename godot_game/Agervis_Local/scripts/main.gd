const DOOR_LEAF_TINTS: = [
	"#6b5136", "#3f4a52", "#5c4a3c", "#4a5b4c", "#7a6244", 
	"#39424a", "#6d5a44", "#54453a", "#2f3a41", "#5f5347", 
]

func draw_interior_door_leaf(rect: Rect2, variant: int) -> void :
	var tint: = Color(DOOR_LEAF_TINTS[posmod(variant, DOOR_LEAF_TINTS.size())])

	draw_rect(rect.grow(6.0), tint.darkened(0.42))
	draw_rect(rect.grow(6.0), tint.darkened(0.6), false, 2.0)
	draw_rect(rect, tint)

	draw_rect(Rect2(rect.position, Vector2(rect.size.x * 0.16, rect.size.y)), tint.darkened(0.16))
	draw_rect(Rect2(rect.end.x - rect.size.x * 0.1, rect.position.y, rect.size.x * 0.1, rect.size.y), tint.lightened(0.1))

	var glazed: = posmod(variant, 2) == 1
	var inset: = rect.grow(-9.0)
	if glazed:
		var light: = Rect2(inset.position.x, inset.position.y, inset.size.x, inset.size.y * 0.42)
		draw_rect(light, Color("#93a6a4"))
		draw_rect(light, tint.darkened(0.35), false, 2.0)

		for wire in range(1, 5):
			var wx: = light.position.x + float(wire) * light.size.x / 5.0
			draw_line(Vector2(wx, light.position.y + 2.0), Vector2(wx, light.end.y - 2.0), Color(1, 1, 1, 0.12), 1.0)
		for wire in range(1, 3):
			var wy: = light.position.y + float(wire) * light.size.y / 3.0
			draw_line(Vector2(light.position.x + 2.0, wy), Vector2(light.end.x - 2.0, wy), Color(1, 1, 1, 0.12), 1.0)
		draw_line(light.position + Vector2(3.0, light.size.y - 3.0), light.position + Vector2(light.size.x * 0.5, 3.0), Color(1, 1, 1, 0.15), 3.0)
		var lower: = Rect2(inset.position.x, light.end.y + 8.0, inset.size.x, inset.end.y - light.end.y - 8.0)
		draw_rect(lower, tint.darkened(0.1))
		draw_rect(lower, tint.lightened(0.12), false, 1.0)
	else:

		for panel in range(2):
			var panel_h: = (inset.size.y - 10.0) * (0.44 if panel == 0 else 0.56)
			var panel_y: = inset.position.y if panel == 0 else inset.position.y + (inset.size.y - 10.0) * 0.44 + 10.0
			var panel_rect: = Rect2(inset.position.x, panel_y, inset.size.x, panel_h)
			draw_rect(panel_rect, tint.darkened(0.12))
			draw_rect(panel_rect, tint.lightened(0.14), false, 1.0)
			draw_line(panel_rect.position + Vector2(2.0, 2.0), Vector2(panel_rect.end.x - 2.0, panel_rect.position.y + 2.0), tint.darkened(0.3), 1.0)

	var handle_y: = rect.position.y + rect.size.y * 0.55
	draw_rect(Rect2(rect.end.x - 22.0, handle_y - 9.0, 8.0, 18.0), Color("#8e9497"))
	draw_rect(Rect2(rect.end.x - 30.0, handle_y - 2.5, 14.0, 5.0), Color("#b9bfc1"))
	draw_rect(Rect2(rect.position.x + 3.0, rect.end.y - 14.0, rect.size.x - 6.0, 11.0), tint.darkened(0.26))
	draw_line(Vector2(rect.position.x + 3.0, rect.end.y - 14.0), Vector2(rect.end.x - 3.0, rect.end.y - 14.0), tint.lightened(0.08), 1.0)

func draw_interior_door(world_x: float, tile_index: int) -> void :
