		if actor != null:
			return actor.position
	return dialog_bubble_anchor

func draw_overhead_speech_bubble() -> void :
	var actor_point: = scene_position(dialog_bubble_world_position())
	var bubble_width: = 320.0
	var bubble_x: = clampf(actor_point.x - bubble_width * 0.5, 20.0, VIEW_SIZE.x - bubble_width - 20.0)
	var bubble_y: = clampf(actor_point.y - 150.0, 88.0, 385.0)
	var bubble: = Rect2(bubble_x, bubble_y, bubble_width, 70)


	if not low_spec:
		draw_rect(Rect2(bubble.position.x + 3, bubble.position.y + 3, bubble.size.x, bubble.size.y), Color(0.02, 0.02, 0.025, 0.4))


	draw_rect(bubble, Color("#ece1bd"))


	if not low_spec:
		draw_rect(Rect2(bubble.position.x + 4, bubble.position.y + 4, bubble.size.x - 8, bubble.size.y - 8), Color("#dfd2ae", 0.3))


	draw_rect(bubble, INK, false, 2.5)
	if not low_spec:
		draw_rect(bubble.grow(-3), Color("#5a4d3a"), false, 1.0)


	var tail_x: = clampf(actor_point.x, bubble.position.x + 18.0, bubble.end.x - 18.0)
	var tail_points: = PackedVector2Array([
		Vector2(tail_x - 10, bubble.end.y), 
		Vector2(tail_x + 10, bubble.end.y), 
		Vector2(tail_x, bubble.end.y + 12), 
	])


	if not low_spec:
		var shadow_tail: = PackedVector2Array([
			Vector2(tail_x - 10 + 2, bubble.end.y + 2), 
			Vector2(tail_x + 10 + 2, bubble.end.y + 2), 
			Vector2(tail_x + 2, bubble.end.y + 14), 
		])
		draw_colored_polygon(shadow_tail, Color(0.02, 0.02, 0.025, 0.3))

	draw_colored_polygon(tail_points, Color("#ece1bd"))
	draw_polyline(PackedVector2Array([
		Vector2(tail_x - 10, bubble.end.y), 
		Vector2(tail_x, bubble.end.y + 12), 
		Vector2(tail_x + 10, bubble.end.y), 
	]), INK, 2.5)

	var spoken: = String(dialog_lines[0]) if not dialog_lines.is_empty() else dialog_title
	draw_wrapped(spoken, Rect2(bubble.position + Vector2(13, 12), bubble.size - Vector2(26, 20)), 13, INK)
