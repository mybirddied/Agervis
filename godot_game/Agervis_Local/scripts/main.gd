func controller_face_label(number: int) -> String:
	var index: = clampi(number - 1, 0, 3)
	match controller_family():
		"PLAYSTATION": return ["X", "O", "SQUARE", "TRIANGLE"][index]
		"SWITCH": return ["B", "A", "Y", "X"][index]
	return ["A", "B", "X", "Y"][index]

func controller_icon_texture(semantic_button: String) -> Texture2D:
	var family: = controller_family()
	var cache_key: = "%s:%s" % [family, semantic_button]
	if controller_icon_cache.has(cache_key):
		return controller_icon_cache[cache_key] as Texture2D
	var path: = InputGlyphs.texture_path(family, semantic_button)
	var texture: Texture2D = load(path) as Texture2D if not path.is_empty() and ResourceLoader.exists(path) else null
	controller_icon_cache[cache_key] = texture
	return texture

func draw_controller_icon(center: Vector2, size: float, semantic_button: String, animate_press: bool = false) -> void :
	var texture: = controller_icon_texture(semantic_button)
	if texture == null:
		draw_circle(center, size * 0.42, Color("#22272a"))
		draw_centered(semantic_button.to_upper().left(4), center + Vector2(0, 4), 8, PAPER)
		return
	var press_scale: = 1.0
	if animate_press:
		press_scale = lerpf(1.0, 0.88, (sin(elapsed * 7.0) + 1.0) * 0.5)
	var draw_size: = size * press_scale
