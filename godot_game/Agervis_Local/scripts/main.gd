		draw_rect(Rect2(cabin_start, veh_y + 2, cabin_width, cabin_height * 0.5), base_color.darkened(0.3))


		draw_line(Vector2(cabin_start, veh_y + 4), 
			Vector2(cabin_start + cabin_width, veh_y + 4), 
			base_color.darkened(0.1), 2.0)


		var windshield_rect: = Rect2(cabin_start + 6, veh_y + 4, cabin_width * 0.4, 14)
		draw_rect(windshield_rect, Color("#1a2228", 0.85))

		draw_rect(Rect2(windshield_rect.position.x, windshield_rect.position.y, 
			windshield_rect.size.x, windshield_rect.size.y * 0.3), 
			Color("#4a5a68", 0.3))

		draw_line(Vector2(windshield_rect.position.x + 2, windshield_rect.position.y + 2), 
			Vector2(windshield_rect.end.x - 6, windshield_rect.position.y + 2), 
			Color("#7a8a98", 0.4), 1.5)


		var rear_window: = Rect2(cabin_start + cabin_width * 0.6, veh_y + 6, cabin_width * 0.35, 12)
		draw_rect(rear_window, Color("#1a2228", 0.75))
		draw_line(Vector2(rear_window.position.x + 1, rear_window.position.y + 1), 
			Vector2(rear_window.end.x - 3, rear_window.position.y + 1), 
			Color("#5a6a78", 0.3), 1.0)


		draw_rect(Rect2(vehicle.x + 10, veh_y + 24, 18, 10), Color("#1a2228", 0.7))
		draw_rect(Rect2(vehicle.x + scaled_width - 28, veh_y + 24, 18, 10), Color("#1a2228", 0.7))

		draw_line(Vector2(vehicle.x + 10, veh_y + 24), 
			Vector2(vehicle.x + 28, veh_y + 24), 
			Color("#5a6a78", 0.4), 1.0)


		draw_rect(Rect2(vehicle.x + scaled_width * 0.4, veh_y + 32, 8, 3), Color("#3a3d3f"))
		draw_rect(Rect2(vehicle.x + scaled_width * 0.6, veh_y + 32, 8, 3), Color("#3a3d3f"))


		var wheel_y: = veh_y + 50
		var wheel_radius: = 9.0
		var rim_radius: = 6.0


		var front_wheel_x: float = vehicle.x + scaled_width * 0.2
		draw_circle(Vector2(front_wheel_x, wheel_y), wheel_radius + 1, Color("#0f0f0f"))
		draw_circle(Vector2(front_wheel_x, wheel_y), wheel_radius, Color("#1a1a1a"))
		draw_circle(Vector2(front_wheel_x, wheel_y), rim_radius, Color("#3a3d40"))
		draw_circle(Vector2(front_wheel_x, wheel_y), rim_radius - 2, Color("#2a2d2f"))

		for spoke in range(4):
			var angle: = spoke * PI / 2.0
			var spoke_start: = Vector2(front_wheel_x, wheel_y) + Vector2(cos(angle), sin(angle)) * 2
			var spoke_end: = Vector2(front_wheel_x, wheel_y) + Vector2(cos(angle), sin(angle)) * (rim_radius - 1)
			draw_line(spoke_start, spoke_end, Color("#4a4d50"), 1.5)


		var rear_wheel_x: float = vehicle.x + scaled_width * 0.8
		draw_circle(Vector2(rear_wheel_x, wheel_y), wheel_radius + 1, Color("#0f0f0f"))
		draw_circle(Vector2(rear_wheel_x, wheel_y), wheel_radius, Color("#1a1a1a"))
		draw_circle(Vector2(rear_wheel_x, wheel_y), rim_radius, Color("#3a3d40"))
		draw_circle(Vector2(rear_wheel_x, wheel_y), rim_radius - 2, Color("#2a2d2f"))
		for spoke in range(4):
			var angle: = spoke * PI / 2.0
			var spoke_start: = Vector2(rear_wheel_x, wheel_y) + Vector2(cos(angle), sin(angle)) * 2
			var spoke_end: = Vector2(rear_wheel_x, wheel_y) + Vector2(cos(angle), sin(angle)) * (rim_radius - 1)
			draw_line(spoke_start, spoke_end, Color("#4a4d50"), 1.5)


		draw_circle(Vector2(front_wheel_x, veh_y + 48), 11, shadow_color)
		draw_circle(Vector2(rear_wheel_x, veh_y + 48), 11, shadow_color)


		var grille: = Rect2(vehicle.x + 4, veh_y + 32, 12, 14)
		draw_rect(grille, Color("#0f0f0f"))
		draw_rect(grille, Color("#1a1d1f"), false, 1.0)

		for bar in range(3):
			draw_line(Vector2(grille.position.x + 2, grille.position.y + 3 + bar * 4), 
				Vector2(grille.end.x - 2, grille.position.y + 3 + bar * 4), 
				Color("#2a2d2f"), 1.0)



		var headlight_left: = Rect2(vehicle.x + 4, veh_y + 44, 10, 6)
		draw_rect(headlight_left, Color("#2a2d2f"))
		if vehicle.lights_on:
			draw_rect(headlight_left, Color("#f8f4e8", 0.95))
			draw_rect(Rect2(headlight_left.position.x + 1, headlight_left.position.y + 1, 8, 4), Color("#fffef8"))

			var beam: = PackedVector2Array([
				Vector2(vehicle.x + 9, veh_y + 47), 
				Vector2(vehicle.x - 60, veh_y + 42), 
				Vector2(vehicle.x - 65, veh_y + 52), 
				Vector2(vehicle.x + 9, veh_y + 50), 
			])
			draw_colored_polygon(beam, Color(0.98, 0.96, 0.88, 0.08))
		else:
			draw_rect(headlight_left, Color("#d8dce0", 0.3))
		draw_rect(headlight_left, Color("#1a1d1f"), false, 1.0)


		var taillight_rect: = Rect2(vehicle.x + scaled_width - 10, veh_y + 44, 8, 6)
		draw_rect(taillight_rect, Color("#3a1a1a"))
		draw_rect(taillight_rect, Color("#8a2a2a", 0.9))
		draw_circle(Vector2(vehicle.x + scaled_width - 6, veh_y + 47), 2, Color("#ca3a3a", 0.85))
		draw_rect(taillight_rect, Color("#1a0a0a"), false, 1.0)


		draw_rect(Rect2(vehicle.x + scaled_width * 0.28, veh_y + 26, 4, 5), Color("#2a2d2f"))
		draw_rect(Rect2(vehicle.x + scaled_width * 0.28, veh_y + 27, 4, 3), Color("#4a5a68", 0.4))


	for i in range(title_pedestrians.size()):
		var ped: Dictionary = title_pedestrians[i]


		if ped.hp <= 0:
			ped.down_time += get_process_delta_time()

			if ped.down_time < 300.0:
				var ped_y: = 540.0
				var body_x: float = ped.x


				var blood_growth: = minf(ped.down_time / 10.0, 1.0)
				var blood_width: = 42.0 * blood_growth
				var blood_height: = 8.0 * blood_growth
				var blood_color: = Color(0.45, 0.08, 0.08, 0.6 * blood_growth)
				draw_filled_ellipse(Rect2(body_x + 8 - blood_width, ped_y + 22 - blood_height, blood_width * 2.0, blood_height * 2.0), blood_color)

				if blood_growth > 0.3:
					var small_width: = blood_width * 0.4
					var small_height: = blood_height * 0.4
					draw_filled_ellipse(Rect2(body_x + 18 - small_width, ped_y + 18 - small_height, small_width * 2.0, small_height * 2.0), blood_color)
					small_width = blood_width * 0.35
					small_height = blood_height * 0.35
					draw_filled_ellipse(Rect2(body_x - 2 - small_width, ped_y + 26 - small_height, small_width * 2.0, small_height * 2.0), blood_color)


				var body_color: Color = ped.color
				var body_shadow: Color = body_color.darkened(0.4)


				draw_filled_ellipse(Rect2(body_x - 18, ped_y + 20, 52, 12), Color(0, 0, 0, 0.3))





				draw_circle(Vector2(body_x - 12, ped_y + 12), 7, body_shadow)
				draw_circle(Vector2(body_x - 12, ped_y + 12), 6, body_color)


				var torso_rect: = Rect2(body_x - 5, ped_y + 4, 18, 16)
				draw_rect(torso_rect, body_color)



				draw_rect(Rect2(body_x - 2, ped_y + 20, 4, 10), body_color.darkened(0.1))

				draw_rect(Rect2(body_x + 8, ped_y + 20, 4, 12), body_color.darkened(0.1))



				draw_rect(Rect2(body_x + 13, ped_y + 6, 14, 5), body_color.darkened(0.05))

				draw_rect(Rect2(body_x + 13, ped_y + 13, 14, 5), body_color.darkened(0.05))
			continue


		if ped.attack_cooldown > 0.0:
			ped.attack_cooldown -= get_process_delta_time()


		if not ped.running and not ped.fleeing and randf() < (1.0 / 15.0) * get_process_delta_time():
			ped.running = true

			if randf() < 0.5:
				var other_peds: Array[int] = []
				for j in range(title_pedestrians.size()):
					if i != j and title_pedestrians[j].hp > 0:
						other_peds.append(j)
				if not other_peds.is_empty():
					var spawn_from_index: int = other_peds[randi() % other_peds.size()]
					ped.x = title_pedestrians[spawn_from_index].x


		if ped.running or ped.fleeing:
			ped.speed = ped.base_speed * 2.5
		else:
			ped.speed = ped.base_speed


		if ped.running and not ped.fleeing and ped.attack_cooldown <= 0.0:
			for j in range(title_pedestrians.size()):
				if i != j:
					var other: Dictionary = title_pedestrians[j]
					if other.hp > 0:
						var distance: float = abs(other.x - ped.x)
						if distance < 30.0:
							other.hp -= 0.2
							ped.attack_cooldown = 1.5


							if other.fights_back and other.hp > 0:

								other.running = true
								other.fleeing = false
							else:

								other.fleeing = true
								other.running = false

							break

		ped.x += ped.speed * get_process_delta_time()
		if ped.x > VIEW_SIZE.x + 60:
			ped.x = -60.0


		var ped_y: = 540.0


		draw_circle(Vector2(ped.x, ped_y - 27), 10.5, ped.color)
		draw_rect(Rect2(ped.x - 7.5, ped_y - 18, 15, 27), ped.color)


		var leg_speed: float = ped.speed
		var leg_phase: = sin(title_city_time * leg_speed * 0.08 + ped.x * 0.05) * 7.5
		draw_line(Vector2(ped.x - 3, ped_y + 9), Vector2(ped.x - 3 + leg_phase, ped_y + 30), ped.color, 3.75)
		draw_line(Vector2(ped.x + 3, ped_y + 9), Vector2(ped.x + 3 - leg_phase, ped_y + 30), ped.color, 3.75)


	for vent in title_steam_vents:
		vent.particle_timer += get_process_delta_time()
		if vent.particle_timer > 0.12:
			vent.particle_timer = 0.0
			vent.particles.append({"y": vent.y + 200.0, "alpha": 1.0, "offset_x": randf_range(-10, 10)})


		var particles_to_remove: Array[int] = []
		for i in range(vent.particles.size()):
			var particle: Dictionary = vent.particles[i]
			particle.y -= 60.0 * get_process_delta_time()
			particle.alpha -= 0.5 * get_process_delta_time()
			if particle.alpha <= 0:
				particles_to_remove.append(i)
			else:
				var steam_x: float = vent.x + particle.offset_x + pan_offset * 0.4
				draw_circle(Vector2(steam_x, particle.y), 15, Color(0.82, 0.86, 0.88, particle.alpha * 0.25))
				draw_circle(Vector2(steam_x, particle.y), 10, Color(0.88, 0.92, 0.94, particle.alpha * 0.35))

