	var records: = admin_editor.room_records(room_key)
	draw_rect(ADMIN_CANVAS_RECT, Color("#2d3835"))
	draw_rect(ADMIN_CANVAS_RECT, Color("#8ca095"), false, 2.0)
	if last_input_controller:
		draw_circle(admin_editor_controller_cursor, 10.0, Color("#f6d36f", 0.18))
		draw_circle(admin_editor_controller_cursor, 10.0, ACCENT, false, 2.0)
		draw_line(admin_editor_controller_cursor - Vector2(15, 0), admin_editor_controller_cursor + Vector2(15, 0), ACCENT, 1.0)
		draw_line(admin_editor_controller_cursor - Vector2(0, 15), admin_editor_controller_cursor + Vector2(0, 15), ACCENT, 1.0)
	for grid_x in range(0, 1001, 100):
		var x: = ADMIN_CANVAS_RECT.position.x + float(grid_x) / 1000.0 * ADMIN_CANVAS_RECT.size.x
		draw_line(Vector2(x, ADMIN_CANVAS_RECT.position.y), Vector2(x, ADMIN_CANVAS_RECT.end.y), Color(0.7, 0.78, 0.7, 0.16), 1.0)
	for grid_y in range(0, 321, 80):
		var y: = ADMIN_CANVAS_RECT.position.y + float(grid_y) / 320.0 * ADMIN_CANVAS_RECT.size.y
		draw_line(Vector2(ADMIN_CANVAS_RECT.position.x, y), Vector2(ADMIN_CANVAS_RECT.end.x, y), Color(0.7, 0.78, 0.7, 0.16), 1.0)
	for index in range(records.size()):
		var record: = records[index] as Dictionary
		if bool(record.get("deleted", false)):
			continue
		var record_type: = String(record.get("record_type", "object"))
		var record_position: Variant = record.get("position", Vector2.ZERO)
		if not record_position is Vector2:
			continue
		var canvas_position: = admin_editor_world_to_canvas(record_position as Vector2)
		var selected: = index == admin_editor_object_cursor
		var tone: = ACCENT if selected else GOOD if record_type == "warp" else DANGER if record_type == "collision_line" else Color("#7aa6c2") if record_type == "tile" else PAPER
		if record_type == "collision_line":
			var points: Variant = record.get("points", [])
			if points is Array and (points as Array).size() >= 2 and points[0] is Vector2 and points[1] is Vector2:
				draw_line(admin_editor_world_to_canvas(points[0] as Vector2), admin_editor_world_to_canvas(points[1] as Vector2), tone, 4.0)
		elif record_type == "tile":
			var tile_size: Variant = record.get("size", Vector2(64, 64))
			var canvas_size: = Vector2(22, 18) if not tile_size is Vector2 else Vector2(maxf(8.0, (tile_size as Vector2).x / 1000.0 * ADMIN_CANVAS_RECT.size.x), maxf(8.0, (tile_size as Vector2).y / 320.0 * ADMIN_CANVAS_RECT.size.y))
			draw_rect(Rect2(canvas_position - canvas_size * 0.5, canvas_size), Color(tone, 0.45))
			draw_rect(Rect2(canvas_position - canvas_size * 0.5, canvas_size), tone, false, 1.0)
		elif record_type == "warp":
			draw_circle(canvas_position, 9.0, Color(tone, 0.32))
			draw_circle(canvas_position, 9.0, tone, false, 2.0)
		else:
			draw_circle(canvas_position, 7.0, tone)
		draw_text(String(record.get("local_id", "")).left(14), canvas_position + Vector2(8, 4), 10, tone)
	var palette_rect: = Rect2(420, 465, 390, 34)
	draw_text("ATLAS PALETTE", Vector2(420, 459), 11, Color("#a9b1ac"))
	for palette_index in range(ADMIN_PALETTE.size()):
		var palette_cell: = Rect2(palette_rect.position.x + palette_index * palette_rect.size.x / ADMIN_PALETTE.size(), palette_rect.position.y, palette_rect.size.x / ADMIN_PALETTE.size() - 2, palette_rect.size.y)
		draw_rect(palette_cell, ADMIN_PALETTE[palette_index]["tone"])
		draw_rect(palette_cell, ACCENT if palette_index == admin_editor_palette_index else Color("#65706b"), false, 2.0)
		draw_centered(str(palette_index + 1), palette_cell.get_center() + Vector2(0, 4), 12, INK)
	var tool_rect: = Rect2(420, 505, 390, 38)
	for tool_index in range(ADMIN_TOOL_BUTTONS.size()):
		var tool_cell: = Rect2(tool_rect.position.x + tool_index * tool_rect.size.x / ADMIN_TOOL_BUTTONS.size(), tool_rect.position.y, tool_rect.size.x / ADMIN_TOOL_BUTTONS.size() - 2, tool_rect.size.y)
		draw_rect(tool_cell, Color("#3b4646") if ADMIN_TOOL_BUTTONS[tool_index] == admin_editor_tool else Color("#202829"))
