func classroom_teacher_lines(skill_name: String) -> Array[String]:
	var aged: = area == "school" and phase != "tutorial"
	if aged:
		match skill_name:
			"Intelligence": return ["Intelligence. Research. Problem solving. Noticing when the official answer lost part of the question ten years ago and nobody filed the correction.", "I trained it through investigation, technical work, careful reading, and paperwork designed to make applicants quit before the department admits the position was cut.", "The clock ran out. The punishment arrived on schedule."]
			"Endurance": return ["Endurance. Stamina pacing. Sustained exertion. Carrying weight while the institution pretends exhaustion is a character flaw.", "I trained it through long shifts, repeated climbs, physical work, and pacing myself when rest became a luxury the budget couldn't justify.", "I stopped when I needed to. The municipal staircase continues without me."]
			"Agility": return ["Agility. Sprint control drains stamina. Controlled turns, vaults, balance, sprint timing. Routes that actually support your weight.", "I trained it through sports, pursuit work, marked climb points, and learning that speed matters when consequences arrive faster.", "The landing mat was inspected every year that still had a budget. Then the inspections stopped arriving."]
			"Fighting": return ["Fighting. Distance, defense, controlled practice. Avoidance as the advanced technique nobody wants to fund.", "I trained it through sparring, dangerous conflict, downing people, and making disposition decisions with permanent consequences I still review at night.", "Lasting injury. Death. Combat as a last resort. The hospital owns the form. I signed twelve of them."]
			"Firearms": return ["Firearms. One School BB Gun. Padded practice kit. Works only on the Disposition Dummy. Cannot be used against a person.", "I trained it through safe handling, lawful ranges, maintenance, controlled practice, and consequential use that creates witnesses, evidence, and disciplinary review boards.", "Treat every weapon as loaded. The city treated every safety report as optional until the settlement cleared and the blame landed."]
			"Stealth": return ["Stealth. Timing, concealment, quiet movement, camera awareness, leaving objects where ownership expects them.", "I trained it by avoiding notice, reading patrol gaps, handling evidence carefully, and surviving failed attempts that still appear in my file as 'incident-adjacent activity.'", "Last decade's students escaped instead of learning Stealth. The school recorded both outcomes as attendance and stopped checking which was which."]
			"Awareness": return ["Awareness. Finding changing hazards, cameras, witnesses, concealed evidence, suspicious behavior, details that moved when nobody admitted touching them.", "I trained it by checking rooms, people, routes, ambush points, and learning the difference between anxiety and actionable information after the distinction mattered.", "I trusted my senses, then verified them. The city has departments for the reverse order. I've met them."]
			"Safety": return ["Safety. Prevention, patrol routines, hazard control, de-escalation, emergency planning, knowing when authority does not make conduct lawful.", "I trained it through security work, careful inspections, protective equipment, and keeping other people alive long enough to complain about the conditions that injured them.", "This room passed inspection. The missing pages passed separately. The inspector retired early."]
			"Medicine": return ["Medicine. Stabilization, overdose response, triage, injury care, prescriptions, protecting medical evidence from administrative erasure.", "I trained it through treatment, emergency response, clinical work, and keeping the item I need in reach because the supply request was denied for the third consecutive quarter.", "Breathe. Clear instructions stay clear even when the patient, the institution, and the insurance provider do not."]
			"Influence": return ["Influence. Listening, negotiation, interviews, sales, leadership, politics, persuasion, de-escalation without confusing pressure for consent.", "I trained it through work, disputes, recruiting, public decisions, difficult conversations, and offers whose hidden cost I identified after acceptance was already binding.", "My voice mattered. The comment period closed yesterday. The meeting was last decade. The sentence remains educational."]
			"Enterprise": return ["Enterprise. Inventory, pricing, bookkeeping, job performance, insurance, ownership, distinguishing revenue from money you merely touched before it disappeared.", "I trained it through reliable work, trade, supply decisions, and records that survived somebody asking where the cash came from after the ledger stopped balancing.", "Profit is not proof of wisdom. It is, however, accepted by the vending machine. The vending machine is broken."]
			"Civics": return ["Civics. Warrants, evidence procedure, contracts, complaints, government credentials, politics, arrest rules, legal representation.", "I trained it by reading what I signed, documenting authority, using formal processes, and recognizing when procedure is being used as scenery to distract from the decision already made.", "The system belongs to everyone. Access to it is available during revised office hours. The revision is permanent."]
		return ["This skill grows through guided practice.", "It grew through relevant work and lived experience.", "The curriculum remains filed. The guidance remains revised."]
	else:
		match skill_name:
			"Intelligence": return ["At school, Intelligence grows through research, comparison, problem solving, and noticing when the official answer misplaced part of the question.", "Outside school, train it through planning, investigation, technical work, careful reading, and paperwork designed to make you quit.", "Take your time. The city only punishes late answers after it loses the clock."]
			"Endurance": return ["At school, Endurance grows through stamina pacing, sustained sprinting and climbing, measured exertion recovery, stairs, and carrying weight without pretending exhaustion is imaginary.", "Outside school, train it through long travel, physical work, repeated climbs, and pacing yourself when rest is expensive.", "You may stop when you need to. The municipal staircase will continue believing in you without supervision."]
			"Agility": return ["Use the visible Sprint control while moving; it drains stamina. At school, Agility grows through controlled turns, vaults, balance, and sprint timing.", "Outside school, train it on legitimate routes, pursuit escapes, sports, and authored climb points that actually support your weight.", "The landing mat is inspected every year that still has a budget."]
			"Fighting": return ["At school, Fighting means distance, defense, controlled practice, and understanding why avoidance is usually the advanced technique.", "Outside school, train it through accepted sparring or dangerous conflict, where downing someone can open a disposition decision with permanent consequences.", "Lasting Injury and death are why combat is a last resort. The hospital already owns a form for anybody told otherwise."]
			"Firearms": return ["At school, I issue one School BB Gun and a padded practice kit. They work only on this room's Disposition Dummy and cannot be used against a person.", "Outside school, Firearms grows through safe handling, lawful ranges, maintenance, controlled practice, and consequential use that creates witnesses and evidence.", "Treat every weapon as loaded. The city treats every safety report as optional until billing finds it."]
			"Stealth": return ["At school, Stealth grows through timing, concealment, quiet movement, camera awareness, and leaving objects where ownership expects them.", "Outside school, train it by avoiding notice, reading patrol gaps, handling evidence carefully, and surviving failed attempts without calling failure invisible.", "Last year's students escaped instead of learning Stealth. The school recorded both outcomes as attendance."]
			"Awareness": return ["At school, Awareness grows by finding changing hazards, cameras, witnesses, concealed evidence, suspicious behavior, and details that moved.", "Outside school, train it by checking rooms, people, routes, ambush points, and the difference between anxiety and actionable information.", "Trust your senses, then verify them. The city has departments for the reverse order."]
			"Safety": return ["At school, Safety grows through prevention, patrol routines, hazard control, de-escalation, emergency planning, and knowing when authority does not make conduct lawful.", "Outside school, train it through security work, careful inspections, protective equipment, and keeping other people alive long enough to complain.", "This room has passed inspection. The missing pages passed separately."]
			"Medicine": return ["At school, Medicine grows through stabilization, overdose response, triage, injury care, prescriptions, and protecting medical evidence.", "Outside school, train it through treatment, emergency response, clinical work, and preparation before somebody needs the item you left at home.", "Breathe. Clear instructions stay clear even when the patient and the institution do not."]
			"Influence": return ["At school, Influence grows through listening, negotiation, interviews, sales, leadership, politics, persuasion, and de-escalation without confusing pressure for consent.", "Outside school, train it in work, disputes, recruiting, public decisions, difficult conversations, and offers whose hidden cost you can identify.", "Your voice matters. The comment period closed yesterday, but the sentence remains educational."]
			"Enterprise": return ["At school, Enterprise grows through inventory, pricing, bookkeeping, job performance, insurance, ownership, and distinguishing revenue from money you merely touched.", "Outside school, train it through reliable work, trade, businesses, shares, supply decisions, and records that survive somebody asking where the cash came from.", "Profit is not proof of wisdom. It is, however, accepted by the vending machine."]
			"Civics": return ["At school, Civics grows through warrants, evidence procedure, contracts, complaints, government credentials, politics, arrest rules, and legal representation.", "Outside school, train it by reading what you sign, documenting authority, using formal processes, and recognizing when procedure is being used as scenery.", "The system belongs to everyone. Access to it is available during revised office hours."]
		return ["At school, this skill grows through guided practice.", "Outside school, it grows through relevant work and lived experience.", "The curriculum remains reassuringly filed."]

func movement_coach_input_type() -> String:
	if last_input_controller:
		return "controller"
	if mobile_controls_enabled:
		return "touch"
	return "keyboard_mouse"

func movement_coach_lines(input_type: String = "") -> Array[String]:
	var active_type: = movement_coach_input_type() if input_type.is_empty() else input_type
	var controls_line: = "WASD moves. Shift sprints. Sprinting drains stamina."
	match active_type:
		"controller":
			controls_line = "Left stick moves. LB/L1 sprints. Sprinting drains stamina."
		"touch":
			controls_line = "Drag the pad to move. Hold SPRINT to sprint. Sprinting drains stamina."
	return [
		controls_line, 
		"Agility grows through vaults, climbs, and not dying during parkour. The city installed fences. You'll learn to climb them.", 
		"The landing mat was inspected in 2019. Good luck.", 
	]

func open_classroom_teacher_dialog(skill_name: String, teacher_name: String) -> void :
	if skill_name == "Firearms" and in_firearms_practice_room():
		issue_firearms_practice_kit()
	if skill_name == "Stealth" and in_stealth_practice_room():
		open_dialog("%s  -  %s" % [teacher_name, skill_name.to_upper()], classroom_teacher_lines(skill_name), [
			{"label": "Open $1 practice pocket", "id": "stealth_pickpocket_menu"}, 
			{"label": "Review demonstration camera", "id": "stealth_camera_review"}, 
			{"label": "End lesson", "id": "close"}, 
		])
		return
	open_dialog("%s  -  %s" % [teacher_name, skill_name.to_upper()], classroom_teacher_lines(skill_name), [])

