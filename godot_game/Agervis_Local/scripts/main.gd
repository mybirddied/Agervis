func portrait_index_for_title(title: String) -> int:
	var upper: = title.to_upper()
	if "COUNSELOR" in upper: return 0
	if "OFFICER" in upper or "PIKE" in upper: return 1
	if "DETAIN" in upper: return 2
	if "BOSS" in upper: return 3
	if "NICO" in upper: return 4
	if "VEX" in upper: return 5
	if "RAE" in upper: return 6
	if "DOZ" in upper: return 7
	return -1

func draw_text(text: String, point: Vector2, size: int, color: Color) -> void :
	if drawing_world_layer and mode == ScreenMode.DIALOG:
		return
	draw_string(font, point, text, HORIZONTAL_ALIGNMENT_LEFT, -1, size, color)

func draw_centered(text: String, point: Vector2, size: int, color: Color) -> void :
	if drawing_world_layer and mode == ScreenMode.DIALOG:
		return
	var width: = font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
	draw_string(font, point - Vector2(width * 0.5, 0), text, HORIZONTAL_ALIGNMENT_LEFT, -1, size, color)

func draw_filled_ellipse(rect: Rect2, color: Color) -> void :

	var points: = PackedVector2Array()
	var center: = rect.get_center()
	var radius_x: = rect.size.x / 2.0
	var radius_y: = rect.size.y / 2.0
	var segments: = 32
	for i in range(segments):
		var angle: = (float(i) / segments) * TAU
		points.append(center + Vector2(cos(angle) * radius_x, sin(angle) * radius_y))
	draw_colored_polygon(points, color)

func draw_button(rect: Rect2, label: String, border_color: Color, bg_color: Color, text_color: Color, button_id: String) -> void :

	var is_pressed: = button_press_state == button_id


	if is_pressed:
		draw_rect(Rect2(rect.position.x + 1, rect.position.y + 1, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.6))
	else:
		draw_rect(Rect2(rect.position.x + 3, rect.position.y + 3, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.6))


	var draw_rect: = rect
	if is_pressed:
		draw_rect = Rect2(rect.position.x + 2, rect.position.y + 2, rect.size.x, rect.size.y)


	var button_bg: = bg_color.darkened(0.15) if is_pressed else bg_color
	var button_bg_top: = button_bg.darkened(0.1) if is_pressed else button_bg.lightened(0.05)
	draw_rect(draw_rect, button_bg)
	draw_rect(Rect2(draw_rect.position.x, draw_rect.position.y, draw_rect.size.x, 8), button_bg_top)


	var border_width: = 2.5 if is_pressed else 3.0
	draw_rect(draw_rect, border_color, false, border_width)
	if not is_pressed:
		draw_rect(draw_rect.grow(-3), border_color.lightened(0.3), false, 1.0)


	var text_offset: = Vector2(1, 7) if is_pressed else Vector2(1, 7)
	draw_centered(label, draw_rect.get_center() + text_offset, 15, Color("#0a0c0e"))
	draw_centered(label, draw_rect.get_center() + text_offset - Vector2(1, 1), 15, text_color)

func draw_handwritten(text: String, point: Vector2, size: int, color: Color) -> void :
	if drawing_world_layer and mode == ScreenMode.DIALOG:
		return

	var x_offset: = 0.0
	for i in range(text.length()):
		var char: = text[i]
		var char_width: = font.get_char_size(char.unicode_at(0), size).x

		var jitter_x: = sin(float(i) * 2.3) * 0.8
		var jitter_y: = cos(float(i) * 1.7) * 0.6

		var char_pos: = point + Vector2(x_offset + jitter_x, jitter_y)
		draw_string(font, char_pos, char, HORIZONTAL_ALIGNMENT_LEFT, -1, size, color)
		x_offset += char_width + 0.5

func draw_handwritten_centered(text: String, point: Vector2, size: int, color: Color) -> void :
	if drawing_world_layer and mode == ScreenMode.DIALOG:
		return
	var width: = font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
	draw_handwritten(text, point - Vector2(width * 0.5, 0), size, color)

func draw_wrapped(text: String, rect: Rect2, size: int, color: Color) -> float:
	var words: = text.split(" ")
	var line: = ""
	var y: = rect.position.y + size
	for word in words:
		var test: = String(word) if line.is_empty() else line + " " + String(word)
		if font.get_string_size(test, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > rect.size.x and not line.is_empty():
			draw_text(line, Vector2(rect.position.x, y), size, color)
			y += size + 5
			line = String(word)
		else:
			line = test
	if not line.is_empty():
		draw_text(line, Vector2(rect.position.x, y), size, color)
	return y - rect.position.y

