func begin_cooking(recipe_name: String) -> void :
	for recipe in COOKING_RECIPES:
		if recipe["name"] == recipe_name:
			cooking_active = true
			cooking_recipe = recipe_name
			cooking_step = 0
			cooking_total_steps = int(recipe["steps"])
			cooking_success_count = 0
			cooking_mistakes = 0
			cooking_burnt = false
			start_cooking_step()
			mode = ScreenMode.PLAY
			return

func start_cooking_step() -> void :
	cooking_timer = 0.0
	cooking_startup_delay = 0.2
	var recipe_data: = get_recipe_data(cooking_recipe)
	cooking_step_duration = float(recipe_data.get("duration", 2.0))


	var step_types: = get_step_challenge_types(cooking_recipe, cooking_step)
	cooking_challenge_type = step_types[cooking_step] if cooking_step < step_types.size() else "timing"

	match cooking_challenge_type:
		"timing":
			cooking_indicator_position = 0.0
			cooking_indicator_speed = randf_range(0.6, 1.0)
		"sequence":
			cooking_sequence_input = []
			cooking_sequence_target = generate_sequence_pattern()
		"temperature":
			cooking_temperature = randf_range(0.0, 0.3)
			cooking_target_temp_min = 0.5
			cooking_target_temp_max = 0.7
		"flip":
			cooking_indicator_position = 0.0
			cooking_indicator_speed = randf_range(0.7, 1.2)

func get_recipe_data(recipe_name: String) -> Dictionary:
	for recipe in COOKING_RECIPES:
		if recipe["name"] == recipe_name:
			return recipe
	return {}

func get_step_challenge_types(recipe_name: String, step_count: int) -> Array[String]:

	match recipe_name:
		"Boiled Water": return ["temperature"]
		"Toast": return ["timing"]
		"Instant Ramen": return ["timing"]
		"Scrambled Eggs": return ["timing", "flip"]
		"Fried Eggs": return ["timing", "flip"]
		"Grilled Cheese": return ["timing", "flip"]
		"Oatmeal": return ["temperature", "timing"]
		"Pancakes": return ["timing", "flip", "timing"]
		"Pasta": return ["temperature", "timing", "timing"]
		"Fried Rice": return ["timing", "flip", "timing"]
		"Stir Fry": return ["temperature", "flip", "timing", "flip"]
		"Risotto": return ["temperature", "sequence", "timing", "timing", "timing", "timing", "timing"]
		"Beef Wellington": return ["timing", "sequence", "temperature", "timing", "flip", "timing", "timing"]
		"Sous Vide Steak": return ["temperature", "temperature", "temperature", "timing", "flip", "timing", "timing", "timing", "timing"]
		"Soufflé": return ["sequence", "timing", "temperature", "temperature", "timing", "timing", "timing", "timing", "timing", "timing", "timing", "timing", "timing"]
		_:

			var pattern: Array[String] = []
			var recipe: = get_recipe_data(recipe_name)
			var steps: = int(recipe.get("steps", 2))
			for i in range(steps):
				if i == 0:
					pattern.append("timing")
				elif i == steps - 1:
					pattern.append("flip" if steps > 2 else "timing")
				else:
					if i % 3 == 0:
						pattern.append("temperature")
					elif i % 3 == 1:
						pattern.append("sequence")
					else:
						pattern.append("timing")
			return pattern
	return ["timing"]

func generate_sequence_pattern() -> Array[String]:
	var length: = clampi(2 + cooking_step, 2, 6)
	var keys: = ["W", "A", "S", "D"]
	var pattern: Array[String] = []
	for i in range(length):
		pattern.append(keys[randi() % keys.size()])
	return pattern

func update_cooking(delta: float) -> void :

	if cooking_startup_delay > 0.0:
		cooking_startup_delay -= delta
		return

	cooking_timer += delta

	match cooking_challenge_type:
		"timing", "flip":
			cooking_indicator_position += cooking_indicator_speed * delta
			if cooking_indicator_position > 1.0:
				cooking_indicator_position -= 1.0
		"temperature":

			cooking_temperature += delta * 0.15
		"sequence":

			pass


	if cooking_timer > cooking_step_duration:
		if cooking_challenge_type == "temperature" or (cooking_challenge_type in ["timing", "flip"] and cooking_timer > cooking_step_duration * 1.5):
			cooking_burnt = true
			cooking_mistakes += 2
			notify("BURNT - SMOKE ALARM DISPLEASED", DANGER, 2.5)
		end_cooking_step(false)

func try_cooking_action() -> void :
	if not cooking_active:
		return

	match cooking_challenge_type:
		"timing":
			var success: = cooking_indicator_position >= 0.4 and cooking_indicator_position <= 0.6
			end_cooking_step(success)
		"flip":
			var success: = cooking_indicator_position >= 0.35 and cooking_indicator_position <= 0.65
			if success:
				notify("FLIPPED", GOOD, 1.0)
			else:
				notify("FUMBLED - FLOOR SEASONING ADDED", DANGER, 1.5)
				cooking_mistakes += 1
			end_cooking_step(success)
		"temperature":
			var in_range: = cooking_temperature >= cooking_target_temp_min and cooking_temperature <= cooking_target_temp_max
			if in_range:
				notify("TEMPERATURE CONTROLLED", GOOD, 1.0)
			else:
				if cooking_temperature < cooking_target_temp_min:
					notify("UNDERCOOKED - RAW CENTERS", DANGER, 1.5)
				else:
					notify("OVERCOOKED - CARBON CONTRIBUTION", DANGER, 1.5)
				cooking_mistakes += 1
			end_cooking_step(in_range)
		"sequence":

			pass

func try_cooking_sequence_key(key: String) -> void :
	if cooking_challenge_type != "sequence" or not cooking_active:
		return

	cooking_sequence_input.append(key)


	var index: = cooking_sequence_input.size() - 1
	if index < cooking_sequence_target.size() and cooking_sequence_input[index] != cooking_sequence_target[index]:
		notify("WRONG INGREDIENT - RECIPE COMPROMISED", DANGER, 1.5)
		cooking_mistakes += 1
		end_cooking_step(false)
		return


	if cooking_sequence_input.size() >= cooking_sequence_target.size():
		notify("SEQUENCE MEMORIZED", GOOD, 1.0)
		end_cooking_step(true)

func end_cooking_step(success: bool) -> void :
	if success:
		cooking_success_count += 1

	cooking_step += 1

	if cooking_step >= cooking_total_steps:
		complete_cooking()
	else:
		start_cooking_step()

func complete_cooking() -> void :
	var recipe_data: Dictionary = {}
	for recipe in COOKING_RECIPES:
		if recipe["name"] == cooking_recipe:
			recipe_data = recipe
			break

	var xp_per_step: = int(recipe_data.get("xp", 5))
	var total_xp: = cooking_success_count * xp_per_step
	var success_rate: = float(cooking_success_count) / float(cooking_total_steps)


	var penalty: = cooking_mistakes * (xp_per_step / 2)
	total_xp = maxi(0, total_xp - penalty)


	total_xp = int(total_xp * 1.1)

	if total_xp > 0:
		grant_xp("Cooking", total_xp)

	var result_text: = ""
	var result_detail: = ""
	if cooking_burnt:
		result_text = "FIRE HAZARD"
		result_detail = "Smoke detector malfunction saved you from documentation."
	elif success_rate >= 0.9 and cooking_mistakes == 0:
		result_text = "INSTITUTIONAL PERFECTION"
		result_detail = "Edible, efficient, no complaints filed."
	elif success_rate >= 0.75:
		result_text = "ACCEPTABLE"
		result_detail = "Standards met. Nobody gets extra portions."
	elif success_rate >= 0.5:
		result_text = "BARELY EDIBLE"
		result_detail = "You'd eat it if you were hungry enough."
	else:
		result_text = "CONDEMNED"
		result_detail = "Even the rats have standards."

	var color: = GOOD if success_rate >= 0.75 and cooking_mistakes <= 1 else (ACCENT if success_rate >= 0.5 else DANGER)
	notify("%s: %s - COOKING +%d XP (%d/%d steps, %d mistakes)" % [cooking_recipe, result_text, total_xp, cooking_success_count, cooking_total_steps, cooking_mistakes], color, 4.0)
	if result_detail != "":
		notify(result_detail, color.darkened(0.3), 3.5)

	cooking_active = false
	cooking_recipe = ""

