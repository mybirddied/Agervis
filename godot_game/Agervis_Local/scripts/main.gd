func draw_build10_exterior_zone() -> void :
	var rear: = area == "rear"
	draw_rect(Rect2(0, 70, 1280, 455), Color("#171b1b" if rear else "#111516"))
	for entry in Build7.BUILDINGS:
		var building_x: = float(entry["x"])
		var local_x: float = building_x - camera_offset_x()
		if local_x < -420.0 or local_x > 1600.0:
			continue
		var stories: = 6 if String(entry["id"]) == "apartment" else 3
		var width: = 430.0
		var top: = 92.0 if stories >= 6 else 170.0
		var bottom: = 430.0
		var wall: = Color("#29312f" if rear else "#202628")
		draw_rect(Rect2(local_x - width * 0.5, top, width, bottom - top), wall)
		draw_rect(Rect2(local_x - width * 0.5, top, width, bottom - top), Color("#0c0e0e"), false, 4)
		for floor_index in range(stories):
			var floor_y: = bottom - 38.0 - floor_index * ((bottom - top - 25.0) / float(stories))
			draw_line(Vector2(local_x - width * 0.5, floor_y), Vector2(local_x + width * 0.5, floor_y), Color(0.05, 0.055, 0.05, 0.55), 2)
			for window_index in range(4):
				var window_x: float = local_x - 155.0 + window_index * 103.0
				draw_rect(Rect2(window_x, floor_y - 34.0, 42, 25), Color("#302f29" if rear else "#343b39"))
		if rear:
			draw_line(Vector2(local_x + 135, bottom - 15), Vector2(local_x + 135, top + 55), Color("#6a6961"), 7)
			for rung_y in range(int(top + 65), int(bottom - 25), 31):
				draw_line(Vector2(local_x + 116, rung_y), Vector2(local_x + 154, rung_y), Color("#77756d"), 4)
		else:
			draw_rect(Rect2(local_x - 180, bottom - 20, 360, 15), Color("#171919"))
	if rear:
		for service_door in rear_service_doors():
			var door_point: Vector2 = service_door["point"]
			var door_x: = door_point.x - camera_offset_x()
			if door_x < -90.0 or door_x > 1370.0: continue
			var door_rect: = Rect2(door_x - 46.0, 346.0, 92.0, 84.0)
			draw_rect(door_rect, Color("#202523"))
			draw_rect(Rect2(door_rect.position + Vector2(7, 8), door_rect.size - Vector2(14, 8)), Color("#3c403b"))
			draw_rect(door_rect, Color("#101312"), false, 4.0)
			draw_circle(Vector2(door_rect.end.x - 14.0, 388.0), 3.5, Color("#a68d52"))
			draw_centered(String(service_door["label"]).replace(" DOOR", "").left(18), Vector2(door_x, 369.0), 8, PAPER)
		draw_rect(Rect2(0, 430, 1280, 95), Color("#252823"))
		draw_text("SERVICE ALLEY - FEWER CAMERAS, NOT FEWER CONSEQUENCES", Vector2(330, 505), 13, Color("#a7a18f"))
		for camera_x_rear in [330.0, 980.0]:
			draw_camera_icon(Vector2(camera_x_rear, 155))
	else:
		draw_rect(Rect2(0, 430, 1280, 95), Color("#202324"))
		draw_text("ROOFTOPS - STAMINA IS A TIMER WITH GRAVITY ATTACHED", Vector2(320, 505), 13, Color("#a7a18f"))

