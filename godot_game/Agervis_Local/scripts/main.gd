		draw_line(Vector2(tuft_x + 1, 431), Vector2(tuft_x - 6, 404), Color(0, 0, 0, 0.3), 5)
		draw_line(Vector2(tuft_x, 431), Vector2(tuft_x - 7, 404), Color("#536044"), 4)
		draw_line(Vector2(tuft_x, 431), Vector2(tuft_x + 9, 399), Color("#49583d"), 3)

		draw_line(Vector2(tuft_x - 3, 415), Vector2(tuft_x - 8, 410), Color("#63704d"), 2)

	var crate: = Rect2(left + width * 0.55, 379, 54, 36)
	draw_rect(crate.grow(1), Color(0, 0, 0, 0.35))
	draw_rect(crate, Color("#6c5a43"))
	draw_rect(crate, Color.BLACK, false, 1.5)

	draw_line(Vector2(left + width * 0.55, 379), Vector2(left + width * 0.55 + 54, 415), Color("#392f28"), 2)
	for i in range(4):
		draw_line(crate.position + Vector2(5, 8 + i * 8), crate.position + Vector2(crate.size.x - 5, 8 + i * 8), Color("#6c5a43").darkened(0.25), 0.5)

func draw_store_bank_backlot(world_center: float, width: float, offset: float) -> void :
	var left: = world_center - width * 0.5 - offset
	if left > 1320.0 or left + width < -40.0:
		return

	draw_rect(Rect2(left, 250, width, 188), Color("#282827"))
	draw_rect(Rect2(left, 250, width, 188), Color.BLACK, false, 1.5)

	for crack_offset in [28.0, 67.0, 95.0]:
		draw_line(Vector2(left + crack_offset, 260), Vector2(left + crack_offset + 15, 430), Color("#1a1a19"), 1.5)

	var dock: = Rect2(left + 12, 268, 96, 84)
	draw_rect(dock.grow(2), Color(0, 0, 0, 0.35))
	draw_rect(dock, Color("#4a4236"))
	draw_rect(dock, Color.BLACK, false, 2.0)

	var door: = Rect2(left + 20, 278, 80, 64)
