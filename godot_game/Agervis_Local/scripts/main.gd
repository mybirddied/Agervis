func confirm_barber_preview() -> void :
	if not barber_preview_active:
		return
	var changed: = barber_changed_categories()
	if changed.is_empty():
		notify("NO STYLE CHANGES  -  NO CHARGE", ACCENT, 2.5)
		close_barber_preview()
		return
	var total: = barber_preview_total()
	if shop_source_balance() < total:
		notify("NOT ENOUGH %s  -  NEED $%d" % [shop_source_name(), total], DANGER, 2.5)
		return
	var appearance: = barber_preview_appearance()
	if online_economy_enabled():
		var serialized: = appearance.duplicate(true)
		serialized["hair_color"] = (appearance["hair_color"] as Color).to_html(false)
		serialized["facial_hair_color"] = (appearance["facial_hair_color"] as Color).to_html(false)
		submit_online_economy_request("BARBER_APPEARANCE", {"appearance": serialized, "money_type": ["clean", "dirty", "bank"][shop_payment_source]}, true, {"changed_categories": changed, "total_price": total})
		return
	change_shop_source_balance( - total)
	apply_barber_preview_appearance(appearance)
	shop_confirmation = "STYLE CONFIRMED  /  PAID $%d FROM %s" % [total, shop_source_name()]
	barber_preview_active = false
	barber_original_appearance.clear()
	mode = ScreenMode.PLAY
	save_current_character("BARBER STYLE CONFIRMED")
	notify(shop_confirmation, GOOD, 3.0)

