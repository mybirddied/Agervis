		return
	for tab_index in range(phone_tab_count()):
		if phone_tab_rect(tab_index).has_point(point):
			phone_tab = tab_index
			phone_cursor = 0
			return
	if phone_tab == 0:
		var start: = maxi(0, phone_messages.size() - 6)
		for row in range(mini(6, phone_messages.size())):
			if phone_message_rect(row).has_point(point):
				phone_cursor = start + row
				return

func contract_phone_lines() -> Array[String]:
	var lines: Array[String] = []
	if job_contract.is_empty():
		lines.append("NO ACTIVE EMPLOYMENT CONTRACT")
		lines.append("Apply at an employer, then the paperwork will start remembering you.")
		return lines
	var employer: = String(job_contract.get("employer", "UNFILED"))
	var required: = String(job_contract.get("required_credential", "none"))
	var pay: Dictionary = Dictionary(job_contract.get("pay_range", {}))
	var attendance: Dictionary = Dictionary(job_contract.get("attendance", {}))
	var threshold: Dictionary = Dictionary(job_contract.get("firing_threshold", {}))
	var task_state: Dictionary = Dictionary(job_contract.get("task_state", {}))
	var completed: Dictionary = Dictionary(task_state.get("completed", {}))
	lines.append("EMPLOYER: %s" % employer.to_upper())
	lines.append("STATUS: %s    TRUST: %d/100" % [String(job_contract.get("status", "active")).to_upper(), int(job_contract.get("trust", 0))])
	if String(job_contract.get("employer_id", "")) == "capone":
		lines.append("QUALIFICATION: CRIMINAL P.A.T.H. + 30 COMPLETED MOTH RUNS")
		lines.append("MISSED ASSIGNMENTS: %d/%d" % [int(job_contract.get("failure_count", 0)), lan_session.CAPONE_FAILURE_LIMIT])
		var capone_task: = active_capone_task()
		if not capone_task.is_empty():
			lines.append("ACTIVE ASSIGNMENT: %s" % String(capone_task.get("label", "ASSIGNED TASK")).to_upper())
		elif String(job_contract.get("status", "")) == "fired":
			var start_runs: = int(capone_record.get("requalification_start_runs", capone_moth_run_count()))
			lines.append("REQUALIFICATION: %d/%d FRESH MOTH RUNS" % [maxi(0, capone_moth_run_count() - start_runs), lan_session.CAPONE_MOTH_RUN_REQUIREMENT])
		return lines
	lines.append("REQUIRED: %s  [%s]" % [required.to_upper(), "FILED" if required in credentials else "MISSING"])
	lines.append("PAY RANGE: $%d-$%d   DEPOSIT BONUS: $%d" % [int(pay.get("min", 0)), int(pay.get("max", 0)), int(pay.get("deposit_bonus", 0))])
	lines.append("ATTENDANCE: %.0fs on site / %.0fs away" % [float(attendance.get("on_site_seconds", 0.0)), float(attendance.get("away_seconds", 0.0))])
	lines.append("FIRING THRESHOLD: %.0fs away" % float(threshold.get("absence_seconds", 0.0)))
	var required_tasks: Array = task_state.get("required", [])
	if required_tasks.is_empty():
		lines.append("TASK STATE: No recurring tasks filed.")
	else:
		var task_line: = "TASKS: "
		for task_variant in required_tasks:
			var task_name: = String(task_variant)
			task_line += "%s [%s]  " % [task_name.to_upper(), "DONE" if bool(completed.get(task_name, false)) else "OPEN"]
		lines.append(task_line.strip_edges())
	var active_task: = String(task_state.get("active", ""))
	if not active_task.is_empty():
		lines.append("ACTIVE ASSIGNMENT: %s" % active_task.to_upper())
	for handoff_variant in handoff_items.values():
		var handoff: Dictionary = Dictionary(handoff_variant)
		if String(handoff.get("employer", "")) == employer and String(handoff.get("state", "")) == "carried":
			lines.append("CARRIED: %s -> %s" % [String(handoff.get("display_name", "ITEM")).to_upper(), String(handoff.get("destination", "UNFILED"))])
	return lines

