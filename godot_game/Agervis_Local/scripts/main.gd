func ease_out_cubic(t: float) -> float:
	return 1.0 - pow(1.0 - t, 3.0)

func ease_in_quad(t: float) -> float:
	return t * t

func ease_out_quad(t: float) -> float:
	return 1.0 - (1.0 - t) * (1.0 - t)

func ease_in_out_quad(t: float) -> float:
	return 2.0 * t * t if t < 0.5 else 1.0 - pow(-2.0 * t + 2.0, 2.0) / 2.0


func calculate_elbow_position(shoulder: Vector2, hand: Vector2, upper_len: float, forearm_len: float, bend_direction: float = 1.0) -> Vector2:
	var delta: = hand - shoulder
	var distance: = delta.length()


	var max_reach: = upper_len + forearm_len
	var min_reach: float = abs(upper_len - forearm_len)
	var clamped_distance: = clampf(distance, min_reach * 0.99, max_reach * 0.99)


	var reachable_hand: = hand
	if distance > 0.001:
		if distance != clamped_distance:
			var direction: = delta / distance
			reachable_hand = shoulder + direction * clamped_distance
			delta = reachable_hand - shoulder
			distance = clamped_distance


	var a: = upper_len
	var b: = forearm_len
	var c: = distance

	var cos_angle: = (a * a + c * c - b * b) / (2.0 * a * c)
	cos_angle = clampf(cos_angle, -1.0, 1.0)
	var angle_at_shoulder: = acos(cos_angle)
	var direction_to_hand: = delta.angle()


	var elbow_angle: = direction_to_hand + angle_at_shoulder * bend_direction

	var elbow: = shoulder + Vector2(cos(elbow_angle), sin(elbow_angle)) * upper_len
	return elbow


func calculate_knee_position(hip: Vector2, foot: Vector2, thigh_len: float, shin_len: float, bend_direction: float = -1.0) -> Vector2:
	var delta: = foot - hip
	var distance: = delta.length()


	var max_reach: = thigh_len + shin_len
	var min_reach: float = abs(thigh_len - shin_len)
	var clamped_distance: = clampf(distance, min_reach * 0.99, max_reach * 0.99)


	var reachable_foot: = foot
	if distance > 0.001:
		if distance != clamped_distance:
			var direction: = delta / distance
			reachable_foot = hip + direction * clamped_distance
			delta = reachable_foot - hip
			distance = clamped_distance

	var a: = thigh_len
	var b: = shin_len
	var c: = distance

	var cos_angle: = (a * a + c * c - b * b) / (2.0 * a * c)
	cos_angle = clampf(cos_angle, -1.0, 1.0)
	var angle_at_hip: = acos(cos_angle)
	var direction_to_foot: = delta.angle()


	var knee_angle: = direction_to_foot + angle_at_hip * bend_direction

	var knee: = hip + Vector2(cos(knee_angle), sin(knee_angle)) * thigh_len
	return knee


func draw_capsule_limb(start: Vector2, end: Vector2, start_width: float, end_width: float, limb_color: Color) -> void :
	var direction: = (end - start).normalized()
	var perpendicular: = Vector2( - direction.y, direction.x)

	var start_offset: = perpendicular * start_width * 0.5
	var end_offset: = perpendicular * end_width * 0.5

	var polygon: = PackedVector2Array([
		start + start_offset, 
		end + end_offset, 
		end - end_offset, 
		start - start_offset
	])

	draw_colored_polygon(polygon, limb_color)
	draw_circle(start, start_width * 0.5, limb_color)
	draw_circle(end, end_width * 0.5, limb_color)

func draw_smear_limb(start: Vector2, end: Vector2, width: float, limb_color: Color, smear_multiplier: float) -> void :

	var length: = (end - start).length()
	var smear_length: = length * smear_multiplier
	var direction: = (end - start).normalized()
	var smear_end: = end + direction * (smear_length - length)


	var start_width: = width * 1.2
	var end_width: = width * 0.4

	draw_capsule_limb(start, smear_end, start_width, end_width, limb_color.darkened(0.15))


func draw_fist_shape(pos: Vector2, rotation: float, is_vertical: bool, skin_color: Color, scale: float = 1.0) -> void :
	var base_radius: = 4.0 * scale
	draw_circle(pos, base_radius, skin_color)

	var knuckle_offset: = Vector2(cos(rotation), sin(rotation)) * base_radius * 0.6
	draw_circle(pos + knuckle_offset, base_radius * 0.7, skin_color.darkened(0.1))

func draw_palm_shape(pos: Vector2, rotation: float, skin_color: Color, scale: float = 1.0) -> void :
	var width: = 8.0 * scale
	var height: = 6.0 * scale
	var direction: = Vector2(cos(rotation), sin(rotation))
	var perpendicular: = Vector2( - direction.y, direction.x)

	var palm: = PackedVector2Array([
		pos + perpendicular * width * 0.5, 
		pos + direction * height * 0.5 + perpendicular * width * 0.3, 
		pos + direction * height * 0.5 - perpendicular * width * 0.3, 
		pos - perpendicular * width * 0.5
	])
	draw_colored_polygon(palm, skin_color)

func draw_elbow_shape(pos: Vector2, skin_color: Color, scale: float = 1.0) -> void :
	var base_radius: = 5.0 * scale
	draw_circle(pos, base_radius, skin_color.darkened(0.05))

	var point_radius: = 3.0 * scale
	draw_circle(pos, point_radius, skin_color.lightened(0.1))

func draw_shin_shape(start: Vector2, end: Vector2, skin_color: Color, scale: float = 1.0) -> void :
	var width: = 7.0 * scale
	draw_capsule_limb(start, end, width, width * 0.8, skin_color)

	draw_line(start, end, skin_color.lightened(0.15), 2.0 * scale)

func draw_character_figure(
	point: Vector2, 
	color: Color, 
	label: String, 
	downed: bool, 
	restrained: bool, 
	is_player: bool = false, 
	skin_color: Color = Color.TRANSPARENT, 
	hair_style: String = "short", 
	body_style: String = "standard", 
	hair_color: Color = Color("#17191b"), 
	face_style: String = "angular", 
	eye_style: String = "steady", 
	stature: String = "average", 
	outfit_style: String = "jacket", 
	surreal_trait: String = "none", 
	accessory: String = "none", 
	facial_hair_style: String = "none", 
	facial_hair_color: Color = Color("#3b2a23"), 
	render_scale: float = 1.0, 
	pants_color: Color = Color("#25282b"), 
	expression: String = "neutral", 
	breast_style: String = "flat", 
	attack_override: bool = false, 
	attack_weapon_override: String = "Fists", 
	facing_override: float = 1.0, 
	walking_override: bool = false
) -> void :
	var actual_skin: = color.lightened(0.26) if skin_color.a <= 0.0 else skin_color
	if downed:
		var breath: = 0.0 if low_spec else sin(elapsed * 4.0 + point.x * 0.03) * 1.4
		draw_flat_ellipse(point + Vector2(0, 19), Vector2(49, 14), Color(0.03, 0.03, 0.035, 0.68))
		draw_line(point + Vector2(-38, 1 + breath), point + Vector2(32, 6), color.darkened(0.18), 22)
		draw_line(point + Vector2(-25, 4), point + Vector2(-45, 13), Color("#202327"), 8)
		draw_circle(point + Vector2(42, 4 + breath * 0.4), 13, actual_skin)
		draw_line(point + Vector2(43, 1), point + Vector2(48, 1), INK, 2)
		draw_centered(label + ("  -  DOWNED" if "DOWNED" not in label else ""), point + Vector2(0, -29), 12, PAPER)
		return
	var depth_scale: = sprite_depth_scale(point.y, render_scale)
	var stature_scale: = stature_scale_for(stature)
	var direction: = facing if is_player else (-1.0 if facing_override < 0.0 else 1.0)
	var arrested_pose: = custody_pose_active(restrained, is_player)
	var vault_pose: = is_player and vault_active and not arrested_pose
	var attack_pose: = (is_player and attack_animation_timer > 0.0 or attack_override) and not arrested_pose and not vault_pose
	var walking_now: = player_walking if is_player else walking_override
	var idle_bob: = 0.0 if low_spec or walking_now else sin(elapsed * 2.1 + point.x * 0.015) * 1.25
	var struggle: = sin(elapsed * 8.5 + point.x * 0.021) if arrested_pose and not low_spec else 0.0
	var body_rotation: = struggle * 0.035 if arrested_pose else -0.12 * direction if vault_pose else -0.09 * direction if attack_pose else sin(elapsed * 1.3 + point.x) * 0.008 if surreal_trait == "tilted posture" else 0.0
