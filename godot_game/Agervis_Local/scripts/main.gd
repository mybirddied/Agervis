		var x_offset_from_center: = (player_world_x - 490.0) * x_multiplier
		var shadow_center: = Vector2(screen.get_center().x + x_offset_from_center, screen.get_center().y)


		var depth_factor: = (player_screen_pos.y - beam_end.y) / (beam_start.y - beam_end.y)
		var base_width: = 60.0
		var base_height: = 100.0
		var size_multiplier: = 1.0 + depth_factor * 1.5
		var shadow_size: = Vector2(base_width * size_multiplier, base_height * size_multiplier)


		var shadow_right_edge: = shadow_center.x + shadow_size.x / 2
		var fade_start_x: = 680.0
		var shadow_alpha: = 0.7
