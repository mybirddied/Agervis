		actor.eye_style, actor.stature, actor.outfit_style, actor.surreal_trait, actor.accessory, 
		actor.facial_hair_style, actor.facial_hair_color, actor.render_scale, Color("#222426"), 
		"neutral", "flat", actor.hostile and actor.attack_cooldown > 0.65, "Fists", actor_facing, actor_walking
	)

func draw_player_world() -> void :
	if sleeping:
		draw_sleeping_player()
		return
	var strike_progress: = 1.0 - attack_animation_timer / 0.24 if attack_animation_timer > 0.0 else 0.0
	var lunge: = sin(strike_progress * PI) * 13.0 if attack_animation_timer > 0.0 else 0.0


	if attack_animation_timer > 0.0 and not low_spec:
		var attack_point: = scene_position(player_position + Vector2(facing * (24.0 + lunge), -35))
		var weapon: = attack_weapon_used


		if strike_progress > 0.2 and strike_progress < 0.8:
			var trail_intensity: = sin(strike_progress * PI) * 0.6
			var trail_color: = Color(1.0, 0.3, 0.2, trail_intensity)
			if weapon != "Fists":

				var trail_start: = attack_point + Vector2( - facing * 25, -15 + sin(strike_progress * PI * 2) * 12)
				var trail_end: = attack_point + Vector2(facing * 20, 10 + sin(strike_progress * PI * 2) * 8)
				for i in range(3):
					var offset: = float(i - 1) * 2.0
					draw_line(trail_start + Vector2(0, offset), trail_end + Vector2(0, offset), trail_color.darkened(float(i) * 0.2), 2.5 - float(i) * 0.5)
			else:

				for i in range(4):
					var blur_offset: = float(i) * facing * -3.0
					draw_circle(attack_point + Vector2(blur_offset, 0), 6.0 - float(i) * 1.0, Color(1.0, 0.8, 0.7, 0.3 - float(i) * 0.06))


		if strike_progress > 0.45 and strike_progress < 0.65 and attack_impact_flash > 0.5:
			var flash_size: = 18.0 * attack_impact_flash
			draw_circle(attack_point, flash_size, Color(1.0, 0.95, 0.85, 0.4 * attack_impact_flash))
			draw_circle(attack_point, flash_size * 0.6, Color(1.0, 0.7, 0.3, 0.6 * attack_impact_flash))

			for angle_i in range(6):
				var angle: = float(angle_i) * TAU / 6.0 + strike_progress * 0.5
				var line_start: = attack_point + Vector2(cos(angle), sin(angle)) * flash_size * 0.4
				var line_end: = attack_point + Vector2(cos(angle), sin(angle)) * flash_size * 1.3
				draw_line(line_start, line_end, Color(1.0, 0.6, 0.2, 0.5 * attack_impact_flash), 2.0)


		if strike_progress > 0.15 and strike_progress < 0.75:
			var line_alpha: = sin(strike_progress * PI) * 0.4
			var line_count: = 5 if weapon != "Fists" else 3
			for i in range(line_count):
				var line_y: = -45.0 + float(i) * 15.0
				var line_length: = 20.0 + sin(strike_progress * PI) * 15.0
				var line_start: = scene_position(player_position + Vector2( - facing * line_length, line_y))
				var line_end: = scene_position(player_position + Vector2( - facing * 5, line_y))
				draw_line(line_start, line_end, Color(0.9, 0.9, 1.0, line_alpha * (1.0 - float(i) * 0.15)), 1.5)

	var point: = scene_position(player_position) + Vector2(facing * lunge, 0)
	draw_character_figure(
		point, player_color, player_name + (" [YOU]" if lan_session.active else ""), player_downed, player_detained or mode == ScreenMode.ARREST, true, 
		player_skin, player_hair_style, player_body_style, player_hair_color, player_face_style, player_eye_style,
		player_stature, player_outfit_style, player_surreal_trait, player_accessory,
		player_facial_hair_style, player_facial_hair_color, 1.16, player_pants_color, player_expression, player_boobs,
		attack_animation_timer > 0.0, attack_type, facing, player_walking
	)
