		var selected: = roster_cursor == index
		var rect: = Rect2(875, 175 + premium_index * 120, 330, 92)


		draw_rect(Rect2(rect.position.x + 2, rect.position.y + 2, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.4))


