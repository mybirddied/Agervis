			selected_actor.revive(28.0)
			notify("d16=%d  -  LASTING INJURY TOOK" % roll, DANGER, 5.0)
	else:
		selected_actor.revive(22.0)
		selected_actor.hostile = false
		selected_actor.ai_state = "flee"
		var bounds: = area_bounds()
		selected_actor.target_x = bounds.x if selected_actor.position.x < player_position.x else bounds.z
		notify("d16=%d  -  PERMANENT OUTCOME FAILED; TARGET ESCAPING" % roll, ACCENT, 5.0)
	grant_xp("Fighting", 80)
	selected_actor = null

