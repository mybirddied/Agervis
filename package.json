{
  "name": "agervis-desktop",
  "version": "1.0.0",
  "description": "Agervis Desktop Server Manager - One-click server deployment for non-technical users",
  "type": "module",
  "main": "dist/electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:react\"",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development tsc electron/**/*.ts --outDir dist && electron dist/electron/main.js",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src electron --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.4.1",
    "recharts": "^2.12.0",
    "lucide-react": "^0.408.0",
    "ws": "^8.14.2",
    "better-sqlite3": "^9.2.2",
    "isomorphic-dompurify": "^2.11.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.6.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "vitest": "^1.1.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.agervis.desktop",
    "productName": "Agervis Server",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
