func draw_panel(title: String, lines: Array[String], options: Array[Dictionary]) -> void :
	var panel: = Rect2(170, 105, 940, 510)


	if not low_spec:
		draw_rect(Rect2(panel.position.x + 4, panel.position.y + 4, panel.size.x, panel.size.y), Color(0.02, 0.02, 0.025, 0.5))


	draw_rect(panel, Color(0.045, 0.047, 0.05, DIALOG_PANEL_ALPHA))


	draw_rect(panel, Color("#4a4d52"), false, 3.0)
	if not low_spec:
		draw_rect(panel.grow(-4), Color("#5a5d62"), false, 1.5)


	var header: = Rect2(190, 125, 900, 58)
	draw_rect(header, Color("#353436"))
	draw_rect(Rect2(header.position.x, header.position.y, header.size.x, 4), Color("#454648"))
	draw_rect(header, Color("#505255"), false, 2.0)


	draw_text(title, Vector2(221, 165), 25, Color("#0a0c0e"))
	draw_text(title, Vector2(220, 164), 25, PAPER)

	var portrait_index: = portrait_index_for_title(title)
	var content_x: = 220.0
	var content_width: = 840.0

	if portrait_index >= 0:
		var portrait_rect: = Rect2(205, 205, 235, 235)


		if not low_spec:
			draw_rect(Rect2(portrait_rect.position.x + 3, portrait_rect.position.y + 3, portrait_rect.size.x, portrait_rect.size.y), Color(0.02, 0.02, 0.025, 0.4))

		draw_matching_character_window(title, portrait_rect)


		var label_rect: = Rect2(205, 450, 235, 28)
		draw_rect(label_rect, Color("#2a2c2e", 0.9))
		draw_rect(label_rect, Color("#4a4d52"), false, 1.5)
		draw_centered("OBSERVED RESIDENT", Vector2(label_rect.get_center().x, 470), 12, Color("#8f8980"))

		content_x = 470.0
		content_width = 590.0

	var compact_skills: = title == "SKILLS"
	var cursor_y: = 205.0 if compact_skills else 220.0

	for line_index in range(lines.size()):
		var line: = String(lines[line_index]).strip_edges()
		var line_x: = content_x
		var line_width: = content_width
		var line_size: = 13 if compact_skills else 16

		if compact_skills and line_index >= 4 and line_index - 4 >= Rules.SKILLS.find("Awareness"):
			line_x += 24.0
			line_width -= 24.0

		var used: = draw_wrapped(line, Rect2(line_x, cursor_y, line_width, 32 if compact_skills else 60), line_size, Color("#c7c0b4"))
		cursor_y += maxf(18.0 if compact_skills else 29.0, used + (2.0 if compact_skills else 8.0))

	if options.is_empty():
		draw_dialog_close_hint(Vector2(content_x, 582))
	else:
		var max_display: = options.size()
		for index in range(max_display):
			var option_rect: = dialog_option_rect(index, options.size())
			var selected: = index == menu_cursor


			var using_face_button: = last_input_controller and index < 4
			var semantic_button: = controller_face_semantic(index + 1) if using_face_button else ""


			if not low_spec:
				draw_rect(Rect2(option_rect.position.x + 2, option_rect.position.y + 2, option_rect.size.x, option_rect.size.y), Color(0.02, 0.02, 0.025, 0.3))


			var bg_color: = Color("#1a1e20")
			if using_face_button:
				bg_color = controller_button_dark_color(semantic_button)
			elif selected:
				bg_color = Color("#3a4041")

			draw_rect(option_rect, bg_color)


			if not low_spec:
				var highlight_color: = Color("#2a2e30")
				if using_face_button:
					highlight_color = controller_button_dark_color(semantic_button).lightened(0.2)
				elif selected:
					highlight_color = Color("#4a4d51")
				draw_rect(Rect2(option_rect.position.x, option_rect.position.y, option_rect.size.x, 3), highlight_color)


			var border_color: = Color("#555a59")
			var border_width: = 1.5
			if using_face_button:
				border_color = controller_button_color(semantic_button).darkened(0.3)
				border_width = 2.0
			elif selected:
				border_color = ACCENT
				border_width = 2.5

			draw_rect(option_rect, border_color, false, border_width)
			if selected and not low_spec and not using_face_button:
				draw_rect(option_rect.grow(-2), ACCENT.lightened(0.3), false, 1.0)


			if selected and not using_face_button:
				draw_rect(Rect2(option_rect.position.x + 4, option_rect.position.y + 10, 3, 28), ACCENT)

			var show_glyph: = last_input_controller or not mobile_controls_enabled
			if show_glyph:
				draw_choice_glyph(option_rect.position + Vector2(19, 17), index + 1)

			var label_x: = 12.0 if not show_glyph else 42.0
			if selected and not using_face_button:
				label_x += 4


			if selected and not using_face_button:
				draw_text(String(options[index]["label"]).left(62), option_rect.position + Vector2(label_x + 1, 24), 14, Color("#0a0c0e"))

			draw_text(String(options[index]["label"]).left(62), option_rect.position + Vector2(label_x, 23), 14, PAPER)

func draw_enhanced_bar(pos: Vector2, width: float, ratio: float, bar_color: Color, label: String, icon: String) -> void :
	var bar_height: = 26.0
	var bar_rect: = Rect2(pos.x, pos.y, width, bar_height)


	if not low_spec:
		draw_rect(Rect2(pos.x + 2, pos.y + 2, width, bar_height), Color(0.02, 0.02, 0.025, 0.4))


	draw_rect(bar_rect, Color("#0e1012"))
	draw_rect(Rect2(pos.x, pos.y, width, 3), Color("#1e2022"))


	draw_rect(bar_rect, Color("#3a3d42"), false, 2.0)
	if not low_spec:
		draw_rect(bar_rect.grow(-2), Color("#4a4d52"), false, 1.0)


	var fill_width: = (width - 6) * clampf(ratio, 0.0, 1.0)
	if fill_width > 0:
		var fill_rect: = Rect2(pos.x + 3, pos.y + 3, fill_width, bar_height - 6)
		draw_rect(fill_rect, bar_color.darkened(0.2))
		draw_rect(Rect2(fill_rect.position.x, fill_rect.position.y, fill_rect.size.x, 3), bar_color.lightened(0.2))


		if not low_spec and ratio < 0.3:
			var pulse: = 0.3 + 0.2 * sin(elapsed * 6.0)
			draw_rect(fill_rect.grow(1), Color(bar_color.r, bar_color.g, bar_color.b, pulse * 0.4))


	draw_text(label, Vector2(pos.x + 9, pos.y + 9), 11, Color("#0a0c0e"))
	draw_text(label, Vector2(pos.x + 8, pos.y + 8), 11, Color("#8a8479"))


	draw_text(icon, Vector2(pos.x + width - 22, pos.y + 18), 16, bar_color)


	var pct_text: = "%d%%" % int(ratio * 100)
	var pct_size: = font.get_string_size(pct_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 13)
	draw_text(pct_text, Vector2(pos.x + width - pct_size.x - 32, pos.y + 18), 13, PAPER)

func draw_option_button(rect: Rect2, label: String, selected: bool, number: int) -> void :
	draw_rect(rect, Color("#3a4041") if selected else Color("#1a1e20"))
	draw_rect(rect, ACCENT if selected else Color("#555a59"), false, 2.0 if selected else 1.0)
	var show_glyph: = last_input_controller or not mobile_controls_enabled
	if show_glyph:
		draw_choice_glyph(rect.position + Vector2(19, 17), number)
	var label_x: = 12.0 if not show_glyph else 42.0
	draw_text(label.left(62), rect.position + Vector2(label_x, 23), 14, PAPER)
func dialog_portrait_profile(identity: String) -> Dictionary:
	var upper: = identity.to_upper()
	if "COUNSELOR" in upper or "MS. VALE" in upper:
		return {"skin": Color("#9b6549"), "shirt": Color("#6f675b"), "hair": "bun", "hair_color": Color("#2b211d"), "body": "slender", "face": "round", "eyes": "steady", "outfit": "sweater", "accessory": "glasses", "facial_hair": "none", "facial_hair_color": Color("#2b211d")}
	if "OFFICER" in upper or "PIKE" in upper:
		return {"skin": Color("#9b664a"), "shirt": Color("#5e7fa6"), "hair": "low fade", "hair_color": Color("#17191b"), "body": "athletic", "face": "heavy jaw", "eyes": "sharp", "outfit": "uniform shirt", "accessory": "none", "facial_hair": "mustache", "facial_hair_color": Color("#17191b")}
	if "DETAIN" in upper:
		return {"skin": Color("#744630"), "shirt": Color("#8e5b54"), "hair": "buzz", "hair_color": Color("#161719"), "body": "slender", "face": "square", "eyes": "tired", "outfit": "tank top", "accessory": "face mark", "facial_hair": "stubble", "facial_hair_color": Color("#161719")}
	if "BOSS" in upper:
