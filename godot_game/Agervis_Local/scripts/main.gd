			draw_arc(Vector2(-12 + face_offset_x, -38), 4, 0, PI, 10, hair_color, 3.0)
			draw_arc(Vector2(12 + face_offset_x, -38), 4, 0, PI, 10, hair_color, 3.0)
		"horseshoe":

			draw_line(Vector2(-10 + face_offset_x, -38), Vector2(-1 + face_offset_x, -36), hair_color, 4.0)
			draw_line(Vector2(1 + face_offset_x, -36), Vector2(10 + face_offset_x, -38), hair_color, 4.0)

			draw_line(Vector2(-10 + face_offset_x, -38), Vector2(-10 + face_offset_x, -25), hair_color, 4.0)
			draw_line(Vector2(10 + face_offset_x, -38), Vector2(10 + face_offset_x, -25), hair_color, 4.0)
		"pencil mustache":

			draw_line(Vector2(-8 + face_offset_x, -37), Vector2(-1 + face_offset_x, -36), hair_color, 1.8)
			draw_line(Vector2(1 + face_offset_x, -36), Vector2(8 + face_offset_x, -37), hair_color, 1.8)
		"walrus":

			draw_line(Vector2(-10 + face_offset_x, -38), Vector2(-1 + face_offset_x, -36), hair_color, 5.0)
			draw_line(Vector2(1 + face_offset_x, -36), Vector2(10 + face_offset_x, -38), hair_color, 5.0)

			draw_line(Vector2(-8 + face_offset_x, -36), Vector2(-8 + face_offset_x, -28), hair_color, 4.0)
			draw_line(Vector2(8 + face_offset_x, -36), Vector2(8 + face_offset_x, -28), hair_color, 4.0)
		"dali":

			draw_line(Vector2(-8 + face_offset_x, -36), Vector2(-10 + face_offset_x, -44), hair_color, 2.0)
			draw_line(Vector2(8 + face_offset_x, -36), Vector2(10 + face_offset_x, -44), hair_color, 2.0)
		"fu manchu":

			draw_line(Vector2(-8 + face_offset_x, -37), Vector2(-1 + face_offset_x, -36), hair_color, 2.5)
			draw_line(Vector2(1 + face_offset_x, -36), Vector2(8 + face_offset_x, -37), hair_color, 2.5)
			draw_line(Vector2(-8 + face_offset_x, -37), Vector2(-8 + face_offset_x, -22), hair_color, 2.5)
			draw_line(Vector2(8 + face_offset_x, -37), Vector2(8 + face_offset_x, -22), hair_color, 2.5)
		"friendly chops":

			draw_line(Vector2( - head_radii.x + 3, -53), Vector2( - head_radii.x + 4, -38), hair_color, 5.0)
			draw_line(Vector2(head_radii.x - 3, -53), Vector2(head_radii.x - 4, -38), hair_color, 5.0)
			draw_line(Vector2( - head_radii.x + 4, -38), Vector2(-1 + face_offset_x, -36), hair_color, 3.5)
			draw_line(Vector2(head_radii.x - 4, -38), Vector2(1 + face_offset_x, -36), hair_color, 3.5)
		"verdi":

			draw_line(Vector2(-9 + face_offset_x, -38), Vector2(-1 + face_offset_x, -36), hair_color, 3.5)
			draw_line(Vector2(1 + face_offset_x, -36), Vector2(10 + face_offset_x, -38), hair_color, 3.5)
			draw_arc(Vector2(0, -30), 8, PI * 0.2, PI * 0.8, 10, hair_color, 6.0)
		"ducktail":

			draw_colored_polygon(PackedVector2Array([
				Vector2(-14, -42), Vector2(-12, -32), Vector2(-8, -26), 
				Vector2(-4, -22), Vector2(0, -18), Vector2(4, -22), 
				Vector2(8, -26), Vector2(12, -32), Vector2(14, -42), 
				Vector2(8, -36), Vector2(-8, -36)
			]), hair_color)

			if not low_spec:
				draw_line(Vector2(0, -28), Vector2(0, -18), hair_color.darkened(0.2), 1.5)
		"corporate beard":

			draw_colored_polygon(PackedVector2Array([
				Vector2(-13, -42), Vector2(-11, -32), Vector2(-7, -26), 
				Vector2(0, -24), Vector2(7, -26), Vector2(11, -32), 
				Vector2(13, -42), Vector2(8, -36), Vector2(-8, -36)
			]), hair_color)
			draw_polyline(PackedVector2Array([
				Vector2(-11, -32), Vector2(-7, -26), Vector2(0, -24), 
				Vector2(7, -26), Vector2(11, -32)
			]), hair_color.lightened(0.1), 1.5, true)
		"bandholz":

			draw_colored_polygon(PackedVector2Array([
				Vector2( - head_radii.x + 2, -45), Vector2(-19, -36), Vector2(-18, -26), 
				Vector2(-14, -18), Vector2(-10, -12), Vector2(0, -8), Vector2(10, -12), 
				Vector2(14, -18), Vector2(18, -26), Vector2(19, -36), 
				Vector2(head_radii.x - 2, -45), Vector2(12, -37), Vector2(-12, -37)
			]), hair_color)
			if not low_spec:
				for strand_x in [-12.0, -6.0, 0.0, 6.0, 12.0]:
					draw_line(Vector2(strand_x, -36), Vector2(strand_x * 0.8, -14), hair_color.darkened(0.18), 1.5)
		"yeard":

			draw_colored_polygon(PackedVector2Array([
				Vector2( - head_radii.x + 2, -45), Vector2(-20, -34), Vector2(-19, -22), 
				Vector2(-16, -12), Vector2(-12, -4), Vector2(-8, 2), Vector2(0, 4), 
				Vector2(8, 2), Vector2(12, -4), Vector2(16, -12), Vector2(19, -22), 
				Vector2(20, -34), Vector2(head_radii.x - 2, -45), Vector2(12, -37), Vector2(-12, -37)
			]), hair_color)
			if not low_spec:
				for strand_x in [-14.0, -8.0, -2.0, 4.0, 10.0]:
					draw_line(Vector2(strand_x, -36), Vector2(strand_x * 0.7, 0), hair_color.darkened(0.2), 1.2)
		"stubble goatee":

			var stubble_positions: = [
				Vector2(-11, -40), Vector2(-9, -39), Vector2(-7, -38), 
				Vector2(9, -39), Vector2(11, -40), Vector2(-10, -35), 
				Vector2(10, -35), Vector2(-8, -30), Vector2(8, -30)
			]
			for dot in stubble_positions:
				draw_circle(dot + Vector2(face_offset_x, 0), 1.0, hair_color.darkened(0.15))

			draw_colored_polygon(PackedVector2Array([
				Vector2(-5 + face_offset_x, -34), Vector2(6 + face_offset_x, -34), 
				Vector2(4 + face_offset_x, -26), Vector2(-3 + face_offset_x, -26)
			]), hair_color)

func draw_character_hair(style: String, hair_color: Color, head_radii: Vector2) -> void :
	var scalp_radius: = head_radii.x - 1.0
	match style:
		"low fade":

			draw_arc(Vector2(0, -50), scalp_radius, PI + 0.12, TAU - 0.12, 18, hair_color, 5.5)
			draw_arc(Vector2(0, -51), scalp_radius - 1, PI + 0.15, TAU - 0.15, 16, hair_color.darkened(0.12), 4.0)

			if not low_spec:
				draw_arc(Vector2(-3, -54), scalp_radius * 0.6, PI + 0.3, PI + 0.7, 8, hair_color.lightened(0.15), 1.5)
				draw_arc(Vector2(2, -55), scalp_radius * 0.5, PI + 0.35, PI + 0.65, 6, hair_color.lightened(0.1), 1.2)

			for fade_step in range(4):
				var fade_y: = -53 + fade_step * 2.5
				var fade_darkness: = 0.25 - fade_step * 0.06
				draw_line(Vector2( - head_radii.x + 2, fade_y), Vector2( - head_radii.x + 3, fade_y + 1.5), hair_color.darkened(fade_darkness), 2.2 - fade_step * 0.3)
				draw_line(Vector2(head_radii.x - 2, fade_y), Vector2(head_radii.x - 3, fade_y + 1.5), hair_color.darkened(fade_darkness), 2.2 - fade_step * 0.3)
		"buzz":

			draw_arc(Vector2(0, -49), scalp_radius, PI + 0.08, TAU - 0.08, 16, hair_color, 3.5)

			if not low_spec:
				for buzz_angle in range(8):
					var angle: = PI + 0.2 + buzz_angle * 0.3
					var buzz_pos: = Vector2(cos(angle) * scalp_radius, -49 + sin(angle) * scalp_radius)
					draw_line(buzz_pos, buzz_pos + Vector2(cos(angle) * 1.5, sin(angle) * 1.5), hair_color.darkened(0.15), 0.8)
		"waves":

			draw_arc(Vector2(0, -50), scalp_radius, PI + 0.1, TAU - 0.1, 18, hair_color, 6.5)

			for wave_x in [-9.0, 0.0, 9.0]:
				draw_arc(Vector2(wave_x, -58 + absf(wave_x) * 0.12), 5, PI + 0.15, TAU - 0.15, 10, hair_color.lightened(0.18), 1.5)
				draw_arc(Vector2(wave_x, -56 + absf(wave_x) * 0.12), 4, PI + 0.2, TAU - 0.2, 8, hair_color.lightened(0.12), 1.2)

			if not low_spec:
				draw_line(Vector2(-4.5, -56), Vector2(-4.5, -52), hair_color.darkened(0.25), 1.2)
				draw_line(Vector2(4.5, -56), Vector2(4.5, -52), hair_color.darkened(0.25), 1.2)
				draw_line(Vector2(-7, -57), Vector2(-7, -54), hair_color.darkened(0.18), 0.9)
				draw_line(Vector2(7, -57), Vector2(7, -54), hair_color.darkened(0.18), 0.9)
		"afro":

			draw_flat_ellipse(Vector2(0, -59), Vector2(head_radii.x + 6, 18), hair_color)

			for puff in [Vector2(-18, -60), Vector2(-11, -70), Vector2(0, -74), Vector2(12, -70), Vector2(19, -59)]:
				draw_circle(puff, 8, hair_color)
				draw_circle(puff, 7, hair_color.darkened(0.08))

			if not low_spec:
				for highlight in [Vector2(-8, -65), Vector2(4, -68), Vector2(0, -72)]:
					draw_circle(highlight, 3.5, hair_color.lightened(0.12))
					draw_circle(highlight, 2.0, hair_color.lightened(0.18))

				for texture_pos in [Vector2(-14, -64), Vector2(-6, -69), Vector2(8, -66), Vector2(14, -62), Vector2(0, -68)]:
					draw_circle(texture_pos, 2.5, hair_color.darkened(0.1))
		"high top":

			draw_colored_polygon(PackedVector2Array([Vector2(-15, -58), Vector2(-13, -80), Vector2(13, -80), Vector2(15, -58)]), hair_color)

			draw_rect(Rect2(-13, -80, 26, 3), hair_color.lightened(0.12))
			draw_line(Vector2(-12, -79), Vector2(12, -79), hair_color.lightened(0.18), 1.5)

			draw_rect(Rect2(-15, -58, 2, 22), hair_color.darkened(0.15))
			draw_rect(Rect2(13, -58, 2, 22), hair_color.darkened(0.15))

			if not low_spec:
				draw_line(Vector2(-13, -78), Vector2(-13, -60), hair_color.lightened(0.08), 1.5)
				draw_line(Vector2(13, -78), Vector2(13, -60), hair_color.lightened(0.08), 1.5)

				draw_line(Vector2(-13, -79), Vector2(-10, -79), hair_color.lightened(0.15), 1.2)
				draw_line(Vector2(10, -79), Vector2(13, -79), hair_color.lightened(0.15), 1.2)
		"locs": draw_locs(hair_color, false)
		"long locs": draw_locs(hair_color, true)
		"freeform locs":

			draw_arc(Vector2(0, -50), scalp_radius, PI + 0.1, TAU - 0.1, 18, hair_color, 6)

			var freeform: = [
				PackedVector2Array([Vector2(-14, -58), Vector2(-18, -66), Vector2(-20, -70), Vector2(-17, -78)]), 
				PackedVector2Array([Vector2(-8, -61), Vector2(-10, -70), Vector2(-12, -75), Vector2(-7, -84)]), 
				PackedVector2Array([Vector2(0, -63), Vector2(-1, -72), Vector2(2, -78), Vector2(0, -88)]), 
				PackedVector2Array([Vector2(8, -61), Vector2(11, -68), Vector2(13, -72), Vector2(10, -82)]), 
				PackedVector2Array([Vector2(14, -57), Vector2(18, -63), Vector2(20, -67), Vector2(18, -76)]), 
			]
			for strand in freeform:
				draw_polyline(strand, hair_color, 4.5, true)

				if not low_spec:
					draw_polyline(strand, hair_color.darkened(0.2), 2.0, true)

			if not low_spec:
				draw_polyline(PackedVector2Array([Vector2(-6, -60), Vector2(-8, -68), Vector2(-6, -74)]), hair_color, 3.5, true)
				draw_polyline(PackedVector2Array([Vector2(6, -60), Vector2(8, -66), Vector2(7, -72)]), hair_color, 3.5, true)
		"cornrows":

			for row_idx in range(5):
				var row_x: = -12.0 + row_idx * 6.0
				var row_path: = PackedVector2Array([
					Vector2(row_x * 0.45, -66), 
					Vector2(row_x * 0.7, -62), 
					Vector2(row_x, -59), 
					Vector2(row_x * 1.08, -55), 
					Vector2(row_x * 1.15, -51)
				])
				draw_polyline(row_path, hair_color, 3.5, true)

				if not low_spec:
					for segment in range(4):
						var seg_y: = -65 + segment * 3.5
						draw_line(Vector2(row_x * (0.5 + segment * 0.15) - 0.8, seg_y), Vector2(row_x * (0.5 + segment * 0.15) + 0.8, seg_y), hair_color.darkened(0.25), 1.2)
		"box braids":

			draw_arc(Vector2(0, -50), scalp_radius, PI + 0.1, TAU - 0.1, 18, hair_color, 6)

			for braid_x in [-15.0, -9.0, -3.0, 4.0, 10.0, 15.0]:
				var braid_end: = -20.0 + fmod(absf(braid_x) * 1.7, 9.0)
				var braid_swing: = sin(braid_x) * 2.0

				draw_line(Vector2(braid_x, -58), Vector2(braid_x + braid_swing, braid_end), hair_color, 3.5)

				if not low_spec:
					for seg in range(int((-58 - braid_end) / 5)):
						var seg_y: = -58 + seg * 5
						draw_line(Vector2(braid_x - 1, seg_y), Vector2(braid_x + 1, seg_y), hair_color.darkened(0.2), 1.5)

				for bead_y in range(-48, int(braid_end), 7):
					draw_circle(Vector2(braid_x + braid_swing * ((-48 - bead_y) / (-48 - braid_end)), bead_y), 2.0, hair_color.lightened(0.14))
					draw_circle(Vector2(braid_x + braid_swing * ((-48 - bead_y) / (-48 - braid_end)), bead_y), 1.5, hair_color.lightened(0.22))
		"twists":

			draw_arc(Vector2(0, -50), scalp_radius, PI + 0.1, TAU - 0.1, 18, hair_color, 6)

			for twist_x in [-14.0, -8.0, 0.0, 8.0, 14.0]:
				var twist_path: = PackedVector2Array([
					Vector2(twist_x, -61), 
					Vector2(twist_x + 3, -52), 
					Vector2(twist_x - 2, -44), 
					Vector2(twist_x + 2, -34)
				])
				draw_polyline(twist_path, hair_color, 3.8, true)

				if not low_spec:
					draw_polyline(twist_path, hair_color.darkened(0.18), 1.8, true)
		"coils":

			for coil_idx in range(7):
				var coil_x: = -16.0 + coil_idx * 5.5
				var coil_size: = 5.5 + sin(coil_idx) * 0.8
				draw_circle(Vector2(coil_x, -60 + absf(coil_x) * 0.13), coil_size, hair_color)

				draw_circle(Vector2(coil_x + 1, -59 + absf(coil_x) * 0.13), coil_size * 0.6, hair_color.darkened(0.2))

				if not low_spec:
					draw_circle(Vector2(coil_x - 1.5, -61 + absf(coil_x) * 0.13), coil_size * 0.35, hair_color.lightened(0.15))
		"bun":

			draw_arc(Vector2(0, -49), scalp_radius, PI + 0.15, TAU - 0.15, 16, hair_color, 6)

			draw_polyline(PackedVector2Array([Vector2(-12, -54), Vector2(0, -56), Vector2(8, -58)]), hair_color, 4.0, true)

			draw_circle(Vector2(head_radii.x * 0.72, -62), 8.5, hair_color)
			draw_circle(Vector2(head_radii.x * 0.72, -62), 7.5, hair_color.darkened(0.12))

			if not low_spec:
				draw_circle(Vector2(head_radii.x * 0.72, -62), 8.5, hair_color.lightened(0.1), false, 1.2)
				draw_arc(Vector2(head_radii.x * 0.72, -62), 5, PI * 0.3, PI * 0.7, 6, hair_color.darkened(0.15), 1.8)
				draw_arc(Vector2(head_radii.x * 0.72, -62), 6.5, PI * 1.2, PI * 1.5, 4, hair_color.lightened(0.12), 1.5)
		"ponytail":

			draw_arc(Vector2(0, -49), scalp_radius, PI + 0.15, TAU - 0.15, 16, hair_color, 6)

			draw_circle(Vector2(head_radii.x * 0.65, -56), 4.5, hair_color.darkened(0.15))

			draw_colored_polygon(PackedVector2Array([
				Vector2(12, -62), 
				Vector2(20, -58), 
				Vector2(27, -55), 
				Vector2(27, -42), 
				Vector2(25, -33), 
				Vector2(23, -29), 
				Vector2(18, -36), 
				Vector2(15, -41)
			]), hair_color)

			if not low_spec:
				draw_line(Vector2(13, -60), Vector2(24, -32), hair_color.lightened(0.14), 2.0)
				draw_line(Vector2(16, -58), Vector2(26, -38), hair_color.lightened(0.08), 1.5)

			draw_rect(Rect2(10, -63, 4, 3), hair_color.darkened(0.3))
		"mohawk":

			draw_arc(Vector2(-10, -48), 4, PI + 0.1, PI + 0.5, 6, hair_color.darkened(0.35), 2.0)
			draw_arc(Vector2(10, -48), 4, PI * 0.5, PI - 0.1, 6, hair_color.darkened(0.35), 2.0)

			draw_colored_polygon(PackedVector2Array([
				Vector2(-6, -59), 
				Vector2(-4, -74), 
				Vector2(-3, -78), 
				Vector2(-1, -76), 
				Vector2(2, -70), 
				Vector2(4, -79), 
				Vector2(6, -82), 
				Vector2(9, -58)
			]), hair_color)

			if not low_spec:
				draw_line(Vector2(-1, -76), Vector2(4, -80), hair_color.lightened(0.15), 2.0)
				draw_line(Vector2(-3, -75), Vector2(2, -77), hair_color.lightened(0.1), 1.5)

			if not low_spec:
				for spike_y in [-75.0, -70.0, -65.0]:
					draw_line(Vector2(-5, spike_y), Vector2(-7, spike_y + 2), hair_color.darkened(0.15), 1.2)
					draw_line(Vector2(7, spike_y), Vector2(9, spike_y + 2), hair_color.darkened(0.15), 1.2)
		"mullet":

			draw_arc(Vector2(0, -50), scalp_radius, PI + 0.12, TAU - 0.12, 18, hair_color, 7)

			draw_arc(Vector2(-8, -52), 5, PI + 0.2, PI + 0.5, 6, hair_color, 4.5)

			draw_colored_polygon(PackedVector2Array([
				Vector2(8, -57), 
				Vector2(16, -52), 
				Vector2(21, -48), 
