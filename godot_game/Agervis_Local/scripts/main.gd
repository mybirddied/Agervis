func open_storage(storage_id: String) -> void :
	current_storage = storage_id
	storage_focus = 0
	storage_cursor = 0
	mode = ScreenMode.STORAGE

func current_storage_items() -> Array[String]:
	return apartment_stash if current_storage == "apartment" else home_stash

func storage_capacity() -> int:
	return 30 if current_storage == "apartment" else 18

func storage_title() -> String:
	return "APARTMENT STORAGE" if current_storage == "apartment" else "BED 6B STORAGE"

func storage_visible_items() -> Array[String]:
	return current_storage_items() if storage_focus == 0 else inventory

func storage_panel_page_start(panel: int, item_count: int) -> int:
	if storage_focus != panel or item_count <= 8: return 0
	return clampi((storage_cursor / 8) * 8, 0, maxi(0, item_count - 1))

func storage_page_button_rect(panel: int, next_page: bool) -> Rect2:
	var x: = 90.0 if panel == 0 else 700.0
	return Rect2(x + (420 if next_page else 355), 174, 55, 29)

func handle_storage_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.PLAY
	elif key.keycode == KEY_LEFT or key.keycode == KEY_RIGHT:
		storage_focus = 1 - storage_focus
		storage_cursor = 0
	elif key.keycode == KEY_UP:
		storage_cursor = maxi(0, storage_cursor - 1)
	elif key.keycode == KEY_DOWN:
		storage_cursor = mini(maxi(0, storage_visible_items().size() - 1), storage_cursor + 1)
	elif key.keycode == KEY_ENTER or key.keycode == KEY_SPACE:
		transfer_selected_storage_item()

func handle_storage_pointer(screen_point: Vector2, secondary: bool) -> void :
	if Rect2(1080, 100, 70, 42).has_point(screen_point):
		mode = ScreenMode.PLAY
		return
	for panel in range(2):
		var panel_items: Array = current_storage_items() if panel == 0 else inventory
		if storage_page_button_rect(panel, false).has_point(screen_point):
			storage_focus = panel
			storage_cursor = maxi(0, storage_cursor - 8)
			return
		if storage_page_button_rect(panel, true).has_point(screen_point):
			storage_focus = panel
			storage_cursor = mini(maxi(0, panel_items.size() - 1), storage_cursor + 8)
			return
		var panel_x: = 90.0 if panel == 0 else 700.0
		var start: = storage_panel_page_start(panel, panel_items.size())
		for row in range(mini(8, maxi(0, panel_items.size() - start))):
			if Rect2(panel_x + 20, 210 + row * 42, 450, 36).has_point(screen_point):
				storage_focus = panel
				storage_cursor = start + row
				if secondary: transfer_selected_storage_item()
				return
	if Rect2(575, 300, 130, 48).has_point(screen_point): transfer_selected_storage_item()

func transfer_selected_storage_item() -> void :
	var source: = storage_visible_items()
	if source.is_empty(): return
	storage_cursor = clampi(storage_cursor, 0, source.size() - 1)
	var item: = String(source[storage_cursor])
	if online_economy_enabled() and current_storage == "apartment":
		submit_online_economy_request("STORAGE_TRANSFER", {
			"storage_id": current_storage, 
			"direction": "take" if storage_focus == 0 else "store", 
			"item_id": item, 
		}, true, {"item_id": item, "direction": "take" if storage_focus == 0 else "store"})
		return
	if reject_unsupported_online_mutation("STORAGE TRANSFER"):
		return
	var stash: = current_storage_items()
	if storage_focus == 0:
		if not can_receive_inventory_item(item):
			notify("CARRIED INVENTORY IS FULL - EQUIP A BACKPACK FOR MORE SPACE", DANGER, 2.5)
			return
		stash.erase(item)
		try_add_inventory_item(item)
		notify("%s TAKEN" % item.to_upper(), GOOD, 1.8)
	else:
		var tag: = String(Build7.item_info(item).get("tag", "CLEAN"))
		if tag in ["TRUSTED", "KEY"] or item == "Phone" or "Deposit" in item:
			notify("THAT ITEM MUST REMAIN CARRIED", DANGER, 2.5)
			return
		if stash.size() >= storage_capacity():
			notify("STASH IS FULL", DANGER, 2.5)
			return
		inventory.erase(item)
		stash.append(item)
		notify("%s STORED" % item.to_upper(), GOOD, 1.8)
	storage_cursor = mini(storage_cursor, maxi(0, storage_visible_items().size() - 1))

