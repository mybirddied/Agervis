func menu_control_help() -> String:
	if mode == ScreenMode.SHOP:
		if barber_preview_active:
			if mobile_controls_enabled: return "TAP: style arrows, payment, CONFIRM or CANCEL"
			if last_input_controller: return "D-PAD: choose / preview   LB/RB: payment   %s: confirm   %s: cancel" % [controller_face_label(1), controller_face_label(2)]
			return "UP/DOWN: category   LEFT/RIGHT: preview   P: payment   ENTER: confirm   ESC: cancel"
		if mobile_controls_enabled: return "TAP: catalog, payment, amount, BUY / SELL, CLOSE"
		if last_input_controller: return "D-PAD: choose / amount   LB/RB: payment   %s: buy   %s: sell   %s: close" % [controller_face_label(1), controller_face_label(3), controller_face_label(2)]
		return "UP/DOWN: catalog   LEFT/RIGHT: amount   TAB: payment   ENTER: buy   S: sell   ESC: close"
	if mode == ScreenMode.STORAGE:
		if mobile_controls_enabled: return "TAP: an item to move it; CLOSE when finished"
		if last_input_controller: return "D-PAD: item   LEFT/RIGHT: carried / storage   %s: move   %s: close" % [controller_face_label(1), controller_face_label(2)]
		return "UP/DOWN: item   LEFT/RIGHT: carried / storage   ENTER: move   ESC: close"
	if mode == ScreenMode.EQUIPMENT:
		if equipment_split_active:
			if mobile_controls_enabled: return "TAP: - / + quantity, then SPLIT"
			if last_input_controller: return "LEFT/RIGHT: quantity   %s: split   %s: cancel" % [controller_face_label(1), controller_face_label(2)]
			return "LEFT/RIGHT: quantity   ENTER: split   ESC: cancel"
		if mobile_controls_enabled: return "TAP: slot, then ACTION / MOVE / SPLIT; CLOSE when finished"
		if last_input_controller: return "D-PAD: select   %s: action   %s: move   %s: split   %s: back" % [controller_face_label(1), controller_face_label(3), controller_face_label(4), controller_face_label(2)]
		return "ARROWS: select   ENTER: action   M: move   S: split   TAB: carried / worn   ESC: back"
	if mode == ScreenMode.QUIZ:
		var answer_count: = Array(quiz_question.get("answers", [])).size()
		if mobile_controls_enabled: return "TAP ONE ANSWER  -  THE ASSESSMENT DOES NOT CLOSE EARLY"
		if last_input_controller:
			return "FACE BUTTONS: ANSWERS 1-4" + ("   D-PAD: ANSWERS 5-%d" % answer_count if answer_count > 4 else "")
		return "NUMBER KEYS 1-%d: ANSWER" % maxi(1, answer_count)
	if mode == ScreenMode.DIALOG:
		if mobile_controls_enabled: return "TAP: a response, or CLOSE to continue"
		if last_input_controller: return "D-PAD: choice   %s: select   %s: close" % [controller_face_label(1), controller_face_label(2)]
		return "UP/DOWN: choice   ENTER: select   ESC: close"
	if mobile_controls_enabled: return "TAP the labeled controls. Use MENU to return to the game."
	if last_input_controller: return "D-PAD: navigate   %s: select   %s: back" % [controller_face_label(1), controller_face_label(2)]
	return "ARROWS: navigate   ENTER: select   ESC: back"
