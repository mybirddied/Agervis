func roster_play_label() -> String:
	if roster_cursor >= ReleaseSave.FREE_SLOTS:
		return "PREMIUM SLOT RESERVED"
	if roster["slots"][roster_cursor] is Dictionary:
		return "PLAY SELECTED RESIDENT"
	if tutorial_draft_at(roster_cursor) is Dictionary:
		return "CONTINUE TUTORIAL"
	return "CREATE RESIDENT FILE"

func draw_roster_screen() -> void :

	draw_texture_rect(STREET_ART, Rect2(Vector2.ZERO, VIEW_SIZE), false, Color("#555555"))

	draw_rect(Rect2(0, 0, VIEW_SIZE.x, VIEW_SIZE.y / 2), Color(0.01, 0.015, 0.018, 0.75))
	draw_rect(Rect2(0, VIEW_SIZE.y / 2, VIEW_SIZE.x, VIEW_SIZE.y / 2), Color(0.018, 0.02, 0.025, 0.88))


	var header_panel: = Rect2(40, 40, VIEW_SIZE.x - 80, 100)
	draw_rect(header_panel.grow(4), Color("#1a1c1e"))
	draw_rect(header_panel, Color("#2a2d32"))
	draw_rect(header_panel, Color("#4a4d52"), false, 2.0)

	draw_rect(header_panel.grow(-6), Color("#3a3d42"), false, 1.0)


	draw_text("RESIDENT ROSTER", Vector2(74, 84), 38, Color("#0a0c0e"))
	draw_text("RESIDENT ROSTER", Vector2(72, 82), 38, PAPER)


	var world_label: = "%s  /  This roster belongs only to this world." % roster_world_label()
	draw_text(world_label, Vector2(76, 116), 16, Color("#0a0c0e"))
	draw_text(world_label, Vector2(74, 114), 16, Color("#aaa49a"))


	for corner_offset in [Vector2(50, 50), Vector2(VIEW_SIZE.x - 50, 50)]:
		draw_line(corner_offset, corner_offset + Vector2(20, 0), ACCENT, 3.0)
		draw_line(corner_offset, corner_offset + Vector2(0, 20), ACCENT, 3.0)


	for index in range(ReleaseSave.FREE_SLOTS):
		var selected: = roster_cursor == index
		var rect: = Rect2(70, 155 + index * 91, 760, 72)


		if selected:
			draw_rect(rect.grow(3), Color(0.15, 0.12, 0.08, 0.6))
		else:
			draw_rect(Rect2(rect.position.x + 2, rect.position.y + 2, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.5))


		var card_bg: = Color("#3a3d42") if selected else Color(0.08, 0.085, 0.09, 0.93)
		var card_bg_top: = card_bg.lightened(0.08) if selected else card_bg
		draw_rect(rect, card_bg)
		draw_rect(Rect2(rect.position.x, rect.position.y, rect.size.x, 8), card_bg_top)


		var border_color: = ACCENT if selected else Color("#5e5b57")
		draw_rect(rect, border_color, false, 3.0 if selected else 2.0)
		if selected:
			draw_rect(rect.grow(-4), ACCENT.lightened(0.2), false, 1.0)


		var slot_num_pos: = rect.position + Vector2(20, 44)
		draw_text("%d" % (index + 1), slot_num_pos + Vector2(1, 1), 25, Color("#0a0c0e"))
		draw_text("%d" % (index + 1), slot_num_pos, 25, ACCENT if selected else PAPER)


		draw_line(rect.position + Vector2(58, 8), rect.position + Vector2(58, rect.size.y - 8), Color("#5e5b57"), 2.0)

		var slot: Variant = roster["slots"][index]
		if slot is Dictionary:
			var deceased: = bool(slot.get("deceased", false))
			var resident_name: = String(slot.get("name", "UNNAMED")).to_upper() + ("  -  DECEASED" if deceased else "")


			draw_text(resident_name, rect.position + Vector2(72, 32), 20, Color("#0a0c0e"))
			draw_text(resident_name, rect.position + Vector2(70, 30), 20, DANGER if deceased else PAPER)


			var job_text: = String(slot.get("active_job", "None"))
			var area_text: = "RECORD PRESERVED" if deceased else String(slot.get("area", "home")).to_upper()
			var level_text: = "TOTAL %d" % int(slot.get("total_level", 12))

			draw_text(job_text, rect.position + Vector2(70, 55), 13, Color("#aaa49a"))
			draw_text("  /  ", rect.position + Vector2(70 + job_text.length() * 7, 55), 13, Color("#6a6560"))
			draw_text(area_text, rect.position + Vector2(100 + job_text.length() * 7, 55), 13, Color("#aaa49a"))
			draw_text("  /  ", rect.position + Vector2(100 + (job_text.length() + area_text.length()) * 7, 55), 13, Color("#6a6560"))
			draw_text(level_text, rect.position + Vector2(130 + (job_text.length() + area_text.length()) * 7, 55), 13, GOOD if not deceased else Color("#8a7a6a"))


			var avatar_center: = rect.position + Vector2(740, 36)
			draw_circle(avatar_center, 16, Color("#2a2d32"))
			var char_color: = stored_color(slot.get("color", "c78965"), Color("#c78965"))
			draw_circle(avatar_center, 14, char_color)
			draw_circle(avatar_center, 14, Color("#1a1c1e"), false, 2.0)

		elif tutorial_draft_at(index) is Dictionary:
			var draft: = tutorial_draft_at(index) as Dictionary


			draw_text("TUTORIAL IN PROGRESS", rect.position + Vector2(72, 32), 20, Color("#0a0c0e"))
			draw_text("TUTORIAL IN PROGRESS", rect.position + Vector2(70, 30), 20, GOOD)

			var checkpoint_text: = "%s   /   CHECKPOINT %d" % [String(draft.get("room_id", "guidance")).to_upper(), int(draft.get("revision", 0))]
			draw_text(checkpoint_text, rect.position + Vector2(70, 55), 13, Color("#aaa49a"))


			var progress_bar: = Rect2(rect.position.x + 620, rect.position.y + 24, 120, 24)
			draw_rect(progress_bar, Color("#1a1c1e"))
			draw_rect(progress_bar, Color("#3a3d42"), false, 1.5)
			var progress: = clampf(float(draft.get("revision", 0)) / 10.0, 0.0, 1.0)
			draw_rect(Rect2(progress_bar.position.x + 2, progress_bar.position.y + 2, (progress_bar.size.x - 4) * progress, progress_bar.size.y - 4), GOOD)
