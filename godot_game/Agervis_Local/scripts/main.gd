func prepare_slot_switch(target_slot: int) -> bool:
	if active_slot < 0 or active_slot == target_slot:
		return true
	if not ENFORCE_ONLINE_RESIDENT_SWITCH_RULES:
		roster["last_switch_unix"] = 0
		persist_roster()
		return true
	var previous: Variant = current_saved_slot()
	if previous is Dictionary:
		if bool(previous.get("deceased", false)):
			return true
		if bool(previous.get("wanted", false)) or int(previous.get("sentence_credits", 0)) > 0 or String(previous.get("area", "")) == "jail":
			release_notice = "SWITCH DENIED  -  ACTIVE RESIDENT IS WANTED OR CONFINED"
			return false
		var now: = int(Time.get_unix_time_from_system())
		var elapsed_since_switch: = now - int(roster.get("last_switch_unix", 0))
		if int(roster.get("last_switch_unix", 0)) > 0 and elapsed_since_switch < 43200:
			var remaining_minutes: = int(ceil(float(43200 - elapsed_since_switch) / 60.0))
			release_notice = "12-HOUR SWITCH LOCK  -  %dh %02dm REMAIN" % [remaining_minutes / 60, remaining_minutes % 60]
			return false
		roster["last_switch_unix"] = now
		persist_roster()
	return true

func stored_color(value: Variant, fallback: Color) -> Color:
	if value is Color:
		return value
	if value is String or value is StringName:
		return Color.from_string(String(value), fallback)
	return fallback

func copy_strings(source: Variant, target: Array[String]) -> void :
	target.clear()
	if source is Array:
		for value in source:
			target.append(String(value))

func copy_dictionaries(source: Variant, target: Array[Dictionary]) -> void :
	target.clear()
	if source is Array:
		for value in source:
			if value is Dictionary:
				var original: = Dictionary(value).duplicate(true)
				var normalized: = EvidenceRecords.normalize_record(original)
				if not String(normalized.get("record_kind", "")).is_empty():
					if String(normalized.get("evidence_id", "")).is_empty():
						normalized["evidence_id"] = "LEGACY-EVIDENCE-%d" % next_evidence_record_id
						next_evidence_record_id += 1
					target.append(normalized)
				else:
					target.append(original)

func handle_play_key(key: InputEventKey) -> void :
	if cooking_active:
		if cooking_challenge_type == "sequence":
			if key.keycode == KEY_W:
				try_cooking_sequence_key("W")
			elif key.keycode == KEY_A:
				try_cooking_sequence_key("A")
			elif key.keycode == KEY_S:
				try_cooking_sequence_key("S")
			elif key.keycode == KEY_D:
				try_cooking_sequence_key("D")
			elif key.keycode == KEY_ESCAPE:
				cooking_active = false
				notify("COOKING ABANDONED - INGREDIENTS WASTED", DANGER, 2.0)
		else:
			if key.is_action("interact") or key.keycode == KEY_SPACE:
				try_cooking_action()
			elif key.keycode == KEY_ESCAPE:
				cooking_active = false
				notify("COOKING ABANDONED - INGREDIENTS WASTED", DANGER, 2.0)
		return
	if key.keycode == KEY_T or key.keycode == KEY_ENTER:
		open_chat()
	elif key.keycode == KEY_F10:
		open_feedback(ScreenMode.PLAY)
	elif key.keycode == KEY_G:
		low_spec = not low_spec
		roster["settings"] = {"low_spec": low_spec, "tips_enabled": tips_enabled, "close_chat_after_enter": close_chat_after_enter}
		persist_roster()
		notify("LOW-SPEC GRAPHICS %s" % ("ON" if low_spec else "OFF"), ACCENT, 2.0)
	elif key.keycode == KEY_F11:
		var next_mode: = DisplayServer.WINDOW_MODE_WINDOWED if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN else DisplayServer.WINDOW_MODE_FULLSCREEN
		DisplayServer.window_set_mode(next_mode)
	elif key.is_action("interact"):
		interact()
	elif key.is_action("attack"):

		if key.shift_pressed and finisher_available:
			player_finisher()
		else:
			player_attack()
	elif key.keycode == KEY_SPACE:

		player_dodge()
	elif key.keycode == KEY_Q:

		player_parry()
	elif key.is_action("vault"):
		vault()
	elif key.is_action("disposition"):
		if nearest_downed(94.0) != null or nearest_lan_downed_peer(94.0) > 0:
			open_disposition()
		else:
			player_dodge()
	elif key.is_action("skills"):
		open_skills_screen()
	elif key.is_action("journal"):
		open_information("JOURNAL")
	elif key.keycode == KEY_P:
		open_phone(ScreenMode.PLAY)
	elif key.is_action("inventory"):
		open_equipment()
	elif key.keycode == KEY_ESCAPE:
		open_game_menu()

func open_chat() -> void :
	chat_input = ""
	click_move_active = false
	mode = ScreenMode.CHAT
	if mobile_controls_enabled:
		DisplayServer.virtual_keyboard_show(chat_input)

func close_chat() -> void :
	if mobile_controls_enabled:
		DisplayServer.virtual_keyboard_hide()
	mode = ScreenMode.PLAY

func handle_chat_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		close_chat()
	elif key.keycode == KEY_ENTER:
		submit_chat_message()
	elif key.keycode == KEY_BACKSPACE:
		chat_input = chat_input.left(maxi(0, chat_input.length() - 1))
	elif key.unicode >= 32 and key.unicode <= 126 and chat_input.length() < 96:
		chat_input += char(key.unicode)

func submit_chat_message() -> void :
	var message: = chat_input.strip_edges()
	chat_input = ""
	if mobile_controls_enabled: DisplayServer.virtual_keyboard_hide()
	if message.is_empty():
		if close_chat_after_enter:
			mode = ScreenMode.PLAY
		return
	if message.begins_with("/"):
		run_offline_admin_command(message)
	elif lan_session.active:
		lan_session.submit_chat(player_name, message)
	else:
		append_chat("[LOCAL] %s: %s" % [player_name, message])
	if close_chat_after_enter and mode == ScreenMode.CHAT:
		mode = ScreenMode.PLAY

func append_chat(message: String) -> void :
	chat_history.append(message.left(150))
	while chat_history.size() > 12:
		chat_history.pop_front()

func open_admin_editor() -> void :
	if lan_session.active:
		admin_editor_online = true
		admin_editor_role = ""
		admin_editor_notice = "REQUESTING ONLINE ADMIN ACCESS..."
		admin_editor_access_retry_timer = 0.0
		admin_editor_apply_queue.clear()
		admin_editor_apply_in_flight = false
		mode = ScreenMode.ADMIN_EDITOR
		admin_editor_reset_controller_cursor()
		lan_session.request_admin_panel()
		return
	admin_editor_online = false
	admin_editor_role = ""
	admin_editor_access_retry_timer = -1.0
	admin_editor.set_offline_authorized(true)
	admin_editor_room_cursor = 0
	admin_editor_object_cursor = 0
	var rooms: = admin_editor.room_keys()
	for room_index in range(rooms.size()):
		var room_records: = admin_editor.room_records(rooms[room_index])
		if room_records.is_empty():
			continue
		admin_editor_room_cursor = room_index
		admin_editor.select(rooms[room_index], String(room_records[0].get("local_id", "")))
		break
	admin_editor_notice = "OFFLINE DEVELOPMENT EDITOR  -  NO LIVE SERVER APPLY"
	mode = ScreenMode.ADMIN_EDITOR
	admin_editor_reset_controller_cursor()

func admin_editor_current_room() -> String:
	var rooms: = admin_editor.room_keys()
	return rooms[admin_editor_room_cursor] if admin_editor_room_cursor >= 0 and admin_editor_room_cursor < rooms.size() else ""

func admin_editor_select_room() -> void :
	var room_key: = admin_editor_current_room()
	var records: = admin_editor.room_records(room_key)
	admin_editor_object_cursor = clampi(admin_editor_object_cursor, 0, maxi(0, records.size() - 1))
	if admin_editor_online and records.is_empty():
		admin_editor_notice = "REQUESTING ROOM %s..." % room_key
		lan_session.request_admin_room(room_key)
	elif not records.is_empty():
		admin_editor.select(room_key, String(records[admin_editor_object_cursor].get("local_id", "")))
	admin_editor_reset_controller_cursor()

func admin_editor_select_object(delta: int) -> void :
	var records: = admin_editor.room_records(admin_editor_current_room())
	if records.is_empty(): return
	admin_editor_object_cursor = posmod(admin_editor_object_cursor + delta, records.size())
	admin_editor_select_room()

func admin_editor_reset_controller_cursor() -> void :
	var selected: = admin_editor.selected_record()
	var selected_position: Variant = selected.get("position", null)
	if selected_position is Vector2:
		admin_editor_controller_cursor = admin_editor_world_to_canvas(selected_position as Vector2)
	else:
		admin_editor_controller_cursor = ADMIN_CANVAS_RECT.get_center()

func admin_editor_move_controller_cursor(delta: Vector2) -> void :
	admin_editor_controller_cursor = Vector2(
		clampf(admin_editor_controller_cursor.x + delta.x, ADMIN_CANVAS_RECT.position.x, ADMIN_CANVAS_RECT.end.x), 
		clampf(admin_editor_controller_cursor.y + delta.y, ADMIN_CANVAS_RECT.position.y, ADMIN_CANVAS_RECT.end.y)
	)
	queue_redraw()

func admin_editor_cycle_tool(delta: int) -> void :
	var current_index: = ADMIN_TOOL_BUTTONS.find(admin_editor_tool)
	admin_editor_set_tool(ADMIN_TOOL_BUTTONS[posmod(current_index + delta, ADMIN_TOOL_BUTTONS.size())])

func admin_editor_canvas_to_world(point: Vector2) -> Vector2:
	var normalized: = (point - ADMIN_CANVAS_RECT.position) / ADMIN_CANVAS_RECT.size
	return Vector2(clampf(normalized.x * 1000.0, 0.0, 1000.0), clampf(normalized.y * 320.0, 0.0, 320.0))

func admin_editor_world_to_canvas(point: Vector2) -> Vector2:
	return ADMIN_CANVAS_RECT.position + Vector2(point.x / 1000.0, point.y / 320.0) * ADMIN_CANVAS_RECT.size

func admin_editor_next_unique_id(prefix: String) -> String:
	var records: = admin_editor.room_records(admin_editor_current_room())
	var index: = 1
	while records.any( func(value: Variant): return value is Dictionary and String((value as Dictionary).get("local_id", "")) == "%s_%d" % [prefix, index]):
		index += 1
	return "%s_%d" % [prefix, index]

func admin_editor_set_tool(tool_name: String) -> void :
	if tool_name not in ADMIN_TOOL_BUTTONS:
		return
	admin_editor_tool = tool_name
	admin_editor.set_tool(tool_name)
	admin_editor_pending_point = Vector2(-1, -1)
	admin_editor_notice = "TOOL: %s" % tool_name.to_upper()
	queue_redraw()

func admin_editor_canvas_action(point: Vector2) -> void :
	var room_key: = admin_editor_current_room()
	if room_key.is_empty():
		return
	var world_position: = admin_editor_canvas_to_world(point)
	match admin_editor_tool:
		"select":
			if admin_editor.select_at(room_key, world_position):
				var selected: = admin_editor.selected_record()
				admin_editor_object_cursor = maxi(0, admin_editor.room_records(room_key).find(selected))
				admin_editor_notice = "SELECTED %s" % String(selected.get("local_id", ""))
			else:
				admin_editor_notice = "NO RECORD AT THAT POINT"
		"erase":
			if admin_editor.select_at(room_key, world_position):
				var erased: = admin_editor.delete_selected()
				admin_editor_notice = "ERASED %s" % String(erased.get("deleted_local_id", "")) if bool(erased.get("ok", false)) else String(erased.get("message", "ERASE FAILED"))
		"tile":
			var palette: Dictionary = ADMIN_PALETTE[admin_editor_palette_index]
			admin_editor.set_palette(String(palette["atlas_id"]), palette["source_rect"], palette["size"])
			var painted: = admin_editor.paint_tile(room_key, world_position, admin_editor_next_unique_id("tile"))
			admin_editor_notice = "PAINTED TILE" if bool(painted.get("ok", false)) else String(painted.get("message", "TILE FAILED"))
		"object", "npc", "fixture":
			var prefix: = admin_editor_tool
			var object_id: = "fixture.editor_marker"
			var graphic_id: = "fixture.editor_marker.v1"
			if admin_editor_tool == "npc":
				object_id = "npc.editor_marker"
				graphic_id = "character.editor_marker.v1"
			var placed: = admin_editor.add_record(room_key, {
				"local_id": admin_editor_next_unique_id(prefix), "record_type": "object", "object_id": object_id, 
				"graphic_id": graphic_id, "render_mode": "editor_marker", "position": world_position, 
				"depth": world_position.y, "priority": 1, "interactive": false, 
			})
			admin_editor_notice = "PLACED %s" % admin_editor_tool.to_upper() if bool(placed.get("ok", false)) else String(placed.get("message", "PLACEMENT FAILED"))
		"collision":
			if admin_editor_pending_point.x < 0.0:
				admin_editor_pending_point = world_position
				admin_editor_notice = "COLLISION START SET - CLICK ENDPOINT"
			else:
				var collision: = admin_editor.add_collision_line(room_key, admin_editor_pending_point, world_position, admin_editor_next_unique_id("collision"))
				admin_editor_pending_point = Vector2(-1, -1)
				admin_editor_notice = "COLLISION LINE ADDED" if bool(collision.get("ok", false)) else String(collision.get("message", "COLLISION FAILED"))
		"warp":
			var warp: = admin_editor.add_warp(room_key, world_position, "AGERVIS-MAIN-FIRST-BLOCK", room_key, world_position, admin_editor_next_unique_id("warp"))
			admin_editor_notice = "WARP ADDED" if bool(warp.get("ok", false)) else String(warp.get("message", "WARP FAILED"))
	queue_redraw()

func handle_admin_editor_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.CHAT
	elif key.keycode == KEY_LEFT:
		admin_editor.move_selected(Vector2(-5, 0))
	elif key.keycode == KEY_RIGHT:
		admin_editor.move_selected(Vector2(5, 0))
	elif key.keycode == KEY_UP:
		admin_editor.move_selected(Vector2(0, -5))
	elif key.keycode == KEY_DOWN:
		admin_editor.move_selected(Vector2(0, 5))
	elif key.keycode == KEY_DELETE:
		admin_editor.delete_selected()
	elif key.keycode == KEY_T:
		admin_editor_set_tool("tile")
	elif key.keycode == KEY_O:
		admin_editor_set_tool("object")
	elif key.keycode == KEY_N:
		admin_editor_set_tool("npc")
	elif key.keycode == KEY_F:
		admin_editor_set_tool("fixture")
	elif key.keycode == KEY_C:
		admin_editor_set_tool("collision")
	elif key.keycode == KEY_W:
		admin_editor_set_tool("warp")
	elif key.keycode == KEY_E:
		admin_editor_set_tool("erase")
	elif key.keycode == KEY_0:
		admin_editor_set_tool("select")
	elif key.keycode == KEY_BRACKETLEFT:
		admin_editor_palette_index = posmod(admin_editor_palette_index - 1, ADMIN_PALETTE.size())
	elif key.keycode == KEY_BRACKETRIGHT:
		admin_editor_palette_index = posmod(admin_editor_palette_index + 1, ADMIN_PALETTE.size())
	elif key.keycode == KEY_TAB:
		admin_editor_select_object(1)
	elif key.keycode == KEY_PAGEUP:
		var rooms: = admin_editor.room_keys()
		if not rooms.is_empty(): admin_editor_room_cursor = posmod(admin_editor_room_cursor - 1, rooms.size());admin_editor_select_room()
	elif key.keycode == KEY_PAGEDOWN:
		var rooms: = admin_editor.room_keys()
		if not rooms.is_empty(): admin_editor_room_cursor = posmod(admin_editor_room_cursor + 1, rooms.size());admin_editor_select_room()
	elif key.keycode == KEY_Z and key.ctrl_pressed:
		admin_editor.undo()
	elif key.keycode == KEY_Y and key.ctrl_pressed:
		admin_editor.redo()
	elif key.keycode == KEY_R:
		if admin_editor_online:
			admin_editor_notice = "REFRESHING ROOM %s..." % admin_editor_current_room()
			lan_session.request_admin_room(admin_editor_current_room())
		else:
			var reset_result: = admin_editor.reset_room(admin_editor_current_room())
			admin_editor_notice = String(reset_result.get("message", "ROOM RESET")) if not bool(reset_result.get("ok", false)) else "ROOM RESET - UNSAVED"
	elif key.keycode == KEY_V:
		var errors: = admin_editor.validate()
		admin_editor_notice = "VALIDATION PASS" if errors.is_empty() else "VALIDATION ERROR: " + String(errors[0])
	elif key.keycode == KEY_S:
		if admin_editor_online:
			queue_online_admin_apply()
		else:
			var export_result: = admin_editor.write_patch()
			admin_editor_notice = "PATCH EXPORTED TO user://admin-room-patch.json" if bool(export_result.get("ok", false)) else String(export_result.get("message", "EXPORT FAILED"))
	queue_redraw()

func handle_admin_editor_controller(button: int) -> void :
	if button == JOY_BUTTON_B:
		mode = ScreenMode.CHAT
	elif button == JOY_BUTTON_LEFT_SHOULDER:
		admin_editor_cycle_tool(-1)
	elif button == JOY_BUTTON_RIGHT_SHOULDER:
		admin_editor_cycle_tool(1)
	elif button == JOY_BUTTON_LEFT_STICK:
		admin_editor_set_tool("collision")
	elif button == JOY_BUTTON_RIGHT_STICK:
		admin_editor_set_tool("warp")
	elif button == JOY_BUTTON_BACK:
		admin_editor_set_tool("erase")
	elif button == JOY_BUTTON_X:
		admin_editor.undo()
	elif button == JOY_BUTTON_Y:
		admin_editor.redo()
	elif button == JOY_BUTTON_DPAD_LEFT:
		admin_editor_move_controller_cursor(Vector2( - ADMIN_CONTROLLER_CURSOR_STEP, 0))
	elif button == JOY_BUTTON_DPAD_RIGHT:
		admin_editor_move_controller_cursor(Vector2(ADMIN_CONTROLLER_CURSOR_STEP, 0))
	elif button == JOY_BUTTON_DPAD_UP:
		admin_editor_move_controller_cursor(Vector2(0, - ADMIN_CONTROLLER_CURSOR_STEP))
	elif button == JOY_BUTTON_DPAD_DOWN:
		admin_editor_move_controller_cursor(Vector2(0, ADMIN_CONTROLLER_CURSOR_STEP))
	elif button == JOY_BUTTON_A:
		admin_editor_canvas_action(admin_editor_controller_cursor)
	elif button == JOY_BUTTON_START:
		if admin_editor_online:
			queue_online_admin_apply()
		else:
			var errors: = admin_editor.validate()
			admin_editor_notice = "VALIDATION PASS" if errors.is_empty() else "VALIDATION ERROR: " + String(errors[0])
	queue_redraw()

func handle_admin_editor_pointer(point: Vector2) -> void :
	if ADMIN_CANVAS_RECT.has_point(point):
		admin_editor_canvas_action(point)
	elif Rect2(350, 105, 500, 34).has_point(point):
		var palette_width: = 500.0 / ADMIN_PALETTE.size()
		admin_editor_palette_index = clampi(int((point.x - 350.0) / palette_width), 0, ADMIN_PALETTE.size() - 1)
		admin_editor_notice = "PALETTE %d SELECTED" % (admin_editor_palette_index + 1)
	elif Rect2(340, 462, 520, 38).has_point(point):
		var tool_width: = 520.0 / ADMIN_TOOL_BUTTONS.size()
		var tool_index: = clampi(int((point.x - 340.0) / tool_width), 0, ADMIN_TOOL_BUTTONS.size() - 1)
		admin_editor_set_tool(ADMIN_TOOL_BUTTONS[tool_index])
	elif Rect2(940, 610, 180, 42).has_point(point):
		mode = ScreenMode.CHAT
	elif Rect2(720, 610, 190, 42).has_point(point):
		if admin_editor_online:
			queue_online_admin_apply()
		else:
			var export_result: = admin_editor.write_patch()
			admin_editor_notice = "PATCH EXPORTED TO user://admin-room-patch.json" if bool(export_result.get("ok", false)) else String(export_result.get("message", "EXPORT FAILED"))
	elif Rect2(500, 610, 190, 42).has_point(point):
		var errors: = admin_editor.validate()
		admin_editor_notice = "VALIDATION PASS" if errors.is_empty() else "VALIDATION ERROR: " + String(errors[0])
	elif Rect2(80, 610, 180, 42).has_point(point):
		admin_editor.undo()
	elif Rect2(280, 610, 180, 42).has_point(point):
		admin_editor.redo()
	queue_redraw()

func queue_online_admin_apply() -> void :
	if not admin_editor_online or admin_editor_role.is_empty():
		admin_editor_notice = "ONLINE ADMIN ACCESS HAS NOT BEEN GRANTED"
		queue_redraw()
		return
	var patch: = admin_editor.export_live_patch()
	if not bool(patch.get("ok", false)):
		admin_editor_notice = String(patch.get("message", "PATCH VALIDATION FAILED"))
		queue_redraw()
		return
	var rooms: Array = Array(patch.get("rooms", []))
	if rooms.is_empty():
		admin_editor_notice = "NO UNSAVED ROOM CHANGES"
		queue_redraw()
		return
	admin_editor_apply_queue.clear()
	for room_value in rooms:
		if room_value is Dictionary:
			admin_editor_apply_queue.append((room_value as Dictionary).duplicate(true))
	admin_editor_apply_in_flight = false
	admin_editor_apply_next()

func admin_editor_apply_next() -> void :
	if admin_editor_apply_in_flight:
		return
	if admin_editor_apply_queue.is_empty():
		admin_editor_notice = "ALL ONLINE ROOM CHANGES APPLIED"
		queue_redraw()
		return
	var entry: = admin_editor_apply_queue[0]
	var room_key: = String(entry.get("room_key", ""))
	admin_editor_apply_in_flight = true
	admin_editor_operation_sequence += 1
	admin_editor_notice = "APPLYING %s..." % room_key
	lan_session.submit_admin_room_patch(room_key, int(admin_editor_revisions.get(room_key, 0)), Array(entry.get("placements", [])), "%s-%d" % [tester_id, admin_editor_operation_sequence])
	queue_redraw()

func _on_admin_status_received(result: Dictionary) -> void :
	if not bool(result.get("ok", false)):
		admin_editor_online = false
		admin_editor_role = ""
		admin_editor_access_retry_timer = -1.0
		admin_editor_notice = String(result.get("message", "ADMIN ACCESS DENIED"))
		queue_redraw()
		return
	admin_editor_online = true
	admin_editor_role = String(result.get("role", "editor")).to_upper()
	admin_editor_access_retry_timer = -1.0
	admin_editor_revisions = Dictionary(result.get("revisions", {})).duplicate(true)
	admin_editor_server_rooms.clear()
	var authoritative_rooms: Array = Array(result.get("rooms", []))
	if authoritative_rooms.is_empty():
		authoritative_rooms = admin_editor.room_keys()
	for room_value in authoritative_rooms:
		admin_editor_server_rooms[String(room_value)] = []
	admin_editor.set_source_rooms(admin_editor_server_rooms, true)
	admin_editor_room_cursor = 0
	admin_editor_object_cursor = 0
	admin_editor_notice = "ONLINE ADMIN EDITOR  -  ROLE %s" % admin_editor_role
	admin_editor_select_room()
	queue_redraw()

func _on_admin_room_received(result: Dictionary) -> void :
	var room_key: = String(result.get("room_key", ""))
	if not bool(result.get("ok", false)):
		admin_editor_notice = String(result.get("message", "ADMIN ROOM REQUEST FAILED"))
		queue_redraw()
		return
	var records: Array = Array(result.get("records", [])).duplicate(true)
	admin_room_overlays[room_key] = records
	admin_editor_revisions[room_key] = int(result.get("revision", 0))
	if admin_editor_online:
		admin_editor_server_rooms[room_key] = records
		admin_editor.set_room_records(room_key, records, true)
		if room_key == admin_editor_current_room():
			admin_editor_object_cursor = 0
			admin_editor_select_room()
			admin_editor_notice = "ROOM LOADED  -  %s REVISION %d" % [room_key, int(result.get("revision", 0))]
	queue_redraw()

func _on_admin_patch_result_received(result: Dictionary) -> void :
	var room_key: = String(result.get("room_key", ""))
	admin_editor_apply_in_flight = false
	if not bool(result.get("ok", false)):
		admin_editor_notice = String(result.get("message", "ADMIN PATCH FAILED"))
		if String(result.get("error_code", "")) == "STALE_ADMIN_REVISION" and result.has("records"):
			admin_room_overlays[room_key] = Array(result.get("records", [])).duplicate(true)
			admin_editor_revisions[room_key] = int(result.get("revision", 0))
			admin_editor_server_rooms[room_key] = Array(result.get("records", [])).duplicate(true)
			admin_editor.set_room_records(room_key, Array(result.get("records", [])), true)
		admin_editor_apply_queue.clear()
		queue_redraw()
		return
	admin_room_overlays[room_key] = Array(result.get("records", [])).duplicate(true)
	admin_editor_revisions[room_key] = int(result.get("revision", 0))
	admin_editor_server_rooms[room_key] = Array(result.get("records", [])).duplicate(true)
	admin_editor.set_room_records(room_key, Array(result.get("records", [])), true)
	if not admin_editor_apply_queue.is_empty():
		admin_editor_apply_queue.pop_front()
	admin_editor_apply_next()
	queue_redraw()

func run_offline_admin_command(message: String) -> void :
	if not OFFLINE_ADMIN_COMMANDS:
		append_chat("[SYSTEM] Admin commands are server-authoritative and unavailable.")
		return
	var parts: = message.substr(1).split(" ", false)
	if parts.is_empty():
		return
	var command: = String(parts[0]).to_lower()
	match command:
		"help":
			append_chat("[ADMIN] /warp AREA[:ROOM_ID] /rooms [AREA] /inspect /editor /heal /god on|off")
			append_chat("[ADMIN] /pissed mob on|off")
			append_chat("[ADMIN] /cash N /points N /job NAME /skill NAME LEVEL /progress PATH")
			append_chat("[ADMIN] /spawnnpc /clearnpcs /wanted on|off /jail N /overdose")
			append_chat("[ADMIN] /give ITEM /items /feedback /clear")
			append_chat("[ADMIN] /tutorialdone - sets all skills to level 5")
			append_chat("[ADMIN] /intelligence N /endurance N /agility N /fighting N /firearms N")
			append_chat("[ADMIN] /stealth N /awareness N /safety N /medicine N /chemistry N")
			append_chat("[ADMIN] /cooking N /greenthumb N /vehicle N /influence N /enterprise N /civics N")
			append_chat("[ADMIN] /punch /kick /overhead /strike /dodge /parry - test combat animations")
			append_chat("[ADMIN] /boxing /karate /wingchun /sumo /muaythai /mma - switch martial arts style")
		"punch", "kick", "overhead", "strike":
			if mode == ScreenMode.CHAT:
				mode = ScreenMode.PLAY

			attack_type = command if command != "strike" else "punch"
			var attack_data: = get_attack_data(attack_type)
			if attack_data.is_empty():
				attack_data = get_attack_data("punch")
			var total_duration: = get_attack_total_duration(attack_data)
			attack_animation_timer = total_duration
			attack_frame = 0.0
			attack_phase = "windup"
			attack_cooldown = total_duration + 0.1
			attack_weapon_used = command if command != "strike" else "Fists"
			append_chat("[ADMIN] Executed %s animation." % command)
		"dodge":
			if mode == ScreenMode.CHAT:
				mode = ScreenMode.PLAY
			player_dodge()
			append_chat("[ADMIN] Executed dodge animation.")
		"parry":
			if mode == ScreenMode.CHAT:
				mode = ScreenMode.PLAY
			player_parry()
			append_chat("[ADMIN] Executed parry animation.")
		"boxing":
			current_martial_arts_style = "boxing"
			append_chat("[ADMIN] Martial arts style: BOXING")
		"karate":
			current_martial_arts_style = "karate"
			append_chat("[ADMIN] Martial arts style: KARATE")
		"wingchun":
			current_martial_arts_style = "wing_chun"
			append_chat("[ADMIN] Martial arts style: WING CHUN")
		"sumo":
			current_martial_arts_style = "sumo"
			append_chat("[ADMIN] Martial arts style: SUMO")
		"muaythai":
			current_martial_arts_style = "muay_thai"
			append_chat("[ADMIN] Martial arts style: MUAY THAI")
		"mma":
			current_martial_arts_style = "mma"
			append_chat("[ADMIN] Martial arts style: MMA")
		"items", "itemids":
			var item_ids: Array = item_command_catalog().keys()
			item_ids.sort()
			var page_count: = ceili(float(item_ids.size()) / 4.0)
			for page in range(page_count):
				var first: = page * 4
				var last: = mini(first + 4, item_ids.size())
				append_chat("[ITEM IDS %d/%d] %s" % [page + 1, page_count, ", ".join(item_ids.slice(first, last))])
		"feedback":
			open_feedback(ScreenMode.CHAT)
		"editor":
			open_admin_editor()
		"clear":
			chat_history.clear()
		"god":
			if parts.size() >= 2:
				god_mode = String(parts[1]).to_lower() == "on"
			else:
				god_mode = not god_mode
			if god_mode:
				health = 100.0
				player_downed = false
			append_chat("[ADMIN] Invincibility %s." % ("ON" if god_mode else "OFF"))
		"speedmode":
			if parts.size() >= 2:
				speed_mode = String(parts[1]).to_lower() == "on"
			else:
				speed_mode = not speed_mode
			append_chat("[ADMIN] Speed mode %s. (10x XP, 5x health regen, 5x stamina regen)" % ("ON" if speed_mode else "OFF"))
		"pissed":
			if parts.size() < 3 or String(parts[1]).to_lower() != "mob" or String(parts[2]).to_lower() not in ["on", "off"]:
				append_chat("[ADMIN] Usage: /pissed mob on|off")
			else:
				var enable_mob: = String(parts[2]).to_lower() == "on"
				laundry_mob_admin_override = 1 if enable_mob else 0
				if enable_mob:
					activate_laundry_mob_hostility("ADMIN TEST")
				else:
					clear_laundry_mob_hostility()
				append_chat("[ADMIN] Laundromat office hostility %s." % ("ON FOR TEN MINUTES" if enable_mob else "OFF"))
		"spawnnpc":
			admin_spawn_disposition_target()
		"clearnpcs":
			admin_clear_disposition_targets()
		"progress":
			admin_progress_shortcut(String(parts[1]).to_lower() if parts.size() >= 2 else "")
		"heal":
			health = 100.0
			stamina = 100.0
			player_downed = false
			append_chat("[ADMIN] Health and stamina restored.")
		"overdose":
			trigger_overdose("ADMIN TEST")
			append_chat("[ADMIN] Overdose contingency test started.")
		"cash":
			if parts.size() >= 2 and String(parts[1]).is_valid_int():
				cash = clampi(int(parts[1]), 0, 999999)
				append_chat("[ADMIN] Cash set to $%d." % cash)
			else:
				append_chat("[ADMIN] Usage: /cash 500")
		"points":
			if parts.size() >= 2 and String(parts[1]).is_valid_int():
				education_points = clampi(int(parts[1]), 0, 9999)
				append_chat("[ADMIN] Scholarship Points set to %d." % education_points)
			else:
				append_chat("[ADMIN] Usage: /points 20")
		"warp":
			if parts.size() < 2:
				append_chat("[ADMIN] Usage: /warp AREA or /warp AREA:ROOM_ID. Use /rooms [AREA].")
			else:
				admin_warp(String(parts[1]).to_lower())
		"rooms":
			admin_list_rooms(String(parts[1]).to_lower() if parts.size() >= 2 else area)
		"inspect":
			admin_inspect_target()
		"job":
			if parts.size() < 2:
				append_chat("[ADMIN] Jobs: cashier security none")
			else:
				admin_set_job(String(parts[1]).to_lower())
		"wanted":
			if parts.size() >= 2:
				wanted = String(parts[1]).to_lower() == "on"
				warrant = wanted
				if not wanted:
					clear_active_case()
				append_chat("[ADMIN] Wanted, warrant, and active probable cause: %s." % ("ON" if wanted else "OFF"))
			else:
				append_chat("[ADMIN] Usage: /wanted on|off")
		"jail":
			var credits: = 3
			if parts.size() >= 2 and String(parts[1]).is_valid_int():
				credits = clampi(int(parts[1]), 0, 30)
			area = "jail"
			player_position = Vector2(100, 220)
			sentence_credits = credits
			objective = "Complete %d jail assignment credits." % credits
			append_chat("[ADMIN] Warped to jail with %d credits." % credits)
		"skill":
			if parts.size() >= 3 and String(parts[2]).is_valid_int():
				var requested: = String(parts[1]).to_lower()
				var matched: = ""
				for skill_name in Rules.SKILLS:
					if skill_name.to_lower() == requested:
						matched = skill_name
						break
				if matched.is_empty():
					append_chat("[ADMIN] Unknown skill. Use /skill Agility 20, for example.")
				else:
					var level: = clampi(int(parts[2]), 1, 99)
					skills[matched] = Rules.xp_for_level(level)
					append_chat("[ADMIN] %s set to level %d." % [matched, level])
			else:
				append_chat("[ADMIN] Usage: /skill Agility 20")
		"give":
			if parts.size() < 2:
				append_chat("[ADMIN] Usage: /give ITEM_ID  -  use /items for every ID")
			else:
				var first_space: = message.find(" ")
				admin_give(message.substr(first_space + 1).strip_edges().to_lower().replace(" ", "_"))
		"tutorialdone":
			for skill_name in Rules.SKILLS:
				skills[skill_name] = Rules.xp_for_level(5)
			append_chat("[ADMIN] All skills set to level 5.")
		"intelligence", "endurance", "agility", "fighting", "firearms", "stealth", "awareness", "safety", "medicine", "chemistry", "cooking", "greenthumb", "vehicle", "influence", "enterprise", "civics":
			var skill_proper: = command.capitalize()
			if parts.size() >= 2 and String(parts[1]).is_valid_int():
				var level: = clampi(int(parts[1]), 1, 99)
				skills[skill_proper] = Rules.xp_for_level(level)
				append_chat("[ADMIN] %s set to level %d." % [skill_proper, level])
			else:
				append_chat("[ADMIN] Usage: /%s LEVEL (e.g., /%s 10)" % [command, command])
		_:
			append_chat("[ADMIN] Unknown command. Type /help.")

func admin_warp(destination: String) -> void :
	var target_area: = destination.get_slice(":", 0).strip_edges()
	var target_room: = destination.get_slice(":", 1).strip_edges() if ":" in destination else ""
	if target_area == "backroom":
		target_area = "store"
		target_room = "stockroom"
	target_room = normalize_legacy_school_room(target_area, target_room)
	var exterior_areas: = ["street", "rear", "rooftop"]
	if target_area in Build10.ROOM_LAYOUTS:
		if target_room.is_empty():
			target_room = String(Build10.DEFAULT_ROOM.get(target_area, ""))
		if target_room not in Build10.room_ids(target_area):
			append_chat("[ADMIN] Unknown RoomID %s:%s. Use /rooms %s." % [target_area, target_room, target_area])
			return
	elif target_area in exterior_areas:
		target_room = ""
	else:
		append_chat("[ADMIN] Unknown area: %s. Use /rooms for the area list." % target_area)
		return
	var positions: = {
		"home": Vector2(500, 260), "street": Vector2(5100, 210), 
		"school": Vector2(500, 260), "store": Vector2(500, 260), 
		"bank": Vector2(500, 260), "jail": Vector2(500, 260), 
		"hospital": Vector2(500, 220), "apartment": Vector2(500, 220), 
		"social": Vector2(500, 220), "restaurant": Vector2(500, 220), 
		"barber": Vector2(500, 220), "laundromat": Vector2(500, 220), 
		"pawn": Vector2(500, 220), "precinct": Vector2(500, 220), 
		"pillmill": Vector2(500, 220), "clinic": Vector2(500, 220), 
		"rear": Vector2(5100, 245), "rooftop": Vector2(5100, 235), 
	}
	area = target_area
	room_id = target_room
	player_position = resolve_safe_position(positions.get(target_area, Vector2(500, 260)))
	append_chat("[ADMIN] Warped to RoomID %s." % visible_room_id())

func admin_list_rooms(requested_area: String) -> void :
	if requested_area.is_empty():
		requested_area = area
	if requested_area == "backroom":
		requested_area = "store"
	if requested_area not in Build10.ROOM_LAYOUTS:
		var areas: Array[String] = ["street", "rear", "rooftop"]
		for area_value in Build10.ROOM_LAYOUTS:
			areas.append(String(area_value))
		areas.sort()
		append_chat("[ROOM AREAS] %s" % ", ".join(areas))
		return
	var room_ids: = Build10.room_ids(requested_area)
	var page_count: = ceili(float(room_ids.size()) / 5.0)
	for page in range(page_count):
		var first: = page * 5
		var last: = mini(first + 5, room_ids.size())
		var qualified: Array[String] = []
		for room_value in room_ids.slice(first, last):
			qualified.append("%s:%s" % [requested_area, String(room_value)])
		append_chat("[ROOM IDS %d/%d] %s" % [page + 1, page_count, ", ".join(qualified)])

func admin_inspect_target() -> void :
	var target: = nearby_context_hotspot()
	append_chat("[INSPECT] RoomID=%s" % visible_room_id())
	if target.is_empty():
		append_chat("[INSPECT] No usable object is within interaction range.")
		return
	append_chat("[INSPECT] %s  ObjectID=%s" % [String(target.get("label", "UNLABELED")), String(target.get("object_id", "unregistered"))])
	append_chat("[INSPECT] InstanceID=%s" % String(target.get("instance_id", "unregistered")))
	append_chat("[INSPECT] GraphicID=%s" % String(target.get("graphic_id", "unregistered")))
func admin_set_job(job: String) -> void :
	match job:
		"cashier":
			start_cashier_contract()
		"security":
			start_security_contract()
		"none":
			close_job_contract("ended")
			active_job = "None"
			on_duty = false
		_:
