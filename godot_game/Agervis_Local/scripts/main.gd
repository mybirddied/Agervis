func update_play(delta: float) -> void :
	if not in_firearms_practice_room() and (firearms_practice_kit_issued or firearms_dummy_state != "ready" or not firearms_teacher_reaction_text.is_empty()):
		reset_firearms_practice(false)
	if not in_medicine_practice_room() and (medicine_drill_active or not medicine_drill_feedback.is_empty()):
		reset_medicine_training_drill()
	autosave_timer += delta
	if autosave_timer >= 30.0:
		autosave_timer = 0.0
		save_current_character()


	update_combat_systems(delta)

	attack_cooldown = maxf(0.0, attack_cooldown - delta)
	vault_cooldown = maxf(0.0, vault_cooldown - delta)
	mark_timer = maxf(0.0, mark_timer - delta)
	update_overdose_state(delta)
	update_medicine_training_drill(delta)
	update_active_substance_effects(delta)
	case_decay_progress += delta / 75.0
	camera_evasion_timer = maxf(0.0, camera_evasion_timer - delta)
	update_job_contract_attendance(delta)
	update_handoffs()
	update_task_directors()
	update_capone_contract()
	if duty_active_timer > 0.0:
		duty_active_timer -= delta
	if on_duty and duty_active_timer > 0.0:
		duty_tick += delta
		if duty_tick >= 12.0:
			duty_tick -= 12.0
			duty_pay += 1
			notify("ACTIVE DUTY PAY +$1", GOOD, 1.5)
	if not vault_active and player_position_hits_solid(player_position):
		player_position = resolve_safe_position(player_position)
	if player_downed:
		vault_active = false
		endurance_training.clear()
		endurance_training_elapsed = 0.0
		if lan_session.active:
			downed_timer += delta
		else:
			update_player_downed(delta)
	elif sleeping:
		update_sleeping(delta)
	elif vault_active:
		update_vault(delta)
	elif cooking_active:
		update_cooking(delta)
	elif not endurance_training.is_empty():
		update_endurance_training(delta)
	else:
		update_movement(delta)
	update_actors(delta)
	update_store_business(delta)
	update_ambience()
	if area == "street":
		update_traffic(delta)
		update_automatic_patrol()
	elif area == "bank":
		update_automatic_patrol()
	elif area == "jail":
		update_jail_life(delta)
	update_case()
	update_contextual_tips()

func update_store_business(delta: float) -> void :
	if online_authority_enforced():
		return
	if store_shares <= 0:
		return
	if active_input_age > 90.0:
		store_business_timer = 0.0
		return
	store_business_timer += delta
	if store_business_timer < 45.0:
		return
	store_business_timer = 0.0

	if rng.randf() < store_insurance_pressure * 0.05:
		append_chat("[STORE] Insurance paperwork delayed this dividend by one cycle.")
		return
	var dividend: = store_shares * 2
	bank_balance += dividend
	append_chat("[STORE] Boss's Corner Store dividend deposited: $%d." % dividend)
	notify("STORE SHAREHOLDER DIVIDEND +$%d" % dividend, GOOD, 2.5)

func update_traffic(delta: float) -> void :
	traffic_spawn_timer -= delta
	if traffic_spawn_timer <= 0.0 and traffic.size() < 4:
		spawn_traffic_car()
		traffic_spawn_timer = rng.randf_range(5.0, 9.5)

	for index in range(traffic.size() - 1, -1, -1):
		var car: Dictionary = traffic[index]
		var direction: = float(car["direction"])


		if not car.has("base_speed"):
			car["base_speed"] = float(car["speed"])


		var car_ahead: Dictionary = {}
		var closest_distance: = 999999.0
		for other_index in range(traffic.size()):
			if other_index == index:
				continue
			var other: Dictionary = traffic[other_index]
			if float(other["direction"]) != direction:
				continue
			var delta_x: = (float(other["x"]) - float(car["x"])) * direction
			if delta_x > 0 and delta_x < closest_distance:
				closest_distance = delta_x
				car_ahead = other


		var target_speed: = float(car.get("base_speed", car["speed"]))
		if not car_ahead.is_empty() and not bool(car.get("crashed", false)):
			var safe_distance: = 180.0
			if closest_distance < safe_distance:
				var speed_factor: = clampf(closest_distance / safe_distance, 0.3, 1.0)
				target_speed *= speed_factor


		if bool(car.get("driveby_stopping", false)):
			var stop_progress: = float(car.get("stop_elapsed", 0.0)) / 2.0
			target_speed = lerpf(float(car.get("base_speed", car["speed"])), 0.0, clampf(stop_progress, 0.0, 1.0))
			car["stop_elapsed"] = float(car.get("stop_elapsed", 0.0)) + delta


		if not bool(car.get("crashed", false)):
			car["speed"] = lerpf(float(car["speed"]), target_speed, delta * 2.0)


		car["x"] = float(car["x"]) + direction * float(car["speed"]) * delta
		var close_x: = absf(float(car["x"]) - player_position.x)


		if player_position.y >= 248.0 and close_x < 92.0 and not bool(car["hit_player"]):
			car["hit_player"] = true
			player_position.x = clampf(player_position.x + direction * 80.0, 40.0, STREET_WIDTH - 40.0)
			player_position.y = maxf(DEPTH_MIN, player_position.y - 35.0)
			damage_player_environment(26.0, "A passing car converted the road into a collision tutorial.")


		car["muzzle_timer"] = maxf(0.0, float(car.get("muzzle_timer", 0.0)) - delta)
		car["exclamation_timer"] = maxf(0.0, float(car.get("exclamation_timer", 0.0)) - delta)


		if bool(car["armed"]) and not bool(car.get("driveby_stopping", false)) and close_x < 470.0:
			car["driveby_stopping"] = true
			car["stop_elapsed"] = 0.0
			car["base_speed"] = float(car["speed"])


			var awareness: = skill_level("Awareness")
			var is_sprinting: = Input.is_action_pressed("sprint") or click_move_sprint or mobile_sprint_held
			var detection_chance: = 0.2 if is_sprinting else minf(0.025 + awareness * 0.039, 0.975)

			if rng.randf() < detection_chance:
				car["player_noticed"] = true
				car["exclamation_timer"] = 2.0
			else:
				car["player_noticed"] = false


		if bool(car.get("driveby_stopping", false)) and not bool(car.get("fired", false)):
			var stop_progress: = float(car.get("stop_elapsed", 0.0)) / 2.0
			if stop_progress >= 1.0:
				car["fired"] = true
				car["muzzle_timer"] = 0.14
				car["resume_timer"] = 1.8
				handle_driveby_shot(car)

		if bool(car.get("fired", false)) and not bool(car.get("police", false)):
			car["resume_timer"] = maxf(0.0, float(car.get("resume_timer", 0.0)) - delta)
			if float(car["resume_timer"]) <= 0.0:
				car["driveby_stopping"] = false

		if bool(car.get("police", false)) and int(car.get("shots_remaining", 0)) > 0:
			car["shot_timer"] = maxf(0.0, float(car.get("shot_timer", 0.0)) - delta)
			if float(car["shot_timer"]) <= 0.0:
				car["shots_remaining"] = int(car.get("shots_remaining", 0)) - 1
				car["shot_timer"] = float(car.get("shot_interval", 0.35))
				car["muzzle_timer"] = 0.14
				if rng.randf() < 0.42:
					damage_player_environment(14.0, "Police driveby shot connected.")
				record_camera_event("SHOTS", "POLICE VEHICLE", "Police gunfire toward marked resident.", 20, player_position)


		if bool(car.get("driveby_stopping", false)) and not bool(car.get("crashed", false)) and not bool(car.get("witness_checked", false)):
			car["witness_checked"] = true
			for witness_index in range(traffic.size()):
				if witness_index == index:
					continue
				var witness: Dictionary = traffic[witness_index]
				if float(witness["direction"]) != direction:
					continue
				var delta_x: = (float(car["x"]) - float(witness["x"])) * direction
				if delta_x > 0 and delta_x < 120.0:
					if rng.randf() < 0.95:
						witness["speed"] = 0.0
						witness["stopped_by_driveby"] = true
					else:
						car["crashed"] = true
						car["crash_timer"] = 60.0
						car["speed"] = 0.0
						witness["crashed"] = true
						witness["crash_timer"] = 60.0
						witness["speed"] = 0.0
						witness["x"] = float(car["x"]) - direction * 100.0
						spawn_blood(Vector2(float(car["x"]), 540.0), "impact", 3)
						notify("TRAFFIC COLLISION BEHIND THE DRIVEBY", ACCENT, 2.0)
					break


		if bool(car.get("crashed", false)):
			car["crash_timer"] = maxf(0.0, float(car.get("crash_timer", 0.0)) - delta)
			if float(car["crash_timer"]) <= 0.0:
				traffic.remove_at(index)
				continue


		if bool(car.get("police", false)) and bool(car.get("fired", false)) and int(car.get("shots_remaining", 0)) <= 0:
			var close_to_player: = absf(float(car["x"]) - player_position.x) < 800.0

			if close_to_player and not bool(car.get("officer_dismounted", false)):
				car["officer_dismounted"] = true
				car["officer_position"] = Vector2(float(car["x"]), 540.0 + (-50.0 if direction < 0 else 50.0))
				car["dismount_timer"] = 0.0
				notify("OFFICER DISMOUNTING WITH SHOTGUN", DANGER, 2.5)

			if bool(car.get("officer_dismounted", false)):
				car["dismount_timer"] = float(car.get("dismount_timer", 0.0)) + delta

				if float(car["dismount_timer"]) > 1.5 and float(car["dismount_timer"]) < 1.7:
					if rng.randf() < 0.72:
						damage_player_environment(28.0, "Police shotgun blast connected.")
					record_camera_event("SHOTS", "POLICE OFFICER", "Shotgun discharge at marked resident.", 22, player_position)

				if not close_to_player or float(car["dismount_timer"]) > 12.0:
					car["officer_dismounted"] = false
					car["dismount_complete_timer"] = 10.0


		if bool(car.get("dismount_complete_timer", false)):
			car["dismount_complete_timer"] = maxf(0.0, float(car.get("dismount_complete_timer", 0.0)) - delta)
			if float(car["dismount_complete_timer"]) <= 0.0:
				traffic.remove_at(index)
				continue


		if bool(car.get("pike_follow_active", false)):
			car["pike_follow_remaining"] = maxf(0.0, float(car.get("pike_follow_remaining", 0.0)) - delta)
			if float(car["pike_follow_remaining"]) <= 0.0:
				car["pike_follow_active"] = false

		traffic[index] = car
		if float(car["x"]) < -260.0 or float(car["x"]) > STREET_WIDTH + 260.0:
			traffic.remove_at(index)

