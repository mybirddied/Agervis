func controller_choice_index(button: int) -> int:
	match button:
		JOY_BUTTON_A: return 0
		JOY_BUTTON_B: return 1
		JOY_BUTTON_X: return 2
		JOY_BUTTON_Y: return 3
	return -1

func controller_quiz_choice_index(button: int, answer_count: int) -> int:
	var face_index: = controller_choice_index(button)
	if face_index >= 0 and face_index < mini(4, answer_count):
		return face_index
	if answer_count > 4:
		var dpad_index: = -1
		match button:
			JOY_BUTTON_DPAD_UP: dpad_index = 4
			JOY_BUTTON_DPAD_RIGHT: dpad_index = 5
			JOY_BUTTON_DPAD_DOWN: dpad_index = 6
			JOY_BUTTON_DPAD_LEFT: dpad_index = 7
		if dpad_index < answer_count:
			return dpad_index
	return -1

