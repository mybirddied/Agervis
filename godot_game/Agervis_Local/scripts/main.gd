func build10_room_data() -> Dictionary:
	if room_id.is_empty() or area not in Build10.ROOM_LAYOUTS: return {}
	for room in Build10.ROOM_LAYOUTS[area]:
		if String(room["id"]) == room_id: return room
	return {}

func build10_room_doors() -> Array[Dictionary]:
	var room: = build10_room_data()
	if room.is_empty(): return []
	var targets: Array = room.get("doors", [])
	var doors: Array[Dictionary] = []
	var count: = targets.size()
	var authored_positions: Dictionary = room.get("door_positions", {})
	var owner_room: = RoomObjects.room_key(area, room_id)
	for index in range(count):
		var target: = String(targets[index])
		var generated_x: = 112.0 if count == 1 else lerpf(130.0, 870.0, float(index) / float(count - 1))
		var x: = float(authored_positions.get(target, generated_x))

		doors.append({
			"target": target, "point": Vector2(x, 205), "label": build10_door_label(target), "kind": "door", "radius": 62.0, "facing": "up", 
			"object_id": "transition.room_door", "instance_id": "%s/door:%s" % [owner_room, target], 
			"graphic_id": "door.interior.standard.v2", "action_id": "room_transition", "owner_room": owner_room, 
		})
	for record in current_room_object_records():
		if String(record.get("record_type", "object")) != "warp" or bool(record.get("deleted", false)):
			continue
		var warp_target: = String(record.get("target_room", "")).strip_edges()
		if warp_target.is_empty():
			continue
		var warp_point: Variant = record.get("position", Vector2.ZERO)
		if not warp_point is Vector2:
			continue
		doors.append({
			"target": warp_target, "point": warp_point as Vector2, "label": "CUSTOM WARP", "kind": "warp", "radius": 48.0, 
			"object_id": "world.warp", "instance_id": String(record.get("local_id", "warp")), "graphic_id": "editor.warp.v1", 
			"action_id": "room_transition", "owner_room": owner_room, "warp_record": record, 
			"facing": String(record.get("facing", "up")).strip_edges().to_lower(), 
			"trigger_rect": authored_warp_trigger_rect(record, warp_point as Vector2), 
		})
	return doors
func build10_door_label(target: String) -> String:
	if target == "street": return "STREET"
	if target == "rear": return "SERVICE SIDE"
	if target == "rooftop": return "ROOF ROUTE"
	return Build10.room_label(area, target)

func build10_door_interaction_rect(door_point: Vector2) -> Rect2:
	return door_contact_rect(door_point)

func authored_warp_trigger_rect(record: Dictionary, warp_point: Vector2) -> Rect2:




	var authored_size: Variant = record.get("trigger_size", Vector2(48.0, 20.0))
	var half_width: = 24.0
	if authored_size is Vector2:
		half_width = maxf(1.0, float((authored_size as Vector2).x) * 0.5)


	return Rect2(warp_point.x - half_width, warp_point.y - DOOR_CONTACT_THRESHOLD_DEPTH, half_width * 2.0, DOOR_CONTACT_THRESHOLD_DEPTH * 2.0)

func room_door_trigger_rect(door: Dictionary) -> Rect2:
	var point: = door.get("point", Vector2.ZERO) as Vector2
	var authored_trigger: Variant = door.get("trigger_rect", null)
	return authored_trigger as Rect2 if authored_trigger is Rect2 else build10_door_interaction_rect(point)

func room_door_contact_position(door: Dictionary) -> Vector2:
	return room_door_trigger_rect(door).get_center()

func room_door_arrival_position(door: Dictionary) -> Vector2:



	var contact: = room_door_contact_position(door)
	return clamp_position_to_area(contact + Vector2(0.0, 14.0))

func nearest_build10_room_door(_radius: float = 48.0) -> Dictionary:
	var best: Dictionary = {}
	var best_distance: = INF
	for door in build10_room_doors():
		var trigger_rect: = room_door_trigger_rect(door)
		var touching_door: = trigger_rect.intersects(player_warp_contact_rect(), true)
		var distance: = player_position.distance_to(trigger_rect.get_center())
		if touching_door and distance < best_distance:
			best_distance = distance
			best = door
	return best

func nearest_build10_room_door_to(target_room: String) -> Dictionary:
	for door in build10_room_doors():
		if String(door["target"]) == target_room:
			return door
	return {}
func building_exterior_x(area_name: String) -> float:
	var value: Variant = Build7.ENTRY_POSITIONS.get(area_name, Vector2(300, 215))
	return float((value as Vector2).x) if value is Vector2 else 300.0

func try_build10_room_transition() -> bool:
	var door: = nearest_build10_room_door()
	if door.is_empty(): return false
	var custom_warp: Dictionary = door.get("warp_record", {}) if door.get("warp_record", {}) is Dictionary else {}
	if not custom_warp.is_empty():
		var target_world: = String(custom_warp.get("target_world", ""))
		if not target_world.is_empty() and not resident_world_id.is_empty() and target_world != resident_world_id:
			notify("WARP REJECTED  -  TARGET WORLD IS NOT THIS SERVER", DANGER, 2.5)
			return true
		var target_key: = String(custom_warp.get("target_room", ""))
		var key_parts: = target_key.split(":", false)
		var target_area: = area
		var target_room: = target_key
		if key_parts.size() == 2:
			target_area = String(key_parts[0])
			target_room = String(key_parts[1])
		if target_area not in Build10.ROOM_LAYOUTS or target_room not in Build10.room_ids(target_area):
			notify("WARP REJECTED  -  TARGET ROOM IS NOT AUTHORED", DANGER, 2.5)
			return true
		cancel_transition_movement_input()
		area = target_area
		room_id = target_room
		if area == "tutorial":
			phase = "tutorial"
		elif area == "school":
			phase = "adult"
		var target_position: Variant = custom_warp.get("target_position", Vector2(500, 270))
		var spawn_position: = Vector2(500, 270)
		if target_position is Vector2:
			spawn_position = target_position as Vector2
		player_position = resolve_safe_position(spawn_position)
		home_instance_id = String(current_player_home().get("home_instance_id", "")) if area == "apartment" and room_id == "unit" else ""
		refresh_active_task_text()
		save_current_character("ROOM CHECKPOINT")
		return true
	var target: = String(door["target"])
	if area == "apartment" and room_id == "unit" and target == "floor_1" and not active_home_visit.is_empty():
		if not submit_online_economy_request("HOME_VISIT_LEAVE", {}, true):
			notify("THE ONLINE HOUSING LEDGER MUST CLOSE THIS VISIT", DANGER, 3.0)
		return true
	if area == "apartment" and target == "unit" and not apartment_home_owned():
		notify("UNIT ENTRY DENIED  -  MERCY COURT HAS NOT ASSIGNED THIS ROOM TO YOU", DANGER, 3.0)
		return true
	if area == "apartment" and target == "security" and "Basic Security Orientation" not in credentials:
		notify("SECURITY OFFICE LOCKED - SAFETY CREDENTIAL REQUIRED", DANGER, 2.5)
		return true
	if area in ["store", "backroom"] and target in ["stockroom", "safe", "dvr"] and "Store Employee Credential" not in credentials and not on_duty:
		notify("EMPLOYEE ROOMS REQUIRE BOSS'S TRUST OR ACTIVE DUTY", DANGER, 2.5)
		return true
	if area == "hospital" and target == "street":
		if hospital_required_treatment and not hospital_stabilized:
			notify("DISCHARGE DENIED  -  STABILIZATION INCOMPLETE", DANGER, 2.5)
		elif hospital_required_treatment:
			hospital_required_treatment = false
			enter_area("home", Vector2(250, 200))
			objective = "Recover at home or return to the block."
			notify("DISCHARGED TO DEFAULT HOME", GOOD, 3.0)
		else:
			enter_area("street", Vector2(building_exterior_x(area), 220))
		return true
	if area == "jail" and target == "street":
		if sentence_credits > 0:
			notify("RELEASE DENIED  -  %d ASSIGNMENT CREDITS REMAIN" % sentence_credits, DANGER, 3.0)
		else:
			release_from_jail()
		return true
	if is_tutorial_school_area() and room_id == "guidance" and target == "orientation_hall" and not tutorial_flags["counselor"]:
		notify("MS. VALE STILL HAS YOUR FIRST ORIENTATION STATEMENT", ACCENT, 3.0)
		return true
	if is_tutorial_school_area() and room_id == "guidance" and target == "orientation_hall":
		tutorial_flags["guidance_exit"] = true
	if is_tutorial_school_area() and room_id == "orientation_hall" and target == "hall_a" and tutorial_headstart.is_empty():
		if not tutorial_missing_orientation_people().is_empty():
			notify("STATEMENTS STILL REQUIRED: %s" % ", ".join(tutorial_missing_orientation_people()).to_upper(), ACCENT, 3.0)
			return true
		open_dialog("FINAL BELL  -  THE CITY WANTS A FIRST IMPRESSION", tutorial_opening_choice_lines(), [
			{"label": "Attend class  -  Civilian opening", "id": "tutorial_civilian"}, 
			{"label": "Take hall-monitor duty  -  Law Enforcement opening", "id": "tutorial_law"}, 
			{"label": "Use the service exit  -  Criminal opening", "id": "tutorial_criminal"}, 
		])
		return true
	if is_tutorial_school_area() and room_id == "service_exit" and target == "street":

		phase = "adult"

		player_stature = creation_statures[creation_stature_index]
		player_facial_hair_style = creation_facial_hair_styles[creation_facial_hair_index]
		enter_area("home", Vector2(640.0, 250.0))
		room_id = "lobby"
		notify("ARRIVED AT GROUP HOME", ACCENT, 3.0)
		return true
	if target == "street":
		enter_area("street", Vector2(building_exterior_x(area), 220))
	elif target in ["rear", "rooftop"]:
		enter_area(target, Vector2(building_exterior_x(area), 230))
	else:
		cancel_transition_movement_input()
		var previous_room: = room_id
		room_id = target
		reset_firearms_practice(false)
		reset_stealth_practice()
		if area == "apartment" and room_id == "unit":
			active_home_visit.clear()
			home_instance_id = String(current_player_home().get("home_instance_id", ""))
		else:
			home_instance_id = ""
			active_home_visit.clear()
		var return_door: = nearest_build10_room_door_to(previous_room)
		var spawn_point: = Vector2(500, 270)
		if not return_door.is_empty():
			spawn_point = room_door_arrival_position(return_door)
		player_position = resolve_safe_position(spawn_point)
		sleeping = false
		refresh_active_task_text()
		save_current_character("ROOM CHECKPOINT")
		notify(area_display_name(), PAPER, 1.4)
	return true

func build10_room_has_legacy_content() -> bool:
	match area:
		"tutorial": return false
		"school": return room_id in ["orientation", "guidance"]


		"store": return room_id == "sales"
		"backroom": return false
		"bank": return false
		"apartment", "social", "hospital", "jail", "precinct", "barber", "laundromat", "pawn", "pillmill", "clinic":
			return room_id == String(Build10.DEFAULT_ROOM.get(area, ""))
	return false

func build10_room_door_rect(screen_point: Vector2) -> Rect2:

	var door_top: = ARCH_FLOOR_Y - AUTHORED_DOOR_HEIGHT
	return Rect2(screen_point.x - 46.0, door_top, 92.0, AUTHORED_DOOR_HEIGHT)

func wrapped_door_label_lines(label: String, max_width: float, text_size: int = 7) -> Array[String]:
	var lines: Array[String] = []
	var current: = ""
	for word_value in label.split(" ", false):
		var word: = String(word_value)
		var candidate: = word if current.is_empty() else current + " " + word
		if current.is_empty() or font.get_string_size(candidate, HORIZONTAL_ALIGNMENT_LEFT, -1, text_size).x <= max_width:
			current = candidate
		else:
			lines.append(current)
			current = word
	if not current.is_empty():
		lines.append(current)
	return lines

func classroom_skill_name(target_room: String) -> String:
	if target_room in ["gym_a", "gym_b"]:
		return "Agility"
	if not target_room.begins_with("class_"):
		return ""
	return target_room.trim_prefix("class_").replace("_", " ").capitalize()

func classroom_skill_order() -> Array[String]:
	return ["Intelligence", "Endurance", "Agility", "Fighting", "Firearms", "Stealth", "Awareness", "Safety", "Medicine", "Influence", "Enterprise", "Civics"]

func classroom_teacher_wait_seconds(skill_name: String) -> float:
	return 25.0 + float(maxi(0, classroom_skill_order().find(skill_name)) % 6)

func classroom_teacher_cycle_time(skill_name: String, at_time: float = -1.0) -> float:
	var wait_seconds: = classroom_teacher_wait_seconds(skill_name)
	var source_time: = classroom_preview_time if at_time < 0.0 and classroom_preview_time >= 0.0 else elapsed if at_time < 0.0 else at_time
	return fposmod(maxf(0.0, source_time), wait_seconds * 2.0 + 6.0)

func classroom_teacher_position(skill_name: String, at_time: float = -1.0) -> Vector2:
	var wait_seconds: = classroom_teacher_wait_seconds(skill_name)
	var cycle_time: = classroom_teacher_cycle_time(skill_name, at_time)
	var left_x: = 220.0
	var right_x: = 390.0
	if cycle_time < wait_seconds:
		return Vector2(left_x, 190.0)
	if cycle_time < wait_seconds + 3.0:
		return Vector2(lerpf(left_x, right_x, (cycle_time - wait_seconds) / 3.0), 190.0)
	if cycle_time < wait_seconds * 2.0 + 3.0:
		return Vector2(right_x, 190.0)
	return Vector2(lerpf(right_x, left_x, (cycle_time - wait_seconds * 2.0 - 3.0) / 3.0), 190.0)

func classroom_teacher_is_walking(skill_name: String, at_time: float = -1.0) -> bool:
	var wait_seconds: = classroom_teacher_wait_seconds(skill_name)
	var cycle_time: = classroom_teacher_cycle_time(skill_name, at_time)
	return (cycle_time >= wait_seconds and cycle_time < wait_seconds + 3.0) or cycle_time >= wait_seconds * 2.0 + 3.0

func classroom_teacher_facing(skill_name: String, at_time: float = -1.0) -> float:
	var wait_seconds: = classroom_teacher_wait_seconds(skill_name)
	return -1.0 if classroom_teacher_cycle_time(skill_name, at_time) >= wait_seconds * 2.0 + 3.0 else 1.0

func classroom_teacher_profile(skill_name: String) -> Dictionary:
	match skill_name:
