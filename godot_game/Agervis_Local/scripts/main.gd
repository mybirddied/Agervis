func _initialize_title_city_animation() -> void :

	for i in range(2):
		title_traffic_vehicles.append({
			"x": randf_range(-100, VIEW_SIZE.x), 
			"speed": randf_range(70, 140), 
			"width": randi_range(50, 90), 
			"color": Color.from_hsv(randf(), randf_range(0.0, 0.15), randf_range(0.18, 0.38)), 
			"lights_on": randf() > 0.25
		})


	for i in range(18):
		var is_runner: = (i % 15 == 0)
		var fights_back: = randf() < 0.5
		title_pedestrians.append({
			"x": randf_range(-60, VIEW_SIZE.x), 
			"speed": randf_range(20, 55), 
			"color": Color.from_hsv(randf(), randf_range(0.0, 0.18), randf_range(0.12, 0.32)), 
			"hp": 2, 
			"running": is_runner, 
			"base_speed": randf_range(20, 55), 
			"target_index": -1, 
			"attack_cooldown": 0.0, 
			"fights_back": fights_back, 
			"fleeing": false, 
			"down_time": 0.0
		})


	for i in range(5):
		title_steam_vents.append({
			"x": 150.0 + i * 220.0, 
			"y": 450.0, 
			"particle_timer": 0.0, 
			"particles": []
		})

func roster_play_rect() -> Rect2:
	return Rect2(875, 425, 330, 58)

func roster_delete_rect() -> Rect2:
	return Rect2(875, 495, 330, 52)

func roster_back_rect() -> Rect2:
