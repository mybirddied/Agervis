func transition_release_event_matches_action(event: InputEvent, action: StringName) -> bool:
	return InputMap.event_is_action(event, action, false)

func track_movement_input_source(event: InputEvent) -> void :
	var actions: Array[StringName] = [&"move_left", &"move_right", &"move_up", &"move_down", &"sprint"]
	if event is InputEventKey or event is InputEventJoypadButton:
		for action in actions:
			if InputMap.event_is_action(event, action, false):
				if event.is_pressed():
					movement_input_sources_down[action] = true
				else:
					movement_input_sources_down.erase(action)
				return
	if event is InputEventJoypadMotion:
		var motion: = event as InputEventJoypadMotion
		if motion.axis not in [JOY_AXIS_LEFT_X, JOY_AXIS_LEFT_Y]:
			return



		if absf(motion.axis_value) <= 0.28:
			if motion.axis == JOY_AXIS_LEFT_X:
				movement_input_sources_down.erase(&"move_left")
				movement_input_sources_down.erase(&"move_right")
			else:
				movement_input_sources_down.erase(&"move_up")
				movement_input_sources_down.erase(&"move_down")
			return
		for action in actions:
			if not InputMap.event_is_action(event, action, false):
				continue
			if absf(motion.axis_value) > 0.38:
				movement_input_sources_down[action] = true
			else:
				movement_input_sources_down.erase(action)

func track_transition_movement_release(event: InputEvent) -> void :
	if not transition_input_suppressed:
		return
	if event is InputEventScreenTouch and not (event as InputEventScreenTouch).pressed:
		var touch: = event as InputEventScreenTouch
		if touch.index == transition_suppressed_joystick_touch:
			transition_suppressed_joystick_touch = -1
		if touch.index == transition_suppressed_sprint_touch:
			transition_suppressed_sprint_touch = -1
		return
	if event is InputEventKey and not (event as InputEventKey).pressed:
		for action in [&"move_left", &"move_right", &"move_up", &"move_down", &"sprint"]:
			if transition_required_movement_actions.has(action) and transition_release_event_matches_action(event, action):
				transition_required_movement_actions.erase(action)
		return
	if event is InputEventJoypadButton and not (event as InputEventJoypadButton).pressed:
		for action in [&"move_left", &"move_right", &"move_up", &"move_down", &"sprint"]:
			if transition_required_movement_actions.has(action) and transition_release_event_matches_action(event, action):
				transition_required_movement_actions.erase(action)
		return
	if event is InputEventJoypadMotion:
		var motion: = event as InputEventJoypadMotion
		if motion.axis in [JOY_AXIS_LEFT_X, JOY_AXIS_LEFT_Y] and absf(motion.axis_value) < 0.28:
			var release_actions: Array[StringName] = []
			if motion.axis == JOY_AXIS_LEFT_X:
				release_actions = [&"move_left", &"move_right"]
			else:
				release_actions = [&"move_up", &"move_down"]
			for action in release_actions:
				transition_required_movement_actions.erase(action)

func begin_mouse_measure_gesture(point: Vector2, force_viewport: bool = false) -> void :
	mouse_measure_pending = true
	mouse_measure_dragging = false
	mouse_measure_first_point = point
	mouse_measure_current_point = point
	mouse_measure_mode = mode
	mouse_measure_force_viewport = force_viewport

func mouse_measurement_enabled() -> bool:
	return Input.is_key_pressed(KEY_CTRL) or mode in [ScreenMode.PLAY, ScreenMode.ADMIN_EDITOR, ScreenMode.TITLE]

func update_mouse_measurement_timer(delta: float) -> void :
	if mouse_measure_timer <= 0.0:
		return
	mouse_measure_timer = maxf(0.0, mouse_measure_timer - delta)
	if mouse_measure_timer <= 0.0:
		clear_mouse_measurement()

func update_mouse_measure_gesture(point: Vector2) -> void :
	if not mouse_measure_pending:
		return
	mouse_measure_current_point = point
	if not mouse_measure_dragging and point.distance_to(mouse_measure_first_point) >= MOUSE_MEASURE_DRAG_THRESHOLD:
		mouse_measure_dragging = true
	if mouse_measure_dragging:
		queue_redraw()

func end_mouse_measure_gesture(point: Vector2) -> void :
	if not mouse_measure_pending:
		return
	mouse_measure_current_point = point
	var was_dragging: = mouse_measure_dragging
	mouse_measure_pending = false
	mouse_measure_dragging = false
	if was_dragging:
		commit_mouse_measurement()
	else:

		if mouse_measure_timer > 0.0 and mouse_measure_rect.has_point(point):
			clear_mouse_measurement()
			queue_redraw()
			return

		if mouse_measure_mode == ScreenMode.SAFETY_NOTICE:
			advance_from_safety_notice()
		elif mouse_measure_mode == ScreenMode.OVERDOSE_AWARENESS:
			advance_from_overdose_awareness()
		else:
			handle_pointer_click(point, false)
	queue_redraw()

func clear_mouse_measurement() -> void :
	mouse_measure_timer = 0.0
	mouse_measure_rect = Rect2()
	mouse_measure_points.clear()
	mouse_measure_coordinate_space = ""
	mouse_measure_first_coordinate = Vector2.ZERO
	mouse_measure_force_viewport = false
	queue_redraw()

func commit_mouse_measurement() -> void :
	var first: = mouse_measure_first_point
	var last: = mouse_measure_current_point
	mouse_measure_rect = Rect2(first, last - first).abs()
	var top_left: = mouse_measure_rect.position
	var top_right: = Vector2(mouse_measure_rect.end.x, mouse_measure_rect.position.y)
	var bottom_left: = Vector2(mouse_measure_rect.position.x, mouse_measure_rect.end.y)
	var bottom_right: = mouse_measure_rect.end
	mouse_measure_points = {"TL": top_left, "TR": top_right, "BL": bottom_left, "BR": bottom_right}
	mouse_measure_mode = mode
	if mouse_measure_force_viewport:
		mouse_measure_coordinate_space = "viewport"
		mouse_measure_first_coordinate = top_left
	elif mode == ScreenMode.PLAY:
		mouse_measure_coordinate_space = "%s:%s world" % [area, visible_room_id()]
		mouse_measure_first_coordinate = screen_to_world(top_left)
		var measured_br: = screen_to_world(bottom_right)
		mouse_measure_points = {"TL": screen_to_world(top_left), "TR": screen_to_world(top_right), "BL": screen_to_world(bottom_left), "BR": measured_br}
	elif mode == ScreenMode.ADMIN_EDITOR:
		mouse_measure_coordinate_space = "%s editor world" % admin_editor_current_room()
		mouse_measure_first_coordinate = admin_editor_canvas_to_world(top_left)
		mouse_measure_points = {"TL": admin_editor_canvas_to_world(top_left), "TR": admin_editor_canvas_to_world(top_right), "BL": admin_editor_canvas_to_world(bottom_left), "BR": admin_editor_canvas_to_world(bottom_right)}
	else:
		mouse_measure_coordinate_space = "screen"
		mouse_measure_first_coordinate = top_left
	mouse_measure_timer = MOUSE_MEASURE_DURATION
	queue_redraw()

func draw_mouse_measurement() -> void :
	var active: = mouse_measure_dragging or mouse_measure_timer > 0.0
	if not active:
		return
	var rect: = mouse_measure_rect if mouse_measure_timer > 0.0 else Rect2(mouse_measure_first_point, mouse_measure_current_point - mouse_measure_first_point).abs()
	var is_viewport: = mouse_measure_coordinate_space == "viewport"
	var fill_color: = Color(0.86, 0.46, 0.23, 0.1) if is_viewport else Color(0.23, 0.86, 0.62, 0.1)
	var border_color: = Color("#e89050") if is_viewport else GOOD
	draw_rect(rect, fill_color, true)
	draw_rect(rect, border_color, false, 2.0)
	var labels: Dictionary = {}
	if mouse_measure_timer > 0.0 and not mouse_measure_points.is_empty():
		labels = mouse_measure_points
	else:
		labels = {"TL": rect.position, "TR": Vector2(rect.end.x, rect.position.y), "BL": Vector2(rect.position.x, rect.end.y), "BR": rect.end}
	var screen_points: = {
		"TL": rect.position, 
		"TR": Vector2(rect.end.x, rect.position.y), 
		"BL": Vector2(rect.position.x, rect.end.y), 
		"BR": rect.end, 
	}
	for key in ["TL", "TR", "BL", "BR"]:
		var point: Vector2 = labels[key]
		var screen_point: Vector2 = screen_points[key]
		var label: = "%s (%d,%d)" % [key, roundi(point.x), roundi(point.y)]
		var label_size: = font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12)
		var label_pos: = screen_point


		var outside: = true
		if key in ["TL", "TR"]:

			label_pos.y -= 4
			if label_pos.y - 12 < 0:

				label_pos.y = screen_point.y + 14
				outside = false
		else:

			label_pos.y += 12
			if label_pos.y + 4 > VIEW_SIZE.y:

				label_pos.y = screen_point.y - 4
				outside = false

		if key in ["TL", "BL"]:

			label_pos.x -= label_size.x + 4
			if label_pos.x < 0:

				label_pos.x = screen_point.x + 4
				outside = false
		else:

			label_pos.x += 4
			if label_pos.x + label_size.x > VIEW_SIZE.x:

				label_pos.x = screen_point.x - label_size.x - 4
				outside = false

		var label_color: = Color("#e89050") if is_viewport else GOOD
		draw_text(label, label_pos, 12, label_color)
	if mouse_measure_timer > 0.0:
		var bottom_right: Vector2 = labels["BR"]
		var delta: = bottom_right - mouse_measure_first_coordinate
		var delta_label: = "BR FROM FIRST (%+d,%+d)" % [roundi(delta.x), roundi(delta.y)]
		var info_color: = Color("#e89050") if is_viewport else ACCENT
		draw_text("MEASURE  %s" % mouse_measure_coordinate_space, Vector2(20, 96), 13, info_color)
		draw_text(delta_label, Vector2(20, 114), 13, info_color)


