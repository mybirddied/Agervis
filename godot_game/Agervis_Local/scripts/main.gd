func draw_item_row(rect: Rect2, item_name: String, selected: bool) -> void :
	var info: = Build7.item_info(item_name)
	var tag: = String(info.get("tag", "CLEAN"))
	var tone: = DANGER if tag in ["DIRTY", "STOLEN"] else ACCENT if tag in ["QUESTIONABLE", "TRUSTED"] else GOOD
	draw_rect(rect, Color("#343a3c") if selected else Color("#202527"))
	draw_rect(rect, tone if selected else Color("#4e5353"), false, 2.0 if selected else 1.0)
	draw_rect(Rect2(rect.position + Vector2(7, 6), Vector2(24, 24)), tone.darkened(0.35))
	draw_centered(item_name.left(1).to_upper(), rect.position + Vector2(19, 24), 13, PAPER)
	draw_text(item_name.left(34), rect.position + Vector2(42, 23), 14, PAPER)
	draw_text(tag, rect.position + Vector2(360, 22), 10, tone)

