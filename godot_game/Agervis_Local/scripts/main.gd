func start_recovery_group() -> void :
	recovery_session = Dictionary(Build9.RECOVERY_SESSIONS[rng.randi_range(0, Build9.RECOVERY_SESSIONS.size() - 1)]).duplicate(true)
	recovery_prompt_index = 0
	recovery_answer_cursor = -1
	recovery_feedback = "Listen first. No answer begins preselected."
	prepare_recovery_prompt()
	mode = ScreenMode.RECOVERY_GROUP

func prepare_recovery_prompt() -> void :
	recovery_answer_map.clear()
	var prompts: Array = recovery_session.get("prompts", [])
	if recovery_prompt_index >= prompts.size(): return
	var prompt: Dictionary = prompts[recovery_prompt_index]
	var answers: Array = prompt.get("answers", [])
	for index in range(answers.size()):
		recovery_answer_map.append({"label": String(answers[index]), "correct": index == int(prompt.get("correct", 0))})
	recovery_answer_map.shuffle()
	recovery_answer_cursor = -1

func handle_recovery_group_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.PLAY
		return
	var index: = numeric_index(key)
	if index >= 0 and index < recovery_answer_map.size(): submit_recovery_answer(index)

func recovery_controller_choice_index(button: int) -> int:
	match button:
		JOY_BUTTON_A: return 0
		JOY_BUTTON_X: return 1
		JOY_BUTTON_Y: return 2
	return -1

func recovery_option_rect(index: int) -> Rect2:
	return Rect2(315, 435 + index * 57, 650, 49)

func handle_recovery_group_pointer(point: Vector2) -> void :
	for index in range(recovery_answer_map.size()):
		if recovery_option_rect(index).has_point(point):
			recovery_answer_cursor = index
			submit_recovery_answer(index)
			return
	if Rect2(1015, 102, 110, 46).has_point(point): mode = ScreenMode.PLAY

func submit_recovery_answer(index: int) -> void :
	if index < 0 or index >= recovery_answer_map.size(): return
	if bool(recovery_answer_map[index]["correct"]):
		recovery_prompt_index += 1
		recovery_feedback = "ATTENTION CONFIRMED  -  THE FORM IS DISAPPOINTED IT WORKED."
		var prompts: Array = recovery_session.get("prompts", [])
		if recovery_prompt_index >= prompts.size():
			mode = ScreenMode.PLAY
			if not online_authority_enforced():
				grant_xp("Medicine", 105)
				grant_xp("Influence", 75)
			complete_sentence_credit("STRUCTURED RECOVERY GROUP")
			notify("SESSION COMPLETE  -  SYMPTOM SUPPORT IS NOT A CURE", GOOD, 4.0)
		else:
			prepare_recovery_prompt()
	else:
		recovery_feedback = "THAT ANSWER WAS AVAILABLE. IT WAS NOT SOMETHING ANYBODY SAID."
		prepare_recovery_prompt()

