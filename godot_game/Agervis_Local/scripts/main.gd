func notify(text: String, color: Color = Color.WHITE, duration: float = 3.0) -> void :
	notification = text
	notification_tone = color
	notification_timer = duration
	if audio_player != null and not audio_player.playing:
		audio_player.stream = tone_danger if color == DANGER else tone_good if color == GOOD else tone_ui
		audio_player.play()

func add_crime(crime: String) -> void :
	crimes.append(crime)
	var witness: = witness_source_here()
	if not witness.is_empty():
		wanted = true
		camera_audit.append(EvidenceRecords.witness_record(
			"WITNESS-%d" % next_evidence_record_id, player_name, 
			crime + " was observed by a nearby person or live camera.", 
			String(witness.get("source_kind", "")), String(witness.get("source_id", "")), 
			area, room_id, player_position, 10, time_stamp(), int(Time.get_unix_time_from_system() * 1000.0)
		))
		next_evidence_record_id += 1

func witness_source_here() -> Dictionary:
	var camera_id: = camera_for_position(area, player_position)
	if not camera_id.is_empty() and camera_feed_mode(camera_id) == "LIVE":
		return {"source_kind": "camera", "source_id": camera_id}
	for actor in actors:
		if actor.area == area and not actor.removed and not actor.downed and actor.distance_to(player_position) <= 205.0:
			return {"source_kind": "resident", "source_id": String(actor.display_name)}
	return {}

func crime_witnessed_here() -> bool:
	return not witness_source_here().is_empty()

func activate_mark() -> void :
