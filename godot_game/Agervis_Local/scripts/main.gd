func update_active_substance_effects(delta: float) -> void :
	var powder: = active_powder_effect()
	if powder.is_empty():
		active_substance_effects.erase("powder")
	elif not player_downed and health > 0.0:
		var regen_multiplier: = 5.0 if speed_mode else 1.0
		health = minf(100.0, health + float(powder.get("health_regen_per_second", 0.0)) * delta * regen_multiplier)

	var food: = active_food_effect()
	if food.is_empty():
		active_substance_effects.erase("food")
	elif not player_downed and health > 0.0:
		var regen_multiplier: = 5.0 if speed_mode else 1.0
		health = minf(100.0, health + float(food.get("health_regen_per_second", 0.0)) * delta * regen_multiplier)

	# Update pharmaceutical/substance buffs and debuffs
	for i in range(active_buffs.size() - 1, -1, -1):
		active_buffs[i]["remaining"] -= delta
		if active_buffs[i]["remaining"] <= 0.0:
			active_buffs.remove_at(i)

	for i in range(active_debuffs.size() - 1, -1, -1):
		active_debuffs[i]["remaining"] -= delta
		if active_debuffs[i]["remaining"] <= 0.0:
			active_debuffs.remove_at(i)

	# Apply per-tick buff/debuff effects
	if not player_downed and health > 0.0:
		var vitality_restore: = get_effect_additive("vitality_restore", 0.0)
		var vitality_drain: = get_effect_additive("vitality_drain", 0.0)
		var vitality_drain_per_tick: = get_effect_additive("vitality_drain_per_tick", 0.0)
		var vitality_regen: = get_effect_additive("vitality_regen", 0.0)

		var net_vitality_change: = (vitality_restore + vitality_drain + vitality_drain_per_tick + vitality_regen) * delta
		health = clampf(health + net_vitality_change, 1.0, 100.0)

	var run_energy_regen: = get_effect_additive("run_energy_regen", 0.0)
	var run_energy_drain: = get_effect_additive("run_energy_drain", 0.0)

	var net_stamina_change: = (run_energy_regen + run_energy_drain) * delta
	stamina = clampf(stamina + net_stamina_change, 0.0, 100.0)

	# Update consumable food HoTs (heal over time)
	for i in range(active_food_hots.size() - 1, -1, -1):
		var hot = active_food_hots[i]
		hot["tick_timer"] -= delta
		if hot["tick_timer"] <= 0.0:
			if not player_downed and health > 0.0:
				var regen_multiplier: = 5.0 if speed_mode else 1.0
				health = minf(100.0, health + float(hot.get("vitality_per_tick", 0.0)) * 100.0 * regen_multiplier)
			hot["tick_timer"] = hot.get("tick_interval", 1.0)
		hot["remaining"] -= delta
		if hot["remaining"] <= 0.0:
			active_food_hots.remove_at(i)

	# Update consumable food DoTs (damage over time)
	for i in range(active_food_dots.size() - 1, -1, -1):
		var dot = active_food_dots[i]
		dot["tick_timer"] -= delta
		if dot["tick_timer"] <= 0.0:
			if not player_downed and health > 0.0:
				health = maxf(0.0, health - float(dot.get("vitality_drain_per_tick", 0.0)) * 100.0)
			dot["tick_timer"] = dot.get("tick_interval", 1.0)
		dot["remaining"] -= delta
		if dot["remaining"] <= 0.0:
			active_food_dots.remove_at(i)

	# Update consumable food buffs (with ramp mechanics)
	for i in range(active_food_buffs.size() - 1, -1, -1):
		var buff = active_food_buffs[i]
		buff["remaining"] -= delta
		if buff["remaining"] <= 0.0:
			# Check for upon_expiration debuff trigger
			if buff.has("debuff_on_expiry"):
				var debuff_data = buff["debuff_on_expiry"]
				apply_food_debuff(debuff_data)
			active_food_buffs.remove_at(i)

	# Decay opioid overdose meter (10 minute window)
	if opioid_dose_count > 0 and opioid_dose_timer > 0.0:
		var time_since_last: = elapsed - opioid_dose_timer
		if time_since_last >= 600.0:  # 10 minutes
			opioid_dose_count = 0
			opioid_dose_timer = 0.0

	# Check for autonomous consumption (fiend behavior)
	for substance_id in addiction_points.keys():
		var addiction_level: = AddictionSystem.get_addiction_level(addiction_points.get(substance_id, 0))
		if addiction_level >= 2:
			var check_result: = AddictionSystem.check_autonomous_consumption(addiction_level, delta, rng)
			if check_result:
				# Fiend behavior triggered - attempt to consume if substance is carried
				attempt_autonomous_substance_use(substance_id)

		# Check for withdrawal effects
		var last_use: = float(addiction_last_use.get(substance_id, 0.0))
		var time_since_use: = elapsed - last_use
		var withdrawal: = AddictionSystem.calculate_withdrawal(substance_id, addiction_level, time_since_use)
		if not withdrawal.is_empty():
			var severity: = String(withdrawal.get("severity", ""))
			var effects: Array = withdrawal.get("effects", [])
			# Apply withdrawal debuffs
			for effect in effects:
				if effect == "health_drain" and not player_downed:
					health = maxf(1.0, health - 0.5 * delta)
				elif effect == "stamina_drain":
					stamina = maxf(0.0, stamina - 1.0 * delta)

func active_stamina_regen_multiplier() -> float:
	var base_multiplier: = float(active_powder_effect().get("stamina_regen_multiplier", 1.0))
	return base_multiplier * 5.0 if speed_mode else base_multiplier

func report_handoff_outcome(item_id: String, outcome: String, detail: String, terminal: bool) -> void :
	if reject_unsupported_online_mutation("LEGACY HANDOFF", false):
		return
	if not handoff_items.has(item_id):
		return
	var handoff: Dictionary = Dictionary(handoff_items[item_id]).duplicate(true)
	if not handoff_belongs_to_active_resident(handoff):
		notify("THAT HANDOFF BELONGS TO A DIFFERENT RESIDENT FILE", DANGER, 3.0)
		return
	handoff["outcome"] = outcome
	if outcome == "WITNESSED":
		handoff["witnessed"] = true
	elif outcome == "TAMPERED WITH":
		handoff["tampered"] = true
	if terminal:
		handoff["state"] = "closed"
		inventory.erase(String(handoff.get("display_name", "")))
		if item_id in ["sealed_dime_bag", "sealed_quarter_bag", "sealed_customer_envelope"] and outcome == "FAILED_TIMEOUT":
			sealed_packages = 0
			var relationship: = moth_relationship()
			relationship["hostile_until_unix_ms"] = max(int(relationship.get("hostile_until_unix_ms", 0)), int(Time.get_unix_time_from_system() * 1000.0) + int(MothContent.HOSTILITY_SECONDS * 1000.0))
			set_local_moth_relationship(relationship)
	handoff_items[item_id] = handoff
	last_handoff_outcome = {"item": String(handoff.get("display_name", item_id)), "outcome": outcome, "detail": detail, "at": elapsed}
	if terminal:
		open_dialog("HANDOFF OUTCOME  -  %s" % outcome, [
			String(handoff.get("display_name", item_id)), 
			detail, 
			"Employer: %s" % String(handoff.get("employer", "UNFILED")), 
		], [])
	else:
		notify("HANDOFF %s  -  %s" % [outcome, detail], DANGER if outcome in ["DELAYED", "TAMPERED WITH", "WITNESSED"] else ACCENT, 4.0)

func mark_carried_handoffs_witnessed(detail: String) -> void :
	for item_variant in handoff_items.keys():
		var item_id: = String(item_variant)
		if carried_handoff(item_id):
			var handoff: Dictionary = Dictionary(handoff_items[item_id])
			if not bool(handoff.get("witnessed", false)):
				report_handoff_outcome(item_id, "WITNESSED", detail, false)

func update_handoffs() -> void :
	for item_variant in handoff_items.keys():
		var item_id: = String(item_variant)
		if not carried_handoff(item_id):
			continue
		var handoff: Dictionary = Dictionary(handoff_items[item_id]).duplicate(true)
		if elapsed >= float(handoff.get("deadline", 0.0)) and not bool(handoff.get("delay_reported", false)):
			handoff["delay_reported"] = true
			handoff_items[item_id] = handoff
			if item_id in ["sealed_dime_bag", "sealed_quarter_bag", "sealed_customer_envelope"]:
				report_handoff_outcome(item_id, "FAILED_TIMEOUT", "The Moth delivery window closed. The handoff is terminal and Moth is unavailable for ten minutes.", true)
			else:
				report_handoff_outcome(item_id, "DELAYED", "The expected arrival window has closed.", false)

func resolve_carried_handoffs(outcome: String, detail: String) -> void :
	var carried_ids: Array[String] = []
	for item_variant in handoff_items.keys():
		var item_id: = String(item_variant)
		if carried_handoff(item_id):
			carried_ids.append(item_id)
	for item_id in carried_ids:
		report_handoff_outcome(item_id, outcome, detail, true)

