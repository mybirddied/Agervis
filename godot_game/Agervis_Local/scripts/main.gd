func _add_body_evidence_effect(record: Dictionary) -> void :
	var evidence_id: = String(record.get("evidence_id", ""))
	if evidence_id.is_empty():
		return
	for existing in body_evidence_effects:
		if String(existing.get("evidence_id", "")) == evidence_id:
			return
	var point_value: Variant = record.get("position", Vector2.ZERO)
	var point: = point_value as Vector2 if point_value is Vector2 else Vector2.ZERO
	body_evidence_effects.append({
		"evidence_id": evidence_id, 
		"outcome_id": String(record.get("outcome_id", "")), 
		"area": String(record.get("area", "")), 
		"room": String(record.get("room_id", "")), 
		"home_instance_id": String(record.get("home_instance_id", "")), 
		"position": point, 
		"target_name": String(record.get("target_name", "Resident")).left(20), 
	})

func _add_blood_evidence_effect(record: Dictionary) -> void :
	var evidence_id: = String(record.get("evidence_id", ""))
	if evidence_id.is_empty():
		return
	for existing in blood_evidence_effects:
		if String(existing.get("evidence_id", "")) == evidence_id:
