func current_skill_classroom_max_level() -> int:
	return maxi(1, int(build10_room_data().get("skill_max_level", 5)))

func current_school_study_record(skill_name: String) -> Dictionary:
	if not is_school_area() or not room_id.begins_with("class_"):
		return {}
	for record in current_room_object_records():
		if String(record.get("action_id", "")) == "school_skill" and String(record.get("skill_name", "")) == skill_name:
			return record.duplicate(true)
	return {}

func open_build10_skill_classroom(skill_name: String) -> void :
	if skill_name not in Rules.SKILLS:
		notify("THIS CLASSROOM LOST ITS CURRICULUM", DANGER, 2.5)
		return
	var current_level: = skill_level(skill_name)
	var classroom_max_level: = current_skill_classroom_max_level()
	var choice_count: = study_choice_count(0, skill_level("Intelligence"), classroom_max_level)
	var options: Array[Dictionary] = []
	if current_level < classroom_max_level:
		options.append({"label": "Take the two-question / %d-choice practical" % choice_count, "id": "build10_skill_" + skill_name.to_lower()})
	options.append({"label": "Return to the hall", "id": "close"})
	open_dialog(skill_name.to_upper() + " CLASSROOM", [
		"Tutorial training can raise this skill to level %d. It does not lock your eventual path." % classroom_max_level, 
		"Both answers must be correct. Wrong answers reduce scholarship credit, so one-button guessing does not pay.", 
		"Current level: %d / %d" % [current_level, classroom_max_level], 
	], options)

func initialize_auto_updater() -> void :

	var AutoUpdaterScript = load("res://scripts/auto_updater.gd")
	if AutoUpdaterScript == null:
		print("Warning: auto_updater.gd not found")
		return

	if auto_updater == null:
		auto_updater = AutoUpdaterScript.new()
		add_child(auto_updater)


	auto_updater.update_available_signal.connect(_on_update_available)
	auto_updater.update_downloaded.connect(_on_update_downloaded)
	auto_updater.update_failed.connect(_on_update_failed)
	auto_updater.no_update_available.connect(_on_no_update_available)

	print("Auto-updater initialized. Current version: %s" % auto_updater.get_current_version())

func _on_update_available(version: String) -> void :
	if update_notification_shown:
		return

	update_notification_shown = true
	print("Update available: version %s" % version)


	var message: = "Version %s is now available. Would you like to update now?" % version
	notify("UPDATE AVAILABLE: v%s" % version, ACCENT, 8.0)


	if auto_updater:
		auto_updater.download_update()

func _on_update_downloaded(path: String) -> void :
	print("Update downloaded to: %s" % path)
	notify("UPDATE READY - RESTARTING...", GOOD, 3.0)


	await get_tree().create_timer(2.0).timeout


	if auto_updater:
		auto_updater.apply_update(path)

func _on_update_failed(error: String) -> void :
	print("Update failed: %s" % error)
	notify("UPDATE CHECK FAILED", DANGER, 3.0)
	update_notification_shown = false

func _on_no_update_available() -> void :
	print("No updates available. Current version is up to date.")
