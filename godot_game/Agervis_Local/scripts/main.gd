func draw_wall_board(rect: Rect2, slate: bool, heading: String) -> void :
	var frame: = Color("#4b3a2b") if not slate else Color("#3c3f36")
	var surface: = Color("#a9814f") if not slate else Color("#2c3630")
	draw_rect(rect.grow(5.0), frame)
	draw_rect(rect.grow(5.0), frame.darkened(0.25), false, 2.0)
	draw_rect(rect, surface)
	draw_rect(Rect2(rect.position, Vector2(rect.size.x, 4.0)), surface.darkened(0.22))
	var seed_base: = int(rect.position.x) + int(rect.position.y) * 7
	if slate:

		for smear in range(4):
			var sy: = rect.position.y + rect.size.y * (0.24 + float(smear) * 0.18)
			var inset: = 10.0 + float(posmod(seed_base + smear * 31, 24))
			draw_line(Vector2(rect.position.x + inset, sy), Vector2(rect.end.x - inset * 0.6, sy), 
				surface.lightened(0.13 + float(smear % 2) * 0.05), 3.0)
		if heading != "":
			draw_centered(heading, Vector2(rect.get_center().x, rect.position.y + 16.0), 9, Color("#d8dccd"))
		draw_rect(Rect2(rect.position.x + 6.0, rect.end.y - 9.0, rect.size.x - 12.0, 5.0), frame.lightened(0.14))
	else:

		for sheet in range(5):
			var sw: = 34.0 + float(posmod(seed_base + sheet * 17, 20))
			var sh: = 26.0 + float(posmod(seed_base + sheet * 23, 18))
			var sx: = rect.position.x + 7.0 + float(posmod(seed_base + sheet * 41, int(maxf(rect.size.x - sw - 14.0, 1.0))))
			var sy: = rect.position.y + 9.0 + float(posmod(seed_base + sheet * 53, int(maxf(rect.size.y - sh - 16.0, 1.0))))
			var paper: = Color("#e6e0cb") if sheet % 3 != 1 else Color("#d8c98f")
			draw_rect(Rect2(sx + 2.0, sy + 2.0, sw, sh), Color(0, 0, 0, 0.22))
			draw_rect(Rect2(sx, sy, sw, sh), paper)
			for line in range(3):
				var ly: = sy + 7.0 + float(line) * (sh - 10.0) / 3.0
				draw_line(Vector2(sx + 4.0, ly), Vector2(sx + sw - 5.0, ly), paper.darkened(0.32), 1.0)
			draw_circle(Vector2(sx + sw * 0.5, sy + 3.0), 2.5, Color("#b4443c") if sheet % 2 == 0 else Color("#3f6b8c"))
		if heading != "":
			var strip: = Rect2(rect.position.x + 4.0, rect.position.y - 2.0, rect.size.x - 8.0, 15.0)
			draw_rect(strip, Color("#2f3a33"))
			draw_centered(heading, strip.get_center() + Vector2(0, 3), 8, Color("#d3d8c6"))



func draw_floor_cabinet(rect: Rect2, tint: Color, glazed: bool) -> void :
	draw_rect(rect, tint.darkened(0.34))
	var body: = rect.grow(-3.0)
	draw_rect(body, tint)

	draw_rect(Rect2(rect.position.x - 3.0, rect.position.y, rect.size.x + 6.0, 8.0), tint.lightened(0.16))
	draw_rect(Rect2(rect.position.x, rect.end.y - 11.0, rect.size.x, 11.0), tint.darkened(0.28))
	var door_w: = (body.size.x - 9.0) * 0.5
	for door in range(2):
		var door_rect: = Rect2(body.position.x + 3.0 + float(door) * (door_w + 3.0), body.position.y + 11.0, door_w, body.size.y - 25.0)
		draw_rect(door_rect, tint.lightened(0.05))
		draw_rect(door_rect, tint.darkened(0.2), false, 2.0)
		var panel: = door_rect.grow(-6.0)
		if glazed:
			var glass: = Rect2(panel.position, Vector2(panel.size.x, panel.size.y * 0.52))
			draw_rect(glass, Color("#8fa9a6"))
			draw_rect(glass, tint.darkened(0.3), false, 2.0)

			for shelf in range(2):
				var shelf_y: = glass.position.y + glass.size.y * (0.42 + float(shelf) * 0.4)
				draw_line(Vector2(glass.position.x + 2.0, shelf_y), Vector2(glass.end.x - 2.0, shelf_y), tint.darkened(0.18), 2.0)
				for box in range(3):
					var bx: = glass.position.x + 4.0 + float(box) * (glass.size.x - 8.0) / 3.0
					var bh: = 8.0 + float(posmod(box * 13 + shelf * 7, 6))
					draw_rect(Rect2(bx, shelf_y - bh, (glass.size.x - 10.0) / 3.0, bh), Color("#e2e5dc").darkened(float(box % 2) * 0.12))

			draw_line(glass.position + Vector2(4.0, glass.size.y - 4.0), glass.position + Vector2(glass.size.x * 0.55, 4.0), Color(1, 1, 1, 0.13), 3.0)
			draw_rect(Rect2(panel.position.x, panel.position.y + panel.size.y * 0.6, panel.size.x, panel.size.y * 0.4), tint.darkened(0.08))
		else:
			draw_rect(panel, tint.darkened(0.07))
			draw_rect(panel, tint.lightened(0.1), false, 1.0)

		var handle_x: = door_rect.end.x - 6.0 if door == 0 else door_rect.position.x + 6.0
		draw_rect(Rect2(handle_x - 1.5, door_rect.get_center().y - 9.0, 3.0, 18.0), Color("#9aa0a2"))
	draw_line(Vector2(body.get_center().x, body.position.y + 11.0), Vector2(body.get_center().x, body.end.y - 14.0), tint.darkened(0.3), 1.0)



func draw_storage_rack(rect: Rect2, tint: Color) -> void :
	draw_rect(rect, Color(0, 0, 0, 0.2))
	var decks: = 4
	var deck_h: = rect.size.y / float(decks)
	for deck in range(decks):
		var deck_y: = rect.position.y + float(deck) * deck_h
		var open_h: = deck_h - 7.0
		draw_rect(Rect2(rect.position.x + 4.0, deck_y + 4.0, rect.size.x - 8.0, open_h), Color("#1b1f1d"))

		var slots: = 3
		for slot in range(slots):
			if posmod(deck * 5 + slot * 3, 4) == 0:
				continue
			var slot_w: = (rect.size.x - 12.0) / float(slots)
			var sx: = rect.position.x + 6.0 + float(slot) * slot_w
			var crate_h: = open_h * (0.5 + float(posmod(deck * 11 + slot * 19, 40)) / 100.0)
			var crate: = Rect2(sx, deck_y + 4.0 + open_h - crate_h, slot_w - 3.0, crate_h)
			var crate_tint: = Color("#8b6f4b").darkened(float(posmod(deck * 7 + slot, 3)) * 0.09)
			draw_rect(crate, crate_tint)
			draw_rect(crate, crate_tint.darkened(0.3), false, 1.0)
			draw_line(Vector2(crate.position.x + 2.0, crate.get_center().y), Vector2(crate.end.x - 2.0, crate.get_center().y), crate_tint.lightened(0.12), 1.0)
		draw_rect(Rect2(rect.position.x, deck_y + deck_h - 5.0, rect.size.x, 5.0), tint)
		draw_line(Vector2(rect.position.x, deck_y + deck_h - 5.0), Vector2(rect.end.x, deck_y + deck_h - 5.0), tint.lightened(0.18), 1.0)
	for upright_x in [rect.position.x, rect.end.x - 6.0]:
		draw_rect(Rect2(upright_x, rect.position.y, 6.0, rect.size.y), tint.darkened(0.1))
		draw_line(Vector2(upright_x + 1.0, rect.position.y), Vector2(upright_x + 1.0, rect.end.y), tint.lightened(0.2), 1.0)
	draw_rect(Rect2(rect.position.x - 2.0, rect.position.y, rect.size.x + 4.0, 6.0), tint.lightened(0.08))

