func update_movement(delta: float) -> void :
	if player_detained or (player_arrested and area != "jail"):
		player_walking = false
		click_move_active = false
		click_interact_when_close = false
		click_move_sprint = false
		mobile_move_vector = Vector2.ZERO
		stamina = minf(max_stamina_value(), stamina + 17.0 * active_stamina_regen_multiplier() * delta)
		return



	if transition_input_suppressed:
		transition_input_suppression_timer += delta
		player_walking = false
		click_move_active = false
		click_interact_when_close = false
		click_move_sprint = false
		mobile_move_vector = Vector2.ZERO
		mobile_sprint_held = false

		if transition_input_suppression_timer > 2.0:
			transition_input_suppressed = false
			transition_input_suppression_timer = 0.0
			transition_required_movement_actions.clear()
			transition_suppressed_joystick_touch = -1
			transition_suppressed_sprint_touch = -1
		elif transition_required_movement_actions.is_empty() and transition_suppressed_joystick_touch < 0 and transition_suppressed_sprint_touch < 0:
			transition_input_suppressed = false
			transition_input_suppression_timer = 0.0
		return
	var input_vector: = Input.get_vector("move_left", "move_right", "move_up", "move_down")
	if mobile_move_vector.length() > input_vector.length():
		input_vector = mobile_move_vector
	if input_vector.length() > 0.01:
		click_move_active = false
		click_interact_when_close = false
	else:
		if click_move_active:
			var remaining: = player_position.distance_to(click_move_target)
			var arrival_radius: = 70.0 if click_interact_when_close else 9.0
			if remaining <= arrival_radius:
				var should_interact: = click_interact_when_close
				click_move_active = false
				click_interact_when_close = false
				click_move_sprint = false
				if should_interact:
					interact()
				return
			input_vector = player_position.direction_to(click_move_target)
	player_walking = input_vector.length() > 0.01
	if input_vector.length() > 0.01:
		input_vector = input_vector.normalized()
		if absf(input_vector.x) > 0.05:
			facing = signf(input_vector.x)
	var sprinting: = (Input.is_action_pressed("sprint") or click_move_sprint or mobile_sprint_held) and stamina > 4.0
	var base_speed: = 275.0 if sprinting else 175.0

	var movement_speed_modifier: = get_effect_additive("movement_speed", 0.0)
	var speed: = base_speed * (1.0 + movement_speed_modifier)

	if "Damaged Knee" in injuries:
		speed *= 0.78
	if sprinting and input_vector.length() > 0.0:
		stamina = maxf(0.0, stamina - 24.0 * delta)
	else:
		stamina = minf(max_stamina_value(), stamina + 17.0 * active_stamina_regen_multiplier() * delta)
	var previous: = player_position
	move_player_with_collision(input_vector * speed * delta)
	if click_move_active and player_position.is_equal_approx(previous):
		click_move_active = false
		click_interact_when_close = false
		click_move_sprint = false
		notify("ROUTE BLOCKED  -  USE DIRECT MOVEMENT OR ANOTHER APPROACH", ACCENT, 2.0)
	if update_automatic_door_transition(input_vector):
		return
	check_jail_edge_transition()
	var bounds: = area_bounds()
	player_position.x = clampf(player_position.x, bounds.x, bounds.z)
	player_position.y = clampf(player_position.y, bounds.y, bounds.w)
	if area in ["street", "rear", "rooftop"]:
		check_ambush_trigger()

func movement_input_is_held() -> bool:
	return Input.is_action_pressed("move_left") or Input.is_action_pressed("move_right") or Input.is_action_pressed("move_up") or Input.is_action_pressed("move_down") or Input.is_action_pressed("sprint") or mobile_joystick_touch >= 0 or mobile_sprint_touch >= 0 or transition_suppressed_joystick_touch >= 0 or transition_suppressed_sprint_touch >= 0

func cancel_transition_movement_input() -> void :


	transition_required_movement_actions.clear()
	for action in movement_input_sources_down.keys():
		transition_required_movement_actions[action] = true
	for action in [&"move_left", &"move_right", &"move_up", &"move_down", &"sprint"]:
		if Input.is_action_pressed(action):
			transition_required_movement_actions[action] = true
	var physical_movement_held: = not transition_required_movement_actions.is_empty() or mobile_joystick_touch >= 0 or mobile_sprint_touch >= 0
	click_move_active = false
	click_interact_when_close = false
	click_move_sprint = false
	mobile_move_vector = Vector2.ZERO
	transition_suppressed_joystick_touch = mobile_joystick_touch
	transition_suppressed_sprint_touch = mobile_sprint_touch
	mobile_joystick_touch = -1
	mobile_sprint_touch = -1
	mobile_sprint_held = false
	controller_axis_latched = false
	pointer_is_down = false
	player_walking = false




	transition_input_suppressed = true
	transition_input_suppression_timer = 0.0

