func mobile_control_label(action: String) -> String:
	if action == "interact" and current_prompt().is_empty():
		return "ACTION"
	match action:
		"item1": return lt_slot_a if not lt_slot_a.is_empty() else "SLOT 1"
		"item2": return lt_slot_b if not lt_slot_b.is_empty() else "SLOT 2"
		"item3": return lt_slot_x if not lt_slot_x.is_empty() else "SLOT 3"
		"item4": return lt_slot_y if not lt_slot_y.is_empty() else "SLOT 4"
		"aim": return "AIM"
		"disposition": return "DISARM"
	return {
		"interact": contextual_action_label(), "attack": "HIT", "climb": "CLIMB / ACT", "menu": "MENU",
	}.get(action, action.to_upper())

func mobile_control_is_disabled(action: String) -> bool:
	match action:
		"interact": return current_prompt().is_empty()
		"disposition": return nearest_downed(94.0) == null and nearest_lan_downed_peer(94.0) <= 0
		"item1": return lt_slot_a.is_empty()
		"item2": return lt_slot_b.is_empty()
		"item3": return lt_slot_x.is_empty()
		"item4": return lt_slot_y.is_empty()
	return false

func mobile_touch_controls_active() -> bool:





	return mobile_controls_enabled and not last_input_controller

func handle_mobile_touch(touch: InputEventScreenTouch) -> void :
	if not mobile_controls_enabled:
		return
	if transition_input_suppressed:
		if not touch.pressed:
			if touch.index == transition_suppressed_joystick_touch:
				transition_suppressed_joystick_touch = -1
			if touch.index == transition_suppressed_sprint_touch:
				transition_suppressed_sprint_touch = -1
		return
	if mode == ScreenMode.ADMIN_EDITOR:
		if touch.pressed:
			if ADMIN_CANVAS_RECT.has_point(touch.position):
				var selected_by_touch: = false
				if admin_editor_tool == "select":
					var room_key: = admin_editor_current_room()
					selected_by_touch = admin_editor.select_at(room_key, admin_editor_canvas_to_world(touch.position))
				admin_editor_touch_drag_index = touch.index
				admin_editor_canvas_action(touch.position)
				admin_editor_touch_dragging = admin_editor_tool == "select" and selected_by_touch and admin_editor.begin_continuous_edit()
			return
		if touch.index == admin_editor_touch_drag_index:
			admin_editor_touch_drag_index = -1
			admin_editor_touch_dragging = false
			admin_editor.end_continuous_edit()
		return
	if mode != ScreenMode.PLAY:
		if touch.pressed:
			handle_pointer_click(touch.position, false)
		return
	if touch.pressed:
		if mobile_touch_controls_active() and touch.position.distance_to(TOUCH_JOYSTICK_CENTER) <= TOUCH_JOYSTICK_RADIUS * 0.9:
			mobile_joystick_touch = touch.index
			mobile_joystick_flick_start_time = Time.get_ticks_msec()
			mobile_joystick_flick_start_vec = Vector2.ZERO
			update_mobile_joystick(touch.position)
			return
		if mobile_touch_controls_active() and touch.position.distance_to(TOUCH_JOYSTICK_CENTER) <= TOUCH_JOYSTICK_RADIUS * 1.35:
			mobile_sprint_touch = touch.index
			mobile_sprint_held = true
			return
		if mobile_touch_controls_active() and handle_mobile_control_press(touch.position):
			return
		begin_pointer_walk(touch.position, true)
	else:
		if touch.index == mobile_joystick_touch:
			mobile_joystick_touch = -1
			mobile_move_vector = Vector2.ZERO
			mobile_joystick_flick_start_vec = Vector2.ZERO
		if touch.index == mobile_sprint_touch:
			mobile_sprint_touch = -1
			mobile_sprint_held = false
		if touch.index == mobile_aim_touch:
			mobile_aim_touch = -1
			aim_mode_active = false

func handle_mobile_drag(drag: InputEventScreenDrag) -> void :
	if transition_input_suppressed:
		return
	if mode == ScreenMode.ADMIN_EDITOR and drag.index == admin_editor_touch_drag_index:
		if ADMIN_CANVAS_RECT.has_point(drag.position) and admin_editor_touch_dragging:
			var selected: = admin_editor.selected_record()
			var selected_position: Variant = selected.get("position", null)
			if selected_position is Vector2:
				var target: = admin_editor_canvas_to_world(drag.position)
				admin_editor.move_selected(target - (selected_position as Vector2))
			admin_editor_controller_cursor = drag.position
			queue_redraw()
		return
	if drag.index == mobile_joystick_touch:
		update_mobile_joystick(drag.position)

func update_mobile_joystick(position: Vector2) -> void:
	var offset: = position - TOUCH_JOYSTICK_CENTER
	var new_vec: = offset.limit_length(TOUCH_JOYSTICK_RADIUS) / TOUCH_JOYSTICK_RADIUS
	if new_vec.length() < 0.16:
		new_vec = Vector2.ZERO

	# Flick-dodge: fast large movement without sprint ring held
	if not mobile_sprint_held and mobile_joystick_flick_start_vec.length() < 0.4 and new_vec.length() >= 0.8:
		var elapsed_ms: float = Time.get_ticks_msec() - mobile_joystick_flick_start_time
		if elapsed_ms < 100.0:
			player_dodge()

	if mobile_joystick_flick_start_vec == Vector2.ZERO and new_vec.length() > 0.1:
		mobile_joystick_flick_start_vec = new_vec
		mobile_joystick_flick_start_time = Time.get_ticks_msec()

	mobile_move_vector = new_vec

func handle_mobile_control_press(point: Vector2) -> bool:
	if contextual_prompt_rect().has_point(point):
		interact()
		return true
	if touch_button_rect("interact").has_point(point):
		interact()
		return true
	if touch_button_rect("attack").has_point(point):
		player_attack()
		return true
	if touch_button_rect("climb").has_point(point):
		vault()
		return true
	if touch_button_rect("aim").has_point(point):
		aim_mode_active = true
		mobile_aim_touch = -1
		return true
	if touch_button_rect("disposition").has_point(point):
		if nearest_lan_downed_peer(94.0) > 0 or nearest_downed(94.0) != null:
			open_disposition()
		return true
	if touch_button_rect("item1").has_point(point):
		activate_lt_slot("down")
		return true
	if touch_button_rect("item2").has_point(point):
		activate_lt_slot("right")
		return true
	if touch_button_rect("item3").has_point(point):
		activate_lt_slot("left")
		return true
	if touch_button_rect("item4").has_point(point):
		activate_lt_slot("up")
		return true
	if touch_button_rect("menu").has_point(point):
		open_game_menu()
		return true
	return false

func draw_mobile_controls() -> void :
	var shell: = Color(0.035, 0.04, 0.045, 0.7)
	var edge: = Color(0.9, 0.71, 0.35, 0.8)
	draw_circle(TOUCH_JOYSTICK_CENTER, TOUCH_JOYSTICK_RADIUS, shell)
	draw_arc(TOUCH_JOYSTICK_CENTER, TOUCH_JOYSTICK_RADIUS, 0, TAU, 32, edge, 3.0)
	var knob: = TOUCH_JOYSTICK_CENTER + mobile_move_vector * (TOUCH_JOYSTICK_RADIUS * 0.58)
	draw_circle(knob, 29, Color(0.2, 0.22, 0.23, 0.88))
	draw_arc(knob, 29, 0, TAU, 24, PAPER, 2.0)
	# Sprint ring around joystick
	var sprint_ring_color: Color = Color(0.9, 0.71, 0.35, 0.55) if mobile_sprint_held else Color(0.9, 0.71, 0.35, 0.22)
	draw_arc(TOUCH_JOYSTICK_CENTER, TOUCH_JOYSTICK_RADIUS * 1.15, 0, TAU, 48, sprint_ring_color, 6.0)

	for action_value in ["interact", "attack", "aim", "disposition", "climb", "item1", "item2", "item3", "item4", "menu"]:
		var action: = String(action_value)
		var rect: = touch_button_rect(action)
		var disabled: = mobile_control_is_disabled(action)
		var held: bool = (action == "aim" and aim_mode_active)
		var fill: Color
		if action == "disposition" and not disabled:
			fill = Color(0.18, 0.32, 0.16, 0.86)
		elif held:
			fill = Color(0.16, 0.22, 0.38, 0.86)
		else:
			fill = shell
		var outline: = DANGER if action == "attack" else edge
		var text_color: = PAPER
		if disabled:
			fill = Color(fill.r * 0.85, fill.g * 0.85, fill.b * 0.85, fill.a * 0.85)
			outline = outline.darkened(0.15)
			text_color = PAPER.darkened(0.15)
		draw_rect(rect, fill)
		draw_rect(rect, outline, false, 2.0)
		draw_centered(mobile_control_label(action), rect.get_center() + Vector2(0, 6), 12, text_color)

func handle_controller_axis_navigation(motion: InputEventJoypadMotion) -> void :
	if motion.axis not in [JOY_AXIS_LEFT_Y, JOY_AXIS_LEFT_X]: return
	if absf(motion.axis_value) < 0.28:
		controller_axis_latched = false
		return
	if mode == ScreenMode.PLAY:
		controller_axis_latched = false
		return
	if controller_axis_latched or absf(motion.axis_value) < 0.72: return
	controller_axis_latched = true
	if mode == ScreenMode.ADMIN_EDITOR:
		var direction: = signf(motion.axis_value)
		if motion.axis == JOY_AXIS_LEFT_X:
			admin_editor_move_controller_cursor(Vector2(direction * ADMIN_CONTROLLER_CURSOR_STEP, 0))
		else:
			admin_editor_move_controller_cursor(Vector2(0, direction * ADMIN_CONTROLLER_CURSOR_STEP))
		return

	if mode == ScreenMode.DIALOG:
		click_move_active = false
		mode = return_mode

func open_feedback(previous_mode: int = ScreenMode.PLAY) -> void :
	return_mode = previous_mode
	feedback_text = ""
	feedback_status = ""
	mode = ScreenMode.FEEDBACK
	if mobile_controls_enabled:
		DisplayServer.virtual_keyboard_show(feedback_text)

func close_feedback() -> void :
	if mobile_controls_enabled:
		DisplayServer.virtual_keyboard_hide()
	mode = return_mode

func handle_feedback_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		close_feedback()
	elif key.keycode == KEY_F2:
		feedback_category = posmod(feedback_category + 1, feedback_categories.size())
	elif key.keycode == KEY_ENTER and key.ctrl_pressed:
		save_feedback(false)
	elif key.keycode == KEY_ENTER and feedback_text.length() < 1200:
		feedback_text += "\n"
	elif key.keycode == KEY_BACKSPACE:
		feedback_text = feedback_text.left(maxi(0, feedback_text.length() - 1))
	elif key.unicode >= 32 and key.unicode <= 1114111 and feedback_text.length() < 1200:
		feedback_text += char(key.unicode)

func handle_feedback_pointer(point: Vector2) -> void :
	for index in range(feedback_categories.size()):
		if Rect2(135 + index * 195, 175, 180, 42).has_point(point):
			feedback_category = index
			return
	if Rect2(185, 555, 250, 55).has_point(point): save_feedback(false)
	elif Rect2(460, 555, 360, 55).has_point(point): save_feedback(true)
	elif Rect2(845, 555, 250, 55).has_point(point): close_feedback()

func feedback_record() -> Dictionary:
	return {
		"created": Time.get_datetime_string_from_system(false, true), 
		"category": feedback_categories[feedback_category], 
		"text": feedback_text.strip_edges(), 
		"build": "Build 11 Private Alpha", 
		"area": area, 
		"position": [round(player_position.x), round(player_position.y)], 
		"input": "touch" if mobile_controls_enabled else "controller" if last_input_controller else "keyboard_mouse", 
		"lan_players": lan_session.connected_player_count(), 
	}

func save_feedback(prepare_email: bool) -> void :
	var clean: = feedback_text.strip_edges()
	if clean.is_empty():
		feedback_status = "TYPE A NOTE FIRST  -  THE FORM CANNOT INFER THE BUG FROM YOUR EXPRESSION"
		return
	var file: = FileAccess.open("user://tester_feedback.jsonl", FileAccess.READ_WRITE)
	if file == null:
		file = FileAccess.open("user://tester_feedback.jsonl", FileAccess.WRITE)
	else:
		file.seek_end()
	if file != null:
		file.store_line(JSON.stringify(feedback_record()))
	feedback_status = "SAVED LOCALLY ON THIS DEVICE"
	if prepare_email:
		var body: = "%s\n\nBuild: Build 11 Private Alpha\nTester: %s\nArea: %s\nPosition: %d, %d\nInput: %s\nPlayers: %d" % [clean, tester_id, area, int(player_position.x), int(player_position.y), "touch" if mobile_controls_enabled else "controller" if last_input_controller else "keyboard/mouse", lan_session.connected_player_count()]
		var uri: = "mailto:mybirddied@gmail.com?subject=%s&body=%s" % [("Agervis tester note  -  " + feedback_categories[feedback_category]).uri_encode(), body.uri_encode()]
		OS.shell_open(uri)
		feedback_status = "SAVED  -  EMAIL APP OPENED; YOU STILL CHOOSE WHETHER TO SEND"

func load_or_create_tester_id() -> String:
	var path: = "user://tester_id.txt"
	if FileAccess.file_exists(path):
		var existing: = FileAccess.get_file_as_string(path).strip_edges()
		if not existing.is_empty(): return existing.left(16)
	var generated: = "T-%04X-%04X" % [rng.randi_range(0, 65535), rng.randi_range(0, 65535)]
	var file: = FileAccess.open(path, FileAccess.WRITE)
	if file != null: file.store_string(generated)
	return generated

func command_line_arguments() -> Array[String]:
	var result: Array[String] = []
	for raw_argument in OS.get_cmdline_args() + OS.get_cmdline_user_args():
		var argument: = String(raw_argument)
		if not result.has(argument):
			result.append(argument)
	return result

