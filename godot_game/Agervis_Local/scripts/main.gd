func clamp_position_to_area(position: Vector2) -> Vector2:
	var bounds: = area_bounds()
	return Vector2(clampf(position.x, bounds.x, bounds.z), clampf(position.y, bounds.y, bounds.w))

func resolve_safe_position(requested: Vector2) -> Vector2:
	var candidate: = clamp_position_to_area(requested)
	if not player_position_hits_solid(candidate):
		return candidate
	var directions: Array[Vector2] = [
		Vector2.RIGHT, Vector2.LEFT, Vector2.DOWN, Vector2.UP, 
		Vector2(1, 1).normalized(), Vector2(-1, 1).normalized(), 
		Vector2(1, -1).normalized(), Vector2(-1, -1).normalized(), 
	]
	for radius in range(24, 241, 24):
		for direction in directions:
			var probe: = clamp_position_to_area(candidate + direction * float(radius))
			if not player_position_hits_solid(probe):
				return probe
	var fallback: = clamp_position_to_area(default_safe_position())
	return fallback if not player_position_hits_solid(fallback) else clamp_position_to_area(Vector2(500, 285))

func parkour_routes() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for source in Build10.PARKOUR_ROUTES:
		if String(source["area"]) != area: continue
		var route: Dictionary = source.duplicate(true)
		var center: = float(route["center"])

		route["obstacle"] = Rect2(center - 58.0, 30.0, 116.0, 105.0)
		result.append(route)
	return result

