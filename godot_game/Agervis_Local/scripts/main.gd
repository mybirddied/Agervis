			{"question": "An order ticket says no onions.", "answers": ["Follow the ticket", "Add onions quietly", "Fold the ticket into food", "Serve it to the grill"]}, 
			{"question": "The cook line is blocked.", "answers": ["Clear the safe route first", "Step over hot pans", "Stack tickets on the floor", "Wait for a customer to solve it"]}, 
			{"question": "A bag has no label.", "answers": ["Match it to the printed ticket", "Use the heaviest bag", "Give it to whoever looks late", "Hide it behind the counter"]}, 
