			for fold in range(3):
				var fold_x: = rect.position.x + 6 + fold * 3
				draw_line(Vector2(fold_x, rect.position.y + 5), Vector2(fold_x, rect.end.y - 5), Color(0.12, 0.09, 0.07, 0.4), 1.0)


		draw_rect(Rect2(rect.position.x - 3, rect.end.y, rect.size.x + 6, 4), Color("#4a5158"))
		draw_rect(Rect2(rect.position.x - 3, rect.end.y, rect.size.x + 6, 1), Color("#5a616a"))
		draw_line(Vector2(rect.position.x - 3, rect.end.y + 4), Vector2(rect.end.x + 3, rect.end.y + 4), Color("#2a2e32"), 1.0)


		if posmod(seed, 2) == 0:
			draw_line(Vector2(rect.position.x + 10, rect.position.y + 6), Vector2(rect.position.x + 18, rect.position.y + 14), Color(0.6, 0.65, 0.7, 0.12), 2.0)
			draw_line(Vector2(rect.position.x + 12, rect.position.y + 8), Vector2(rect.position.x + 16, rect.position.y + 12), Color(0.7, 0.75, 0.8, 0.08), 1.0)


		if lit and posmod(seed, 7) == 0:

			draw_circle(Vector2(rect.position.x + 14, rect.end.y - 6), 4, Color(0.22, 0.32, 0.2, 0.7))
			draw_circle(Vector2(rect.position.x + 16, rect.end.y - 8), 3, Color(0.18, 0.28, 0.16, 0.6))
func draw_building_bush(x: float, width: float, seed_value: int) -> void :

	var bush_count: = 1 if width < 200 else 2
	for i in range(bush_count):
		var bush_x: = x + (width * 0.25) + (i * width * 0.5) if bush_count == 2 else x + width * 0.5
		var bush_y: = 475.0
		var bush_width: = 24.0 + posmod(seed_value + i, 3) * 4.0
		var bush_height: = 18.0 + posmod(seed_value + i, 2) * 3.0


		var planter_rect: = Rect2(bush_x - bush_width * 0.5 - 4, bush_y - 2, bush_width + 8, 8)
		draw_rect(planter_rect.grow(1), Color(0, 0, 0, 0.3))
		draw_rect(planter_rect, Color("#3a2e28"))
		draw_rect(planter_rect, Color("#2a1e18"), false, 1.5)
		draw_line(Vector2(planter_rect.position.x, planter_rect.position.y), Vector2(planter_rect.end.x, planter_rect.position.y), Color("#4a3e38"), 1.0)


		draw_rect(Rect2(planter_rect.position.x + 2, planter_rect.position.y + 2, planter_rect.size.x - 4, 4), Color("#2d2520"))


		var foliage_base: = Color("#2a3d2e")
		var foliage_highlight: = Color("#354a38")
		var foliage_shadow: = Color("#1f2e22")


		for cluster in range(4):
			var angle: = (cluster / 4.0) * TAU
			var cluster_x: = bush_x + cos(angle) * (bush_width * 0.2)
			var cluster_y: = bush_y - bush_height * 0.5 + sin(angle) * (bush_height * 0.15)
			draw_circle(Vector2(cluster_x, cluster_y), bush_width * 0.35, foliage_shadow)


		for cluster in range(5):
			var angle: = (cluster / 5.0) * TAU + 0.3
			var cluster_x: = bush_x + cos(angle) * (bush_width * 0.15)
			var cluster_y: = bush_y - bush_height * 0.5 + sin(angle) * (bush_height * 0.1)
			draw_circle(Vector2(cluster_x, cluster_y), bush_width * 0.3, foliage_base)


		if not low_spec:
			for cluster in range(3):
				var angle: = (cluster / 3.0) * PI - PI * 0.5
				var cluster_x: = bush_x + cos(angle) * (bush_width * 0.1)
				var cluster_y: = bush_y - bush_height * 0.6 + sin(angle) * (bush_height * 0.15)
				draw_circle(Vector2(cluster_x, cluster_y), bush_width * 0.2, foliage_highlight)


			if posmod(seed_value, 2) == 0:
				draw_line(Vector2(bush_x - 2, bush_y - 4), Vector2(bush_x - 6, bush_y - 10), Color("#4a3830"), 1.5)
				draw_line(Vector2(bush_x + 3, bush_y - 3), Vector2(bush_x + 7, bush_y - 8), Color("#4a3830"), 1.5)

