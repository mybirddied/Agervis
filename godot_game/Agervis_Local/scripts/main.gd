func reject_unsupported_online_mutation(action_label: String, show_notice: bool = true) -> bool:
	if not online_authority_enforced():
		return false
	if show_notice:
		notify("%s IS NOT YET ON THE ONLINE LEDGER" % action_label.to_upper(), ACCENT, 2.8)
	return true

func next_economy_transaction_id() -> String:
	economy_request_sequence += 1
	return "TXN-%s-%s-%d-%d-%d" % [
		resident_world_id, handoff_owner_key(), active_slot, Time.get_ticks_msec(), economy_request_sequence, 
	]

func submit_online_economy_request(action: String, payload: Dictionary = {}, requires_transaction: bool = true, context: Dictionary = {}) -> bool:
	if not online_economy_enabled():
		return false
	if not economy_pending_action.is_empty():
		notify("THE LEDGER IS STILL PROCESSING THE LAST REQUEST", ACCENT, 2.2)
		return true
	var request: = payload.duplicate(true)
	request["action"] = action
	request["world_id"] = resident_world_id
	request["account_id"] = handoff_owner_key()
	request["resident_slot"] = active_slot
	if requires_transaction:
		request["transaction_id"] = next_economy_transaction_id()
	economy_pending_action = action
	economy_request_context = context.duplicate(true)
	lan_session.submit_economy_request(request)
	return true

