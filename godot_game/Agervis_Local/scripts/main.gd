func vault() -> void :
	if vault_active or vault_cooldown > 0.0 or player_downed or player_detained or player_arrested:
		return
	if is_school_area() and room_id == "gym_b":
		var gym_interaction: = nearest_room_owned_interaction()
		if String(gym_interaction.get("action_id", "")) == "gym_obstacle":
			begin_gym_obstacle(gym_interaction)
			return
	if area in ["street", "rear", "rooftop"] and try_parkour_route():
		return
	notify("NO VAULTABLE OBSTACLE AHEAD", ACCENT, 1.2)

func begin_vault(destination: Vector2, route_name: String, consume_stamina: bool = true) -> void :
	vault_active = true
	vault_transitioned = false
	vault_start = player_position
	vault_end = destination
	vault_elapsed = 0.0
	vault_duration = 2.0
	vault_arrival_elapsed = 0.0
	vault_route_name = route_name
	vault_cooldown = vault_duration + vault_arrival_duration + 0.25

	if vault_animation_type == "":
		vault_animation_type = "jump"
	var stamina_cost: = float(pending_parkour_route.get("stamina", 18.0))
	if consume_stamina:
		stamina = maxf(0.0, stamina - stamina_cost)
	player_walking = true

func update_vault(delta: float) -> void :
	if vault_transitioned:
		vault_arrival_elapsed = minf(vault_arrival_duration, vault_arrival_elapsed + delta)
		player_walking = false
		if vault_arrival_elapsed >= vault_arrival_duration:
			vault_active = false
			vault_transitioned = false
		return
	vault_elapsed = minf(vault_duration, vault_elapsed + delta)
	var progress: = clampf(vault_elapsed / maxf(vault_duration, 0.01), 0.0, 1.0)
	var eased: = progress * progress * (3.0 - 2.0 * progress)
	player_position = vault_start.lerp(vault_end, eased)
	player_walking = true
	if progress < 1.0:
		return
	player_position = vault_end
	player_walking = false
	vault_transitioned = true
	vault_arrival_elapsed = 0.0
	resolve_vault_landing()
	vault_active = not player_downed

func resolve_vault_landing() -> void :
	if not pending_parkour_route.is_empty():
		var route: = pending_parkour_route.duplicate(true)
		pending_parkour_route.clear()
		if bool(route.get("safe_gym_training", false)):
			resolve_gym_obstacle_landing(route)
			return
		var required: = int(route.get("agility", 1))
		var risk: = float(route.get("risk", 0.05))
		var agility_gap: = maxi(0, required - skill_level("Agility"))
		var fail_chance: = clampf(risk + float(agility_gap) * 0.09, 0.02, 0.72)
		if parkour_failed or rng.randf() < fail_chance:
			parkour_failed = false
			if god_mode:
				notify("CLIMB FAILED - INVINCIBILITY PREVENTED THE LANDING DAMAGE", ACCENT, 2.5)
				return
			health = maxf(0.0, health - 18.0 - required * 3.0)
			spawn_blood(player_position, "fall", 7 + required)
			if health <= 0.0: enter_player_downed("A failed climb ended on terrain instead of dignity.")
			else: notify("CLIMB FAILED - ROUTE, STAMINA, AND AGILITY ALL OBJECT", DANGER, 3.2)
			return
		var target_area: = String(route.get("target_area", area))
		var target_position: Vector2 = route.get("target", player_position)
		var parkour_object_id: = String(route.get("parkour_object_id", route.get("id", "")))
		var repeated_object: = not parkour_object_id.is_empty() and parkour_object_id == last_parkour_object_id
		last_parkour_object_id = parkour_object_id
		if not repeated_object:
			grant_xp("Agility", 35 + required * 12)
			grant_xp("Endurance", 25 + int(float(route.get("stamina", 18.0))))


		enter_area(target_area, target_position, false)
		if repeated_object:
			notify("%s CLEARED - REPEAT ROUTE GRANTS NO XP" % vault_route_name, ACCENT, 3.0)
		else:
			notify("%s CLEARED" % vault_route_name, GOOD, 3.0)
		return
	grant_xp("Agility", 25)
	notify("%s CLEARED" % vault_route_name, GOOD, 2.0)

func begin_endurance_station(record: Dictionary) -> void :
	if not is_school_area() or room_id != "class_endurance":
		return
	if not endurance_training.is_empty():
		notify("FINISH THE CURRENT ENDURANCE DRILL FIRST", ACCENT, 2.5)
		return
	var max_level: = current_skill_classroom_max_level()
	if skill_level("Endurance") >= max_level:
		notify("ENDURANCE TRAINING LIMIT %d REACHED" % max_level, ACCENT, 3.0)
		return
	var stamina_cost: = maxf(0.0, float(record.get("stamina_cost", 8.0)))
	if stamina + 0.001 < stamina_cost:
		notify("REST BEFORE STARTING THIS ENDURANCE DRILL", ACCENT, 3.0)
		return
	if online_authority_enforced():
		submit_online_economy_request("SCHOOL_TRAINING_START", {
			"station_instance_id": String(record.get("instance_id", "")), 
		}, true, {"training_record": record.duplicate(true)})
		return
	stamina = maxf(0.0, stamina - stamina_cost)
	endurance_training = record.duplicate(true)
	endurance_training_elapsed = 0.0
	player_walking = false
	click_move_active = false
	click_interact_when_close = false
	click_move_sprint = false
	mobile_move_vector = Vector2.ZERO
	var duration: = maxf(0.5, float(endurance_training.get("duration_seconds", 3.5)))
	notify("%s STARTED - HOLD THE STATION FOR %.1f SECONDS" % [String(endurance_training.get("label", "ENDURANCE DRILL")), duration], ACCENT, 3.0)

func update_endurance_training(delta: float) -> void :
	if endurance_training.is_empty():
		return
	if not is_school_area() or room_id != "class_endurance" or player_downed or player_detained or player_arrested:
		endurance_training.clear()
		endurance_training_elapsed = 0.0
		return
	player_walking = false
	click_move_active = false
	click_interact_when_close = false
	click_move_sprint = false
	mobile_move_vector = Vector2.ZERO
	var duration: = maxf(0.5, float(endurance_training.get("duration_seconds", 3.5)))
	endurance_training_elapsed = minf(duration, endurance_training_elapsed + maxf(0.0, delta))
	if endurance_training_elapsed < duration:
		return
	var completed: = endurance_training.duplicate(true)
	if online_authority_enforced():
		endurance_training_elapsed = duration
		if economy_pending_action.is_empty():
			submit_online_economy_request("SCHOOL_TRAINING_COMPLETE", {
				"station_instance_id": String(completed.get("instance_id", "")), 
			}, true, {"training_record": completed})
		return
	endurance_training.clear()
	endurance_training_elapsed = 0.0
	var max_level: = current_skill_classroom_max_level()
	if skill_level("Endurance") >= max_level:
		notify("%s COMPLETE - ENDURANCE TRAINING LIMIT %d" % [String(completed.get("label", "ENDURANCE DRILL")), max_level], ACCENT, 3.0)
		return
	var current_xp: = int(skills.get("Endurance", 0))
	var ceiling_xp: = Rules.xp_for_level(max_level + 1) - 1
	var reward: = mini(int(completed.get("xp_reward", 55)), maxi(0, ceiling_xp - current_xp))
	grant_xp("Endurance", reward)
	save_current_character("ENDURANCE STATION")
	notify("%s COMPLETE - ENDURANCE XP +%d" % [String(completed.get("label", "ENDURANCE DRILL")), reward], GOOD, 3.0)

