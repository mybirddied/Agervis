func begin_gym_obstacle(record: Dictionary) -> void :
	if not is_school_area() or room_id != "gym_b" or vault_active or vault_cooldown > 0.0:
		return
	if online_authority_enforced():
		submit_online_economy_request("SCHOOL_TRAINING_START", {
			"station_instance_id": String(record.get("instance_id", "")), 
		}, true, {"training_kind": "agility", "training_record": record.duplicate(true)})
		return
	begin_gym_obstacle_traversal(record, true)

func begin_gym_obstacle_traversal(record: Dictionary, consume_stamina: bool) -> void :
	if not is_school_area() or room_id != "gym_b" or vault_active or vault_cooldown > 0.0:
		return
	var kind: = String(record.get("obstacle_kind", "vault"))
	var point: = record.get("position", player_position) as Vector2
	var destination: = player_position
	match kind:
		"rope":
			destination = Vector2(point.x, 142.0 if player_position.y >= 185.0 else 255.0)
			facing = 1.0
			vault_animation_type = "climb"
		"ledge":
			var ledge_direction: = 1.0 if player_position.x <= point.x else -1.0
			destination = Vector2(point.x + ledge_direction * 125.0, 185.0)
			facing = ledge_direction
			vault_animation_type = "balance"
		_:
			var vault_direction: = 1.0 if player_position.x <= point.x else -1.0
			destination = Vector2(point.x + vault_direction * 115.0, 225.0)
			facing = vault_direction
			vault_animation_type = "jump"
	destination = clamp_position_to_area(destination)
	pending_parkour_route = {
		"safe_gym_training": true, 
		"parkour_object_id": String(record.get("training_id", record.get("instance_id", "gym_obstacle"))), 
		"station_instance_id": String(record.get("instance_id", "")), 
		"label": String(record.get("label", "AGILITY OBSTACLE")), 
		"stamina": float(record.get("stamina", 8.0)), 
		"xp_amount": 95, 
		"skill_max_level": current_skill_classroom_max_level(), 
	}
	parkour_failed = false
	begin_vault(destination, String(record.get("label", "AGILITY OBSTACLE")), consume_stamina)
	vault_duration = 1.8 if kind == "rope" else 2.4 if kind == "ledge" else 1.45

func resolve_gym_obstacle_landing(route: Dictionary) -> void :
	var obstacle_id: = String(route.get("parkour_object_id", ""))
	if online_authority_enforced():
		if economy_pending_action.is_empty():
			submit_online_economy_request("SCHOOL_TRAINING_COMPLETE", {
				"station_instance_id": String(route.get("station_instance_id", "")), 
			}, true, {"training_kind": "agility", "training_route": route.duplicate(true)})
		return

	var repeated_object: = not obstacle_id.is_empty() and obstacle_id in last_agility_gym_obstacle_ids

	if not obstacle_id.is_empty():
		last_agility_gym_obstacle_ids.append(obstacle_id)
		if last_agility_gym_obstacle_ids.size() > 2:
			last_agility_gym_obstacle_ids.pop_front()
	if repeated_object:
		self_guidance_text = "I will not earn Agility XP by repeating the same obstacle. I need to use two different stations first."
		self_guidance_timer = 12.0
		notify("%s COMPLETE - CONSECUTIVE REPEAT GRANTS NO XP" % vault_route_name, ACCENT, 3.2)
		return
	var max_level: = maxi(1, int(route.get("skill_max_level", 5)))
	if skill_level("Agility") >= max_level:
		notify("%s COMPLETE - AGILITY TRAINING LIMIT %d" % [vault_route_name, max_level], ACCENT, 3.0)
		return
	var current_xp: = int(skills.get("Agility", 0))
	var ceiling_xp: = Rules.xp_for_level(max_level + 1) - 1
	var reward: = mini(int(route.get("xp_amount", 95)), maxi(0, ceiling_xp - current_xp))
	grant_xp("Agility", reward)
	notify("%s COMPLETE - AGILITY XP +%d" % [vault_route_name, reward], GOOD, 3.0)

func vault_visual_lift() -> float:
	if not vault_active:
		return 0.0
	if vault_transitioned:
		var arrival_progress: = clampf(vault_arrival_elapsed / maxf(vault_arrival_duration, 0.01), 0.0, 1.0)
		return (1.0 - arrival_progress) * 12.0
	var progress: = clampf(vault_elapsed / maxf(vault_duration, 0.01), 0.0, 1.0)

	match vault_animation_type:
		"climb":

			return progress * -80.0
		"balance":

			return sin(progress * PI * 4.0) * 8.0
		_:

			return sin(progress * PI) * 54.0
