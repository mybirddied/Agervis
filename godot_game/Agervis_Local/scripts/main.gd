	var action: = String(result.get("action", economy_pending_action)).to_upper()
	var context: = economy_request_context.duplicate(true)
	economy_pending_action = ""
	economy_request_context.clear()
	var resident_value: Variant = result.get("resident", {})
	if resident_value is Dictionary and not (resident_value as Dictionary).is_empty():
		apply_authoritative_economy_resident(resident_value as Dictionary)
		if action in ["INVENTORY_USE", "SCHOOL_TRAINING_START"]:
			health = clampf(float((resident_value as Dictionary).get("health", health)), 0.0, 100.0)
			stamina = clampf(float((resident_value as Dictionary).get("stamina", stamina)), 0.0, max_stamina_value())
	if action in ["INVENTORY_MOVE", "INVENTORY_SPLIT"]:
		reset_inventory_edit_state()
		equipment_focus = 0
		if not inventory.is_empty():
			equipment_cursor = clampi(int(context.get("destination_display", equipment_cursor)), 0, inventory.size() - 1)
	if not bool(result.get("ok", false)):
		if action == "SCHOOL_TRAINING_COMPLETE" and String(result.get("error_code", "")) in ["NO_TRAINING_ACTION", "TRAINING_ACTION_MISMATCH", "RESIDENT_DISCONNECTED", "RESIDENT_UNAVAILABLE", "WRONG_LOCATION", "TRAINING_INTERRUPTED"]:
			endurance_training.clear()
			endurance_training_elapsed = 0.0
		if action == "SCHOOL_STUDY_COMPLETE":
			education_server_quiz_id = ""
			education_server_desk_instance_id = ""
			education_server_answers.clear()
			mode = ScreenMode.PLAY
		if action in ["COMPLETE_BLOOD_CLEANING", "CANCEL_BLOOD_CLEANING"] and String(result.get("error_code", "")) in ["NO_CLEANING_ACTION", "EVIDENCE_NOT_FOUND", "CLEANING_ACTION_MISMATCH", "RESIDENT_DISCONNECTED"]:
			active_blood_cleaning.clear()
		if action == "CASHIER_TASK_ASSIGN":
			cashier_assignment_retry_at = elapsed + 3.0
		elif action == "CAPONE_TASK_ASSIGN":
			capone_assignment_retry_at = elapsed + 3.0
			if not capone_record.is_empty():
				sync_capone_employment(capone_record)
		elif action == "SERVICE_TASK_ASSIGN":
			var failed_employer: = String(context.get("employer_id", ""))
			if not failed_employer.is_empty():
				task_directors[failed_employer] = {"owner": player_name, "task": "", "variation": 0, "state": "delayed", "retry_at": elapsed + 3.0}
				sync_service_contract()
		refresh_active_task_text()
		notify(economy_result_message(result).to_upper(), DANGER, 3.2)
		return
	var audit: Dictionary = Dictionary(result.get("audit", {}))
	match action:
		"SCHOOL_TRAINING_START":
			var training_value: Variant = context.get("training_record", {})
			if String(audit.get("skill", "Endurance")) == "Agility":
				if training_value is Dictionary:
					begin_gym_obstacle_traversal((training_value as Dictionary).duplicate(true), false)
			else:
				if training_value is Dictionary:
					endurance_training = (training_value as Dictionary).duplicate(true)
				endurance_training_elapsed = 0.0
				player_walking = false
				click_move_active = false
				click_interact_when_close = false
				click_move_sprint = false
				mobile_move_vector = Vector2.ZERO
				var duration: = float(audit.get("duration_seconds", endurance_training.get("duration_seconds", 3.5)))
				notify("%s STARTED - HOLD THE STATION FOR %.1f SECONDS" % [String(endurance_training.get("label", "ENDURANCE DRILL")), duration], ACCENT, 3.0)
		"SCHOOL_TRAINING_COMPLETE":
			var completed_skill: = String(audit.get("skill", "Endurance"))
			var training_reward: = maxi(0, int(audit.get("xp_awarded", 0)))
			if completed_skill == "Agility":
				var completed_route: Dictionary = Dictionary(context.get("training_route", {}))
				var completed_label: = String(completed_route.get("label", "AGILITY OBSTACLE"))
				var training_id: = String(audit.get("training_id", ""))
				if not training_id.is_empty():
					last_agility_gym_obstacle_ids.append(training_id)
					if last_agility_gym_obstacle_ids.size() > 2:
						last_agility_gym_obstacle_ids.pop_front()
				if bool(audit.get("repeated_obstacle", false)):
					self_guidance_text = "I will not earn Agility XP by repeating the same obstacle. I need to use two different stations first."
					self_guidance_timer = 12.0
					notify("%s COMPLETE - CONSECUTIVE REPEAT GRANTS NO XP" % completed_label, ACCENT, 3.2)
				else:
					if training_reward > 0:
						_on_lan_xp_event_received({"peer_id": 0, "skill": "Agility", "amount": training_reward, "area": area, "room_id": room_id, "home_instance_id": home_instance_id, "position": player_position})
					notify("%s COMPLETE - AGILITY XP +%d" % [completed_label, training_reward], GOOD if training_reward > 0 else ACCENT, 3.0)
			else:
				var completed_label: = String(endurance_training.get("label", "ENDURANCE DRILL"))
				endurance_training.clear()
				endurance_training_elapsed = 0.0
				if training_reward > 0:
					_on_lan_xp_event_received({"peer_id": 0, "skill": "Endurance", "amount": training_reward, "area": area, "room_id": room_id, "home_instance_id": home_instance_id, "position": player_position})
				notify("%s COMPLETE - ENDURANCE XP +%d" % [completed_label, training_reward], GOOD if training_reward > 0 else ACCENT, 3.0)
		"SCHOOL_PRACTICE_KIT":
			firearms_practice_kit_issued = true
			firearms_dummy_state = "ready"
