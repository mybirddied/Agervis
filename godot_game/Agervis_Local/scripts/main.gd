func classroom_door_placard_is_distressed() -> bool:
	return area == "school" and phase != "tutorial"

func draw_classroom_door_placard(rect: Rect2, skill_name: String, distressed: bool = false) -> void :
	var clean_tone: = skill_door_tone(skill_name)
	var tone: = clean_tone.lerp(Color("#716d61"), 0.48) if distressed else clean_tone
	var placard: = Rect2(rect.position + Vector2(9, 8), Vector2(rect.size.x - 18, 70))
	draw_rect(placard, Color("#24231f") if distressed else Color("#181b1a"))
	if distressed:
		draw_rect(Rect2(placard.position + Vector2(4, 5), Vector2(placard.size.x - 8, 13)), Color("#303029"))
		draw_rect(Rect2(placard.position + Vector2(5, 53), Vector2(placard.size.x - 10, 10)), Color("#171816"))
	draw_rect(placard, tone.darkened(0.18), false, 2.0)
	var icon_center: = Vector2(placard.get_center().x, placard.position.y + 25)
	draw_circle(icon_center, 17.0, Color("#262a28"))
	draw_circle(icon_center, 17.0, tone.darkened(0.22), false, 2.0)
	draw_skill_door_icon(icon_center, skill_name, tone)
	draw_line(Vector2(placard.position.x + 7, placard.position.y + 48), Vector2(placard.end.x - 7, placard.position.y + 48), tone.darkened(0.25), 1.0)
	if distressed:
		var scratch_seed: = absi(skill_name.hash())
		for scratch_index in range(5):
			var scratch_x: = placard.position.x + 7.0 + float((scratch_seed + scratch_index * 17) % 54)
			var scratch_y: = placard.position.y + 6.0 + float((scratch_seed / maxi(1, scratch_index + 1) + scratch_index * 11) % 55)
			draw_line(Vector2(scratch_x, scratch_y), Vector2(scratch_x + 7 + scratch_index % 4, scratch_y - 3 + scratch_index % 3), Color(0.72, 0.69, 0.59, 0.34), 1.0)
		draw_colored_polygon(PackedVector2Array([placard.position, placard.position + Vector2(12, 0), placard.position + Vector2(0, 10)]), Color("#242725"))
		draw_colored_polygon(PackedVector2Array([placard.end, placard.end - Vector2(12, 0), placard.end - Vector2(0, 9)]), Color("#242725"))
		draw_rect(Rect2(placard.position + Vector2(19, -3), Vector2(32, 7)), Color(0.58, 0.51, 0.37, 0.72))
		draw_line(placard.position + Vector2(7, 45), placard.position + Vector2(27, 38), Color("#111311"), 2.0)
		draw_line(placard.position + Vector2(27, 38), placard.position + Vector2(34, 48), Color("#111311"), 2.0)
	draw_centered(skill_name.to_upper(), Vector2(placard.get_center().x + (1.0 if distressed else 0.0), placard.end.y - 8), 7, Color("#bcb6a8") if distressed else PAPER)

func draw_build10_room_architecture() -> void :
	var gym_room: = is_school_area() and room_id in ["gym_a", "gym_b"]
	var aged: = area == "school" and phase != "tutorial"


	var wall_base: Color
	match area:
		"school", "tutorial":
			wall_base = Color("#3f4743") if not aged else Color("#363a37")
		"home":
			wall_base = Color("#3d433e")
		"store", "backroom":
			wall_base = Color("#3a3e3b")
		"bank":
			wall_base = Color("#3c4240")
		"jail":
			wall_base = Color("#383d38")
		"hospital":
			wall_base = Color("#3e4542")
		"apartment":
			wall_base = Color("#3f4340")
		"social":
			wall_base = Color("#3a3d3a")
		"restaurant":
			wall_base = Color("#3d4138")
		_:
			wall_base = Color("#3e4441")

	if not gym_room:

		for seam_x in range(0, 1281, 128):
			draw_line(Vector2(seam_x, ARCH_WALL_TOP), Vector2(seam_x, ARCH_BASEBOARD_Y), Color(0.05, 0.05, 0.045, 0.22), 1)
		if not low_spec:
			for stain_index in range(8):
				var stain_x: = float(60 + (stain_index * 173 + abs(area.hash())) % 1160)
				var stain_y: = float(150 + (stain_index * 47 + abs(room_id.hash())) % 180)
				draw_circle(Vector2(stain_x, stain_y), 12 + stain_index % 18, Color(0.12, 0.08, 0.045, 0.1))



		draw_rect(Rect2(0, ARCH_BASEBOARD_Y, 1280, 15), Color("#171918"))
	for door in build10_room_doors():
		var point: = scene_position(door["point"] as Vector2)
		var rect: = build10_room_door_rect(point)
		draw_rect(rect, Color("#242725"))
		draw_rect(Rect2(rect.position + Vector2(8, 12), rect.size - Vector2(16, 18)), Color("#3e403a"))
		draw_rect(rect, Color("#111312"), false, 5)
		draw_circle(Vector2(rect.end.x - 16, rect.position.y + rect.size.y * 0.66), 4, Color("#a68d52"))
		var classroom_skill: = classroom_skill_name(String(door.get("target", "")))
		if not classroom_skill.is_empty():
			draw_classroom_door_placard(rect, classroom_skill, classroom_door_placard_is_distressed())
		else:
			var label_rect: = Rect2(rect.position + Vector2(8, 9), Vector2(rect.size.x - 16, 34))
			draw_rect(label_rect, Color("#1c1e1c"))
			var label_lines: = wrapped_door_label_lines(String(door["label"]), label_rect.size.x - 4.0)
			var line_height: = 8.0
			var first_baseline: = label_rect.get_center().y - float(label_lines.size() - 1) * line_height * 0.5 + 3.0
			for line_index in range(label_lines.size()):
				draw_centered(label_lines[line_index], Vector2(label_rect.get_center().x, first_baseline + line_index * line_height), 7, PAPER)
	for record in current_room_object_records():
		if String(record.get("render_mode", "")) == "wall_apartment_elevator":
			draw_apartment_elevator(record)

