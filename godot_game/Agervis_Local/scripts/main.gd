func begin_service_assignment(employer_id: String, task_name: String) -> void :
	var object_id: = service_task_object(employer_id, task_name)
	if not task_object_is_visible(object_id):
		notify("THAT ASSIGNMENT IS NOT IN THIS ROOM", DANGER, 2.5)
		return
	var director: Dictionary = Dictionary(task_directors.get(employer_id, {}))
	if String(director.get("owner", "")) != player_name or String(director.get("state", "")) != "assigned":
		notify("THE EMPLOYER HAS NOT ASSIGNED LIVE WORK", ACCENT, 2.5)
		return
	if String(director.get("task", "")) != task_name:
		notify("CURRENT ASSIGNMENT: %s" % String(director.get("task", "")).to_upper(), ACCENT, 2.5)
		return
	open_service_assignment_dialog(employer_id, task_name, int(director.get("variation", 0)))

func open_service_assignment_dialog(employer_id: String, task_name: String, variation: int) -> void :
	var entry: = service_task_question(employer_id, task_name, variation)
	var options: Array[Dictionary] = []
	var answers: Array = entry.get("answers", [])
	for answer_index in range(answers.size()):
		options.append({"label": String(answers[answer_index]), "id": "service_assignment_correct" if answer_index == 0 else "service_assignment_wrong"})
	options.shuffle()
	open_dialog("%s - ASSIGNMENT %d" % [task_name.to_upper(), variation + 1], [String(entry.get("question", "Follow the posted procedure.")), "One wrong answer delays the work. Guessing is unpaid."], options)

func resolve_service_assignment(correct: bool) -> void :
	mode = ScreenMode.PLAY
	var employer_id: = "alibis" if active_job == "Carryout Worker" else "spin_cycle" if active_job == "Laundry Attendant" else ""
	if employer_id.is_empty():
		return
	var director: Dictionary = Dictionary(task_directors.get(employer_id, {})).duplicate(true)
	var task_name: = String(director.get("task", ""))
	if task_name.is_empty() or String(director.get("state", "")) != "assigned":
		return
	if online_economy_enabled():
		if correct:
			submit_online_economy_request("SERVICE_TASK_COMPLETE", {
				"employer_id": employer_id, "task_id": task_name, "interaction_sequence_valid": true, 
			}, true, {"employer_id": employer_id, "task_id": task_name})
		else:
			submit_online_economy_request("SERVICE_TASK_RELEASE", {"employer_id": employer_id}, false, {"employer_id": employer_id, "task_id": task_name})
		return
	if not correct:
		director["state"] = "delayed"
		director["retry_at"] = elapsed + 12.0
		task_directors[employer_id] = director
		sync_service_contract()
		refresh_active_task_text()
		notify("TASK DELAYED - THE EMPLOYER NOTICED THE CONFIDENCE", DANGER, 3.0)
		return
	if employer_id == "alibis":
		restaurant_tasks[task_name] = true
		grant_xp("Enterprise" if task_name == "counter" else "Endurance", 75)
	else:
