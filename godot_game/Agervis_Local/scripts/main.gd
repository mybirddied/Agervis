		open_apartment_elevator(1)
		return true
	if choice_id == "apartment_elevator_page_2":
		open_apartment_elevator(2)
		return true
	if choice_id == "apartment_elevator_page_3":
		open_apartment_elevator(3)
		return true
	if choice_id == "apartment_elevator_page_4":
		open_apartment_elevator(4)
		return true
	if choice_id == "home_access_browse":
		request_home_access_directory(false)
		return true
	if choice_id == "home_access_owner":
		request_home_access_directory(true)
		return true
	if choice_id == "home_access_owner_local":
		open_home_access_owner()
		return true
	if choice_id == "home_access_keys":
		open_home_access_keys()
		return true
	if choice_id.begins_with("home_access_page_"):
		open_home_access_browse(int(choice_id.trim_prefix("home_access_page_")))
		return true
	if choice_id.begins_with("home_access_pending_"):
		notify("VISIT REQUEST PENDING  -  THE OWNER HAS THE NEXT FORM", ACCENT, 3.0)
		return true
	if choice_id.begins_with("home_access_request_"):
		home_access_submit_for_index("HOME_VISIT_REQUEST", int(choice_id.trim_prefix("home_access_request_")))
		return true
	if choice_id.begins_with("home_access_enter_"):
		home_access_submit_for_index("HOME_VISIT_ENTER", int(choice_id.trim_prefix("home_access_enter_")))
		return true
	if choice_id.begins_with("home_access_review_"):
		open_home_access_request_review(int(choice_id.trim_prefix("home_access_review_")))
		return true
	if choice_id.begins_with("home_access_once_"):
		home_access_submit_owner_action("HOME_VISIT_APPROVE_ONCE", int(choice_id.trim_prefix("home_access_once_")))
		return true
	if choice_id.begins_with("home_access_permanent_"):
		home_access_submit_owner_action("HOME_VISIT_APPROVE_PERMANENT", int(choice_id.trim_prefix("home_access_permanent_")))
		return true
	if choice_id.begins_with("home_access_deny_"):
		home_access_submit_owner_action("HOME_VISIT_DENY", int(choice_id.trim_prefix("home_access_deny_")))
		return true
	if choice_id.begins_with("home_access_revoke_"):
		home_access_submit_owner_action("HOME_KEY_REVOKE", int(choice_id.trim_prefix("home_access_revoke_")))
		return true
	if choice_id == "apartment_elevator_home":
		travel_apartment_elevator("unit")
		return true
	if choice_id == "apartment_elevator_roof":
		travel_apartment_elevator("roof")
		return true
	if choice_id.begins_with("apartment_elevator_floor_"):
		var target_floor: = choice_id.trim_prefix("apartment_elevator_floor_")
		travel_apartment_elevator("floor_%s" % target_floor)
		return true
	if choice_id in ["service_assignment_correct", "service_assignment_wrong"]:
		resolve_service_assignment(choice_id == "service_assignment_correct")
		return true
	if choice_id in ["cashier_answer_correct", "cashier_answer_wrong"]:
		resolve_cashier_answer(choice_id == "cashier_answer_correct")
		return true
	if choice_id.begins_with("build10_skill_"):
		var classroom_skill: = choice_id.trim_prefix("build10_skill_").capitalize()
		mode = ScreenMode.PLAY
		if online_authority_enforced():
			var study_record: = current_school_study_record(classroom_skill)
