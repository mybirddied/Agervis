			draw_circle(Vector2( - head_radii.x + 5, -36), 2, Color("#1a3a5a"))
			if not low_spec:
				for detail in range(3):
					draw_circle(Vector2( - head_radii.x + 4 + detail, -38 + detail * 2), 0.8, Color("#2a4a6a"))
		"piercing":

			draw_circle(Vector2(-2, -34), 1.5, ACCENT)
			draw_circle(Vector2(-2, -34), 1.0, ACCENT.lightened(0.2))
		"mohawk pin":

			draw_circle(Vector2(0, -68), 3, ACCENT.darkened(0.2))
			draw_line(Vector2(0, -68), Vector2(0, -76), ACCENT, 2.0)
			draw_circle(Vector2(0, -76), 2, ACCENT.lightened(0.15))
	var upper_label: = label.to_upper()
	if "OFFICER" in upper_label or "PIKE" in upper_label or "GUARD" in upper_label:
		draw_circle(Vector2(10, -11), 4.5, ACCENT)
		draw_arc(Vector2(0, -58), 17, PI, TAU, 12, Color("#20262d"), 6)
	elif upper_label == "BOSS": draw_rect(Rect2(-13, -13, 26, 28), Color(0.72, 0.67, 0.57, 0.72), true)
	elif "VEX" in upper_label: draw_arc(Vector2(0, -54), 17, PI, TAU, 12, Color("#181a1d"), 9)
	elif "NICO" in upper_label: draw_line(Vector2(-12, -26), Vector2(15, 11), Color("#282321"), 4)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	draw_centered(label, point + Vector2(0, -82 * depth_scale * stature_scale - vault_lift), 12, PAPER)
func active_attack_weapon() -> String:
	for item_name in ["Worn Revolver", "Pipe Wrench", "Bolt Cutters", "Box Cutter", "Kitchen Knife", "Baseball Bat", "Crowbar", "Tire Iron"]:
		if item_name in inventory:
			return item_name
	return "Fists"

func draw_attack_weapon(item_name: String, hand: Vector2) -> void :
	match item_name:
		"Worn Revolver":

			draw_rect(Rect2(hand + Vector2(-2, -5), Vector2(21, 7)), Color("#222527"))
			draw_line(hand + Vector2(-2, -4), hand + Vector2(19, -4), Color("#323537"), 2.0)
			draw_line(hand + Vector2(-2, 1), hand + Vector2(19, 1), Color("#121517"), 1.5)

			draw_rect(Rect2(hand + Vector2(14, -3), Vector2(11, 3)), Color("#111315"))
			draw_line(hand + Vector2(15, -2), hand + Vector2(24, -2), Color("#212325"), 0.8)
			draw_circle(hand + Vector2(17, -1), 1.0, Color("#0a0c0d"))
			draw_circle(hand + Vector2(20, -1), 1.0, Color("#0a0c0d"))
			draw_circle(hand + Vector2(23, -1), 1.0, Color("#0a0c0d"))

			draw_line(hand + Vector2(6, 1), hand + Vector2(9, 11), Color("#4c4038"), 5.0)
			for grip_line in range(3):
				draw_line(hand + Vector2(6.5, 3 + grip_line * 2.5), hand + Vector2(8.5, 3 + grip_line * 2.5), Color("#3c3028"), 0.8)

			draw_rect(Rect2(hand + Vector2(10, -6), Vector2(3, 2)), Color("#2a2d2f"))
		"Pipe Wrench":

			draw_line(hand + Vector2(-2, 6), hand + Vector2(19, -13), Color("#6e7471"), 6.0)
			draw_line(hand + Vector2(-1, 5), hand + Vector2(18, -14), Color("#8e9491"), 2.0)
			for grip_notch in range(5):
				var notch_pos: = hand.lerp(hand + Vector2(21, -19), grip_notch / 5.0)
				draw_circle(notch_pos, 1.5, Color("#5e6461"))

			draw_arc(hand + Vector2(20, -14), 7.0, -0.2, 2.1, 8, Color("#9a9e96"), 4.0)
			draw_arc(hand + Vector2(20, -14), 6.0, -0.2, 2.1, 8, Color("#bac2be"), 1.5)

			for tooth in range(3):
				draw_line(hand + Vector2(24 + tooth * 2, -15), hand + Vector2(24 + tooth * 2, -12), Color("#7a7e7b"), 1.2)
		"Bolt Cutters":

			draw_line(hand + Vector2(0, 6), hand + Vector2(17, -12), Color("#863b33"), 4.5)
			draw_line(hand + Vector2(1, 6), hand + Vector2(18, -12), Color("#a64d43"), 1.5)
			draw_line(hand + Vector2(6, 10), hand + Vector2(19, -9), Color("#863b33"), 4.5)
			draw_line(hand + Vector2(7, 10), hand + Vector2(20, -9), Color("#a64d43"), 1.5)

			draw_arc(hand + Vector2(19, -11), 6.0, -0.5, 1.1, 7, Color("#777b75"), 3.0)
			draw_arc(hand + Vector2(19, -11), 5.0, -0.5, 1.1, 7, Color("#979b95"), 1.2)

			for serr in range(4):
				var angle: = -0.5 + serr * 0.4
				var edge_pos: = hand + Vector2(19, -11) + Vector2(cos(angle), sin(angle)) * 5.5
				draw_line(edge_pos, edge_pos + Vector2(cos(angle), sin(angle)) * 1.5, Color("#575b55"), 1.0)

			draw_circle(hand + Vector2(18, -10), 2.5, Color("#4a4e4b"))
			draw_circle(hand + Vector2(18, -10), 1.5, Color("#2a2e2b"))
		"Box Cutter":

			draw_rect(Rect2(hand + Vector2(0, -3), Vector2(16, 5)), Color("#c9ad55"))
			draw_rect(Rect2(hand + Vector2(0, -3), Vector2(16, 5)), Color("#a98d35"), false, 1.0)

			for grip_y in range(3):
				draw_line(hand + Vector2(2, -2 + grip_y * 2), hand + Vector2(14, -2 + grip_y * 2), Color("#a98d35"), 0.6)

			draw_rect(Rect2(hand + Vector2(12, -1), Vector2(3, 1)), Color("#7a6d45"))

			draw_colored_polygon(PackedVector2Array([hand + Vector2(16, -3), hand + Vector2(25, -1), hand + Vector2(16, 2)]), Color("#d8dbd8"))
			draw_line(hand + Vector2(16, -3), hand + Vector2(25, -1), Color("#f8fbf8"), 1.5)
			draw_line(hand + Vector2(25, -1), hand + Vector2(16, 2), Color("#a8aba8"), 1.0)

			for notch in range(3):
				draw_line(hand + Vector2(17 + notch * 2.5, -2.5), hand + Vector2(17 + notch * 2.5, 1.5), Color("#b8bbb8"), 0.5)
		_:
			pass

func draw_exposed_arm(start: Vector2, wrist: Vector2, hand: Vector2, skin: Color, elbow_bend: Vector2, show_hand: bool = true) -> void :
	var elbow: = start.lerp(wrist, 0.52) + elbow_bend

	draw_line(start, elbow, skin.darkened(0.1), 8.2, true)
	draw_line(start, elbow, skin, 6.2, true)
	var bicep: = start.lerp(elbow, 0.58)
	draw_circle(bicep, 4.15, skin)

	if not low_spec:
		draw_circle(bicep + Vector2(-1, -1), 2.5, skin.lightened(0.06))

		var tricep_shadow: = start.lerp(elbow, 0.55) + Vector2(0, 2)
		draw_line(start + Vector2(0, 1), elbow + Vector2(0, 1), skin.darkened(0.18), 2.0)

	draw_line(elbow, wrist, skin.darkened(0.08), 7.5, true)
	draw_line(elbow, wrist, skin, 5.8, true)

	if not low_spec:
		var forearm_mid: = elbow.lerp(wrist, 0.45)
		draw_circle(forearm_mid, 3.2, skin.lightened(0.04))

		draw_line(elbow, wrist, skin.darkened(0.12), 1.2)

	draw_circle(elbow, 3.8, skin.darkened(0.08))
	if not low_spec:
		draw_circle(elbow, 2.5, skin.darkened(0.04))
	if show_hand:

		draw_circle(wrist, 3.2, skin.darkened(0.06))

		var hand_direction: = (hand - wrist).normalized()
		var palm_center: = wrist.lerp(hand, 0.45)

		draw_circle(palm_center, 5.5, skin)
		draw_circle(palm_center, 4.8, skin.lightened(0.03))

		var thumb_base: = palm_center + Vector2( - hand_direction.y * 3, hand_direction.x * 3)
		draw_line(thumb_base, thumb_base + Vector2( - hand_direction.y * 4, hand_direction.x * 4), skin.darkened(0.08), 2.8)
		draw_circle(thumb_base + Vector2( - hand_direction.y * 5, hand_direction.x * 5), 1.8, skin.darkened(0.05))

		for finger_idx in range(4):
			var finger_offset: = -1.5 + finger_idx * 1.0
			var finger_start: = palm_center + Vector2(hand_direction.y * finger_offset, - hand_direction.x * finger_offset)
			var finger_end: = hand + Vector2(hand_direction.y * finger_offset * 0.7, - hand_direction.x * finger_offset * 0.7)

			draw_line(finger_start, finger_end, skin.darkened(0.08), 2.2)

			draw_circle(finger_end, 1.2, skin.darkened(0.06))

			if not low_spec:
				var knuckle: = finger_start.lerp(finger_end, 0.35)
				draw_circle(knuckle, 1.4, skin.darkened(0.04))

		if not low_spec:
			draw_line(palm_center - hand_direction * 2, palm_center + hand_direction * 1, skin.darkened(0.15), 0.8)
			draw_line(palm_center + Vector2( - hand_direction.y * 2, hand_direction.x * 2), palm_center + Vector2(hand_direction.y * 1, - hand_direction.x * 1), skin.darkened(0.12), 0.6)
	draw_circle(bicep + Vector2(-0.7, -0.8), 1.8, skin.lightened(0.035))
	draw_circle(elbow, 3.8, skin)
	draw_line(elbow, wrist, skin.darkened(0.08), 7.2, true)
	draw_line(elbow, wrist, skin.lightened(0.025), 5.2, true)
	if show_hand:
		draw_circle(hand, 5.0, skin.darkened(0.03))
		draw_circle(hand + Vector2(-1.2, -1.4), 2.4, skin.lightened(0.045))
