		return
	var indices: = dvr_event_indices()
	var start: = maxi(0, indices.find(camera_cursor) - 4) if not indices.is_empty() else 0
	for display_index in range(start, mini(indices.size(), start + 8)):
		if Rect2(115, 185 + (display_index - start) * 42, 570, 36).has_point(point):
			camera_cursor = indices[display_index]
			return
	for index in range(6):
		if camera_action_rect(index).has_point(point):
			match index:
				0: export_camera_event()
				1: delete_camera_event()
				2: set_dvr_feed_mode("FROZEN")
				3: set_dvr_feed_mode("DUMMY")
				4: set_dvr_feed_mode("LIVE")
				5: mode = ScreenMode.PLAY
			return

