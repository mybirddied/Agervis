func move_player_with_collision(motion: Vector2) -> void :
	var previous: = player_position
	player_position.x += motion.x
	if player_position_hits_solid(player_position):
		player_position.x = previous.x
	player_position.y += motion.y
	if player_position_hits_solid(player_position):
		player_position.y = previous.y


	var bounds: = area_bounds()
	player_position.y = clampf(player_position.y, bounds.y, bounds.w)

func object_collision_base_band(solid: Rect2) -> Rect2:



	var band_height: = minf(32.0, solid.size.y)
	return Rect2(solid.position.x, solid.end.y - band_height, solid.size.x, band_height)

func player_position_hits_solid(position: Vector2) -> bool:


	var feet: = player_feet_rect(position)
	for solid in solid_rects_for_area():
		if feet.intersects(object_collision_base_band(solid)):
			return true
	if player_position_hits_authored_collision_line(position):
		return true
	return false

func player_position_hits_authored_collision_line(position: Vector2) -> bool:
	if not current_room_is_authored():
		return false
	var feet_center: = player_feet_rect(position).get_center()
	for record in current_room_object_records():
		if String(record.get("record_type", "object")) != "collision_line" or String(record.get("collision_kind", "solid")) != "solid":
			continue
		var points: Variant = record.get("points", [])
		var width: = maxf(1.0, float(record.get("width", 8.0)))
		if not points is Array:
			continue
		for point_index in range((points as Array).size() - 1):
			if not points[point_index] is Vector2 or not points[point_index + 1] is Vector2:
				continue
			var start: = points[point_index] as Vector2
			var finish: = points[point_index + 1] as Vector2
			var segment: = finish - start
			var segment_length_squared: = segment.length_squared()
			var ratio: = 0.0 if is_zero_approx(segment_length_squared) else clampf((feet_center - start).dot(segment) / segment_length_squared, 0.0, 1.0)
			if feet_center.distance_to(start + segment * ratio) <= width * 0.5 + 10.0:
				return true
	return false

func player_feet_rect(position: Vector2 = player_position) -> Rect2:
	return Rect2(position.x - 16.0, position.y - 10.0, 32.0, 20.0)

func stature_scale_for(stature_name: String) -> float:


	match stature_name:
		"child": return 0.7
		"very short": return 0.82
		"short": return 0.9
		"tall": return 1.1
		"very tall": return 1.18
	return 1.0

func sprite_depth_scale(anchor_screen_y: float, render_scale: float = WORLD_FIGURE_RENDER_SCALE) -> float:

	return clampf(0.88 + (anchor_screen_y - 420.0) / 580.0, 0.82, 1.12) * render_scale

func figure_sole_screen_offset(anchor_screen_y: float, stature_name: String = player_stature) -> float:

	return SPRITE_LOCAL_SOLE_Y * sprite_depth_scale(anchor_screen_y) * stature_scale_for(stature_name)

func world_depth_for_screen_y(screen_y: float) -> float:


	if area in EXTERIOR_PROJECTION_AREAS:
		return WORLD_DEPTH_DATUM + (screen_y - SCREEN_Y_DATUM) / WORLD_TO_SCREEN_Y
	return WORLD_DEPTH_DATUM + (screen_y - INTERIOR_SCREEN_Y_DATUM) / INTERIOR_WORLD_TO_SCREEN_Y

func indoor_door_base_screen_y(_stature_name: String = player_stature) -> float:








	return ARCH_FLOOR_Y

func door_threshold_depth(door_base_screen_y: float, stature_name: String = player_stature) -> float:



	var anchor: = door_base_screen_y
	for _pass in range(5):
		anchor = door_base_screen_y - figure_sole_screen_offset(anchor, stature_name)
	var bounds: = area_bounds()
	return clampf(world_depth_for_screen_y(anchor), bounds.y, bounds.w)

