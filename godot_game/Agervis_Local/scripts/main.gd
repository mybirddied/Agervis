func draw_cooking_overlay() -> void :

	draw_rect(Rect2(Vector2.ZERO, VIEW_SIZE), Color(0.02, 0.02, 0.025, 0.4))
	if not low_spec:

		for corner in [Vector2(0, 0), Vector2(VIEW_SIZE.x - 200, 0), Vector2(0, VIEW_SIZE.y - 200), Vector2(VIEW_SIZE.x - 200, VIEW_SIZE.y - 200)]:
			draw_rect(Rect2(corner, Vector2(200, 200)), Color(0, 0, 0, 0.3))

	var rect: = Rect2(320, 160, 640, 400)


	if not low_spec:
		draw_rect(Rect2(rect.position.x + 8, rect.position.y + 8, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.7))
		draw_rect(Rect2(rect.position.x + 6, rect.position.y + 6, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.5))
		draw_rect(Rect2(rect.position.x + 4, rect.position.y + 4, rect.size.x, rect.size.y), Color(0.02, 0.02, 0.025, 0.3))


	var wood_base: = Color("#2d2520")
	draw_rect(rect, wood_base)


	if not low_spec:
		for i in range(20):
			var grain_y: = rect.position.y + i * 20 + randf_range(-2, 2)
			var grain_color: = wood_base.lightened(randf_range(-0.05, 0.08))
			draw_rect(Rect2(rect.position.x, grain_y, rect.size.x, randf_range(1, 3)), grain_color)


	var counter_rect: = Rect2(rect.position.x, rect.position.y, rect.size.x, 80)
	var counter_color: = Color("#3d342d")
	draw_rect(counter_rect, counter_color)
	if not low_spec:

		for i in range(30):
			var gradient_alpha: = (30.0 - i) / 30.0 * 0.15
			draw_rect(Rect2(counter_rect.position.x, counter_rect.position.y + i, counter_rect.size.x, 1), Color(1, 1, 1, gradient_alpha))


	draw_rect(Rect2(counter_rect.position.x, counter_rect.end.y - 3, counter_rect.size.x, 3), counter_color.lightened(0.3))


	var tile_start_y: = rect.position.y + 85
	var tile_size: = 25.0
	for row in range(4):
		for col in range(int(rect.size.x / tile_size) + 1):
			var tile_x: = rect.position.x + col * tile_size
			var tile_y: = tile_start_y + row * tile_size
			var tile_color: = Color("#4a4541") if (row + col) % 2 == 0 else Color("#454038")
			draw_rect(Rect2(tile_x, tile_y, tile_size - 1, tile_size - 1), tile_color)
			if not low_spec:

				draw_rect(Rect2(tile_x, tile_y, tile_size - 1, 3), tile_color.lightened(0.2))



	var burner1_pos: = Vector2(rect.position.x + 80, rect.position.y + 35)
	var burner2_pos: = Vector2(rect.position.x + 150, rect.position.y + 35)
	for burner in [burner1_pos, burner2_pos]:

		draw_circle(burner, 18, Color("#1a1a1a"))
		draw_circle(burner, 16, Color("#2a2a2a"))

		for i in range(4):
			var angle: = i * PI / 2
			var line_end: Vector2 = burner + Vector2(cos(angle), sin(angle)) * 14
			draw_line(burner, line_end, Color("#4a4a4a"), 2.0)

		if cooking_active and not low_spec:
			var flame_pulse: float = 0.6 + 0.4 * abs(sin(elapsed * 8.0 + burner.x))
			draw_circle(burner, 20, Color(1.0, 0.4, 0.1, flame_pulse * 0.3))
			draw_circle(burner, 15, Color(1.0, 0.6, 0.2, flame_pulse * 0.5))


	var pot_x: = rect.position.x + rect.size.x * 0.5
	var pot_y: = rect.position.y + 40

	draw_rect(Rect2(pot_x - 35, pot_y, 70, 25), Color("#3a3a3a"))
	draw_rect(Rect2(pot_x - 40, pot_y + 25, 80, 8), Color("#2a2a2a"))

	draw_circle(Vector2(pot_x - 45, pot_y + 12), 5, Color("#4a4a4a"))
	draw_circle(Vector2(pot_x + 45, pot_y + 12), 5, Color("#4a4a4a"))

	draw_rect(Rect2(pot_x - 38, pot_y - 8, 76, 10), Color("#5a5a5a"))
	draw_circle(Vector2(pot_x, pot_y - 3), 6, Color("#4a4a4a"))

	if cooking_active and not low_spec:
		for i in range(5):
			var steam_x: = pot_x + randf_range(-25, 25)
			var steam_y: float = pot_y - 15 - fmod(elapsed * 30.0 + i * 20.0, 60.0)
			var steam_alpha: float = 0.3 - (fmod(elapsed * 30.0 + i * 20.0, 60.0) / 60.0 * 0.3)
			draw_circle(Vector2(steam_x, steam_y), randf_range(3, 6), Color(0.9, 0.9, 1.0, steam_alpha))


	var rack_x: = rect.position.x + rect.size.x - 120
	var rack_y: = rect.position.y + 30

	draw_line(Vector2(rack_x, rack_y), Vector2(rack_x, rack_y + 35), Color("#6b4423"), 4.0)
	draw_circle(Vector2(rack_x, rack_y + 38), 6, Color("#6b4423"))

	draw_line(Vector2(rack_x + 20, rack_y), Vector2(rack_x + 20, rack_y + 30), Color("#8a8a8a"), 2.0)
	draw_rect(Rect2(rack_x + 15, rack_y + 30, 10, 8), Color("#9a9a9a"))

	draw_line(Vector2(rack_x + 40, rack_y), Vector2(rack_x + 40, rack_y + 25), Color("#7a7a7a"), 2.0)
	for i in range(5):
		var whisk_offset: = (i - 2) * 2
		draw_line(Vector2(rack_x + 40, rack_y + 25), Vector2(rack_x + 40 + whisk_offset, rack_y + 35), Color("#7a7a7a"), 1.0)



	var salt_x: = rect.position.x + 520
	var salt_y: = rect.position.y + 50
	draw_rect(Rect2(salt_x, salt_y, 12, 18), Color("#e8e8e8"))
	draw_circle(Vector2(salt_x + 6, salt_y - 3), 4, Color("#d8d8d8"))
	draw_text("S", Vector2(salt_x + 3, salt_y + 12), 8, Color("#2a2a2a"))

	draw_rect(Rect2(salt_x + 18, salt_y, 12, 18), Color("#2a2a2a"))
	draw_circle(Vector2(salt_x + 24, salt_y - 3), 4, Color("#1a1a1a"))
	draw_text("P", Vector2(salt_x + 21, salt_y + 12), 8, Color("#e8e8e8"))


	var book_x: = rect.position.x + 30
	var book_y: = rect.position.y + rect.size.y - 80
	draw_rect(Rect2(book_x, book_y, 70, 60), Color("#8b4513"))
	draw_rect(Rect2(book_x + 2, book_y + 2, 66, 56), Color("#a0522d"))
	draw_text("RECIPES", Vector2(book_x + 8, book_y + 32), 8, Color("#f4e4c8"))

	for i in range(3):
		draw_line(Vector2(book_x + 35, book_y + i), Vector2(book_x + 70, book_y + i), Color("#f4e4c8"))


	var cooking_color: = Color("#b98555")
	draw_rect(rect, cooking_color.darkened(0.3), false, 5.0)
	draw_rect(rect, cooking_color, false, 3.0)
	if not low_spec:
		draw_rect(rect.grow(-3), cooking_color.lightened(0.3), false, 2.0)
		draw_rect(rect.grow(-6), cooking_color.lightened(0.1), false, 1.0)

		var corner_size: = 15.0
		for corner_offset in [Vector2(0, 0), Vector2(rect.size.x - corner_size, 0), Vector2(0, rect.size.y - corner_size), Vector2(rect.size.x - corner_size, rect.size.y - corner_size)]:
			var corner_pos: Vector2 = rect.position + corner_offset
			draw_rect(Rect2(corner_pos, Vector2(corner_size, corner_size)), cooking_color)


	var title_banner: = Rect2(rect.position.x + 50, rect.position.y + 200, rect.size.x - 100, 50)
	draw_rect(title_banner, Color("#1a1e20"))
	draw_rect(Rect2(title_banner.position.x, title_banner.position.y, title_banner.size.x, 4), cooking_color)
	draw_rect(Rect2(title_banner.position.x, title_banner.end.y - 4, title_banner.size.x, 4), cooking_color)


	var title_text: = "GROUP HOME KITCHEN: %s" % cooking_recipe.to_upper()
	if not low_spec:

		for offset in [Vector2(-1, -1), Vector2(1, -1), Vector2(-1, 1), Vector2(1, 1)]:
			draw_centered(title_text, Vector2(640, 222) + offset, 18, cooking_color.darkened(0.5))
	draw_centered(title_text, Vector2(641, 223), 18, Color("#0a0c0e"))
	draw_centered(title_text, Vector2(640, 222), 18, PAPER)


	var step_text: = "STEP %d / %d" % [cooking_step + 1, cooking_total_steps]
	draw_centered(step_text, Vector2(480, 265), 14, ACCENT)


	var dot_start_x: = 420
	for i in range(cooking_total_steps):
		var dot_x: = dot_start_x + i * 15
		var dot_color: = GOOD if i < cooking_step else (ACCENT if i == cooking_step else Color("#3a3a3a"))
		draw_circle(Vector2(dot_x, 275), 5, dot_color.darkened(0.3))
		draw_circle(Vector2(dot_x, 275), 4, dot_color)
		if i < cooking_step:

			draw_text("✓", Vector2(dot_x - 3, 278), 8, Color("#e8e8e8"))


	var mistakes_x: = 720
	var mistakes_color: = GOOD if cooking_mistakes == 0 else (ACCENT if cooking_mistakes <= 2 else DANGER)
	draw_text("MISTAKES:", Vector2(mistakes_x, 265), 13, Color("#bcb5aa"))
	draw_text("%d" % cooking_mistakes, Vector2(mistakes_x + 75, 265), 16, mistakes_color)

	for i in range(cooking_mistakes):
		var icon_x: = mistakes_x + 95 + i * 15
		draw_text("⚠", Vector2(icon_x, 265), 12, mistakes_color)


	var timer_ratio: = clampf(cooking_timer / cooking_step_duration, 0.0, 1.0)
	var timer_bar: = Rect2(370, 290, 540, 24)


	draw_rect(Rect2(timer_bar.position.x + 3, timer_bar.position.y + 3, timer_bar.size.x, timer_bar.size.y), Color(0, 0, 0, 0.4))
	draw_rect(timer_bar, Color("#0e1012"))
	if not low_spec:
		draw_rect(Rect2(timer_bar.position.x, timer_bar.position.y, timer_bar.size.x, 4), Color("#08090a"))
	draw_rect(timer_bar, Color("#454851"), false, 3.0)
	draw_rect(timer_bar.grow(-2), Color("#353841"), false, 1.0)


	for i in range(10):
		var segment_x: = timer_bar.position.x + (timer_bar.size.x / 10.0) * i
		draw_line(Vector2(segment_x, timer_bar.position.y + 2), Vector2(segment_x, timer_bar.end.y - 2), Color("#555861"), 1.0)


	var timer_fill: = timer_bar.size.x * timer_ratio
	if timer_fill > 0:
		var timer_color: = GOOD if timer_ratio < 0.7 else ACCENT if timer_ratio < 0.9 else DANGER
		var fill_rect: = Rect2(timer_bar.position.x + 3, timer_bar.position.y + 3, timer_fill - 6, timer_bar.size.y - 6)


		draw_rect(fill_rect, timer_color.darkened(0.3))
		if not low_spec:

			for i in range(5):
				var gradient_y: = fill_rect.position.y + i * 3
				var gradient_alpha: = (5.0 - i) / 5.0
				draw_rect(Rect2(fill_rect.position.x, gradient_y, fill_rect.size.x, 2), Color(timer_color.r, timer_color.g, timer_color.b, gradient_alpha * 0.5))


		draw_rect(Rect2(fill_rect.position.x, fill_rect.position.y, fill_rect.size.x, 4), timer_color.lightened(0.4))


		if not low_spec:
			var stripe_offset: = fmod(elapsed * 100.0, 20.0)
			for i in range(int(fill_rect.size.x / 10) + 2):
				var stripe_x: = fill_rect.position.x + i * 20 - stripe_offset
				if stripe_x >= fill_rect.position.x and stripe_x <= fill_rect.end.x:
					draw_rect(Rect2(stripe_x, fill_rect.position.y, 8, fill_rect.size.y), Color(1, 1, 1, 0.1))


		if timer_ratio > 0.85 and not low_spec:
			var pulse: float = abs(sin(elapsed * 10.0)) * 0.6
			draw_rect(fill_rect.grow(2), Color(timer_color.r, timer_color.g, timer_color.b, pulse))

			if timer_ratio > 0.95:
				draw_centered("!!!", Vector2(640 + randf_range(-2, 2), 302 + randf_range(-1, 1)), 14, DANGER)


	var time_remaining: = cooking_step_duration - cooking_timer
	var time_text: = "%.1fs" % time_remaining
	var time_bg: = Rect2(615, 295, 50, 18)
	draw_rect(time_bg, Color("#1a1e20"))
	draw_rect(time_bg, ACCENT, false, 1.0)
	draw_centered(time_text, Vector2(640, 307), 12, PAPER)


	match cooking_challenge_type:
		"timing":
			draw_centered("⏱ TIMING CHALLENGE - HIT THE ZONE ⏱", Vector2(640, 330), 15, ACCENT)
			draw_cooking_timing_challenge()
		"flip":
			draw_centered("🍳 FLIP CHALLENGE - DON'T DROP IT 🍳", Vector2(640, 330), 15, ACCENT)
			draw_cooking_timing_challenge()
		"temperature":
			draw_centered("🔥 TEMPERATURE CONTROL - STOP IN RANGE 🔥", Vector2(640, 330), 15, ACCENT)
			draw_cooking_temperature_challenge()
		"sequence":
			draw_centered("📋 INGREDIENT SEQUENCE - MEMORIZE THE ORDER 📋", Vector2(640, 330), 15, ACCENT)
			draw_cooking_sequence_challenge()


	var controls_panel: = Rect2(780, 490, 170, 60)
	draw_rect(controls_panel, Color("#1a1e20"))
	draw_rect(controls_panel, cooking_color.darkened(0.3), false, 2.0)

	var controls_y: = 505.0
	var controls_x: = 790.0

	if last_input_controller:
		if cooking_challenge_type == "sequence":
			draw_text("D-PAD: SEQUENCE", Vector2(controls_x, controls_y), 10, Color("#bcb5aa"))
		else:
			draw_text("FACE: ACTION", Vector2(controls_x, controls_y), 10, GOOD)
		draw_text("B: ABANDON", Vector2(controls_x, controls_y + 16), 10, DANGER.lightened(0.2))
		draw_text("START: PAUSE", Vector2(controls_x, controls_y + 32), 10, Color("#7a7d72"))
	else:
		if cooking_challenge_type == "sequence":
			draw_text("WASD: SEQUENCE", Vector2(controls_x, controls_y), 10, Color("#bcb5aa"))
		else:
			draw_text("SPACE/E: ACTION", Vector2(controls_x, controls_y), 10, GOOD)
		draw_text("ESC: ABANDON", Vector2(controls_x, controls_y + 16), 10, DANGER.lightened(0.2))
		draw_text("P: PAUSE", Vector2(controls_x, controls_y + 32), 10, Color("#7a7d72"))


	var score_panel: = Rect2(330, 505, 180, 50)
	draw_rect(score_panel, Color("#1a1e20"))
	draw_rect(score_panel, cooking_color.darkened(0.3), false, 2.0)

	var success_rate: = float(cooking_success_count) / float(cooking_step) if cooking_step > 0 else 1.0
	var score_text: = "SUCCESS: %d/%d" % [cooking_success_count, cooking_step]
	var score_color: = GOOD if success_rate >= 0.8 else (ACCENT if success_rate >= 0.5 else DANGER)
	draw_text(score_text, Vector2(340, 520), 12, score_color)


	var stars: = 3 if success_rate >= 0.9 and cooking_mistakes == 0 else (2 if success_rate >= 0.75 else (1 if success_rate >= 0.5 else 0))
	draw_text("RATING:", Vector2(340, 538), 10, Color("#bcb5aa"))
	for i in range(3):
		var star_x: = 395 + i * 18
		var star_color: = Color("#ffd700") if i < stars else Color("#3a3a3a")
		draw_text("★", Vector2(star_x, 538), 12, star_color)


	if cooking_mistakes == 0 and cooking_step > 0:
		draw_text("PERFECT!", Vector2(455, 538), 10, GOOD.lightened(0.3))
		if not low_spec:
			var sparkle_pulse: float = abs(sin(elapsed * 6.0))
			draw_text("✨", Vector2(445, 538), 10, Color(1, 1, 1, sparkle_pulse))


	var difficulty_panel: = Rect2(560, 505, 180, 50)
	draw_rect(difficulty_panel, Color("#1a1e20"))
	draw_rect(difficulty_panel, cooking_color.darkened(0.3), false, 2.0)
	draw_text("DIFFICULTY:", Vector2(570, 520), 10, Color("#bcb5aa"))
	var difficulty_level: = cooking_total_steps
	var diff_text: = "EASY" if difficulty_level <= 3 else ("MEDIUM" if difficulty_level <= 5 else "HARD")
	var diff_color: = GOOD if difficulty_level <= 3 else (ACCENT if difficulty_level <= 5 else DANGER)
	draw_text(diff_text, Vector2(645, 520), 11, diff_color)


	for i in range(5):
		var bar_x: = 570 + i * 24
		var bar_color: = diff_color if i < difficulty_level else Color("#3a3a3a")
		draw_rect(Rect2(bar_x, 535, 18, 10), bar_color)
		draw_rect(Rect2(bar_x, 535, 18, 10), bar_color.lightened(0.3), false, 1.0)








func draw_cooking_timing_challenge() -> void :
	var track: = Rect2(380, 340, 520, 60)


	draw_rect(track, Color("#0e1012"))
	if not low_spec:

		draw_rect(Rect2(track.position.x, track.position.y, track.size.x, 4), Color("#08090a"))
	draw_rect(track, Color("#3a3c3e"), false, 2.0)


	var zone_start: = 0.4 if cooking_challenge_type == "timing" else 0.35
	var zone_width: = 0.2 if cooking_challenge_type == "timing" else 0.3
	var success_zone: = Rect2(380 + 520 * zone_start, 340, 520 * zone_width, 60)


	if not low_spec:
		var glow_pulse: = 0.15 + 0.1 * sin(elapsed * 3.0)
		draw_rect(success_zone.grow(3), Color(GOOD.r, GOOD.g, GOOD.b, glow_pulse))

	draw_rect(success_zone, Color(GOOD.r, GOOD.g, GOOD.b, 0.25))
	draw_rect(success_zone, GOOD, false, 2.5)


