func current_room_is_authored() -> bool:
	return not room_id.is_empty() and area in Build10.ROOM_LAYOUTS and room_id in Build10.room_ids(area)

func apply_admin_room_overlay(room_records: Array[Dictionary]) -> Array[Dictionary]:
	var room_key: = RoomObjects.room_key(area, room_id)
	if not admin_room_overlays.has(room_key):
		return room_records
	var overlay_value: Variant = admin_room_overlays.get(room_key, [])
	if overlay_value is not Array:
		return room_records



	var result: Array[Dictionary] = []
	for value in overlay_value as Array:
		if value is Dictionary and not bool((value as Dictionary).get("deleted", false)):
			result.append((value as Dictionary).duplicate(true))
	return result

func current_room_object_records() -> Array[Dictionary]:
	if not current_room_is_authored():
		return []
	var records: Array[Dictionary] = apply_admin_room_overlay(RoomObjects.records_for(area, room_id, phase))
	if area == "social" and room_id == "lobby":
		var guide_position: = social_lobby_guide_position()
		for index in range(records.size()):
			if String(records[index].get("action_id", "")) == "social_lobby":
				records[index]["position"] = guide_position
				records[index]["depth"] = guide_position.y
	if is_school_area() and (room_id.begins_with("class_") or room_id == "gym_a"):
		var classroom_skill: = classroom_skill_name(room_id)
		for index in range(records.size()):
			if String(records[index].get("action_id", "")) in ["school_teacher", "tutorial_controls_coach"]:
				var teacher_position: = classroom_teacher_position(classroom_skill)
				records[index]["position"] = teacher_position
				records[index]["depth"] = teacher_position.y
	if area == "apartment" and room_id == "unit":
		var customization: = current_player_home_customization()
		if "questionable_couch" in Array(customization.get("furniture", [])):
			records.append({
				"local_id": "questionable_couch", "object_id": "furniture.questionable_couch", "graphic_id": "furniture.questionable_couch.v1", 
