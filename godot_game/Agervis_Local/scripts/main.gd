func draw_admin_collision_line_record(record: Dictionary) -> void :
	var points: Variant = record.get("points", [])
	if not points is Array:
		return
	var width: = maxf(1.0, float(record.get("width", 8.0)))
	var tone: = Color("#d67070") if String(record.get("collision_kind", "solid")) == "solid" else Color("#d8af67")
	for point_index in range((points as Array).size() - 1):
		if points[point_index] is Vector2 and points[point_index + 1] is Vector2:
			draw_line(scene_position(points[point_index] as Vector2), scene_position(points[point_index + 1] as Vector2), tone, width)

func draw_admin_warp_record(record: Dictionary) -> void :
