func draw_locs(hair_color: Color, long_style: bool) -> void :
	draw_arc(Vector2(0, -51), 16, PI + 0.08, TAU - 0.08, 18, hair_color, 6)


	var loc_positions: = [-15.0, -10.0, -5.0, 5.0, 10.0, 15.0]
	for index in range(loc_positions.size()):
		var loc_x: float = loc_positions[index]
		var side: = -1.0 if loc_x < 0.0 else 1.0
		var outside: = absf(loc_x) >= 9.0
		var end_x: = loc_x + side * (8.0 if outside else 6.0)
		var end_y: = (-9.0 + float(index % 3) * 5.0) if long_style else (-27.0 + float(index % 3) * 4.0) if outside else (-35.0 + float(index % 2) * 4.0)
		var strand: = PackedVector2Array([
			Vector2(loc_x * 0.7, -63 + absf(loc_x) * 0.14), 
			Vector2(loc_x + side * 2.0, -55), 
			Vector2(loc_x + side * 5.0, -45), 
			Vector2(end_x, end_y), 
		])
		draw_polyline(strand, hair_color, 3.2, true)
		draw_circle(strand[strand.size() - 1], 1.8, hair_color.darkened(0.08))

		if not low_spec:
			draw_line(strand[1], strand[2], hair_color.lightened(0.1), 1.0)

	draw_polyline(PackedVector2Array([Vector2(-2, -64), Vector2(-6, -72), Vector2(-10, -67)]), hair_color, 3.0, true)
	draw_polyline(PackedVector2Array([Vector2(2, -64), Vector2(7, -70), Vector2(11, -64)]), hair_color, 3.0, true)

func draw_flat_ellipse(center: Vector2, radii: Vector2, color: Color) -> void :
	var points: = PackedVector2Array()
	for index in range(24):
		var angle: = TAU * float(index) / 24.0
		points.append(center + Vector2(cos(angle) * radii.x, sin(angle) * radii.y))
	draw_colored_polygon(points, color)

func draw_camera_icon(point: Vector2, quality: int = 3) -> void :

	var body_dark: = Color("#1a1d1f")
	var body_mid: = Color("#2a2e31")
	var body_light: = Color("#3a3e42")
	var lens_ring: = Color("#4a4f53")
	var lens_glass: = Color("#0f1214")
	var bracket: = Color("#35393c")
	var cable: = Color("#17191b")


	var scale: = 1.0 + (quality - 3) * 0.15


	var bracket_base: = Vector2(point.x, point.y - 8 * scale)
	draw_circle(bracket_base, 7 * scale, bracket.darkened(0.2))
	draw_circle(bracket_base, 7 * scale, body_dark, false, 1.5)
	draw_circle(bracket_base, 5 * scale, bracket)

	if not low_spec:
		draw_circle(bracket_base + Vector2(-3.5 * scale, 0), 1.2 * scale, body_dark)
		draw_circle(bracket_base + Vector2(3.5 * scale, 0), 1.2 * scale, body_dark)

		draw_line(bracket_base + Vector2(-3.5 * scale, -1 * scale), 
			bracket_base + Vector2(-3.5 * scale, 1 * scale), body_light, 0.7)
		draw_line(bracket_base + Vector2(3.5 * scale, -1 * scale), 
			bracket_base + Vector2(3.5 * scale, 1 * scale), body_light, 0.7)


	var arm_start: = bracket_base + Vector2(0, 4 * scale)
	var arm_end: = point + Vector2(-10 * scale, 2 * scale)
	draw_line(arm_start, arm_end, bracket.darkened(0.15), 4 * scale)
	draw_circle(arm_start, 2.5 * scale, bracket.darkened(0.3))
	draw_circle(arm_end, 3 * scale, body_mid)
	draw_circle(arm_end, 3 * scale, body_dark, false, 1.0)


	var body_center: = point
	var body_length: = 24 * scale
	var body_height: = 14 * scale
	var body_rect: = Rect2(body_center.x - body_length * 0.5, body_center.y - body_height * 0.5, 
		body_length, body_height)


	draw_rect(Rect2(body_rect.position.x + 2, body_rect.end.y - 3 * scale, 
		body_rect.size.x - 4, 3 * scale), body_dark.darkened(0.4))


	draw_rect(body_rect, body_mid)
	draw_rect(body_rect, body_dark, false, 1.5)


	draw_rect(Rect2(body_rect.position.x + 2, body_rect.position.y + 1, 
		body_rect.size.x - 4, 2 * scale), body_light)


	if not low_spec:
		var panel_x: = body_rect.position.x + body_rect.size.x * 0.35
		draw_line(Vector2(panel_x, body_rect.position.y + 2), 
			Vector2(panel_x, body_rect.end.y - 2), body_dark.darkened(0.2), 1.0)

		for slot in range(3):
			var slot_x: = body_rect.position.x + 4 + slot * 3 * scale
			draw_line(Vector2(slot_x, body_center.y - 3 * scale), 
				Vector2(slot_x, body_center.y + 3 * scale), body_dark.darkened(0.3), 1.0)


	var lens_center: = Vector2(body_rect.end.x - 6 * scale, body_center.y)
	var lens_outer_radius: = 6 * scale
	var lens_inner_radius: = 4.5 * scale
	var lens_core_radius: = 3 * scale


	draw_circle(lens_center, lens_outer_radius, lens_ring)
	draw_circle(lens_center, lens_outer_radius, body_dark, false, 1.2)


	draw_circle(lens_center, lens_inner_radius, lens_glass.lightened(0.15))
	draw_circle(lens_center, lens_core_radius, lens_glass)


	if not low_spec:
		draw_arc(lens_center + Vector2(-1.5 * scale, -1.5 * scale), lens_core_radius * 0.7, 
			PI * 0.7, PI * 1.2, 8, Color(1, 1, 1, 0.2), 1.5)
		draw_circle(lens_center + Vector2(-2 * scale, -2 * scale), 1.2 * scale, 
			Color(1, 1, 1, 0.25))


	var led_count: = 6
	var led_radius: = lens_outer_radius + 2 * scale
	for i in range(led_count):
		var angle: = (TAU / led_count) * i + PI * 0.25
		var led_pos: = lens_center + Vector2(cos(angle), sin(angle)) * led_radius
		draw_circle(led_pos, 1.3 * scale, Color("#3a1a1c"))

		draw_circle(led_pos, 0.9 * scale, DANGER.darkened(0.3))


	var indicator_pos: = Vector2(body_rect.position.x + 6 * scale, body_rect.position.y + 3 * scale)
	draw_circle(indicator_pos, 1.8 * scale, body_dark.darkened(0.2))
	draw_circle(indicator_pos, 1.3 * scale, DANGER)

	if not low_spec:
		draw_circle(indicator_pos, 2.3 * scale, Color(DANGER.r, DANGER.g, DANGER.b, 0.15))


	var cable_start: = bracket_base + Vector2(0, 7 * scale)
	var cable_end: = cable_start + Vector2(-3 * scale, 12 * scale)
	draw_line(cable_start, cable_end, cable, 2.5 * scale)

	draw_line(cable_start, cable_end, cable.lightened(0.15), 1.0)

func camera_offset_x() -> float:
	return clampf(player_position.x - 640.0, 0.0, STREET_WIDTH - 1280.0) if area in ["street", "rear", "rooftop"] else 0.0

func scene_position(world_point: Vector2) -> Vector2:
	var exterior: = area in EXTERIOR_PROJECTION_AREAS
	var x: = world_point.x - camera_offset_x() if exterior else 130.0 + world_point.x

	var datum: = SCREEN_Y_DATUM if exterior else INTERIOR_SCREEN_Y_DATUM
	var scale: = WORLD_TO_SCREEN_Y if exterior else INTERIOR_WORLD_TO_SCREEN_Y
	var y: = datum + (world_point.y - WORLD_DEPTH_DATUM) * scale
	return Vector2(x, y)

