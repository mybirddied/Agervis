func dialog_uses_overhead_bubble() -> bool:
	if not dialog_bubble_actor_id.is_empty():
		var actor: = actor_by_id(dialog_bubble_actor_id)
		return actor != null and not actor.removed and actor.area == area
	return dialog_bubble_anchor != Vector2.ZERO

func dialog_bubble_world_position() -> Vector2:
	if not dialog_bubble_actor_id.is_empty():
