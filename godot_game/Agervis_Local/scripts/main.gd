func draw_endurance_station(record: Dictionary) -> void :
	var solid: = world_rect_to_screen_rect(record.get("solid_rect", Rect2()) as Rect2)
	var aged: = String(record.get("condition", "clean")) == "aged"
	var frame: = Color("#4d514d") if aged else Color("#526b65")
	var metal: = Color("#73766f") if aged else Color("#a6b5ac")
	var accent: = Color("#815e55") if aged else skill_door_tone("Endurance")
	var active: = String(endurance_training.get("instance_id", "")) == String(record.get("instance_id", ""))
	match String(record.get("station_kind", "weighted_cart")):
		"weighted_cart":
			var cart: = Rect2(solid.position.x + 4, solid.position.y - 54, solid.size.x - 8, 54)
			draw_rect(cart.grow(4), Color("#202321"))
			draw_rect(cart, frame)
			draw_line(cart.position + Vector2(8, 4), cart.position + Vector2(-18, -22), metal, 7.0)
			for crate_index in range(3):
				var crate: = Rect2(cart.position.x + 8 + crate_index * 30, cart.position.y + 10, 25, 30)
				draw_rect(crate, Color("#625a4a") if aged else Color("#8d7958"))
				draw_rect(crate, Color("#2a2c29"), false, 2.0)
				draw_centered(str(10 + crate_index * 5), crate.get_center() + Vector2(0, 4), 8, PAPER)
			for wheel_x in [cart.position.x + 18, cart.end.x - 18]:
				draw_circle(Vector2(wheel_x, cart.end.y + 7), 9.0, Color("#1d201f"))
				draw_circle(Vector2(wheel_x, cart.end.y + 7), 4.0, metal)
			draw_centered("WEIGHTED CART", Vector2(cart.get_center().x, cart.position.y - 11), 8, PAPER)
		_:
			var riser: = Rect2(solid.position.x + 5, solid.position.y - 34, solid.size.x - 10, 34)
			draw_rect(riser.grow(4), Color("#202321"))
			draw_rect(riser, frame)
			var step_offset: = sin(endurance_training_elapsed * 8.0) * 5.0 if active else 0.0
			draw_rect(Rect2(riser.position + Vector2(7, -15 + step_offset), Vector2(34, 14)), accent)
			draw_rect(Rect2(riser.position + Vector2(riser.size.x - 41, -15 - step_offset), Vector2(34, 14)), accent.darkened(0.12))
			draw_line(riser.position + Vector2(riser.size.x * 0.5, 2), riser.position + Vector2(riser.size.x * 0.5, -62), metal, 7.0)
			var timer: = Rect2(riser.get_center().x - 27, riser.position.y - 88, 54, 28)
			draw_rect(timer, Color("#252b29"))
			draw_rect(timer, metal, false, 2.0)
			var remaining: = maxf(0.0, float(record.get("duration_seconds", 5.0)) - endurance_training_elapsed) if active else float(record.get("duration_seconds", 5.0))
			draw_centered("%.1f" % remaining, timer.get_center() + Vector2(0, 4), 10, ACCENT if active else PAPER)
			draw_centered("TIMED STEP", Vector2(riser.get_center().x, timer.position.y - 10), 8, PAPER)
	draw_rect(solid, frame.darkened(0.22))
	if aged:
		draw_line(solid.position + Vector2(12, -18), solid.position + Vector2(33, -24), Color(0.76, 0.7, 0.58, 0.45), 2.0)
	if active:
		var duration: = maxf(0.5, float(record.get("duration_seconds", 3.5)))
		var progress: = clampf(endurance_training_elapsed / duration, 0.0, 1.0)
		var progress_rect: = Rect2(solid.position.x, solid.end.y + 14, solid.size.x, 8)
		draw_rect(progress_rect, Color("#202321"))
		draw_rect(Rect2(progress_rect.position, Vector2(progress_rect.size.x * progress, progress_rect.size.y)), GOOD)

