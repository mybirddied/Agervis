	if mobile_touch_controls_active() and mode == ScreenMode.PLAY:
		draw_mobile_controls()
	match mode:
		ScreenMode.DIALOG: draw_dialog_overlay()
		ScreenMode.QUIZ: draw_quiz_overlay()
		ScreenMode.CAMERA: draw_camera_overlay()
		ScreenMode.DISPOSITION: draw_disposition_overlay()
		ScreenMode.JAIL_TASK: draw_jail_task_overlay()
		ScreenMode.LAUNDRY_SORT: draw_laundry_sort_overlay()
		ScreenMode.RECOVERY_GROUP: draw_recovery_group_overlay()
		ScreenMode.DEATH: draw_death_overlay()
		ScreenMode.CHAT: draw_chat_overlay()
		ScreenMode.ARREST: draw_arrest_overlay()
		ScreenMode.STORAGE: draw_storage_overlay()
		ScreenMode.EQUIPMENT: draw_equipment_overlay()
		ScreenMode.SKILLS: draw_skills_overlay()
		ScreenMode.PHONE: draw_phone_overlay()
		ScreenMode.SHOP: draw_shop_overlay()
		ScreenMode.CONTEXT: draw_context_overlay()
		ScreenMode.SUSPENSE: draw_suspense_overlay()
		ScreenMode.GAME_MENU: draw_game_menu_overlay()
	draw_active_task_strip()
	if radial_wheel_active:
		draw_radial_wheel()

	if mode == ScreenMode.PLAY and last_input_controller:

		if lt_radial_active:
			draw_lt_radial()
		if rt_radial_active:
			draw_rt_radial()
		if contingency_radial_active:
			draw_contingency_radial()
	elif lt_radial_active or rt_radial_active or contingency_radial_active:

		if lt_radial_active:
			draw_lt_radial()
		if rt_radial_active:
			draw_rt_radial()
		if contingency_radial_active:
			draw_contingency_radial()
	draw_mouse_measurement()
	if lightning_active:
		draw_lightning_flash()


	if autoplay_attacks_mode and not autoplay_current_label.is_empty():
		var label_text: = autoplay_current_label
		var label_size: = 12
		var text_size: = font.get_string_size(label_text, HORIZONTAL_ALIGNMENT_LEFT, -1, label_size)
		var label_pos: = Vector2(10, VIEW_SIZE.y - 15)

		draw_rect(Rect2(label_pos.x - 4, label_pos.y - 2, text_size.x + 8, text_size.y + 4), Color(0, 0, 0, 0.6))
		draw_rect(Rect2(label_pos.x - 4, label_pos.y - 2, text_size.x + 8, text_size.y + 4), ACCENT, false, 2.0)
		draw_string(font, label_pos, label_text, HORIZONTAL_ALIGNMENT_LEFT, -1, label_size, Color(0.9, 0.9, 0.9, 0.9))

