		{"label": "Choose another game", "id": "dice_choose_game"}, 
	])

func street_dice_result(player_roll: int, table_roll: int, game_mode: String = "high") -> String:
	match game_mode:
		"low":
			if player_roll < table_roll: return "win"
			if player_roll == table_roll: return "push"
		"pair":
			if player_roll == table_roll: return "win"
		_:
			if player_roll > table_roll: return "win"
			if player_roll == table_roll: return "push"
	return "loss"

func street_dice_payout_multiplier(game_mode: String) -> int:
	return 5 if game_mode == "pair" else 2

func street_dice_settlement(bet: int, player_roll: int, table_roll: int, game_mode: String = "high") -> Dictionary:
	var result: = street_dice_result(player_roll, table_roll, game_mode)
	var payout: = bet if result == "push" else bet * street_dice_payout_multiplier(game_mode) if result == "win" else 0
	return {"result": result, "payout": payout, "money_type": "dirty"}

func street_dice_win_count(game_mode: String) -> int:
	var wins: = 0
	for player_roll in range(1, 7):
		for table_roll in range(1, 7):
			if street_dice_result(player_roll, table_roll, game_mode) == "win":
				wins += 1
	return wins

func play_street_dice(bet: int, game_mode: String = street_dice_mode) -> void :
	if reject_unsupported_online_mutation("STREET DICE"):
		return
	if bet <= 0:
		return
	if dirty_cash < bet:
		notify("NOT ENOUGH DIRTY CASH FOR THE TABLE", DANGER, 2.5)
		return
	var player_roll: = rng.randi_range(1, 6)
	var table_roll: = rng.randi_range(1, 6)
	var settlement: = street_dice_settlement(bet, player_roll, table_roll, game_mode)
	dirty_cash -= bet
	if String(settlement["result"]) == "win":
		dirty_cash += int(settlement["payout"])
		grant_xp("Influence", 20)
		notify("DICE WINS - d6 %d / %d PAID DIRTY $%d" % [player_roll, table_roll, int(settlement["payout"])], GOOD, 3.5)
	elif String(settlement["result"]) == "push":
		dirty_cash += int(settlement["payout"])
		notify("DICE TIES - d6 %d MATCHED %d AND RETURNED DIRTY $%d" % [player_roll, table_roll, bet], ACCENT, 3.0)
	else:
		grant_xp("Awareness", 10)
		notify("DICE LOSES - d6 %d / %d AND DIRTY $%d STAYED" % [player_roll, table_roll, bet], DANGER, 3.5)

func sell_shop_selection() -> void :
	if reject_unsupported_online_mutation("VENDOR SALE"):
		return
	var offer: = selected_shop_offer()
	if offer.is_empty(): return
	var item_name: = String(offer["name"])
	if item_name not in inventory:
		notify("YOU ARE NOT CARRYING %s" % item_name.to_upper(), DANGER, 2.5)
		return
	var quantity: = mini(shop_quantity, inventory.count(item_name))
	var proceeds: = maxi(1, int(offer["price"]) / 2) * quantity
	for unit in range(quantity): inventory.erase(item_name)
	cash += proceeds
	shop_button_flash = 0.22
	shop_confirmation = "SOLD %s x%d  /  RECEIVED CLEAN $%d" % [item_name.to_upper(), quantity, proceeds]
	notify(shop_confirmation, GOOD, 3.0)

func open_dialog(title: String, lines: Array[String], options: Array[Dictionary]) -> void :
	click_move_active = false
