func open_context_menu(screen_point: Vector2) -> void :
	if player_detained or (player_arrested and area != "jail"):
		return
	context_position = Vector2(clampf(screen_point.x, 12.0, 1030.0), clampf(screen_point.y, 82.0, 515.0))
	var hotspot: = hotspot_at_screen(screen_point)
	context_world_position = (hotspot["point"] as Vector2) if not hotspot.is_empty() else clamp_position_to_area(screen_to_world(screen_point))
	context_options.clear()
	if hotspot.is_empty():
		context_options.append_array([
			{"label": "Walk here", "id": "walk"}, {"label": "Sprint here", "id": "sprint"}, 
			{"label": "Inspect area", "id": "inspect"}, {"label": "Cancel", "id": "cancel"}, 
		])
	else:
		context_options.append_array([
			{"label": "Approach " + String(hotspot["label"]), "id": "walk"}, 
			{"label": "Interact", "id": "interact"}, {"label": "Inspect", "id": "inspect"}, 
			{"label": "Cancel", "id": "cancel"}, 
		])
	context_cursor = 0
	mode = ScreenMode.CONTEXT

func handle_context_key(key: InputEventKey) -> void :
	if key.keycode == KEY_ESCAPE:
		mode = ScreenMode.PLAY
	elif key.keycode == KEY_UP:
		context_cursor = posmod(context_cursor - 1, context_options.size())
	elif key.keycode == KEY_DOWN:
		context_cursor = posmod(context_cursor + 1, context_options.size())
	elif key.keycode == KEY_ENTER:
		activate_context_option(context_cursor)

func activate_context_option(index: int) -> void :
	if index < 0 or index >= context_options.size(): return
	var action: = String(context_options[index]["id"])
	mode = ScreenMode.PLAY
	match action:
		"walk", "sprint", "interact":
			click_move_target = context_world_position
			click_move_active = true
			click_move_sprint = action == "sprint"
			click_interact_when_close = action == "interact"
		"inspect": notify("YOU NOTICE WHAT THE BLOCK WAS WILLING TO SHOW FROM HERE", ACCENT, 2.5)
		"cancel": pass

func context_option_rect(index: int) -> Rect2:
	return Rect2(context_position.x, context_position.y + 34 + index * 39, 238, 35)

func quiz_option_rect(index: int) -> Rect2:
