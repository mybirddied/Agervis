func movement_enters_door_facing(movement_direction: Vector2, door_facing: String) -> bool:
	if movement_direction.length_squared() <= 0.0001:
		return false
	var direction: = movement_direction.normalized()
	match door_facing.strip_edges().to_lower():
		"down": return direction.y > 0.2
		"left": return direction.x < -0.2
		"right": return direction.x > 0.2
		_: return direction.y < -0.2

func update_automatic_door_transition(movement_direction: Vector2 = Vector2.ZERO) -> bool:
	var room_door: = nearest_build10_room_door()
	var street_door: = nearest_street_building_door()
	var rear_door: = nearest_rear_service_door()
	var touching_any_door: = not room_door.is_empty() or not street_door.is_empty() or not rear_door.is_empty()
	if not touching_any_door:
		automatic_door_contact_latched = false
		return false
	if automatic_door_contact_latched:
		return true
	var touching_door: Dictionary = room_door if not room_door.is_empty() else street_door if not street_door.is_empty() else rear_door



	if not movement_enters_door_facing(movement_direction, String(touching_door.get("facing", "up"))):
		return false
	automatic_door_contact_latched = true
	click_move_active = false
	click_interact_when_close = false
	click_move_sprint = false
	if not room_door.is_empty():
		return try_build10_room_transition()
	if not street_door.is_empty():
		return try_street_building_door()
	return try_rear_service_door()

func near_parkour_x(world_x: float) -> bool:
	return absf(player_position.x - world_x) <= 92.0

func parkour_route_requires_lower_approach(route: Dictionary) -> bool:
	return String(route.get("kind", "")) in ["dumpster", "fence", "ladder", "fire_escape", "ledge"]

func parkour_route_approach_point(route: Dictionary) -> Vector2:
	return Vector2(float(route["center"]), 245.0 if parkour_route_requires_lower_approach(route) else 235.0)

func parkour_route_can_activate(route: Dictionary) -> bool:
	var approach: = parkour_route_approach_point(route)
	if parkour_route_requires_lower_approach(route):
		return absf(player_position.x - approach.x) <= 44.0 and player_position.y >= 220.0 and player_position.y <= 300.0
	return absf(player_position.x - approach.x) <= 92.0 and absf(player_position.y - approach.y) <= 82.0

func try_parkour_route() -> bool:
	if vault_active or vault_cooldown > 0.0 or player_downed or player_arrested:
		return false
	var selected_route: Dictionary = {}
	var lower_approach_blocked: = false
	for route in parkour_routes():
		if parkour_route_can_activate(route):
			selected_route = route
			break
		if parkour_route_requires_lower_approach(route) and near_parkour_x(float(route["center"])) and player_position.y < 220.0:
			lower_approach_blocked = true
	if selected_route.is_empty():
		if lower_approach_blocked:
			notify("APPROACH THE CLIMB MARKER FROM BELOW", ACCENT, 2.2)
			return true
		return false
	var stamina_cost: = float(selected_route.get("stamina", 18.0))
	var vertical_climb: = parkour_route_requires_lower_approach(selected_route)
	pending_parkour_route = selected_route.duplicate(true)
	if stamina < stamina_cost:
		parkour_failed = true
		notify("STAMINA FAILED MID-ROUTE - THE GROUND IS STILL AVAILABLE", DANGER, 2.5)
		var failed_destination: = player_position + (Vector2(0, -48.0) if vertical_climb else Vector2(facing * 42.0, -12.0))
		begin_vault(clamp_position_to_area(failed_destination), String(selected_route["name"]))
		return true
	parkour_failed = false
	var direction: = 1.0 if player_position.x <= float(selected_route["center"]) else -1.0
	facing = direction
	var visual_destination: Vector2
	if vertical_climb:
		var alignment: = clampf(float(selected_route["center"]) - player_position.x, -24.0, 24.0)
		visual_destination = clamp_position_to_area(player_position + Vector2(alignment, -96.0))
	else:
		visual_destination = clamp_position_to_area(player_position + Vector2(direction * 76.0, -18.0))
	begin_vault(visual_destination, String(selected_route["name"]))
	return true
func skill_level(skill_name: String) -> int:
	return Rules.level_from_xp(int(skills.get(skill_name, 0)))

func grant_xp(skill_name: String, amount: int) -> void :
	if reject_unsupported_online_mutation("XP REWARD"):
		return
	if skill_name not in skills or amount <= 0:
		return


	var actual_amount: = amount * 10 if speed_mode else amount

	var old_level: = skill_level(skill_name)
	skills[skill_name] = int(skills[skill_name]) + actual_amount


	xp_notifications.append({
		"skill": skill_name, 
		"amount": actual_amount, 
		"timer": 3.0, 
		"y_offset": 0.0, 
		"old_level": old_level, 
	})

	if lan_session.active and roster_server_owned:
		lan_session.request_xp_popup(skill_name, actual_amount)
	else:
		_on_lan_xp_event_received({"peer_id": 0, "skill": skill_name, "amount": actual_amount, "area": area, "room_id": room_id, "home_instance_id": home_instance_id, "position": player_position})
	var new_level: = skill_level(skill_name)
	if new_level > old_level:
		notify("%s LEVEL %d" % [skill_name.to_upper(), new_level], GOOD, 3.0)

func total_level() -> int:
	var total: = 0
	for skill_name in Rules.SKILLS:
		total += skill_level(skill_name)
	return total

