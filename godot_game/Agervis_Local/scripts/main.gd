func draw_skyline_building(x: float, y: float, width: float, height: float, seed: int) -> void :

	var base_color: = Color("#171c20")
	draw_rect(Rect2(x, y, width, height), base_color)

	if not low_spec:

		var window_rows: = int(height / 18)
		var window_cols: = int(width / 24)
		for row in range(window_rows):
			for col in range(window_cols):
				var wx: = x + 12 + col * 24
				var wy: = y + 8 + row * 18

				if posmod(seed + row + col, 4) == 0:
					draw_rect(Rect2(wx, wy, 8, 10), Color(0.28, 0.22, 0.12, 0.6))
				else:
					draw_rect(Rect2(wx, wy, 8, 10), Color(0.08, 0.09, 0.1, 0.5))


		if posmod(seed, 3) == 0:

			var tower_x: = x + width * 0.5
			draw_line(Vector2(tower_x, y - 24), Vector2(tower_x, y), Color("#2a2f32"), 3.0)
			draw_circle(Vector2(tower_x, y - 20), 4, Color("#3a3f42"))
			draw_line(Vector2(tower_x - 6, y - 12), Vector2(tower_x + 6, y - 12), Color("#2a2f32"), 2.0)
		elif posmod(seed, 5) == 1:

			var tank_x: = x + width * 0.6
			draw_rect(Rect2(tank_x, y - 12, 18, 10), Color("#1a1f22"))
		elif posmod(seed, 7) == 2:

			draw_rect(Rect2(x + width * 0.25, y - 20, width * 0.5, 20), base_color.lightened(0.05))

			for mini_col in range(2):
				var mwx: = x + width * 0.35 + mini_col * 18
				draw_rect(Rect2(mwx, y - 12, 6, 8), Color(0.18, 0.15, 0.1, 0.4))


		if posmod(seed, 2) == 0:
			draw_line(Vector2(x, y), Vector2(x, y + height), Color(0.12, 0.14, 0.16, 0.3), 2.0)

func draw_street() -> void :
	var offset: = camera_offset_x()
	draw_rect(Rect2(0, 70, 1280, 220), Color("#252b31"))
	for index in range(14):
		var skyline_x: = index * 145.0 - fmod(offset * 0.16, 145.0)

		if skyline_x + 112.0 < 0.0 or skyline_x > VIEW_SIZE.x:
			continue
		var skyline_height: = 85.0 + float((index * 37) % 120)
		draw_skyline_building(skyline_x, 290.0 - skyline_height, 112, skyline_height, index)


	draw_nonwalkable_street_setback(offset)
	draw_tiled_ground(offset)
	for entry in Build7.BUILDINGS:
		var building_x: = float(entry["x"])
		var building_width: = float(entry["width"])
		var screen_x: float = building_x - offset

		if screen_x + building_width < -200.0 or screen_x > VIEW_SIZE.x + 200.0:
			continue
		draw_building_exterior(building_x, building_width, String(entry["id"]), String(entry["label"]), int(entry["wall"]), int(entry["wall"]), Color(String(entry["color"])), offset)
	draw_street_lots(offset)
	draw_bus_stop(BUS_STOP_X - offset)

	for lamp_index in range(14):
		var lamp_x: = 550.0 + lamp_index * 750.0
		draw_street_lamppost(lamp_x, offset, lamp_index)

	for trash_index in range(8):
		var trash_x: = 1100.0 + trash_index * 1050.0
		draw_street_trash_can(trash_x, offset, trash_index)
	draw_parkour_routes(offset)
	draw_neighborhood_humor(offset)
	for camera_x in [1640.0, 3000.0, 5000.0, 5200.0, 6460.0, 7180.0, 7920.0]:
		var screen_x: float = camera_x - offset
		if screen_x >= -50.0 and screen_x <= VIEW_SIZE.x + 50.0:
			draw_camera_icon(Vector2(screen_x, 245))
	var patrol_home_x: float = 500.0 - offset
	if patrol_home_x >= -100.0 and patrol_home_x <= VIEW_SIZE.x + 100.0:
		draw_patrol_point(patrol_home_x, security_checkpoints["home"])
	var patrol_store_x: float = 5320.0 - offset
	if patrol_store_x >= -100.0 and patrol_store_x <= VIEW_SIZE.x + 100.0:
		draw_patrol_point(patrol_store_x, security_checkpoints["store"])
	if not low_spec:
		draw_street_weather()
	draw_surreal_street_layer(offset)

func draw_nonwalkable_street_setback(offset: float) -> void :



	const WORLD_BAND_WIDTH: = 320.0
	var first_band: = int(floor(offset / WORLD_BAND_WIDTH)) - 1
	for index in range(first_band, first_band + 6):
		var screen_x: = float(index) * WORLD_BAND_WIDTH - offset
		var band_tone: = Color("#42433e") if posmod(index, 2) == 0 else Color("#3b3d39")
		draw_rect(Rect2(screen_x, 398, WORLD_BAND_WIDTH + 1.0, 97), band_tone)
		draw_rect(Rect2(screen_x, 398, WORLD_BAND_WIDTH + 1.0, 5), Color("#69675d", 0.68))


		var decay_seed: = posmod(index, 19)
		if not low_spec:

			if decay_seed % 3 == 0:
				for butt in range(4):
					var butt_x: = screen_x + 40 + decay_seed * 18 + butt * 65
					var butt_y: = 425 + butt * 14
					draw_line(Vector2(butt_x, butt_y), Vector2(butt_x + 4, butt_y + 1), Color("#d4c8a8"), 1.5)
					draw_circle(Vector2(butt_x + 4, butt_y + 1), 1, Color("#8a7a5a"))


			if decay_seed % 7 == 2:
				var needle_x: = screen_x + 120 + decay_seed * 22
				var needle_y: = 450 + decay_seed * 7
				draw_line(Vector2(needle_x, needle_y), Vector2(needle_x + 9, needle_y - 2), Color("#b8bcc0"), 0.8)
				draw_circle(Vector2(needle_x, needle_y), 1.5, Color("#d87a68"))


			if decay_seed % 5 == 1:
				for shard in range(3):
					var shard_x: = screen_x + 80 + decay_seed * 25 + shard * 45
					var shard_y: = 440 + shard * 10
					var shard_points: = PackedVector2Array([
						Vector2(shard_x, shard_y), 
						Vector2(shard_x + 3, shard_y - 2), 
						Vector2(shard_x + 5, shard_y + 1)
					])
					draw_polyline(shard_points, Color(0.7, 0.75, 0.78, 0.4), 1.0)


		if decay_seed % 4 == 3:
			var stain_x: = screen_x + 100 + decay_seed * 30
			var stain_y: = 430 + decay_seed * 9
			draw_circle(Vector2(stain_x, stain_y), 16, Color(0.06, 0.06, 0.07, 0.65))
			draw_circle(Vector2(stain_x - 4, stain_y + 3), 9, Color(0.04, 0.04, 0.05, 0.45))

			if not low_spec:
				draw_arc(Vector2(stain_x - 2, stain_y), 8, 0, PI, 8, Color(0.4, 0.3, 0.5, 0.15), 1.0, false)


		if decay_seed % 6 == 0:
			for gum in range(3):
				var gum_x: = screen_x + 60 + decay_seed * 35 + gum * 70
				var gum_y: = 455 + gum * 12
				draw_circle(Vector2(gum_x, gum_y), 3, Color("#1a1a1a"))
				draw_circle(Vector2(gum_x, gum_y), 2, Color("#2a2a2a"))


		if decay_seed % 3 == 1:
			var crack_start: = Vector2(screen_x + 30 + decay_seed * 20, 405)
			var crack_end: = Vector2(screen_x + 240 + decay_seed * 15, 485)
			draw_line(crack_start, crack_end, Color("#1a1c18"), 2.0)
			draw_line(crack_start + Vector2(1, 0), crack_end + Vector2(1, 0), Color("#2a2c28"), 0.5)

		for seam in range(1, 4):
			var seam_x: = screen_x + float(seam) * WORLD_BAND_WIDTH / 4.0
			draw_line(Vector2(seam_x, 404), Vector2(seam_x - 13, 495), Color("#282b29", 0.56), 2.0)
		draw_line(Vector2(screen_x + 12, 483), Vector2(screen_x + WORLD_BAND_WIDTH - 16, 483), Color("#55564f", 0.48), 2.0)

func live_camera_recording_player() -> String:
	if camera_evasion_timer > 0.0:
		return ""
	var camera_id: = camera_for_position(area, player_position)
	if camera_id.is_empty() or camera_feed_mode(camera_id) != "LIVE":
		return ""
	return camera_id

func draw_surreal_street_layer(offset: float) -> void :
	var camera_id: = live_camera_recording_player()
	if camera_id.is_empty(): return
	var camera_centers: = {
		"SCHOOL-EXTERIOR": 1660.0, "ALIBIS-EXTERIOR": 3040.0, "STORE-EXTERIOR": 5100.0, 
		"PAWN-EXTERIOR": 5820.0, "HOSPITAL-EXTERIOR": 6540.0, "PRECINCT-EXTERIOR": 7280.0, 
		"BANK-EXTERIOR": 8020.0, 
	}
	if camera_id not in camera_centers: return
	var center: = float(camera_centers[camera_id])
	var eye_world_points: = [Vector2(center - 105.0, 228), Vector2(center + 108.0, 240)]
	var blink_open: = low_spec or fmod(elapsed, 5.2) < 4.65
	for eye_world in eye_world_points:
		var eye_point: = Vector2(eye_world.x - offset, eye_world.y)
		if eye_point.x > -40 and eye_point.x < 1320:
			draw_surreal_eye(eye_point, Vector2(18, 9), blink_open, Color("#b2a071"))

func draw_surreal_eye(point: Vector2, radii: Vector2, open: bool, sclera: Color) -> void :
	if not open:
		draw_line(point - Vector2(radii.x, 0), point + Vector2(radii.x, 0), sclera.darkened(0.45), 3.0)
		return
	draw_flat_ellipse(point, radii, sclera)
	var pupil_target: = scene_position(player_position) - point
	var pupil_offset: = pupil_target.normalized() * minf(4.0, pupil_target.length() * 0.01) if pupil_target.length() > 0.01 else Vector2.ZERO
	draw_circle(point + pupil_offset, minf(radii.y * 0.62, 5.0), Color("#17191b"))
	draw_circle(point + pupil_offset - Vector2(1, 1), 1.1, Color("#ded4b9"))

func draw_tiled_ground(offset: float) -> void :
