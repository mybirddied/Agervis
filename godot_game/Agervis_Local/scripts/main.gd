		begin_education_test("skill_class_" + classroom_skill.to_lower(), 2, choice_count, 2)
		return true

	return false

func update_sleeping(delta: float) -> void :
	player_walking = false
	click_move_active = false
	health = minf(100.0, health + 4.0 * delta)
	stamina = minf(max_stamina_value(), stamina + 8.0 * delta)

