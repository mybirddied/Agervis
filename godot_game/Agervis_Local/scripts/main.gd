			arrow_tip
		])
		draw_polygon(arrow_points, PackedColorArray([Color("#c7bfa6")]))
		draw_line(Vector2(arrow_tip.x - 35, arrow_tip.y), Vector2(arrow_tip.x - 25, arrow_tip.y), Color("#c7bfa6"), 4.0)

func draw_school_clock(point: Vector2) -> void :
	draw_rect(Rect2(point.x - 52, point.y - 15, 24, 31), Color("#252a29"))
	for hole in range(3):
		draw_circle(Vector2(point.x - 40, point.y - 7 + hole * 7), 1.7, Color("#0e1110"))
	draw_circle(point + Vector2(17, 0), 23, Color("#c7c0ad"))
	draw_circle(point + Vector2(17, 0), 23, Color("#292c2b"), false, 4.0)


	var time_dict: = Time.get_time_dict_from_system()
	var hours: float = time_dict.hour % 12
	var minutes: float = time_dict.minute
	var seconds: float = time_dict.second


	var hour_angle: = (hours + minutes / 60.0) * (PI * 2.0 / 12.0) - PI / 2.0
	draw_line(point + Vector2(17, 0), point + Vector2(17, 0) + Vector2(cos(hour_angle) * 10, sin(hour_angle) * 10), Color("#292c2b"), 2.5)


	var minute_angle: = (minutes + seconds / 60.0) * (PI * 2.0 / 60.0) - PI / 2.0
	draw_line(point + Vector2(17, 0), point + Vector2(17, 0) + Vector2(cos(minute_angle) * 18, sin(minute_angle) * 18), Color("#292c2b"), 2.0)
