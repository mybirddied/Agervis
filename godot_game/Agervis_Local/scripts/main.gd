func in_street_entry_strip(world_x: float, half_width: float = 92.0) -> bool:
	return player_touches_door(Vector2(world_x, 215.0), minf(48.0, half_width), EXTERIOR_DOOR_BASE_SCREEN_Y)

func in_indoor_door_strip(world_x: float, half_width: float = 78.0) -> bool:
	return player_touches_door(Vector2(world_x, 205.0), minf(48.0, half_width), indoor_door_base_screen_y())

func door_contact_rect(door_point: Vector2, half_width: float = 48.0, door_base_screen_y: float = -1.0) -> Rect2:







	var base: = indoor_door_base_screen_y() if door_base_screen_y < 0.0 else door_base_screen_y
	var threshold: = door_threshold_depth(base)
	return Rect2(door_point.x - half_width, threshold - DOOR_CONTACT_THRESHOLD_DEPTH, half_width * 2.0, DOOR_CONTACT_THRESHOLD_DEPTH * 2.0)

func player_touches_door(door_point: Vector2, half_width: float = 48.0, door_base_screen_y: float = -1.0) -> bool:
	return door_contact_rect(door_point, half_width, door_base_screen_y).intersects(player_warp_contact_rect(), true)

func nearest_street_building_door() -> Dictionary:
	if area != "street":
		return {}
	var best: Dictionary = {}
	var best_distance: = INF
	for entry_value in Build7.BUILDINGS:
		var entry: Dictionary = entry_value
		var point: = Vector2(float(entry["x"]), 215.0)
		var distance: = player_position.distance_to(point)
		if player_touches_door(point, 48.0, EXTERIOR_DOOR_BASE_SCREEN_Y) and distance < best_distance:
			best_distance = distance
			best = entry
	return best

func try_street_building_door() -> bool:
	var entry: = nearest_street_building_door()
	if entry.is_empty():
		return false
	var destination: = String(entry["id"])
	if destination == "hospital":
		hospital_required_treatment = false
		hospital_stabilized = true
	enter_area(destination, interior_entry_position(destination))
	return true

