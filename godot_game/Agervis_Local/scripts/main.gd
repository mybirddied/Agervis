func online_economy_enabled() -> bool:
	return lan_session.active and roster_server_owned and active_slot >= 0 and not resident_world_id.is_empty()

func online_authority_enforced() -> bool:
	if not online_economy_enabled() or phase != "adult":
		return false
	var slots: Array = roster.get("slots", [])
