func actor_visible_in_current_room(actor: AgervisActor) -> bool:
	if actor.area != area or actor.removed:
		return false
	if not actor.room_id.is_empty():
		return actor.room_id == room_id



	if area in ["street", "rear", "rooftop"]:
		return true
	if area == "store":
		return room_id == "sales"
	if area == "jail":
		return room_id in ["tier", "west_tier"]
	return room_id.is_empty()

func remote_visible_in_current_room(state: Dictionary) -> bool:
	if String(state.get("area", "")) != area:
		return false
	if String(state.get("room_id", "")) != room_id:
		return false
	if area == "apartment" and room_id == "unit":
		return not home_instance_id.is_empty() and String(state.get("home_instance_id", "")) == home_instance_id
	return true
func draw_world_actors() -> void :
	var items: Array[Dictionary] = []



	var show_area_actors: = room_id.is_empty() or build10_room_has_legacy_content()
	if phase != "tutorial" and show_area_actors:
		for actor in actors:
			if actor_visible_in_current_room(actor):
				items.append({"kind": "actor", "actor": actor, "depth": actor.position.y})
	if phase != "tutorial":
		for peer_id in lan_remote_states.keys():
			if remote_state_is_local_resident(lan_remote_states[peer_id], int(peer_id)): continue
			var state: Dictionary = lan_remote_states[peer_id]
			if bool(state.get("deceased", false)):
				continue
			if remote_visible_in_current_room(state):
				items.append({"kind": "remote", "state": state, "peer_id": int(peer_id), "depth": remote_state_position(state).y})
	items.append({"kind": "player", "depth": player_position.y})
	items.sort_custom( func(a: Dictionary, b: Dictionary) -> bool: return float(a["depth"]) < float(b["depth"]))
	for item in items:
		match String(item["kind"]):
			"actor": draw_actor_world(item["actor"] as AgervisActor)
			"remote": draw_remote_player_world(item["state"] as Dictionary, int(item["peer_id"]))
			"player": draw_player_world()

func interior_depth_items() -> Array[Dictionary]:
	var items: Array[Dictionary] = []
	for record in current_room_object_records():
		var render_mode: = String(record.get("render_mode", "depth_fixture"))
		if render_mode in ["content", "runtime_actor"] or render_mode.begins_with("wall_"):
			continue
		items.append({"kind": "room_object", "id": String(record.get("fixture_id", record.get("local_id", ""))), "instance_id": String(record.get("instance_id", "")), "record": record, "depth": float(record.get("depth", (record.get("position", Vector2.ZERO) as Vector2).y)), "priority": int(record.get("priority", 2))})


	if (area == "tutorial" or area == "school") and room_id.begins_with("class_"):
		for row in range(3):
			for desk_col in range(4):
				var desk_y: = 537 + row * 12
				items.append({"kind": "classroom_desk", "row": row, "col": desk_col, "depth": float(desk_y + 21), "priority": 2})

	if phase != "tutorial":
		for actor in actors:
			if actor_visible_in_current_room(actor):
				items.append({"kind": "actor", "actor": actor, "depth": actor.position.y, "priority": 1})
		for peer_id in lan_remote_states.keys():
			if int(peer_id) == lan_session.local_peer_id():
				continue
			var state: Dictionary = lan_remote_states[peer_id]
			if bool(state.get("deceased", false)):
				continue
			if remote_visible_in_current_room(state):
				items.append({"kind": "remote", "state": state, "peer_id": int(peer_id), "depth": remote_state_position(state).y, "priority": 1})
	items.append({"kind": "player", "depth": player_position.y, "priority": 1})
	items.sort_custom( func(a: Dictionary, b: Dictionary) -> bool:
		var depth_a: = float(a["depth"])
		var depth_b: = float(b["depth"])
		if is_equal_approx(depth_a, depth_b):
			return int(a["priority"]) < int(b["priority"])
		return depth_a < depth_b
	)
	return items
