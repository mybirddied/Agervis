func save_current_character(reason: String = "") -> void :
	if not save_enabled or phase not in ["tutorial", "adult"] or active_slot < 0:
		return
	var snapshot: = character_snapshot()
	roster["settings"] = {"low_spec": low_spec, "tips_enabled": tips_enabled, "close_chat_after_enter": close_chat_after_enter}
	if phase == "tutorial":
		var drafts: Array = roster.get("tutorial_drafts", ReleaseSave.empty_tutorial_drafts())
		snapshot = tutorial_candidate_with_authority(snapshot, active_slot)
		drafts[active_slot] = ReleaseSave.legacy_tutorial_draft(snapshot, active_slot)
		roster["tutorial_drafts"] = drafts
		roster["active_tutorial_slot"] = active_slot
		if roster_server_owned:
			if not lan_session.active:
				if not reason.is_empty():
					release_notice = "SERVER SAVE FAILED  -  WORLD CONNECTION IS CLOSED"
				return
			pending_tutorial_save_reason = reason
			lan_session.save_server_tutorial_draft(active_slot, snapshot)
			return
		if persist_roster() and not reason.is_empty():
			release_notice = "SAVED  -  " + reason
		return
	roster["slots"][active_slot] = snapshot
	roster["active_slot"] = active_slot
	if roster_server_owned:
		if not lan_session.active:
			if not reason.is_empty():
				release_notice = "SERVER SAVE FAILED  -  WORLD CONNECTION IS CLOSED"
			return
		lan_session.save_server_resident(active_slot, snapshot, {
			"last_switch_unix": int(roster.get("last_switch_unix", 0)), 
		})
		if not reason.is_empty():
			release_notice = "SAVED TO %s  -  %s" % [resident_world_id, reason]
	elif persist_roster() and not reason.is_empty():
		release_notice = "SAVED  -  " + reason

func persist_roster() -> bool:
	if not save_enabled:
		return true
	if roster_server_owned:
		return lan_session.active
	return ReleaseSave.save_roster(roster)
func load_character(slot: Dictionary, slot_index: int) -> void :
	slot = SaveMigration.migrate_resident(slot)
	if bool(slot.get("deceased", false)):
		release_notice = "DECEASED FILE  -  RECORD PRESERVED; SELECT AN EMPTY SLOT"
		mode = ScreenMode.ROSTER
		return
	if not prepare_slot_switch(slot_index):
		mode = ScreenMode.ROSTER
		return
	reset_character_state()
	active_slot = slot_index
	player_name = String(slot.get("name", "Citizen")).left(16)
	player_color = stored_color(slot.get("color", "c78965"), creation_colors[0])
	player_skin = stored_color(slot.get("skin", "b97855"), creation_skin_colors[0])
