func service_tasks_complete(employer_id: String) -> Dictionary:
	return restaurant_tasks if employer_id == "alibis" else laundry_tasks

func choose_next_service_assignment(employer_id: String) -> void :
	var expected_job: = "Carryout Worker" if employer_id == "alibis" else "Laundry Attendant"
	if active_job != expected_job:
		refresh_active_task_text()
		return
	if online_economy_enabled():
		request_online_service_assignment(employer_id)
		refresh_active_task_text()
		return
	var director: Dictionary = Dictionary(task_directors.get(employer_id, {})).duplicate(true)
	if String(director.get("state", "")) == "assigned" and String(director.get("owner", "")) == player_name:
		sync_service_contract()
		refresh_active_task_text()
		return
	if String(director.get("state", "")) == "delayed" and elapsed < float(director.get("retry_at", 0.0)):
		sync_service_contract()
		refresh_active_task_text()
		return
	var completed: = service_tasks_complete(employer_id)
	var available: Array[String] = []
	for task_name in service_task_list(employer_id):
		if not bool(completed.get(task_name, false)):
			available.append(task_name)
	if available.is_empty():
		task_directors[employer_id] = {"owner": player_name, "task": "", "variation": 0, "state": "completed", "generation": int(director.get("generation", 0))}
		sync_service_contract()
		refresh_active_task_text()
		return
	available.shuffle()
	task_directors[employer_id] = {"owner": player_name, "task": available[0], "variation": rng.randi_range(0, 2), "state": "assigned", "generation": int(director.get("generation", 0)) + 1, "issued_at": elapsed, "retry_at": 0.0}
	sync_service_contract()
	refresh_active_task_text()

func request_online_service_assignment(employer_id: String) -> void :
	if not online_economy_enabled() or not economy_pending_action.is_empty():
		return
	var expected_job: = "Carryout Worker" if employer_id == "alibis" else "Laundry Attendant"
	if active_job != expected_job:
		return
	var director: Dictionary = Dictionary(task_directors.get(employer_id, {}))
	if String(director.get("state", "")) == "assigned" and String(director.get("owner", "")) == player_name:
		return
	if String(director.get("state", "")) == "delayed" and elapsed < float(director.get("retry_at", 0.0)):
		return
	var completed: = service_tasks_complete(employer_id)
	if service_task_list(employer_id).all( func(task_name): return bool(completed.get(task_name, false))):
		task_directors[employer_id] = {"owner": player_name, "task": "", "variation": 0, "state": "completed"}
		sync_service_contract()
		return
	task_directors[employer_id] = {"owner": player_name, "task": "", "variation": 0, "state": "requesting"}
	sync_service_contract()
	submit_online_economy_request("SERVICE_TASK_ASSIGN", {"employer_id": employer_id}, false, {"employer_id": employer_id})

