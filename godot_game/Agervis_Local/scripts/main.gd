func damage_player_environment(amount: float, reason: String) -> void :
	if god_mode:
		return
	if player_downed:
		return
	sleeping = false
	spawn_blood(player_position, "environment", maxi(3, int(amount / 4.0)))
	var reason_lower: = reason.to_lower()
	if "car" in reason_lower and String(equipment.get("back", "")) == "Reflective Scholarship Backpack":
		amount *= 0.75
	var ballistic: = "shot" in reason_lower or "gun" in reason_lower or "ballistic" in reason_lower
	if ballistic and health - amount <= 0.0:
		var spent_vest: = consume_equipped_contingency(["Used Kevlar", "Kevlar Vest"])
		if not spent_vest.is_empty():
			health = 1.0
			notify("%s STOPPED THE LETHAL HIT - VEST RUINED" % spent_vest.to_upper(), GOOD, 4.0)
