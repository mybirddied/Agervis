func update_lan(delta: float) -> void :
	update_lan_remote_attack_visuals(delta)
	lan_sync_timer += delta
	var resident_is_active: = roster_server_owned and active_slot >= 0 and not resident_world_id.is_empty()
	var resident_screen: = mode not in [ScreenMode.STUDIO, ScreenMode.TITLE, ScreenMode.LAN, ScreenMode.ROSTER, ScreenMode.ROSTER_DELETE]
	if lan_sync_timer >= 0.18 and resident_is_active and resident_screen:
		lan_sync_timer = 0.0
		lan_session.submit_local_state(local_lan_state())



func update_lan_remote_attack_visuals(delta: float) -> void :
	for peer_value in lan_remote_attacks.keys():
		var peer_id: = int(peer_value)
		var visual: Dictionary = lan_remote_attacks[peer_id]
		visual["remaining"] = float(visual.get("remaining", 0.0)) - delta
		if float(visual["remaining"]) <= 0.0:
			lan_remote_attacks.erase(peer_id)
		else:
			lan_remote_attacks[peer_id] = visual
	for peer_value in lan_remote_hostile_arrows.keys():
		var peer_id: = int(peer_value)
		var remaining: = float(lan_remote_hostile_arrows[peer_id]) - delta
		if remaining <= 0.0:
			lan_remote_hostile_arrows.erase(peer_id)
		else:
			lan_remote_hostile_arrows[peer_id] = remaining

func update_lan_host_authority(delta: float) -> void :
	for index in range(lan_pending_outcomes.size() - 1, -1, -1):
		lan_pending_outcomes[index]["remaining"] = float(lan_pending_outcomes[index]["remaining"]) - delta
		if float(lan_pending_outcomes[index]["remaining"]) <= 0.0:
			var pending: Dictionary = lan_pending_outcomes[index]
			var target: = int(pending["target"])
			if bool(pending["success"]):
				if bool(pending["fatal"]):
					lan_session.host_patch_peer(target, {"health": 0.0, "downed": true, "dead": true})
				else:
					lan_session.host_patch_peer(target, lan_session.authoritative_hospital_recovery_patch())
			else:
				lan_session.host_patch_peer(target, lan_session.authoritative_hospital_recovery_patch())
			lan_pending_outcomes.remove_at(index)
	for peer_id in lan_session.peer_states.keys():
		var state: Dictionary = lan_session.peer_states[peer_id]
		if bool(state.get("downed", false)) and not lan_peer_has_pending_outcome(int(peer_id)):
			lan_downed_timers[peer_id] = float(lan_downed_timers.get(peer_id, 0.0)) + delta
			if float(lan_downed_timers[peer_id]) >= 3.0:
				lan_downed_timers.erase(peer_id)
				lan_session.host_patch_peer(int(peer_id), lan_session.authoritative_hospital_recovery_patch())
		else:
			lan_downed_timers.erase(peer_id)

func lan_peer_has_pending_outcome(peer_id: int) -> bool:
	for pending in lan_pending_outcomes:
		if int(pending["target"]) == peer_id: return true
	return false

