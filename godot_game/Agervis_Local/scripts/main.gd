func carry_capacity_for_back(back_item: String) -> int:
	return 8 + Build10.backpack_capacity(back_item)

func carry_capacity() -> int:
	return carry_capacity_for_back(String(equipment.get("back", "")))

func projected_carry_capacity(slot_name: String, replacement: String) -> int:
	var projected_back: = String(equipment.get("back", ""))
	if slot_name == "back":
		projected_back = replacement
	return carry_capacity_for_back(projected_back)

func can_receive_inventory_item(item_name: String) -> bool:
	if inventory.size() < carry_capacity():
		return true


	if Build10.equipment_slot(item_name) == "back":
		return inventory.size() + 1 <= projected_carry_capacity("back", item_name)
	return false

func try_add_inventory_item(item_name: String) -> bool:
	if reject_unsupported_online_mutation("INVENTORY CHANGE"):
		return false
	if not can_receive_inventory_item(item_name):
		return false
	inventory.append(item_name)
	return true

func can_receive_inventory_items(item_names: Array[String]) -> bool:
	return inventory.size() + item_names.size() <= carry_capacity()

func grant_carried_item(item_name: String, source_label: String = "") -> bool:
	if try_add_inventory_item(item_name):
		return true
	var source_suffix: = ""
	if not source_label.is_empty():
		source_suffix = " AT %s" % source_label.to_upper()
	notify("CARRY SPACE FULL - %s STAYS%s" % [item_name.to_upper(), source_suffix], DANGER, 3.0)
	return false

func grant_carried_items(item_names: Array[String], source_label: String = "") -> bool:
	if reject_unsupported_online_mutation("INVENTORY CHANGE"):
		return false
	if not can_receive_inventory_items(item_names):
		var source_suffix: = ""
		if not source_label.is_empty():
			source_suffix = " AT %s" % source_label.to_upper()
		notify("CARRY SPACE FULL - THE PACKAGE STAYS%s" % source_suffix, DANGER, 3.0)
		return false
	for item_name in item_names:
		inventory.append(item_name)
	return true
func contingency_slot_for_item(item_name: String) -> String:
	var preferred: = Build10.equipment_slot(item_name)
	if not preferred.begins_with("contingency"):
		return ""
	if String(equipment.get(preferred, "")).is_empty():
		return preferred
	for slot_name in ["contingency_1", "contingency_2"]:
		if String(equipment.get(slot_name, "")).is_empty():
			return slot_name
	return ""

func equipped_contingency_slot(item_names: Array[String]) -> String:
	for slot_name in ["contingency_1", "contingency_2"]:
		if String(equipment.get(slot_name, "")) in item_names:
			return slot_name
	return ""

func has_equipped_contingency(item_names: Array[String]) -> bool:
	return not equipped_contingency_slot(item_names).is_empty()

func consume_equipped_contingency(item_names: Array[String]) -> String:
	if reject_unsupported_online_mutation("EQUIPMENT CHANGE", false):
		return ""
	var slot_name: = equipped_contingency_slot(item_names)
	if slot_name.is_empty():
		return ""
	var item_name: = String(equipment.get(slot_name, ""))
	equipment[slot_name] = ""
	sync_contingencies_from_equipment()
	return item_name

func equip_contingency_item(item_name: String) -> bool:
	if reject_unsupported_online_mutation("EQUIPMENT CHANGE"):
		return false
	var slot_name: = contingency_slot_for_item(item_name)
	if slot_name.is_empty():
		return false
	equipment[slot_name] = item_name
	sync_contingencies_from_equipment()
	return true

func normalize_equipment_state() -> void :
	var legacy_items: = contingencies.duplicate()
	sync_contingencies_from_equipment()
	for item_name in legacy_items:
		if Build10.equipment_slot(item_name).begins_with("contingency") and not has_equipped_contingency([item_name]):
			var slot_name: = contingency_slot_for_item(item_name)
			if not slot_name.is_empty():
				equipment[slot_name] = item_name
	sync_contingencies_from_equipment()
	stamina = minf(stamina, max_stamina_value())

func apply_involuntary_exposure(source: String) -> void :
	if player_downed or overdose_active:
		return
	var awareness_escape: = clampf(0.12 + float(skill_level("Awareness")) * 0.045, 0.12, 0.42)
	if rng.randf() < awareness_escape:
		grant_xp("Awareness", 18)
		notify("YOU NOTICED THE EXPOSED PAPER AND GOT CLEAR", ACCENT, 3.5)
		return
	trigger_overdose(source)
func trigger_overdose(source: String = "Unknown exposure") -> void :
	if player_downed or overdose_active:
		return
	overdose_active = true
	overdose_timer = 7.0
	overdose_source = source
	notify("OVERDOSE EMERGENCY - READY REVIVAR WILL DEPLOY IF EQUIPPED", DANGER, 4.0)

func update_overdose_state(delta: float) -> void :
	if not overdose_active:
		return
	var spent_reversal: = consume_equipped_contingency(["Revivar (single)", "Clinic Revivar", "Revivar Kit"])
	if not spent_reversal.is_empty():
		overdose_active = false
		overdose_timer = 0.0
		health = maxf(health, 45.0)
		notify("%s DEPLOYED - OVERDOSE INTERRUPTED" % spent_reversal.to_upper(), GOOD, 4.0)
		save_current_character("CONTINGENCY USED")
		return
	overdose_timer -= delta
	if overdose_timer <= 0.0:
		overdose_active = false
		damage_player_environment(100.0, "An overdose emergency had no ready reversal.")

func max_stamina_value() -> float:
	var back_item: = String(equipment.get("back", ""))
	var penalty: = int(Build10.EQUIPMENT_CATALOG.get(back_item, {}).get("stamina_cost", 0))
	return maxf(65.0, 100.0 - float(penalty))

func open_equipment() -> void :
	click_move_active = false
	reset_inventory_edit_state()
	equipment_focus = 0
	equipment_cursor = 0
	mode = ScreenMode.EQUIPMENT

func inventory_edit_active() -> bool:
	return equipment_move_source_record_index >= 0 or equipment_split_active

func reset_inventory_edit_state() -> void :
	equipment_move_source_display = -1
	equipment_move_source_record_index = -1
	equipment_move_expected_record.clear()
	equipment_split_active = false
	equipment_split_source_record_index = -1
	equipment_split_expected_record.clear()
	equipment_split_quantity = 1

func current_carried_inventory_selection() -> Dictionary:
	if equipment_focus != 0 or inventory.is_empty():
		return {}
	var display_index: = clampi(equipment_cursor, 0, inventory.size() - 1)
	var selection: = authoritative_inventory_selection_for_display_index(display_index)
	if not selection.is_empty():
		return selection
	return {
		"record_index": display_index, 
		"unit_offset": 0, 
		"display_start": display_index, 
		"record": SaveMigration.default_item_record(String(inventory[display_index])), 
	}

func start_inventory_move() -> void :
	if equipment_focus != 0 or inventory.size() < 2:
		notify("SELECT A CARRIED ITEM BEFORE MOVING IT", ACCENT, 2.4)
		return
	var selection: = current_carried_inventory_selection()
	if selection.is_empty():
		notify("THAT CARRIED SLOT IS NO LONGER AVAILABLE", DANGER, 2.4)
		return
	reset_inventory_edit_state()
	equipment_move_source_display = equipment_cursor
	equipment_move_source_record_index = int(selection.get("record_index", -1))
	equipment_move_expected_record = Dictionary(selection.get("record", {})).duplicate(true)
	notify("MOVE SOURCE SET  -  CHOOSE ITS FINAL SLOT", ACCENT, 2.5)

func confirm_inventory_move() -> void :
	if equipment_move_source_record_index < 0 or equipment_move_expected_record.is_empty():
		start_inventory_move()
		return
	var destination_selection: = current_carried_inventory_selection()
	if destination_selection.is_empty():
		notify("CHOOSE A FILLED CARRIED SLOT", DANGER, 2.2)
		return
	var destination_record_index: = int(destination_selection.get("record_index", -1))
	if destination_record_index == equipment_move_source_record_index:
		notify("CHOOSE A DIFFERENT FINAL SLOT", ACCENT, 2.0)
		return
	var moved_item: = String(equipment_move_expected_record.get("item_id", "ITEM"))
	if online_authority_enforced():
		submit_online_economy_request("INVENTORY_MOVE", {
			"source_index": equipment_move_source_record_index, 
			"destination_index": destination_record_index, 
			"expected_record": equipment_move_expected_record.duplicate(true), 
		}, true, {"item_id": moved_item, "destination_display": equipment_cursor})
		return
	var source_display: = equipment_move_source_display
	var destination_display: = clampi(equipment_cursor, 0, inventory.size() - 1)
	if source_display < 0 or source_display >= inventory.size():
		reset_inventory_edit_state()
		notify("THAT CARRIED SLOT CHANGED BEFORE THE MOVE", DANGER, 2.5)
		return
	var local_item: = inventory[source_display]
	inventory.remove_at(source_display)
	inventory.insert(destination_display, local_item)
	equipment_cursor = destination_display
	reset_inventory_edit_state()
	notify("MOVED %s" % moved_item.to_upper(), GOOD, 2.0)
	save_current_character("INVENTORY REORDERED")

func selected_inventory_stack_quantity() -> int:
	var selection: = current_carried_inventory_selection()
	var record: Dictionary = selection.get("record", {})
	return maxi(1, int(record.get("quantity", 1))) if not record.is_empty() else 1

func use_selected_standard_item() -> void :
	var selection: = current_carried_inventory_selection()
	var record: Dictionary = selection.get("record", {})
	if record.is_empty():
		notify("THAT CARRIED ITEM IS NO LONGER AVAILABLE", DANGER, 2.4)
		return
	var item_id: = String(record.get("item_id", ""))
	if not ItemUseRules.is_standard_consumable(item_id):
		return
	if online_authority_enforced():
		submit_online_economy_request("INVENTORY_USE", {
			"source_index": int(selection.get("record_index", -1)), 
			"expected_record": record.duplicate(true), 
		}, true, {"item_id": item_id})
		return
	var healing_effectiveness: = get_effect_multiplicative("healing_effectiveness", 1.0)
	var instant_heal_effectiveness: = get_effect_multiplicative("instant_heal_effectiveness", 1.0)

	var effect: = ItemUseRules.apply_standard_effect(item_id, health, stamina, max_stamina_value(), healing_effectiveness, instant_heal_effectiveness)
	if not bool(effect.get("ok", false)):
		notify("THAT ITEM WOULD NOT CHANGE YOUR CURRENT CONDITION", ACCENT, 2.5)
		return
	health = float(effect.get("health", health))
	stamina = float(effect.get("stamina", stamina))
	inventory.remove_at(clampi(equipment_cursor, 0, inventory.size() - 1))
	equipment_cursor = clampi(equipment_cursor, 0, maxi(0, inventory.size() - 1))
	var restored: = roundi(float(effect.get("health_restored", 0.0)))
	var restored_label: = "HEALTH +%d" % restored if restored > 0 else "STAMINA +%d" % roundi(float(effect.get("stamina_restored", 0.0)))
	notify("USED %s  -  %s" % [item_id.to_upper(), restored_label], GOOD, 2.6)
	save_current_character("INVENTORY ITEM USED")

func consume_substance(item_id: String, voluntary: bool = true) -> void:
	if reject_unsupported_online_mutation("SUBSTANCE USE", false):
		return

	# Determine if this is a pharmaceutical or street substance
	var substance_data: Dictionary = {}
	var substance_id: = ""

	# Check pharmaceuticals
	for pharma_name in PharmaceuticalContent.PHARMA_SUBSTANCES.keys():
		if item_id.contains(pharma_name):
			substance_id = pharma_name
			substance_data = PharmaceuticalContent.PHARMA_SUBSTANCES[pharma_name]
			break

	# Check syrup
	if substance_id.is_empty() and item_id.contains("Syrup"):
		substance_id = "Syrup"
		substance_data = PharmaceuticalContent.SYRUP

	# Check Revivar
	if substance_id.is_empty() and item_id.contains("Revivar"):
		substance_id = "revivar"
		substance_data = PharmaceuticalContent.REVIVAR

	# Check street substances
	if substance_id.is_empty():
		for street_name in StreetSubstances.STREET_SUBSTANCES.keys():
			if item_id.contains(street_name):
				substance_id = street_name
				substance_data = StreetSubstances.STREET_SUBSTANCES[street_name]
				break

	if substance_data.is_empty():
		notify("THAT SUBSTANCE CANNOT BE CONSUMED", DANGER, 2.5)
		return

	# Check for receptor blockade
	var substance_internal_id: String = substance_data.get("substance_id", "")
	var active_substance_ids: Array = []
	for buff in active_buffs:
		if buff.has("substance"):
			active_substance_ids.append(buff["substance"])
	var blockade_check: = AddictionSystem.check_receptor_blockade(substance_internal_id, active_substance_ids)
	if blockade_check:
		notify("RECEPTOR BLOCKADE - NO EFFECT FROM %s" % substance_internal_id.to_upper(), ACCENT, 3.5)
		return

	# Check for precipitated withdrawal

	# Opioid overdose system integration
	var is_opioid: = OpioidOverdoseSystem.is_opioid(substance_internal_id)
	var is_subscriptxone: = substance_internal_id == "subscriptxone"

	# Check Subscriptxone precipitated withdrawal (new decay system)
	if is_subscriptxone:
		# Check if any opioid is currently active
		var has_active_opioid: = false
		for sub_id in active_substance_ids:
			if OpioidOverdoseSystem.is_opioid(sub_id):
				has_active_opioid = true
				break

		if has_active_opioid:
			var withdrawal_mult: = OpioidOverdoseSystem.calculate_subscriptxone_withdrawal_multiplier(0.0)
			var withdrawal_data: = OpioidOverdoseSystem.apply_precipitated_withdrawal(withdrawal_mult)
			if not withdrawal_data.is_empty():
				notify("PRECIPITATED WITHDRAWAL - VIOLENT REVERSAL", DANGER, 4.0)
				# Apply scaled withdrawal effects
				var effects: Dictionary = withdrawal_data.get("effects", {})
				health = maxf(10.0, health * (1.0 - effects.get("vitality_drain", 0.0)))
				# Add withdrawal debuff with decay
				active_debuffs.append({
					"substance": substance_internal_id,
					"name": "Precipitated Withdrawal",
					"effects": effects,
					"remaining": withdrawal_data.get("duration_remaining", 600.0),
					"decay_multiplier": withdrawal_mult
				})
				subscriptxone_active_time = elapsed

	# Check if opioid consumed while Subscriptxone active
	if is_opioid and subscriptxone_active_time > 0.0:
		var time_since_sub: = elapsed - subscriptxone_active_time
		if time_since_sub < OpioidOverdoseSystem.SUBSCRIPTXONE_WITHDRAWAL_DURATION:
			var withdrawal_mult: = OpioidOverdoseSystem.calculate_subscriptxone_withdrawal_multiplier(time_since_sub)
			var withdrawal_data: = OpioidOverdoseSystem.apply_precipitated_withdrawal(withdrawal_mult)
			if not withdrawal_data.is_empty():
				notify("PRECIPITATED WITHDRAWAL FROM OPIOID USE", DANGER, 4.0)
				var effects: Dictionary = withdrawal_data.get("effects", {})
				health = maxf(10.0, health * (1.0 - effects.get("vitality_drain", 0.0)))
				active_debuffs.append({
					"substance": substance_internal_id,
					"name": "Precipitated Withdrawal",
					"effects": effects,
					"remaining": withdrawal_data.get("duration_remaining", 600.0),
					"decay_multiplier": withdrawal_mult
				})

	# Track opioid doses for shared overdose meter
	if is_opioid:
		opioid_dose_count += 1
		opioid_dose_timer = elapsed

		# Check opioid overdose with CNS multiplier
		var overdose_triggered: = OpioidOverdoseSystem.check_overdose(opioid_dose_count, active_substance_ids, rng)
		if overdose_triggered:
			notify("OPIOID OVERDOSE - RESPIRATORY FAILURE", DANGER, 5.0)
			trigger_overdose("OPIOID OVERDOSE")
			opioid_dose_count = 0

	# Old precipitated withdrawal check (legacy, replaced by above)
	var precip_check: = AddictionSystem.check_precipitated_withdrawal(substance_internal_id, active_substance_ids)
	if precip_check:
		notify("PRECIPITATED WITHDRAWAL - VIOLENT REVERSAL UNDERWAY", DANGER, 4.0)
		apply_precipitated_withdrawal()
		return

	# Get purity tier for street substances (from item metadata)
	# TODO: Implement proper item metadata storage system
	# For now, purity tier would need to be encoded in the item_id string
	var purity_tier: int = 0
	var purity_data: Dictionary = {}

	# Apply purity multipliers from moth_content.gd if street substance
	var purity_multiplier: float = 1.0
	var purity_duration_multiplier: float = 1.0
	if purity_tier > 0:
		purity_data = MothContent.powder_purity(purity_tier)
		# Extract multipliers from purity data
		# Base tier 3 as 1.0x, scale others relative to it
		var base_duration: float = 60.0  # tier 3 baseline
		purity_duration_multiplier = float(purity_data.get("duration_seconds", base_duration)) / base_duration
		# Use stamina_regen_multiplier as proxy for overall effect strength
		var base_multiplier: float = 1.4  # tier 3 baseline
		purity_multiplier = float(purity_data.get("stamina_regen_multiplier", base_multiplier)) / base_multiplier

	# Calculate tolerance if redosing (simplified - no tolerance system implemented)
	var tolerance_multiplier: Dictionary = {"buff_multiplier": 1.0, "debuff_multiplier": 1.0, "addiction_multiplier": 1.0}

	# Apply buff with purity modifiers
	if substance_data.has("buff"):
		var buff: Dictionary = substance_data.get("buff", {})
		var base_buff_duration: float = float(buff.get("duration_seconds", 0.0))
		var buff_duration: float = base_buff_duration * tolerance_multiplier.get("buff_multiplier", 1.0) * purity_duration_multiplier

		# Apply purity multiplier to buff effects
		var buff_effects: Dictionary = buff.get("effects", {}).duplicate(true)
		if purity_tier > 0:
			for effect_key in buff_effects.keys():
				if buff_effects[effect_key] is float or buff_effects[effect_key] is int:
					buff_effects[effect_key] = float(buff_effects[effect_key]) * purity_multiplier

		active_buffs.append({
			"substance": substance_internal_id,
			"name": buff.get("name", ""),
			"effects": buff_effects,
			"remaining": buff_duration
		})

	# Apply debuff with purity modifiers
	if substance_data.has("debuff"):
		var debuff: Dictionary = substance_data.get("debuff", {})
		var base_debuff_duration: float = float(debuff.get("duration_seconds", 0.0))
		var debuff_duration: float = base_debuff_duration * tolerance_multiplier.get("debuff_multiplier", 1.0) * purity_duration_multiplier

		# Apply purity multiplier to debuff effects
		var debuff_effects: Dictionary = debuff.get("effects", {}).duplicate(true)
		if purity_tier > 0:
			for effect_key in debuff_effects.keys():
				if debuff_effects[effect_key] is float or debuff_effects[effect_key] is int:
					debuff_effects[effect_key] = float(debuff_effects[effect_key]) * purity_multiplier

		active_debuffs.append({
			"substance": substance_internal_id,
			"name": debuff.get("name", ""),
			"effects": debuff_effects,
			"remaining": debuff_duration
		})

	# Track addiction
	var addiction_level_str: String = substance_data.get("addiction_level", "None")
	var base_addiction: = AddictionSystem.ADDICTION_POINTS_PER_USE.get(addiction_level_str, 0)
	var addiction_gained: = int(base_addiction * tolerance_multiplier.get("addiction_multiplier", 1.0))
	addiction_points[substance_internal_id] = int(addiction_points.get(substance_internal_id, 0)) + addiction_gained
	addiction_last_use[substance_internal_id] = elapsed

	# Check for overdose
	if substance_data.has("overdose"):
		var od_data: Dictionary = substance_data.get("overdose", {})
		if bool(od_data.get("instant_death", false)):
			trigger_overdose("%s OVERDOSE" % substance_internal_id.to_upper())

	# Check for dangerous combinations
	var combo_check: Dictionary = StreetSubstances.check_dangerous_combination(active_substance_ids)
	if not combo_check.is_empty():
		var combo_name: String = combo_check.get("name", "UNKNOWN")
		notify("DANGEROUS COMBINATION: %s" % combo_name.to_upper(), DANGER, 4.0)
		var combo_id: String = combo_check.get("id", "")
		var combo_addiction: float = StreetSubstances.get_combination_addiction_multiplier(combo_id)
		addiction_points[substance_internal_id] = int(addiction_points.get(substance_internal_id, 0)) + int(addiction_gained * (combo_addiction - 1.0))

	if voluntary:
		notify("CONSUMED %s" % item_id.to_upper(), ACCENT, 2.5)
	else:
		notify("AUTONOMOUS CONSUMPTION - %s" % item_id.to_upper(), DANGER, 3.0)

	save_current_character("SUBSTANCE CONSUMED")

func consume_food(item_name: String) -> void:
	var food_data: = ConsumableFood.get_consumable_data(item_name)
	if food_data.is_empty():
		notify("THAT CANNOT BE CONSUMED", DANGER, 2.0)
		return

	# Check food block (Full Stomach debuff)
	if has_food_block():
		notify("TOO FULL TO EAT", ACCENT, 2.0)
		return

	var hot_type: = food_data.get("hot_dot_type", "")

	# Apply buff/HoT
	if food_data.has("buff"):
		apply_food_buff(food_data["buff"], hot_type, food_data.get("debuff", {}))
	elif food_data.has("hot"):
		apply_food_hot(food_data["hot"])

	# Apply debuff (immediate, not upon_expiration)
	if food_data.has("debuff"):
		var debuff_data = food_data["debuff"]
		if debuff_data.get("trigger", "") != "upon_expiration":
			apply_food_debuff(debuff_data)

	# Apply DoT if present
	if food_data.has("dot"):
		apply_food_dot(food_data["dot"])

	notify("CONSUMED %s" % item_name.to_upper(), ACCENT, 2.0)
	save_current_character("FOOD CONSUMED")

func has_food_block() -> bool:
	for debuff in active_debuffs:
		if debuff.get("effects", {}).has("food_block"):
			return true
	for buff in active_food_buffs:
		if buff.get("effects", {}).has("food_block"):
			return true
	return false

func apply_food_buff(buff_data: Dictionary, hot_type: String, debuff_data: Dictionary) -> void:
	var total_duration: = float(buff_data.get("total_duration", 60.0))
	var tick_interval: = float(buff_data.get("tick_interval", 10.0))

	var buff_record: = {
		"name": buff_data.get("name", "Food Buff"),
		"effects": buff_data.get("effects", {}).duplicate(true),
		"remaining": total_duration,
		"tick_interval": tick_interval,
		"tick_timer": tick_interval,
		"ramp_type": buff_data.get("ramp_type", "")
	}

	# Store debuff for upon_expiration trigger
	if not debuff_data.is_empty() and debuff_data.get("trigger", "") == "upon_expiration":
		buff_record["debuff_on_expiry"] = debuff_data

	active_food_buffs.append(buff_record)

func apply_food_hot(hot_data: Dictionary) -> void:
	var total_duration: = float(hot_data.get("total_duration", 60.0))
	var tick_interval: = float(hot_data.get("tick_interval", 10.0))
	var vitality_per_tick: = float(hot_data.get("vitality_per_tick", 0.0))

	active_food_hots.append({
		"name": hot_data.get("name", "Heal Over Time"),
		"vitality_per_tick": vitality_per_tick,
		"remaining": total_duration,
		"tick_interval": tick_interval,
		"tick_timer": tick_interval
	})

func apply_food_dot(dot_data: Dictionary) -> void:
	var duration: = float(dot_data.get("duration_seconds", 60.0))
	var tick_interval: = float(dot_data.get("tick_interval", 5.0))
	var vitality_drain: = float(dot_data.get("vitality_drain_per_tick", 0.0))

	active_food_dots.append({
		"name": dot_data.get("name", "Damage Over Time"),
		"vitality_drain_per_tick": vitality_drain,
		"remaining": duration,
		"tick_interval": tick_interval,
		"tick_timer": tick_interval
	})

func apply_food_debuff(debuff_data: Dictionary) -> void:
	var duration: = float(debuff_data.get("duration_seconds", 60.0))

	active_debuffs.append({
		"substance": "food_debuff",
		"name": debuff_data.get("name", "Food Debuff"),
		"effects": debuff_data.get("effects", {}).duplicate(true),
		"remaining": duration
	})

func attempt_autonomous_substance_use(substance_id: String) -> void:
	# Find any carried dose of this substance
	for item_name in inventory:
		if item_name.contains(substance_id) and (item_name.contains("(single)") or item_name.contains("(0.1g dose)")):
			inventory.erase(item_name)
			consume_substance(item_name, false)
			return

func apply_precipitated_withdrawal() -> void:
	# Extremely severe withdrawal effects
	health = maxf(10.0, health - 40.0)
	notify("EXTREME WITHDRAWAL - HEALTH REDUCED", DANGER, 4.0)

func breakdown_substance_package(item_id: String) -> bool:
	if reject_unsupported_online_mutation("PACKAGE BREAKDOWN", false):
		return false

	if not inventory.has(item_id):
		notify("YOU DO NOT HAVE THAT PACKAGE", DANGER, 2.5)
		return false

	var breakdown_result: Array = []

	# Check if pharmaceutical pack (contains "-pack")
	if item_id.contains("-pack"):
		var pack_size: int = 0
		if item_id.contains("(30-pack)"):
			pack_size = 30
		elif item_id.contains("(60-pack)"):
			pack_size = 60
		elif item_id.contains("(90-pack)"):
			pack_size = 90

		if pack_size > 0:
			breakdown_result = SubstancePackaging.break_pharma_pack(item_id, pack_size)

	# Check if street substance package (contains "g)" for grams)
	elif item_id.contains("g)") and not item_id.contains("dose"):
		# Extract substance and weight from item_id
		for substance_name in StreetSubstances.STREET_SUBSTANCES.keys():
			if item_id.to_lower().contains(substance_name.to_lower()):
				var street_key: String = substance_name
				var substance: Dictionary = StreetSubstances.STREET_SUBSTANCES[street_key]

				# Parse weight from item_id (e.g., "Crystal (1.0g)" -> 1.0)
				var weight_str: String = item_id.split("(")[1].split("g)")[0]
				var weight: float = float(weight_str)

				breakdown_result = SubstancePackaging.break_street_package(item_id, weight, substance.get("substance_id", ""))
				break

	if breakdown_result.is_empty():
		notify("THAT PACKAGE CANNOT BE BROKEN DOWN", DANGER, 2.5)
		return false

	inventory.erase(item_id)

	for dose_dict in breakdown_result:
		var dose_item: = String(dose_dict.get("item_id", ""))
		if not dose_item.is_empty():
			inventory.append(dose_item)

	notify("BROKE DOWN %s INTO %d DOSES" % [item_id.to_upper(), breakdown_result.size()], GOOD, 3.0)
	save_current_character("PACKAGE BROKEN DOWN")
	return true

func press_pill(item_id: String) -> bool:
	if reject_unsupported_online_mutation("PILL PRESS", false):
		return false

	if skill_level("Chemistry") < SubstancePackaging.PILL_PRESS_CHEMISTRY_LEVEL:
		notify("CHEMISTRY LEVEL %d REQUIRED TO PRESS PILLS" % SubstancePackaging.PILL_PRESS_CHEMISTRY_LEVEL, DANGER, 3.0)
		return false

	if not inventory.has(item_id):
		notify("YOU DO NOT HAVE THAT ITEM", DANGER, 2.5)
		return false

	# Pills must be in blister form to be pressed (checked for authenticity)
	if not item_id.contains("™") or item_id.contains("-pack"):
		notify("THAT ITEM CANNOT BE PRESSED", DANGER, 2.5)
		return false

	# For pill pressing, we need to determine authenticity tier
	# In a real implementation, this would be stored with the item
	# For now, assume a random tier based on item hash
	var item_hash: = hash(item_id + str(rng.randi()))
	var authenticity: int = 1 + (abs(item_hash) % SubstancePackaging.PILL_AUTHENTICITY_LEVELS.size())

	var tier_data: Dictionary = SubstancePackaging.pill_authenticity_data(authenticity)
	var tier_label: String = tier_data.get("label", "Unknown")

	notify("PILL PRESS RESULT: %s (TIER %d)" % [tier_label, authenticity], ACCENT, 4.0)
	grant_xp("Chemistry", 25)
	return true

func start_inventory_split() -> void :
	if not online_authority_enforced():
		notify("STACK SPLITTING REQUIRES A CONNECTED SERVER INVENTORY", ACCENT, 2.7)
		return
	var selection: = current_carried_inventory_selection()
	var record: Dictionary = selection.get("record", {})
	var quantity: = maxi(1, int(record.get("quantity", 1))) if not record.is_empty() else 1
	if quantity <= 1:
		notify("THAT CARRIED ITEM IS ALREADY ONE UNIT", ACCENT, 2.2)
		return
	reset_inventory_edit_state()
	equipment_split_active = true
	equipment_split_source_record_index = int(selection.get("record_index", -1))
	equipment_split_expected_record = record.duplicate(true)
	equipment_split_quantity = 1

func adjust_inventory_split_quantity(direction: int) -> void :
	if not equipment_split_active:
		return
	var source_quantity: = maxi(1, int(equipment_split_expected_record.get("quantity", 1)))
	equipment_split_quantity = clampi(equipment_split_quantity + direction, 1, maxi(1, source_quantity - 1))

func confirm_inventory_split() -> void :
	if not equipment_split_active or equipment_split_source_record_index < 0 or equipment_split_expected_record.is_empty():
		return
	var source_quantity: = maxi(1, int(equipment_split_expected_record.get("quantity", 1)))
	if equipment_split_quantity <= 0 or equipment_split_quantity >= source_quantity:
		notify("LEAVE AT LEAST ONE UNIT IN EACH STACK", DANGER, 2.3)
		return
	var split_item: = String(equipment_split_expected_record.get("item_id", "ITEM"))
	submit_online_economy_request("INVENTORY_SPLIT", {
		"source_index": equipment_split_source_record_index, 
		"destination_index": equipment_split_source_record_index + 1, 
		"split_quantity": equipment_split_quantity, 
		"expected_record": equipment_split_expected_record.duplicate(true), 
	}, true, {"item_id": split_item, "split_quantity": equipment_split_quantity})

