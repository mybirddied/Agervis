func draw_bank_lobby_wall_column(x: float, width: float, tint: Color) -> void :
	var top: = ARCH_WALL_TOP
	var bottom: = ARCH_BASEBOARD_Y
	var right: = x + width
	var column: = int(x / 128.0)
	var mortar: = tint.darkened(0.3)
	var courses: = 4
	var course_h: = (bottom - top) / float(courses)
	for course in range(courses):
		var cy: = top + course * course_h

		var stagger: = 0.0 if course % 2 == 0 else width * 0.5
		for block in range(2):
			var bx: = x + stagger + block * width
			var face: = Rect2(bx + 1.0, cy + 1.0, width - 2.0, course_h - 2.0)
			if face.position.x < right and face.end.x > x:
				draw_rect(face, tint.darkened(0.03 + float(posmod(course * 7 + block * 3 + column, 4)) * 0.035))
		draw_line(Vector2(x, cy), Vector2(right, cy), mortar, 1.0)
		draw_line(Vector2(x, cy + 1.5), Vector2(right, cy + 1.5), tint.lightened(0.14), 1.0)
	if column % 2 == 1:
		var pilaster: = Rect2(x + width * 0.34, top, width * 0.32, bottom - top)
		draw_rect(pilaster, tint.lightened(0.08))
		draw_line(pilaster.position, Vector2(pilaster.position.x, pilaster.end.y), tint.lightened(0.24), 2.0)
		draw_line(Vector2(pilaster.end.x, top), pilaster.end, mortar, 2.0)

		draw_rect(Rect2(pilaster.position.x - 3.0, top, pilaster.size.x + 6.0, 7.0), tint.lightened(0.18))
		draw_rect(Rect2(pilaster.position.x - 3.0, bottom - 9.0, pilaster.size.x + 6.0, 9.0), tint.darkened(0.12))



func draw_bank_lobby_floor_column(x: float, column: int, width: float, tint: Color) -> void :
	var right: = x + width
	var bands: = floor_row_bands()
	var base: = tint.darkened(0.08)
	var brass: = Color("#7c6a3f")
	for row in range(bands.size() - 1):
		var top: = bands[row]
		var band_h: = bands[row + 1] - top
		draw_rect(Rect2(x, top, width, band_h), base.darkened(0.07 - float(row % 2) * 0.05))

		var seam_x: = x + float(posmod(column * 61 + row * 17, 100)) / 100.0 * width
		draw_line(Vector2(seam_x, top), Vector2(seam_x, top + band_h), base.darkened(0.18), 1.0)
		if not low_spec and band_h > 22.0:
			for fleck in range(4):
				var fx: = x + float(posmod(fleck * 37 + column * 23 + row * 11, 100)) / 100.0 * width
				var fy: = top + float(posmod(fleck * 53 + row * 31, 100)) / 100.0 * band_h
				draw_rect(Rect2(fx, fy, 2.0, 2.0), base.lightened(0.22))
		draw_line(Vector2(x, top), Vector2(right, top), brass, 1.0)






func draw_school_floor_column(floor_tile: int, x: float, column: int, width: float, waxed: bool) -> void :
	var right: = x + width
	var bands: = floor_row_bands()
	var base: = Color("#8e9a86") if waxed else Color("#4a4f46")
	if floor_tile == 20:
		base = base.darkened(0.16)
	elif floor_tile == 19:
		base = base.lightened(0.05)
	for row in range(bands.size() - 1):
		var top: = bands[row]
		var band_h: = bands[row + 1] - top
		draw_rect(Rect2(x, top, width, band_h), base.darkened(0.08 - float(row % 2) * 0.06))


		var tile_w: = maxf(band_h * 1.9, 16.0)
		var tiles: = int(ceil(width / tile_w))
		for tile in range(tiles):
			var tx: = x + tile * tile_w
			var tile_right: = minf(tx + tile_w, right)
			if posmod(tile + row + column, 2) == 1:
				draw_rect(Rect2(tx, top, tile_right - tx, band_h), base.darkened(0.1))
			draw_line(Vector2(tx, top), Vector2(tx, top + band_h), base.darkened(0.2), 1.0)
			if not low_spec and band_h > 18.0:


				for fleck in range(2):
					var fx: = tx + float(posmod(tile * 41 + fleck * 67 + column * 19, 100)) / 100.0 * (tile_right - tx)
					var fy: = top + float(posmod(tile * 29 + fleck * 47 + row * 13, 100)) / 100.0 * band_h
					draw_rect(Rect2(fx, fy, 2.0, 2.0), base.lightened(0.18 if waxed else 0.1))
		if waxed and not low_spec and band_h > 24.0:
			var sheen_y: = top + band_h * 0.7
			draw_line(Vector2(x + 6.0, sheen_y), Vector2(right - 6.0, sheen_y), base.lightened(0.13), 2.0)
		draw_line(Vector2(x, top), Vector2(right, top), base.darkened(0.24), 1.0)

