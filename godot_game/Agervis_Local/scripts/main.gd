func check_jail_edge_transition() -> void :


	if vault_active or player_downed:
		return
	for wrap in horizontal_room_wraps():
		var side: = String(wrap.get("side", ""))
		var crossed: = (side == "left" and player_position.x < 34.0) or (side == "right" and player_position.x > 966.0)
