	draw_circle(Vector2(indicator_x, 370), 8, Color("#b98555"))
	draw_circle(Vector2(indicator_x, 370), 6, PAPER)


	var speed_indicator: = cooking_indicator_speed
	for i in range(3):
		var line_offset: = (i - 1) * 3
		var line_alpha: = 0.5 + speed_indicator * 0.3
		draw_line(Vector2(indicator_x + line_offset, 365), Vector2(indicator_x + line_offset, 375), Color(PAPER.r, PAPER.g, PAPER.b, line_alpha), 1.0)


	var instruction_y: = 420.0
	if last_input_controller:
		draw_centered("PRESS ANY FACE BUTTON WHEN INDICATOR IS IN GREEN ZONE", Vector2(640, instruction_y), 12, Color("#bcb5aa"))
	else:
		draw_centered("PRESS [SPACE] OR [E] WHEN INDICATOR IS IN GREEN ZONE", Vector2(640, instruction_y), 12, Color("#bcb5aa"))


	var distance_from_center: float = abs(cooking_indicator_position - (zone_start + zone_width * 0.5))
	var accuracy_text: = ""
	if cooking_indicator_position >= zone_start and cooking_indicator_position <= zone_start + zone_width:
		var accuracy: float = 100.0 - (distance_from_center / (zone_width * 0.5)) * 100.0
		accuracy_text = "ACCURACY: %.0f%%" % accuracy
		draw_centered(accuracy_text, Vector2(640, 450), 11, GOOD)





func draw_cooking_temperature_challenge() -> void :
	var bar: = Rect2(380, 340, 520, 50)


	draw_rect(bar, Color("#0e1012"))
	if not low_spec:
		draw_rect(Rect2(bar.position.x, bar.position.y, bar.size.x, 4), Color("#08090a"))
	draw_rect(bar, Color("#3a3c3e"), false, 2.0)


	var target_x: = 380 + 520 * cooking_target_temp_min
	var target_w: = 520 * (cooking_target_temp_max - cooking_target_temp_min)
	var target_zone: = Rect2(target_x, 340, target_w, 50)

	if not low_spec:
		var glow_pulse: = 0.15 + 0.1 * sin(elapsed * 3.0)
		draw_rect(target_zone.grow(3), Color(GOOD.r, GOOD.g, GOOD.b, glow_pulse))

	draw_rect(target_zone, Color(GOOD.r, GOOD.g, GOOD.b, 0.25))
	draw_rect(target_zone, GOOD, false, 2.5)


	draw_rect(Rect2(target_zone.position.x, target_zone.position.y, 3, target_zone.size.y), GOOD.lightened(0.3))
	draw_rect(Rect2(target_zone.end.x - 3, target_zone.position.y, 3, target_zone.size.y), GOOD.lightened(0.3))


	var temp_fill: = bar.size.x * cooking_temperature
	if temp_fill > 0:
		var temp_color: = DANGER if cooking_temperature > cooking_target_temp_max else (GOOD if cooking_temperature >= cooking_target_temp_min else Color("#6b8aa3"))
		var fill_rect: = Rect2(bar.position.x + 2, bar.position.y + 2, minf(temp_fill - 4, bar.size.x - 4), bar.size.y - 4)


		draw_rect(fill_rect, temp_color.darkened(0.2))


		draw_rect(Rect2(fill_rect.position.x, fill_rect.position.y, fill_rect.size.x, 6), temp_color.lightened(0.3))


		if cooking_temperature > cooking_target_temp_max and not low_spec:
			var shimmer: float = abs(sin(elapsed * 10.0)) * 0.5
			draw_rect(fill_rect.grow(1), Color(DANGER.r, DANGER.g, DANGER.b, shimmer))


		if cooking_temperature < cooking_target_temp_min and not low_spec:
			for i in range(5):
				var crystal_x: = fill_rect.position.x + (fill_rect.size.x / 5.0) * i + randf_range(-2, 2)
				var crystal_y: = fill_rect.position.y + randf_range(5, fill_rect.size.y - 5)
				draw_circle(Vector2(crystal_x, crystal_y), 2, Color("#9eb5c4"))


	var temp_percent: = int(cooking_temperature * 100)
	var temp_text: = "%d°" % temp_percent
	var temp_text_color: = DANGER if cooking_temperature > cooking_target_temp_max else (GOOD if cooking_temperature >= cooking_target_temp_min else Color("#8ba4b8"))
	draw_centered(temp_text, Vector2(640, 365), 16, temp_text_color)


	draw_text("❄ COLD", Vector2(385, 400), 10, Color("#6b8aa3"))
	draw_text("✓ TARGET", Vector2(target_x + 10, 400), 10, GOOD)
	draw_text("🔥 BURNT", Vector2(850, 400), 10, DANGER)


	var rise_speed: = "SLOW" if cooking_temperature < 0.3 else ("MEDIUM" if cooking_temperature < 0.6 else "FAST")
	var rise_color: = ACCENT if cooking_temperature < 0.6 else DANGER
	draw_centered("RISE SPEED: %s" % rise_speed, Vector2(640, 415), 10, rise_color)


	var instruction_y: = 435.0
	if last_input_controller:
		draw_centered("PRESS ANY FACE BUTTON TO LOCK TEMPERATURE IN GREEN ZONE", Vector2(640, instruction_y), 12, Color("#bcb5aa"))
	else:
		draw_centered("PRESS [SPACE] OR [E] TO LOCK TEMPERATURE IN GREEN ZONE", Vector2(640, instruction_y), 12, Color("#bcb5aa"))






func draw_cooking_sequence_challenge() -> void :
	var y: = 340.0


	draw_centered("TARGET SEQUENCE:", Vector2(640, y), 13, ACCENT)
	y += 25
	var key_spacing: = 50.0
	var start_x: = 640 - (cooking_sequence_target.size() * key_spacing) / 2.0
	for i in range(cooking_sequence_target.size()):
		var key: = cooking_sequence_target[i]
		var x: = start_x + i * key_spacing
		var key_rect: = Rect2(x, y, 40, 40)
		var entered: = i < cooking_sequence_input.size()
		var correct: = entered and cooking_sequence_input[i] == key
		var wrong: = entered and cooking_sequence_input[i] != key

		var key_color: = GOOD if correct else (DANGER if wrong else Color("#3a3c3e"))
		draw_rect(key_rect, Color("#1a1c1e"))
		draw_rect(key_rect, key_color, false, 2.0)
		draw_centered(key, Vector2(x + 20, y + 26), 16, PAPER if entered else Color("#7a7d72"))


	y += 60
	draw_centered("YOUR INPUT:", Vector2(640, y), 13, ACCENT)
	y += 25
	start_x = 640 - (cooking_sequence_target.size() * key_spacing) / 2.0
	for i in range(cooking_sequence_target.size()):
		var x: = start_x + i * key_spacing
		var key_rect: = Rect2(x, y, 40, 40)
		draw_rect(key_rect, Color("#1a1c1e"))
		draw_rect(key_rect, Color("#454851"), false, 1.0)
		if i < cooking_sequence_input.size():
			draw_centered(cooking_sequence_input[i], Vector2(x + 20, y + 26), 16, PAPER)

	draw_centered("PRESS [W] [A] [S] [D] IN CORRECT ORDER", Vector2(640, 480), 12, Color("#bcb5aa"))

