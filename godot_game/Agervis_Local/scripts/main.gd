func draw_station(world_point: Vector2, label: String, completed: bool) -> void :
	var point: = scene_position(world_point)
	var marker_color: = GOOD if completed else Color("#77736d")

	var floor_plate: = Rect2(point.x - 21, point.y + 16, 42, 9)
	draw_rect(floor_plate.grow(1), Color(0, 0, 0, 0.3))
	draw_rect(floor_plate, Color("#242826"))
	draw_rect(floor_plate, Color.BLACK, false, 2.0)
	draw_rect(floor_plate, marker_color.darkened(0.12), false, 2.0)

	if completed:
		draw_rect(floor_plate.grow(2), marker_color.darkened(0.4), false, 1.0)
		draw_circle(Vector2(point.x, point.y + 20), 3, marker_color.lightened(0.3))

	var label_width: = maxf(96.0, font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 22.0)
	var label_rect: = Rect2(point.x - label_width * 0.5, point.y - 53, label_width, 25)
	draw_rect(label_rect.grow(2), Color(0, 0, 0, 0.3))
	draw_rect(label_rect, Color(0.025, 0.027, 0.03, 0.78))
	draw_rect(label_rect, Color.BLACK, false, 1.5)

	draw_line(Vector2(label_rect.position.x, label_rect.end.y), Vector2(label_rect.end.x, label_rect.end.y), marker_color.darkened(0.3), 3.0)
	draw_line(Vector2(label_rect.position.x, label_rect.end.y), Vector2(label_rect.end.x, label_rect.end.y), marker_color, 2.0)

	if completed:
		var check_center: = Vector2(label_rect.position.x + 10, point.y - 40)
		draw_line(check_center + Vector2(-3, 0), check_center + Vector2(-1, 3), marker_color, 2.0)
		draw_line(check_center + Vector2(-1, 3), check_center + Vector2(4, -4), marker_color, 2.0)
	draw_centered(("[OK] " if completed else "") + label, point + Vector2(0, -35), 12, PAPER)

