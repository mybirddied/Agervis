func pike_can_witness_driveby(car: Dictionary) -> bool:
	var officer: = actor_by_id("officer_pike")
	return officer != null and not officer.removed and officer.area == "street" and absf(officer.position.x - float(car.get("x", 0.0))) <= DRIVEBY_PIKE_WITNESS_X_RANGE

