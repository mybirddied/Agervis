func cashier_task_label(task: String) -> String:
	return {"stock": "STOCK THE SNACK SHELF", "register": "WORK THE EMPLOYEE REGISTER", "clean": "MOP THE SPILL"}.get(task, "WAIT FOR BOSS TO INVENT WORK")

func choose_next_cashier_assignment() -> void :
	if active_job != "Cashier":
		cashier_current_task = ""
		refresh_active_task_text()
		return
	if online_economy_enabled():
		if cashier_current_task.is_empty():
			request_online_cashier_assignment()
		refresh_active_task_text()
		return
	var director: Dictionary = Dictionary(task_directors.get("boss_store", {})).duplicate(true)
	if String(director.get("state", "")) == "assigned" and String(director.get("owner", "")) == player_name:
		cashier_current_task = String(director.get("task", ""))
		sync_cashier_contract()
		refresh_active_task_text()
		return
	if String(director.get("state", "")) == "delayed" and elapsed < float(director.get("retry_at", 0.0)):
		cashier_current_task = ""
		sync_cashier_contract()
		refresh_active_task_text()
		return
	var available: Array[String] = []
	for task in ["stock", "register", "clean"]:
		if not bool(cashier_tasks.get(task, false)):
			available.append(task)
	if available.is_empty():
		cashier_current_task = ""
		task_directors["boss_store"] = {"owner": player_name, "task": "", "variation": 0, "state": "completed", "generation": int(director.get("generation", 0))}
		sync_cashier_contract()
		refresh_active_task_text()
		return
	available.shuffle()
	cashier_current_task = available[0]
	task_directors["boss_store"] = {
		"owner": player_name, 
		"task": cashier_current_task, 
		"variation": rng.randi_range(0, 2), 
		"state": "assigned", 
		"generation": int(director.get("generation", 0)) + 1, 
		"issued_at": elapsed, 
		"retry_at": 0.0, 
	}
	sync_cashier_contract()
	refresh_active_task_text()

func request_online_cashier_assignment() -> void :
	if not online_economy_enabled() or active_job != "Cashier" or not cashier_current_task.is_empty() or elapsed < cashier_assignment_retry_at:
		return
	cashier_assignment_retry_at = elapsed + 3.0
	submit_online_economy_request("CASHIER_TASK_ASSIGN", {}, false)
func cashier_task_questions(task: String) -> Array[Dictionary]:
	match task:
		"register": return [
			{"question": "Total is $7. Customer hands you $10.", "answers": ["Return $3", "Return $17", "Keep it silently", "Ask the refrigerator"]}, 
			{"question": "A sealed deposit bag is short $5.", "answers": ["Recount before sealing", "Seal it faster", "Add drawer money secretly", "Blame the bus stop"]}, 
			{"question": "The receipt printer jams during a sale.", "answers": ["Pause and record the sale", "Mash every key", "Discard the cash", "Invent a receipt number"]}, 
		]
		"stock": return [
			{"question": "Boss points to the shelf label ending 42.", "answers": ["Match the box ending 42", "Use the brightest box", "Hide the label", "Stock by smell"]}, 
			{"question": "A glass bottle is leaking in the snack case.", "answers": ["Isolate it before stocking", "Put chips under it", "Turn the label inward", "Call it marinade"]}, 
			{"question": "Two products share similar packaging.", "answers": ["Check both item codes", "Guess by weight", "Mix them evenly", "Price both as beer"]}, 
		]
		_: return [
			{"question": "The spill is moving toward an outlet.", "answers": ["Block the area and cut power", "Mop toward the outlet", "Add water", "Wait for a customer"]}, 
			{"question": "The mop water is visibly worse than the floor.", "answers": ["Replace the water", "Use more perfume", "Mop the counter too", "Rename the color"]}, 
			{"question": "A customer walks into the wet aisle.", "answers": ["Warn and redirect them", "Mop around their shoes", "Turn off the lights", "Invoice the sidewalk"]}, 
		]

func begin_cashier_assignment(task: String) -> void :
	var object_id: = "cashier_" + task
	if not task_object_is_visible(object_id):
		notify("THAT ASSIGNMENT IS NOT IN THIS ROOM", DANGER, 3.0)
		return
	if not cashier_action_task.is_empty():
		notify("FINISH OR FAIL THE TASK ALREADY IN YOUR HANDS", ACCENT, 2.5)
		return
	if cashier_current_task.is_empty():
		choose_next_cashier_assignment()
		if online_economy_enabled():
			notify("BOSS IS POSTING THE NEXT ASSIGNMENT", ACCENT, 2.0)
			return
	var director: Dictionary = Dictionary(task_directors.get("boss_store", {}))
	if String(director.get("owner", "")) != player_name or String(director.get("state", "")) != "assigned":
		notify("BOSS HAS NOT ASSIGNED YOU A LIVE TASK", ACCENT, 2.5)
		return
	if task != String(director.get("task", "")):
		notify("BOSS ASSIGNED: %s" % cashier_task_label(String(director.get("task", ""))), ACCENT, 2.5)
		return
	if bool(cashier_tasks.get(task, false)):
		notify("THAT TASK HAS ALREADY BEEN CLAIMED", ACCENT, 2.2)
		return
	cashier_action_task = task
	cashier_action_step = 0
	cashier_action_failures = 0
	open_cashier_action_step()
func open_cashier_action_step() -> void :
	var questions: = cashier_task_questions(cashier_action_task)
	if cashier_action_step >= questions.size():
		var finished_task: = cashier_action_task
		cashier_action_task = ""
		complete_cashier_assignment(finished_task)
		return
	var director: Dictionary = Dictionary(task_directors.get("boss_store", {}))
	var variation: = int(director.get("variation", 0))
	var question_index: = posmod(cashier_action_step + variation, questions.size())
	var entry: Dictionary = questions[question_index]
	var options: Array[Dictionary] = []
	var answers: Array = entry["answers"]
	for answer_index in range(answers.size()):
		options.append({"label": String(answers[answer_index]), "id": "cashier_answer_correct" if answer_index == 0 else "cashier_answer_wrong"})
	options.shuffle()
	open_dialog("%s  -  VARIATION %d  -  STEP %d/3" % [cashier_task_label(cashier_action_task), variation + 1, cashier_action_step + 1], [String(entry["question"]), "One bad action delays the task. Guessing is an unpaid strategy."], options)
func resolve_cashier_answer(correct: bool) -> void :
	mode = ScreenMode.PLAY
	if cashier_action_task.is_empty():
		return
	if not correct:
		cashier_action_failures += 1
		release_cashier_assignment("The assigned variation was failed.")
		return
	cashier_action_step += 1
	open_cashier_action_step()
func complete_cashier_assignment(task: String) -> void :
	var director: Dictionary = Dictionary(task_directors.get("boss_store", {})).duplicate(true)
	if task != String(director.get("task", "")) or String(director.get("state", "")) != "assigned":
		notify("TASK DIRECTOR REJECTED THAT COMPLETION", DANGER, 2.5)
		return
	if bool(cashier_tasks.get(task, false)):
		notify("ANOTHER WORKER ALREADY CLAIMED THAT TASK", ACCENT, 2.2)
		return
	if online_economy_enabled():
		cashier_action_step = 0
		cashier_action_failures = 0
		submit_online_economy_request("CASHIER_TASK_COMPLETE", {
			"task_id": task, "interaction_sequence_valid": true, 
		}, true, {"task_id": task})
		refresh_active_task_text()
		return
	cashier_tasks[task] = true
	director["state"] = "completed"
	director["completed_at"] = elapsed
	task_directors["boss_store"] = director
	var standing: = clampi(int(employer_standing.get("Boss's Corner Store", 0)), 0, Build9.EMPLOYER_STANDING.size() - 1)
	var task_pay: = 5 + standing * 2
	cash += task_pay
	grant_xp("Endurance" if task == "clean" else "Enterprise", 65 if task != "register" else 80)
	if cashier_tasks.values().all( func(value): return value):
		employer_standing["Boss's Corner Store"] = mini(standing + 1, Build9.EMPLOYER_STANDING.size() - 1)
	cashier_current_task = ""
	choose_next_cashier_assignment()
	refresh_active_task_text()
	notify("TASK COMPLETE  -  CLEAN PAY +$%d" % task_pay, GOOD, 3.0)
func attempt_restocking_theft(stock_id: String, item_name: String, required_stealth: int, base_seconds: float, camera_description: String) -> bool:
	if reject_unsupported_online_mutation("SHOPLIFTING"):
		return false
	var remaining: = float(theft_restock_timers.get(stock_id, 0.0))
	if remaining > 0.0:
		notify("DISPLAY EMPTY  -  RESTOCK IN ABOUT %ds" % int(ceil(remaining)), ACCENT, 2.5)
		return false
	if skill_level("Stealth") < required_stealth:
		notify("STEALTH LEVEL %d REQUIRED  -  THE WATCHERS ARE BORED, NOT BLIND" % required_stealth, DANGER, 3.0)
		return false
	if not grant_carried_item(item_name, "THE DISPLAY"):
		return false
	theft_restock_timers[stock_id] = base_seconds * rng.randf_range(0.9, 1.1)
	shoplifted_goods += 1
	add_crime("SHOPLIFTING")
	grant_xp("Stealth", 65 + required_stealth * 8)
	record_camera_event("THEFT", player_name, camera_description, 24 + required_stealth * 3, player_position)
	store_insurance_pressure = minf(1.0, store_insurance_pressure + 0.005)
	activate_mark()
	return true

