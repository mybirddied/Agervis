func purchase_education_reward(item_name: String, cost: int) -> void :
	if reject_unsupported_online_mutation("EDUCATION REWARD"):
		return
	if education_points < cost or item_name in inventory:
		return
	if not can_receive_inventory_item(item_name):
		notify("CARRY SPACE IS FULL - EQUIP A BACKPACK OR MAKE ROOM", DANGER, 3.0)
		return
	education_points -= cost
	inventory.append(item_name)
	notify("%s RECEIVED  -  %d SCHOLARSHIP POINTS REMAIN" % [item_name.to_upper(), education_points], GOOD, 4.0)

func numeric_index(key: InputEventKey) -> int:
	if key.keycode >= KEY_1 and key.keycode <= KEY_9:
		return key.keycode - KEY_1
	return -1

