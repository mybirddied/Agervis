func draw_hospital_ward_patient(point: Vector2, patient_id: String) -> void :
	var skin: = Color("#a66f50")
	var hair: = Color("#302820")
	var gown: = Color("#9aa9a0")
	match patient_id:
		"subscription":
			skin = Color("#b77d58")
			hair = Color("#3b3028")
			gown = Color("#718d8a")
		"appeal":
			skin = Color("#754b37")
			hair = Color("#252421")
			gown = Color("#8f8798")
		"docket":
			skin = Color("#d09a70")
			hair = Color("#81633e")
			gown = Color("#8c9aa2")
	draw_circle(point + Vector2(-51, -28), 12, skin)
	draw_circle(point + Vector2(-55, -32), 9, hair)
	draw_rect(Rect2(point.x - 40, point.y - 37, 39, 23), gown)
