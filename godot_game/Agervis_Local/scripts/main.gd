		return
	var follow_point: = player_position + Vector2(-70.0 * facing, 18.0)
	actor.position = actor.position.move_toward(follow_point, 125.0 * delta)

func deposit_origin_x() -> float:
	match deposit_source:
		"restaurant": return 3040.0
		"laundromat": return 4380.0
	return 5100.0

func check_ambush_trigger() -> void :
	if not deposit_active or ambush_spawned or player_position.x < deposit_origin_x() + 760.0:
		return
	ambush_spawned = true
	if deposit_source == "store" and escort_trusted:
		return
	var robber: = Actor.new("robber_vex", "Vex", "Robber", "street", Vector2(player_position.x + 180.0, player_position.y - 15), Color("#9b4d4d"))
	robber.hostile = true
	robber.cash = 12
	actors.append(robber)
	notify("Someone noticed the deposit bag.", DANGER, 3.0)

func player_attack() -> void :
	if phase == "tutorial":
		notify("THE SCHOOL HAS DISABLED VIOLENCE FOR ORIENTATION", ACCENT, 2.5)
		return


	if attack_animation_timer > 0.0 and attack_phase in ["strike", "impact_hold", "followthrough"]:
		if not queued_attack:
			queued_attack = true
			attack_queue_timer = attack_queue_window
		return

	if not can_player_act():
		var reasons: = []
		if player_knockdown: reasons.append("KNOCKDOWN")
		if player_downed: reasons.append("DOWNED")
		if player_detained: reasons.append("DETAINED")
		if player_arrested: reasons.append("ARRESTED")
		notify("CANNOT ACT: %s" % " + ".join(reasons), DANGER, 1.5)
		return

	var weapon_stats: = get_weapon_stats()
	var weapon_range: = float(weapon_stats.get("range", 92.0))
	var requires_facing: = bool(weapon_stats.get("requires_facing", true))

	var target: = nearest_facing_actor(weapon_range, true) if requires_facing else nearest_actor(weapon_range, true)
	if target == null:

		attack_cooldown = 0.35
		return


	var weapon: = active_attack_weapon()
	attack_weapon_used = weapon

	if weapon == "Fists":

		if combo_count > 0 and combo_timer > 0.0:

			if combo_count % 3 == 0:
				attack_type = "kick"
			elif combo_count % 2 == 0:
				attack_type = "heavy_punch"
			else:
				attack_type = "punch"
		else:

			var roll: = rng.randf()
			if roll < 0.7:
				attack_type = "punch"
			else:
				attack_type = "kick"
	elif weapon in ["Knife", "Kitchen Knife", "Scalpel", "Shiv", "Box Cutter"]:
		attack_type = "stab" if rng.randf() < 0.5 else "slash"
	elif weapon in ["Pipe", "Bat", "Baseball Bat", "Crowbar", "Pipe Wrench", "Tire Iron", "Wrench", "Hammer", "Sledgehammer", "Bolt Cutters"]:
		attack_type = "overhead" if rng.randf() < 0.4 else "slash"
	elif weapon in ["Pistol", "Worn Revolver", "Revolver", "SMG"]:
		attack_type = "shoot_1h"
	elif weapon in ["Shotgun", "Rifle", "AR"]:
		attack_type = "shoot_2h"
	elif weapon in ["Grenade", "Molotov", "Rock", "Brick"]:
		attack_type = "throw"
	else:
		attack_type = "slash"


	var attack_data: = get_attack_data(attack_type)
	if attack_data.is_empty():
		attack_type = "punch"
		attack_data = get_attack_data(attack_type)

	var base_stamina_cost: = float(attack_data.get("stamina_cost", 15.0))
	var weapon_stamina_mult: = float(weapon_stats.get("stamina_multiplier", 1.0))
	var stamina_cost: = base_stamina_cost * weapon_stamina_mult

	if stamina < stamina_cost:
		notify("NOT ENOUGH STAMINA", DANGER, 1.0)
		return


	stamina -= stamina_cost
	stamina_regen_delay = 0.5


	var total_duration: = get_attack_total_duration(attack_data)
	attack_animation_timer = total_duration
	attack_frame = 0.0
	attack_phase = "windup"
	attack_cooldown = total_duration + 0.1


	if lan_session.active:
		var office_target: = target if is_laundry_office_actor(target) else null
		var office_target_id: = office_target.actor_id if office_target != null else ""
		lan_session.request_attack(office_target_id, local_lan_state())
		return

func actor_stress_snap(actor: AgervisActor) -> void :

	actor.stress = 0.0
	actor.witnessed_violence = false


	var snap_behaviors: = ["attack_nearest", "attack_player", "attack_random", "self_harm"]
	var behavior: String = snap_behaviors[rng.randi_range(0, snap_behaviors.size() - 1)]

	match behavior:
		"attack_player":
			actor.hostile = true
			actor.ai_state = "chase"
			add_world_note("%s snapped and is attacking you!" % actor.display_name)
		"attack_nearest":

			var nearest: AgervisActor = null
			var nearest_dist: = 999999.0
			for other in actors:
				if other == actor or other.removed or other.downed or other.hostile:
					continue
				if other.area != actor.area:
					continue
				var dist: = actor.position.distance_to(other.position)
				if dist < nearest_dist:
					nearest = other
					nearest_dist = dist
			if nearest != null:
				nearest.take_damage(50.0)
				spawn_blood(nearest.position, "strike", 8)
				add_world_note("%s snapped and attacked %s!" % [actor.display_name, nearest.display_name])
				record_camera_event("ASSAULT", actor.display_name, "Stress-induced attack against %s." % nearest.display_name, 24, actor.position)
		"attack_random":

			var visible_actors: = []
			for other in actors:
				if other == actor or other.removed or other.downed:
					continue
				if other.area == actor.area and actor_visible_in_current_room(other):
					visible_actors.append(other)
			if visible_actors.size() > 0:
				var victim: AgervisActor = visible_actors[rng.randi_range(0, visible_actors.size() - 1)]
				victim.take_damage(45.0)
				spawn_blood(victim.position, "strike", 7)
				add_world_note("%s snapped and attacked %s randomly!" % [actor.display_name, victim.display_name])
				record_camera_event("ASSAULT", actor.display_name, "Random stress-induced attack against %s." % victim.display_name, 24, actor.position)
		"self_harm":
			actor.take_damage(80.0)
			spawn_blood(actor.position, "strike", 10)
			add_world_note("%s snapped and harmed themselves!" % actor.display_name)
			record_camera_event("SELF-HARM", actor.display_name, "Stress-induced self-harm.", 20, actor.position)

func player_has_gun_equipped() -> bool:
	return active_attack_weapon() in ["Pistol", "Revolver", "SMG", "Shotgun", "Rifle", "AR"]

func player_has_gun_in_inventory() -> bool:
	for gun in ["Worn Revolver", "Pistol", "Revolver", "SMG", "Shotgun", "Rifle", "AR"]:
		if gun in inventory:
			return true
	return false

func apply_gun_presence_modifier(actor: AgervisActor, base_trust: int) -> int:

	var modified_trust: = base_trust
	if player_has_gun_equipped():
		modified_trust -= 25
	elif player_has_gun_in_inventory():
		modified_trust -= 12


	if actor.was_shot:
		modified_trust -= 50
		actor.hostile = true


	if actor.witnessed_gun_execution:
		modified_trust -= 35

	return clampi(modified_trust, 0, 100)

func spread_dangerous_reputation(witness: AgervisActor) -> void :


	for actor in actors:
		if actor == witness or actor.removed:
			continue
		if actor.area == witness.area and actor.position.distance_to(witness.position) < 500.0:

			actor.dangerous_reputation = minf(100.0, actor.dangerous_reputation + 25.0)
			actor.witnessed_gun_execution = true

func damage_player(amount: float, attacker: AgervisActor) -> void :
	if god_mode:
		return
	if player_downed:
		return
	sleeping = false
	spawn_blood(player_position, "attack", maxi(4, int(amount / 4.0)))

	# Apply guard mitigation from buffs/debuffs
	var guard_mitigation: = get_effect_additive("guard_mitigation", 0.0)
	var guard_mitigation_kinetic: = get_effect_additive("guard_mitigation_kinetic", 0.0)
	var total_mitigation: = clampf(guard_mitigation + guard_mitigation_kinetic, 0.0, 0.95)
	var mitigated_damage: = amount * (1.0 - total_mitigation)

	# Apply vitality floor from buffs/debuffs
	var vitality_floor: = get_effect_additive("vitality_floor", 0.0)
	var min_health: = maxf(0.0, vitality_floor)

	health = maxf(min_health, health - mitigated_damage)
	record_camera_event("ASSAULT", attacker.display_name, "Attack against %s." % player_name, 18, player_position)


	var knockback_direction: = (player_position - attacker.position).normalized()
	var knockback_force: = clampf(amount * 2.5, 40.0, 180.0)
	var knockdown_base_chance: = clampf(amount / 100.0, 0.05, 0.4)


	var weapon_multiplier: = 1.0
	var attacker_weapon: = String(attacker.attack_weapon_override if not attacker.attack_weapon_override.is_empty() else "Fists")
	if attacker_weapon in ["Pipe", "Bat", "Crowbar", "Wrench", "Hammer", "Sledgehammer"]:
		weapon_multiplier = 1.5
		knockdown_base_chance += 0.15
	elif attacker_weapon in ["Knife", "Kitchen Knife", "Scalpel", "Shiv", "Box Cutter"]:
		weapon_multiplier = 0.8
		knockdown_base_chance += 0.05


	var attacker_fighting_level: = 3
	if attacker.role == "Officer":
		attacker_fighting_level = 6
	elif attacker.hostile:
		attacker_fighting_level = 4

	apply_knockback_to_player(knockback_force, knockback_direction, knockdown_base_chance, attacker_fighting_level, weapon_multiplier)

	if health <= 0.0:
		enter_player_downed("%s reduced your health to zero." % attacker.display_name)
		if is_laundry_office_actor(attacker):
			laundry_mob_defeat_pending = true
			downed_disposition_resolved = true

func enter_player_downed(reason: String) -> void :
	if god_mode:
		return
	if player_downed:
		return
	player_downed = true
	spawn_blood(player_position, "downed", 12)
	downed_timer = 0.0
	downed_reason = reason
	downed_disposition_resolved = false
	health = 0.0
	notify("DOWNED  -  3-SECOND DISPOSITION WINDOW", DANGER, 3.0)

func update_player_downed(delta: float) -> void :
	downed_timer += delta
	if laundry_mob_defeat_pending:
		var capone: = actor_by_id("laundry_capone")
		if capone == null or capone.removed or capone.downed:
			laundry_mob_defeat_pending = false
			downed_disposition_resolved = false
		else:
			downed_timer = minf(downed_timer, 2.9)
	if not downed_disposition_resolved and downed_timer >= 1.35:
		downed_disposition_resolved = true
		var attacker: = nearest_hostile(150.0)
		if attacker != null:
			if deposit_active:
				deposit_active = false
				attacker.cash += deposit_value
				deposit_value = 0
				inventory.erase("Entrusted Deposit Bag")
				add_world_note("The entrusted deposit was taken during the downed window.")
			resolve_carried_handoffs("STOLEN", "A hostile took the carried handoff during the downed window.")
			resolve_permanent_harm_against_player(attacker)
			if mode in [ScreenMode.SUSPENSE, ScreenMode.DEATH]:
				return
	if downed_timer >= 3.0:
		if area == "jail":
			to_jail_infirmary(downed_reason)
		else:
			home_turf_rescues += 1
			to_hospital(downed_reason)

func to_jail_infirmary(reason: String) -> void :


	player_downed = false
	downed_timer = 0.0
	downed_disposition_resolved = false
	health = 32.0
	stamina = 28.0
	room_id = "infirmary"
	player_position = resolve_safe_position(Vector2(500, 275))
	vault_active = false
	objective = "Recover in the Tier Infirmary, then complete %d remaining sentence credits." % sentence_credits
	notify("TIER INFIRMARY TRANSFER - SENTENCE REMAINS ACTIVE: %s" % reason, DANGER, 4.0)

func resolve_permanent_harm_against_player(attacker: AgervisActor) -> void :
	var fatal_attempt: = mark_timer > 0.0 or wanted
	var roll: = rng.randi_range(1, 16)
	var succeeded: = Rules.fatality_succeeds(roll, fatal_attempt)
	var interrupted: = fatal_attempt and succeeded and has_equipped_contingency(["Emergency Beacon"])
	if interrupted:
		succeeded = false
	begin_suspense({
		"lan": false, "fatal": fatal_attempt, "success": succeeded, "roll": roll, 
		"duration": rng.randf_range(5.0, 8.0), "attacker": attacker.display_name, "interrupted": interrupted, 
	})

func to_hospital(reason: String) -> void :
	if area == "laundromat" and room_id == "office":
		clear_laundry_mob_hostility()
	resolve_carried_handoffs("LOST", "Emergency transport separated you from the carried handoff.")
	player_downed = false
	downed_timer = 0.0
	downed_disposition_resolved = false
	health = 22.0
	stamina = 20.0
	area = "hospital"
	room_id = String(Build10.DEFAULT_ROOM.get("hospital", "intake"))
	vault_active = false
	player_position = resolve_safe_position(Vector2(400, 270))
	hospital_stabilized = false
	hospital_required_treatment = true
	for actor in actors:
		if actor.hostile:
			actor.hostile = false
			actor.removed = true
	objective = "Stabilize at intake, then use the discharge door."
	notify("HOSPITAL TRANSPORT: %s" % reason, ACCENT, 6.0)





func update_combat_systems(delta: float) -> void :

	update_stamina(delta)
	update_combo_system(delta)
	update_dodge_system(delta)
	update_parry_system(delta)
	update_hitstop(delta)
	update_screen_shake(delta)
	update_style_rank(delta)
	update_hit_markers(delta)
	update_knockback_system(delta)


	if attack_animation_timer > 0.0:
		update_attack_animation(delta)

func update_stamina(delta: float) -> void :
	if stamina_regen_delay > 0.0:
		stamina_regen_delay -= delta
		return

	if stamina < max_stamina:
		stamina = minf(max_stamina, stamina + stamina_regen_rate * delta)

func update_combo_system(delta: float) -> void :
	if combo_timer > 0.0:
		combo_timer -= delta * COMBO_DECAY_RATE
		if combo_timer <= 0.0:
			reset_combo()

func update_dodge_system(delta: float) -> void :
	if dodge_cooldown > 0.0:
		dodge_cooldown -= delta

	if dodge_active:
		dodge_timer -= delta
		if dodge_timer <= 0.0:
			dodge_active = false
			dodge_invincible = false

func update_parry_system(delta: float) -> void :
	if parry_window > 0.0:
		parry_window -= delta
		if parry_window <= 0.0:
			parry_success = false

	if parry_cooldown > 0.0:
		parry_cooldown -= delta

	if perfect_dodge_slowmo > 0.0:
		perfect_dodge_slowmo -= delta * 2.0

func update_hitstop(delta: float) -> void :
	if hitstop_timer > 0.0:
		hitstop_timer -= delta
		return

func update_screen_shake(delta: float) -> void :
	if camera_trauma > 0.0:
		camera_trauma = maxf(0.0, camera_trauma - delta * 2.0)
		screen_shake_intensity = camera_trauma * camera_trauma

	if screen_shake_duration > 0.0:
		screen_shake_duration -= delta

func update_style_rank(delta: float) -> void :
	if style_timer > 0.0:
		style_timer -= delta
		if style_timer <= 0.0:
			style_points = maxf(0.0, style_points - STYLE_DECAY_RATE * delta)
			update_style_rank_from_points()

func update_style_rank_from_points() -> void :
	var old_rank: = style_rank
	style_rank = 0
	for i in range(STYLE_THRESHOLDS.size()):
		if style_points >= STYLE_THRESHOLDS[i]:
			style_rank = i + 1

	if style_rank > old_rank:
		var rank_names: = ["D", "C", "B", "A", "S", "SSS"]
		if style_rank < rank_names.size():
			notify("STYLE RANK: %s" % rank_names[style_rank], GOOD, 1.5)

func update_hit_markers(delta: float) -> void :
	var i: = 0
	while i < hit_markers.size():
		var marker: = hit_markers[i]
		marker["timer"] = float(marker.get("timer", 0.0)) - delta
		if marker["timer"] <= 0.0:
			hit_markers.remove_at(i)
		else:
			i += 1

func update_knockback_system(delta: float) -> void :

	if attack_queue_timer > 0.0:
		attack_queue_timer -= delta
		if attack_queue_timer <= 0.0:
			queued_attack = false


	if player_knockback_active:

		movement_locked = true


		var speed: = player_knockback_velocity.length()
		if speed > 5.0:
			var friction_force: = player_knockback_velocity.normalized() * player_knockback_friction * delta * 60.0
			if friction_force.length() > speed:
				friction_force = player_knockback_velocity
			player_knockback_velocity -= friction_force


			var knockback_delta: = player_knockback_velocity * delta
			var old_position: = player_position
			player_position += knockback_delta


			if player_position_hits_solid(player_position):
				player_position = resolve_safe_position(player_position)

				land_from_knockback(true)
				trigger_screen_shake(0.6)
				spawn_blood(player_position, "strike", 5)
		else:

			land_from_knockback(false)
	else:

		movement_locked = false


	if player_knockdown:
		player_knockdown_timer += delta


		if player_knockdown_timer >= player_knockdown_max_duration * 0.5:
			player_knockdown_can_recover = true


		if player_knockdown_timer >= player_knockdown_max_duration:
			recover_from_knockdown()

func land_from_knockback(hit_wall: bool) -> void :
	if not player_knockback_active:
		return

	player_knockback_active = false
	player_knockback_velocity = Vector2.ZERO
	movement_locked = false


	var knockdown_chance: = player_last_knockback_distance / 200.0
	knockdown_chance = clampf(knockdown_chance, 0.05, 0.95)


	if hit_wall:
		knockdown_chance += 0.3
		knockdown_chance = clampf(knockdown_chance, 0.0, 0.98)


	if rng.randf() < knockdown_chance:
		trigger_knockdown_on_landing(player_last_knockback_distance, hit_wall)

func trigger_knockdown_on_landing(knockback_distance: float, hit_wall: bool) -> void :
	player_knockdown = true
	player_knockdown_timer = 0.0
	player_knockdown_can_recover = false
	movement_locked = true


	var base_duration: = 0.8
	var distance_factor: = (knockback_distance - 20.0) / 180.0
	distance_factor = clampf(distance_factor, 0.0, 1.0)
	player_knockdown_max_duration = base_duration + (distance_factor * 2.7)


	if hit_wall:
		player_knockdown_max_duration += 0.5


	trigger_screen_shake(0.7)
	spawn_blood(player_position, "strike", 8)
	add_style_points(-20.0)
	notify("KNOCKED DOWN - HOLD SPACE TO RECOVER", DANGER, 1.5)


	combo_count = 0
	combo_timer = 0.0

func apply_knockback_to_player(force: float, direction: Vector2, knockdown_chance: float, attacker_fighting_level: int, weapon_multiplier: float) -> void :
	if god_mode or dodge_invincible or player_downed or player_knockback_active:
		return


	var player_fighting_level: = skill_level("Fighting")
	var resistance: = 1.0 - (player_fighting_level * 0.04)
	resistance = clampf(resistance, 0.3, 1.0)


	var final_force: = force * weapon_multiplier * resistance
	final_force = clampf(final_force, 20.0, 200.0)


	player_knockback_velocity = direction.normalized() * final_force * 3.5
	player_knockback_active = true
	player_last_knockback_distance = final_force
	movement_locked = true


	trigger_screen_shake(0.4)



func recover_from_knockdown() -> void :
	if not player_knockdown:
		return

	player_knockdown = false
	player_knockdown_timer = 0.0
	player_knockdown_can_recover = false
	player_knockback_active = false
	player_knockback_velocity = Vector2.ZERO


	dodge_invincible = true
	dodge_timer = 0.2

	notify("RECOVERED", ACCENT, 1.0)

func can_player_act() -> bool:

	return not player_knockdown and not player_downed and not player_detained and not player_arrested

func apply_knockback_to_actor(actor: AgervisActor, force: float, direction: Vector2, knockdown_base_chance: float) -> void :
	if actor.downed or actor.knockback_active:
		return


	var resistance: = 1.0 - (actor.fighting_level * 0.04)
	resistance = clampf(resistance, 0.3, 1.0)


	var final_force: = force * resistance
	final_force = clampf(final_force, 20.0, 200.0)


	actor.knockback_velocity = direction.normalized() * final_force * 3.5
	actor.knockback_active = true
	actor.last_knockback_distance = final_force


	spawn_blood(actor.position, "strike", 3)

func update_actor_knockback(actor: AgervisActor, delta: float) -> void :
	if not actor.knockback_active:
		return


	var speed: = actor.knockback_velocity.length()
	if speed > 5.0:
		var friction_force: = actor.knockback_velocity.normalized() * player_knockback_friction * delta * 60.0
		if friction_force.length() > speed:
			friction_force = actor.knockback_velocity
		actor.knockback_velocity -= friction_force


		var knockback_delta: = actor.knockback_velocity * delta
		var old_position: = actor.position
		actor.position += knockback_delta


		var hit_wall: = false
		if actor.area == "street":
			if actor.position.x < 40.0:
				actor.position.x = 40.0
				hit_wall = true
			elif actor.position.x > STREET_WIDTH - 40.0:
				actor.position.x = STREET_WIDTH - 40.0
				hit_wall = true
		else:

			if actor.position.x < 100.0:
				actor.position.x = 100.0
				hit_wall = true
			elif actor.position.x > 880.0:
				actor.position.x = 880.0
				hit_wall = true

		if hit_wall:
			actor_land_from_knockback(actor, true)
			spawn_blood(actor.position, "strike", 5)
	else:

		actor_land_from_knockback(actor, false)


	if actor.knockdown:
		actor.knockdown_timer += delta


		if actor.knockdown_timer >= actor.knockdown_max_duration:
			actor_recover_from_knockdown(actor)

func actor_land_from_knockback(actor: AgervisActor, hit_wall: bool) -> void :
	if not actor.knockback_active:
		return

	actor.knockback_active = false
	actor.knockback_velocity = Vector2.ZERO


	var knockdown_chance: = actor.last_knockback_distance / 200.0


	if hit_wall:
		knockdown_chance += 0.3


	if rng.randf() < knockdown_chance:
		actor_trigger_knockdown_on_landing(actor, actor.last_knockback_distance, hit_wall)

func actor_trigger_knockdown_on_landing(actor: AgervisActor, knockback_distance: float, hit_wall: bool) -> void :
	actor.knockdown = true
	actor.knockdown_timer = 0.0


	var distance_factor: = (knockback_distance - 20.0) / 180.0
	distance_factor = clampf(distance_factor, 0.0, 1.0)
	actor.knockdown_max_duration = 0.8 + (distance_factor * 2.7)


	if hit_wall:
		actor.knockdown_max_duration += 0.5


	spawn_blood(actor.position, "strike", 8)

func actor_recover_from_knockdown(actor: AgervisActor) -> void :
	if not actor.knockdown:
		return

	actor.knockdown = false
	actor.knockdown_timer = 0.0
	actor.knockback_active = false
	actor.knockback_velocity = Vector2.ZERO

func update_attack_animation(delta: float) -> void :
	if hitstop_timer > 0.0:
		return

	attack_animation_timer -= delta
	if attack_animation_timer <= 0.0:
		end_attack()
		return


	var attack_data: = get_attack_data(attack_type)
	if attack_data.is_empty():
		return

	var total_duration: = get_attack_total_duration(attack_data)
	var elapsed: = total_duration - attack_animation_timer
	attack_frame = elapsed / total_duration


	var windup_end: = float(attack_data.get("windup", 0.0))
	var anticipation_end: = windup_end + float(attack_data.get("anticipation", 0.0))
	var strike_end: = anticipation_end + float(attack_data.get("strike", 0.0))
	var impact_hold_end: = strike_end + float(attack_data.get("impact_hold", 0.0))
	var followthrough_end: = impact_hold_end + float(attack_data.get("followthrough", 0.0))

	if elapsed < windup_end:
		attack_phase = "windup"
	elif elapsed < anticipation_end:
		attack_phase = "anticipation"
	elif elapsed < strike_end:
		if attack_phase != "strike":
			execute_attack_hit()
		attack_phase = "strike"
	elif elapsed < impact_hold_end:
		attack_phase = "impact_hold"
	elif elapsed < followthrough_end:
		attack_phase = "followthrough"
	else:
		attack_phase = "recovery"


func verify_phase_sync() -> void :
	if attack_type.is_empty() or attack_animation_timer <= 0.0:
		return

	var visual_data: = get_visual_phase_data()
	if visual_data.is_empty():
		return

	var visual_phase: String = visual_data["phase"]
	var auth_phase: String = attack_phase


	var phases_match: = false
	if auth_phase == visual_phase:
		phases_match = true
	elif (auth_phase == "windup" or auth_phase == "anticipation") and (visual_phase == "windup" or visual_phase == "anticipation"):
		phases_match = true
	elif (auth_phase == "strike" or auth_phase == "impact_hold") and (visual_phase == "strike" or visual_phase == "impact_hold"):
		phases_match = true
	elif (auth_phase == "followthrough" or auth_phase == "recovery") and (visual_phase == "followthrough" or visual_phase == "recovery"):
		phases_match = true

	if not phases_match:
		push_warning("PHASE MISMATCH: Auth='%s' Visual='%s' Attack='%s' Elapsed=%.3f" % [
			auth_phase, visual_phase, attack_type, visual_data["elapsed"]
		])

func get_attack_data(attack_name: String) -> Dictionary:
	return COMBAT_FRAME_DATA.get(attack_name, {})

func get_attack_total_duration(attack_data: Dictionary) -> float:
	return float(attack_data.get("windup", 0.0)) + \
	float(attack_data.get("anticipation", 0.0)) + \
	float(attack_data.get("strike", 0.0)) + \
	float(attack_data.get("impact_hold", 0.0)) + \
	float(attack_data.get("followthrough", 0.0)) + \
	float(attack_data.get("recovery", 0.0))

func get_effect_additive(key: String, default_value: float = 0.0) -> float:
	var total: = 0.0
	var found: = false
	for record in active_buffs + active_debuffs:
		var effects: Dictionary = record.get("effects", {})
		if effects.has(key):
			total += float(effects[key])
			found = true
	return total if found else default_value

func get_effect_multiplicative(key: String, default_value: float = 1.0) -> float:
	var product: = 1.0
	var found: = false
	for record in active_buffs + active_debuffs:
		var effects: Dictionary = record.get("effects", {})
		if effects.has(key):
			product *= float(effects[key])
			found = true
	return product if found else default_value

func get_effect_flag(key: String) -> bool:
	for record in active_buffs + active_debuffs:
		var effects: Dictionary = record.get("effects", {})
		if effects.has(key) and effects[key]:
			return true
	return false

func get_weapon_stats() -> Dictionary:
	var weapon: = active_attack_weapon()
	return WEAPON_STATS.get(weapon, WEAPON_STATS["Fists"])



func get_visual_phase_data() -> Dictionary:
	if attack_animation_timer <= 0.0:
		return {}

	var attack_data: = get_attack_data(attack_type)
	if attack_data.is_empty():
		return {}

	var total_duration: = get_attack_total_duration(attack_data)
	var elapsed: = total_duration - attack_animation_timer


	var windup_end: = float(attack_data.get("windup", 0.0))
	var anticipation_end: = windup_end + float(attack_data.get("anticipation", 0.0))
	var strike_end: = anticipation_end + float(attack_data.get("strike", 0.0))
	var impact_hold_end: = strike_end + float(attack_data.get("impact_hold", 0.0))
	var followthrough_end: = impact_hold_end + float(attack_data.get("followthrough", 0.0))

	var phase: = ""
	var phase_start: = 0.0
	var phase_duration: = 0.0

	if elapsed < windup_end:
		phase = "windup"
		phase_start = 0.0
		phase_duration = float(attack_data.get("windup", 0.0))
	elif elapsed < anticipation_end:
		phase = "anticipation"
		phase_start = windup_end
		phase_duration = float(attack_data.get("anticipation", 0.0))
	elif elapsed < strike_end:
		phase = "strike"
		phase_start = anticipation_end
		phase_duration = float(attack_data.get("strike", 0.0))
	elif elapsed < impact_hold_end:
		phase = "impact_hold"
		phase_start = strike_end
		phase_duration = float(attack_data.get("impact_hold", 0.0))
	elif elapsed < followthrough_end:
		phase = "followthrough"
		phase_start = impact_hold_end
		phase_duration = float(attack_data.get("followthrough", 0.0))
	else:
		phase = "recovery"
		phase_start = followthrough_end
		phase_duration = float(attack_data.get("recovery", 0.0))


	var phase_elapsed: = elapsed - phase_start
	var phase_t: = clampf(phase_elapsed / phase_duration, 0.0, 1.0) if phase_duration > 0.0 else 0.0


	var normalized_t: = clampf(elapsed / total_duration, 0.0, 1.0)

	return {
		"attack_name": attack_type, 
		"elapsed": elapsed, 
		"phase": phase, 
		"phase_t": phase_t, 
		"normalized_t": normalized_t, 
		"total_duration": total_duration
	}

func execute_attack_hit() -> void :
	var weapon_stats: = get_weapon_stats()
	var weapon_range: = float(weapon_stats.get("range", 92.0))
	var requires_facing: = bool(weapon_stats.get("requires_facing", true))

	var target: = nearest_facing_actor(weapon_range, true) if requires_facing else nearest_actor(weapon_range, true)
	if target == null:

		add_style_points(-5.0)
		return

	var attack_data: = get_attack_data(attack_type)
	if attack_data.is_empty():
		return

	var base_damage: = float(attack_data.get("damage", 30.0))
	var skill_bonus: = minf(15.0, skill_level("Fighting") * 0.6)

	var weapon_damage_bonus: = float(weapon_stats.get("damage_bonus", 0.0))
	var muscle_boost: = get_effect_additive("muscle_boost", 0.0)
	var muscle_penalty: = get_effect_additive("muscle_penalty", 0.0)
	var hands_boost: = get_effect_additive("hands_boost", 0.0)
	var hands_penalty: = get_effect_additive("hands_penalty", 0.0)

	var total_damage_bonus: = weapon_damage_bonus + muscle_boost + muscle_penalty + hands_boost + hands_penalty
	var final_damage: = (base_damage + skill_bonus + total_damage_bonus) * damage_multiplier

	var base_crit_chance: = 0.15
	var weapon_crit_bonus: = float(weapon_stats.get("crit_chance_bonus", 0.0))
	var effect_crit_bonus: = get_effect_additive("crit_chance", 0.0)
	var total_crit_chance: = base_crit_chance + weapon_crit_bonus + effect_crit_bonus

	if rng.randf() < total_crit_chance:
		critical_hit = true
		final_damage *= CRITICAL_DAMAGE_MULTIPLIER
		trigger_hitstop(HITSTOP_CRITICAL)
		add_style_points(15.0)
	else:
		critical_hit = false
		trigger_hitstop(HITSTOP_MEDIUM)


	if perfect_dodge_slowmo > 0.0:
		final_damage *= PERFECT_DODGE_DAMAGE_MULTIPLIER
		add_style_points(25.0)


	if posture_break_timer > 0.0:
		final_damage *= POSTURE_BREAK_VULNERABILITY
		add_style_points(20.0)


	if check_environment_collision(target):
		final_damage += ENVIRONMENT_DAMAGE_BONUS
		environment_hit = true
		add_style_points(18.0)
		trigger_screen_shake(0.6)
	else:
		environment_hit = false
		trigger_screen_shake(0.3)


	var posture_damage: = float(attack_data.get("posture_damage", 15.0))
	target_posture += posture_damage
	if target_posture >= target_max_posture:
		trigger_posture_break(target)


	var downed_now: = target.take_damage(final_damage)
	last_hit_position = target.position


	if not downed_now:
		var knockback_direction: = (target.position - player_position).normalized()
		var knockback_force: = float(attack_data.get("knockback_force", 80.0))


		if critical_hit:
			knockback_force *= 1.4


		if posture_break_timer > 0.0:
			knockback_force *= 1.3


		if environment_hit:
			knockback_force *= 1.2

		var knockdown_chance: = float(attack_data.get("knockdown_chance", 0.05))
		apply_knockback_to_actor(target, knockback_force, knockback_direction, knockdown_chance)


	increment_combo()
	add_style_points(8.0 + combo_count * 2.0)


	attack_impact_flash = 1.0
	spawn_blood(target.position, "strike", 5 if not downed_now else 10)
	add_hit_marker(target.position, int(final_damage), critical_hit)


	if target.health <= target.max_health * 0.2 and not downed_now:
		finisher_available = true
		finisher_target = target
		notify("FINISHER AVAILABLE - PRESS F+SHIFT", ACCENT, 2.0)


	var is_gun_attack: = active_attack_weapon() in ["Pistol", "Revolver", "SMG", "Shotgun", "Rifle", "AR"]
	grant_xp("Fighting" if not is_gun_attack else "Firearms", 14 + combo_count * 2)

	if is_laundry_office_actor(target):
		activate_laundry_mob_hostility("A UNION OFFICE MEMBER WAS ATTACKED")

	var unprovoked: = not target.hostile and target.role not in ["Robber", "Betrayer"]
	if unprovoked:
		add_crime("ASSAULT")
		activate_mark()


	if audio_player != null:
		audio_player.stream = make_punch_sound()
		audio_player.volume_db = -14.0 + minf(4.0, combo_count * 0.5)
		audio_player.play()

	if downed_now:
		notify("%s IS DOWNED" % target.display_name.to_upper(), DANGER, 2.0)
		add_style_points(30.0)

func trigger_posture_break(target: AgervisActor) -> void :
	target_posture = 0.0
	posture_break_timer = 2.5
	trigger_hitstop(HITSTOP_HEAVY)
	trigger_screen_shake(0.8)
	add_style_points(35.0)
	notify("POSTURE BREAK!", GOOD, 1.5)

func check_environment_collision(target: AgervisActor) -> bool:


	var collision_distance: = 50.0


	if target.position.x < 200.0 or target.position.x > VIEW_SIZE.x - 200.0:
		return true


	if target.position.distance_to(player_position) < 60.0:
		return true

	return false

func add_hit_marker(position: Vector2, damage: int, is_critical: bool) -> void :
	hit_markers.append({
		"position": position, 
		"damage": damage, 
		"critical": is_critical, 
		"timer": 0.8, 
		"offset_y": 0.0, 
	})

func increment_combo() -> void :
	combo_count += 1
	combo_timer = combo_window
	last_attack_type = attack_type


	if combo_count % 5 == 0:
		var word_index: = mini(combo_count / 5 - 1, combo_words.size() - 1)
		if word_index >= 0:
			notify("%d HIT COMBO - %s!" % [combo_count, combo_words[word_index]], GOOD, 1.5)

func reset_combo() -> void :
	combo_count = 0
	combo_timer = 0.0
	last_attack_type = ""

func add_style_points(points: float) -> void :
	style_points += points
	style_timer = 2.0
	update_style_rank_from_points()

func trigger_hitstop(duration: float) -> void :
	hitstop_timer = duration
	hitstop_duration = duration

func trigger_screen_shake(intensity: float) -> void :
	camera_trauma = minf(1.0, camera_trauma + intensity)
	screen_shake_duration = 0.5

func end_attack() -> void :
	attack_animation_timer = 0.0
	attack_phase = ""
	attack_cooldown = 0.3
	damage_multiplier = 1.0
	critical_hit = false

func player_dodge() -> void :

	if player_knockdown:
		if player_knockdown_can_recover:
			recover_from_knockdown()
		return

	if dodge_cooldown > 0.0 or stamina < DODGE_STAMINA_COST:
		return

	if not can_player_act():
		return


	stamina -= DODGE_STAMINA_COST
	stamina_regen_delay = 1.0


	var dodge_dir: = Vector2.ZERO
	if Input.is_action_pressed("move_left"):
		dodge_dir.x -= 1.0
	if Input.is_action_pressed("move_right"):
		dodge_dir.x += 1.0
	if Input.is_action_pressed("move_up"):
		dodge_dir.y -= 1.0
	if Input.is_action_pressed("move_down"):
		dodge_dir.y += 1.0

	if dodge_dir.length() == 0.0:
		dodge_dir = Vector2(facing, 0.0)

	dodge_direction = dodge_dir.normalized()
	dodge_active = true
	dodge_timer = 0.35
	dodge_invincible = true
	dodge_cooldown = 0.6


	var nearest_enemy: = nearest_hostile(120.0)
	if nearest_enemy != null and nearest_enemy.attack_cooldown > 0.0:

		perfect_dodge_slowmo = 1.5
		add_style_points(40.0)
		notify("PERFECT DODGE!", ACCENT, 1.0)
		damage_multiplier = PERFECT_DODGE_DAMAGE_MULTIPLIER


	var dodge_distance: = 140.0
	player_position += dodge_direction * dodge_distance

func player_parry() -> void :
	if parry_cooldown > 0.0 or stamina < PARRY_STAMINA_COST:
		return

	if not can_player_act():
		return


	stamina -= PARRY_STAMINA_COST
	stamina_regen_delay = 0.8


	parry_window = PARRY_WINDOW_DURATION
	parry_cooldown = 1.2


	var nearest_enemy: = nearest_hostile(100.0)
	if nearest_enemy != null and nearest_enemy.attack_cooldown > 0.0:

		parry_success = true
		nearest_enemy.attack_cooldown = 0.0
		nearest_enemy.take_damage(15.0)


		target_posture += 50.0
		if target_posture >= target_max_posture:
			trigger_posture_break(nearest_enemy)

		trigger_hitstop(HITSTOP_HEAVY)
		trigger_screen_shake(0.7)
		add_style_points(50.0)
		notify("PARRY!", GOOD, 1.0)


		damage_multiplier = 2.0

func player_finisher() -> void :
	if not finisher_available or finisher_target == null:
		return

	if finisher_target.downed or finisher_target.removed:
		finisher_available = false
		finisher_target = null
		return


	if stamina < 40.0:
		notify("NOT ENOUGH STAMINA FOR FINISHER", DANGER, 1.5)
		return

	stamina -= 40.0
	stamina_regen_delay = 2.0


	var finisher_damage: = finisher_target.health * FINISHER_DAMAGE_MULTIPLIER
	finisher_target.take_damage(finisher_damage)

	trigger_hitstop(HITSTOP_CRITICAL * 1.5)
	trigger_screen_shake(1.0)
	add_style_points(100.0)

	spawn_blood(finisher_target.position, "strike", 15)
	notify("FINISHER! %s ELIMINATED" % finisher_target.display_name.to_upper(), ACCENT, 3.0)

	finisher_available = false
	finisher_target = null


	grant_xp("Fighting", 50)





func nearest_actor(radius: float, include_neutral: bool = false) -> AgervisActor:
	var best: AgervisActor = null
	var best_distance: = radius
	for actor in actors:
		if not actor_visible_in_current_room(actor) or actor.downed:
			continue
		if not include_neutral and not actor.hostile:
			continue
		var distance: = actor.distance_to(player_position)
		if distance < best_distance:
			best = actor
			best_distance = distance
	return best

func actor_is_in_facing_direction(actor: AgervisActor) -> bool:
	var horizontal_delta: = actor.position.x - player_position.x
	return absf(horizontal_delta) <= 1.0 or horizontal_delta * (-1.0 if facing < 0.0 else 1.0) > 0.0

func nearest_facing_actor(radius: float, include_neutral: bool = false) -> AgervisActor:
	var best: AgervisActor = null
	var best_distance: = radius
	for actor in actors:
		if not actor_visible_in_current_room(actor) or actor.downed or not actor_is_in_facing_direction(actor):
			continue
		if not include_neutral and not actor.hostile:
			continue
		var distance: = actor.distance_to(player_position)
		if distance < best_distance:
			best = actor
			best_distance = distance
	return best

func nearest_downed(radius: float = 100.0) -> AgervisActor:
	var best: AgervisActor = null
	var best_distance: = radius
	for actor in actors:
		if not actor_visible_in_current_room(actor) or not actor.downed:
			continue
		var distance: = actor.distance_to(player_position)
		if distance < best_distance:
			best = actor
			best_distance = distance
	return best

func nearest_hostile(radius: float) -> AgervisActor:
	return nearest_actor(radius, false)

func interact() -> void :
	if player_downed or player_detained or (player_arrested and area != "jail") or vault_active:
		return
	if not active_blood_cleaning.is_empty():
		cancel_blood_cleaning("PLAYER_CANCELLED")
		return
	if area in ["rear", "rooftop"] and try_parkour_route():
		return
	var nearby_blood: = nearest_blood_evidence()
	if not nearby_blood.is_empty():
		open_blood_evidence_dialog(nearby_blood)
		return


	var nearby_actor: = nearest_actor(86.0, true)
	if nearby_actor != null:
		interact_actor(nearby_actor)
		return
	var room_interaction: = nearest_room_owned_interaction()
	if not room_interaction.is_empty() and interact_room_owned_record(room_interaction):
		return
	if try_build10_room_activity():
		return
	if contextual_action_label() in ["ENTER", "EXIT"]:
		interact_current_area_without_actor_priority()
		return


	if current_room_is_authored() and nearest_room_owned_interaction().is_empty():
		return
	match area:
		"tutorial", "school": interact_school()
		"home": interact_home()
		"street": interact_street()
		"store": interact_store()
		"backroom": interact_backroom()
		"bank": interact_bank()
		"jail": interact_jail()
		"hospital": interact_hospital()
		"apartment": interact_apartment()
		"social": interact_social()
		"restaurant": interact_restaurant()
		"barber": interact_barber()
		"laundromat": interact_laundromat()
		"pawn": interact_pawn()
		"precinct": interact_precinct()
		"pillmill": interact_pillmill()
		"clinic": interact_clinic()
		"debugshop": interact_debugshop()

func collect_blood_sample(record: Dictionary) -> void :
	if "Test Tube" not in inventory:
		notify("A TEST TUBE IS REQUIRED BEFORE THE BLOOD CAN BE COLLECTED", DANGER, 3.0)
		return
	if online_economy_enabled():
		submit_online_economy_request("COLLECT_BLOOD_SAMPLE", {"evidence_id": String(record.get("evidence_id", ""))}, true)
		return
	notify("BLOOD SAMPLE COLLECTION REQUIRES THE SERVER EVIDENCE LEDGER", ACCENT, 3.0)

func carried_blood_cleaners() -> Array[String]:
	var carried: Array[String] = []
	for cleaner in BLOOD_CLEANER_OPTIONS:
		if cleaner in inventory:
			carried.append(cleaner)
	return carried

func blood_evidence_record_for_id(evidence_id: String) -> Dictionary:
	for record in blood_evidence_effects:
		if String(record.get("evidence_id", "")) == evidence_id:
			return record.duplicate(true)
	return {}

func open_blood_evidence_dialog(record: Dictionary) -> void :
	blood_dialog_evidence_id = String(record.get("evidence_id", ""))
	var cleaners: = carried_blood_cleaners()
	var options: Array[Dictionary] = []
	if "Test Tube" in inventory:
		options.append({"label": "Collect a blood sample", "id": "blood_sample"})
	for cleaner in cleaners:
		options.append({"label": "Clean with %s" % cleaner, "id": "blood_clean_%d" % options.size(), "cleaner_item_id": cleaner})
	options.append({"label": "Leave the evidence", "id": "close"})
	var lines: Array[String] = [
		"The stain is still active evidence. Removing it changes the scene, but does not erase its history.", 
		"Choose one carried tool. The server checks the room, home instance, reach, and Resident state before anything is consumed.", 
	]
	if options.size() == 1:
		lines = ["The stain is active evidence, but this Resident carries neither a Test Tube nor an approved cleaner."]
	open_dialog("BLOOD EVIDENCE", lines, options)

func start_blood_cleaning(record: Dictionary, cleaner_item_id: String) -> void :
	if not online_economy_enabled():
		notify("BLOOD CLEANING REQUIRES THE AUTHORITATIVE WORLD LEDGER", ACCENT, 3.2)
		return
	if cleaner_item_id not in carried_blood_cleaners():
		notify("THAT CLEANER IS NOT IN THE CARRIED INVENTORY", DANGER, 2.8)
		return
	if submit_online_economy_request("START_BLOOD_CLEANING", {"evidence_id": String(record.get("evidence_id", "")), "cleaner_item_id": cleaner_item_id}, true, {"evidence_id": String(record.get("evidence_id", "")), "cleaner_item_id": cleaner_item_id}):
		notify("CLEANING STARTED  -  MOVEMENT, DAMAGE, OR COMBAT WILL INTERRUPT IT", ACCENT, 3.2)

func cancel_blood_cleaning(reason: String = "PLAYER_CANCELLED") -> void :
	if active_blood_cleaning.is_empty():
		return
	if not online_economy_enabled():
		active_blood_cleaning.clear()
